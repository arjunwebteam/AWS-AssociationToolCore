<script>
    // ================================================================
    // SQUARE
    // ================================================================
    var squareCard = null;
    var SQUARE_APP_ID = "sandbox-sq0idb-swKow-4fK41_9Ix3INYhbg";
    var SQUARE_LOCATION_ID = "LH88Y6MRZFB82";
    var squarePrePaymentDone = false;
    var squarePrePaymentInProgress = false;

    function resetSquareState() {
        squareCard = null; squarePrePaymentDone = false; squarePrePaymentInProgress = false;
        var btn = document.getElementById("btnProceedPay");
        if (btn) { btn.style.display = "inline-block"; btn.disabled = false; btn.innerText = "Proceed to Pay"; }
        var cardBtn = document.getElementById("card-button");
        if (cardBtn) cardBtn.style.display = "none";
        var container = document.getElementById("card-container");
        if (container) container.innerHTML = "";
    }

    async function initializeSquareCard() {
        if (squareCard) return;
        if (typeof Square === "undefined") { await loadScript("https://sandbox.web.squarecdn.com/v1/square.js"); }
        var payments = Square.payments(SQUARE_APP_ID, SQUARE_LOCATION_ID);
        squareCard = await payments.card();
        await squareCard.attach("#card-container");
    }

    function loadScript(src) {
        return new Promise(function (resolve, reject) {
            if (document.querySelector("script[src='" + src + "']")) { resolve(); return; }
            var s = document.createElement("script");
            s.src = src; s.onload = resolve; s.onerror = reject;
            document.head.appendChild(s);
        });
    }

    $(document).ready(function () {
        $(document).on("click", ".cus-tab-label", function () {
            var clickedTab = $(this).data("tab");
            if ($("#PaymentMethod").val() === "Square" && clickedTab !== "tabsquare") { resetSquareState(); }
        });

        $("#btnProceedPay").on("click", async function () {
            if ($("#PaymentMethod").val() !== "Square") return;
            if (!$("#SignupForm").valid()) {
                $('html, body').animate({ scrollTop: $("em.help-block:first").offset().top - 100 }, 500);
                return;
            }
            var amt = $("#AmountPaid").val();
            if (!amt || parseFloat(amt) <= 0) { alert("Please select a performance category first."); return; }
            var btn = document.getElementById("btnProceedPay");
            if (squarePrePaymentDone) {
                btn.style.display = "none";
                document.getElementById("card-button").style.display = "inline-block";
                return;
            }
            if (squarePrePaymentInProgress) return;
            squarePrePaymentInProgress = true; btn.disabled = true; btn.innerText = "Loading payment form...";
            try {
                await initializeSquareCard();
                squarePrePaymentDone = true;
                document.getElementById("card-button").style.display = "inline-block";
                btn.style.display = "none";
            } catch (err) {
                btn.disabled = false; btn.innerText = "Proceed to Pay"; squarePrePaymentInProgress = false;
                alert("Error loading payment form: " + (err.message || "Unexpected error."));
            }
        });

        $("#card-button").on("click", async function () {
            if (!squareCard) { alert("Card form not ready. Please try again."); return; }
            var btn = this; btn.disabled = true; btn.innerText = "Processing...";
            try {
                var result = await squareCard.tokenize();
                if (result.status === "OK") {
                    $("#SquareNonce").val(result.token);
                    btn.innerText = "Processing payment...";
                    document.getElementById("SignupForm").submit();
                } else {
                    btn.disabled = false; btn.innerText = "Pay";
                    var errors = result.errors ? result.errors.map(function (e) { return e.message; }).join(", ") : "Unknown error";
                    alert("Card error: " + errors);
                }
            } catch (err) {
                btn.disabled = false; btn.innerText = "Pay";
                alert("Error processing payment: " + (err.message || "Unexpected error"));
            }
        });
    });
</script>

<script>
    var actionStatus = null;
    var cnameValue = '@Html.Raw(cname)';

    // ── track if braintree partial loaded ──
    var braintreePartialLoaded = false;

    // ================================================================
    // HELPERS
    // ================================================================
    function onlyAlphabets(e, t) {
        var c = e.which || e.keyCode;
        return c === 32 || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || [8,9,46,37,39].indexOf(c) !== -1;
    }
    function onlyNumbers(event) {
        var c = event.which || event.keyCode;
        if (c > 31 && (c < 48 || c > 57)) { event.preventDefault(); return false; }
        return true;
    }
    function PhoneNochange(event) {
        if (event.keyCode != 8 && event.keyCode != 46) {
            var ph = $('#PhoneNo').val();
            if (ph.length == 3) $('#PhoneNo').val(ph + '-');
            if (ph.length == 7) $('#PhoneNo').val(ph + '-');
        }
    }
    function ContactPhonechange(event) {
        if (event.keyCode != 8 && event.keyCode != 46) {
            var ph = $('#ContactPhone').val();
            if (ph.length == 3) $('#ContactPhone').val(ph + '-');
            if (ph.length == 7) $('#ContactPhone').val(ph + '-');
        }
    }

    // ── Cheque radio handlers ──
    function hideCheque() {
        $('#cheque-show').show();
        $('.cheque-hide').hide();
        var validator = $('#SignupForm').data('validator');
        if (validator) {
            $("#ChequeHolderName").rules("remove");
            $("#file").rules("add", { required: true, validImageExtension: true });
            validator.settings.ignore = ':hidden:not(#file)';
            validator.resetForm();
            $('.has-error').removeClass('has-error');
            $('.has-success').removeClass('has-success');
        }
    }

    function ShowCheque() {
        $('#cheque-show').hide();
        $('.cheque-hide').show();
        var validator = $('#SignupForm').data('validator');
        if (validator) {
            $("#file").rules("remove");
            validator.settings.ignore = ':hidden';
            $("#ChequeHolderName").rules("add", {
                required: true,
                messages: { required: 'Please enter the name of the person' }
            });
            validator.resetForm();
            $('.has-error').removeClass('has-error');
            $('.has-success').removeClass('has-success');
        }
    }

  
    function AAAmemberBind()     
    { 
        $('#aaamemberhide').toggle($('#AAALifetimeMember').val() === 'No'); 
    }
    function AAAInstagramBind()      
    { 
        $('#AAAInstagramhide').toggle($('#AAAInstagram').val() === 'No');
    }
    function PerformanceCategorybind() 
    { 
        $('#Otherhide').toggle($('#PerformanceCategoryId').val() === 'Other'); 
    }
    function ParticipantAgeGroupbind()
    { 
        $('#ddlParticipantAgeGroup').val($('#ParticipantAgeGroup').val());
    }

    // ── NEW: only enable PayPal button once amount + all required fields are actually valid ──
    function paypalReadyCheck() {
        var amt = parseFloat($('#AmountPaid').val());
        var isReady = !isNaN(amt) && amt > 0 && $('#SignupForm').valid();

        if (typeof actionStatus !== 'undefined') {
            try {
                if (isReady) { actionStatus.enable(); }
                else { actionStatus.disable(); }
            } catch (e) {}
        }
        return isReady;
    }

    function generateRows() {
        var count = parseInt($('#NumberofParticipants').val()) || 0;
        var current = $('.child-row').length;
        if (count > current) { for (var i = current; i < count; i++) { addRow(i); } }
        else if (count < current) { $('.child-row').slice(count).remove(); }
    }
    function awsAddRow()
    {
        addRow($('.child-row').length); 
    }
    function addRow(index) {
        var newRow = '<div class="child-row row gx-2 align-items-center">' +
            '<div class="col-md-4"><fieldset><legend class="float-none w-auto px-1">First Name</legend>' +
            '<input class="input-box" type="text" name="[' + index + '].FirstName" placeholder="First Name"></fieldset></div>' +
            '<div class="col-md-3"><fieldset><legend class="float-none w-auto px-1">Last Name</legend>' +
            '<input class="input-box" type="text" name="[' + index + '].LastName" placeholder="Last Name"></fieldset></div>' +
            '<div class="col-md-3"><fieldset><legend class="float-none w-auto px-1">Email</legend>' +
            '<input class="input-box" type="text" name="[' + index + '].Email" placeholder="Email"></fieldset></div>' +
            '<div class="col-md-2"><a class="aws-remove-btn" onclick="deleteRow(this)"><i class="bi bi-trash3"></i> Remove</a></div>' +
            '</div>';
        $('#childinfo').append(newRow);
    }
    function deleteRow(btn) { $(btn).closest('.child-row').remove(); }

    // ================================================================
    // BRAINTREE INIT - with retry until partial is ready
    // ================================================================
    function initBraintreeWhenReady() {
        // ✅ FIX: wait until startBraintree is available (partial loaded)
        if (typeof window.startBraintree === "function") {
            if (window.dropinInst) {
                try {
                    window.dropinInst.teardown(function () {
                        window.dropinInst = null;
                        window.startBraintree();
                    });
                } catch(e) {
                    window.dropinInst = null;
                    window.startBraintree();
                }
            } else {
                window.startBraintree();
            }
        } else {
            // Retry every 300ms until partial script loads
            setTimeout(initBraintreeWhenReady, 300);
        }
    }

    // ================================================================
    // PAYMENT TAB SWITCHER
    // ================================================================
    function paymentbind(type) {
        console.log('paymentbind:', type);

        // Reset validator ignore at start
        var validator = $('#SignupForm').data('validator');
          if (validator) {
        validator.settings.ignore = ':hidden:not(#recaptchaResponse)';  // ← FIXED
    }

        // Teardown Braintree when switching away from Credit Card
        if (type !== "Credit Card" && window.dropinInst) {
            try {
                window.dropinInst.teardown(function () {
                    window.dropinInst = null;
                });
            } catch (e) { window.dropinInst = null; }
            $('#dropin-container').empty();
        }

        // ── Button visibility ──
        if (type === "PayPal") {
            $('#paypalbuttonshow').show();
            $('#paypal-button-container').show();
            $('#button-show').hide();
            $('#submit-button').hide();
        } else if (type === "Square") {
            $('#paypalbuttonshow').hide();
            $('#paypal-button-container').hide();
            $('#button-show').hide();
            $('#submit-button').hide();
            $('#btnProceedPay').show().prop('disabled', false).text('Proceed to Pay');
            $('#card-button').hide();
            $('#square-timer-display').hide();
        } else if (type === "Credit Card") {
            $('#paypalbuttonshow').hide();
            $('#paypal-button-container').hide();
            $('#button-show').show();
            $('#submit-button').show();
        } else {
            // Cash/Cheque, Zelle, Stripe, SwirePay
            $('#paypalbuttonshow').hide();
            $('#paypal-button-container').hide();
            $('#button-show').show();
            $('#submit-button').show();
        }

        $('#PaymentMethod').val(type);

        // ── Validation rules ──
        if (validator) {
            $("#CardNumber, #CardName, #Cvv, #CSVYear, #CSVMonth").rules("remove");
            $("#Zelle, #ZellePartnerName, #filezelle").rules("remove");
            $("#file").rules("remove");
            $("#ChequeHolderName").rules("remove");

            if (type === "Zelle") {
                $("#Zelle").rules("add",            { required: true });
                $("#ZellePartnerName").rules("add",  { required: true });
                $("#filezelle").rules("add",         { required: true, validImageExtension: true });

            } else if (type === "Cash/Cheque") {
                $('#Mailed-1').prop('checked', true);
                $('#cheque-show').show();
                $('.cheque-hide').hide();
                $("#ChequeHolderName").rules("remove");
                $("#file").rules("add", { required: true, validImageExtension: true });
                validator.settings.ignore = ':hidden:not(#file)';
            }

            validator.resetForm();
            $('.has-error').removeClass('has-error');
            $('.has-success').removeClass('has-success');
        }

        // ── Activate tab panel ──
        var cleanedTabId = "tab" + type.toLowerCase().replace(/[^a-z0-9\s]/g, '').trim().replace(/\s+/g, '-');
        $('.cus-tab-pane').removeClass('active').hide();
        $('#' + cleanedTabId).addClass('active').show();
        $('.cus-tab-label').removeClass('active');
        $('.cus-tab-label[value="' + type + '"]').addClass('active');

        // ✅ FIX: Init Braintree AFTER tab is visible
        if (type === "Credit Card") {
            setTimeout(function () {
                initBraintreeWhenReady();
            }, 100);
        }

        // ✅ FIX: Re-show PayPal after tab switch
        if (type === "PayPal") {
            setTimeout(function () {
                $('#paypalbuttonshow').show();
                $('#paypal-button-container').show();
            }, 200);
        }
    }
</script>

<script>
    $(document).ready(function () {

        AAAmemberBind();
        AAAInstagramBind();
        PerformanceCategorybind();

        $("#CardNumber").on("input", function () {
            var v = $(this).val().replace(/\D/g, '');
            if (v.length > 0) v = v.match(/.{1,4}/g).join(' ');
            $(this).val(v);
        });
        $("#Cvv").on("input", function () { $(this).val($(this).val().replace(/\D/g, '')); });

        // ── Load Braintree partial FIRST then init tabs ──
        // ✅ FIX: Load partial on page load, not on tab click
        $.ajax({
            type: "GET",
            url: '@Url.Action("BrainTree", "BrainTreePayment", new { area = "User" })',
            success: function (data) {
                $("#tabcredit-card").html(data);
                braintreePartialLoaded = true;
                console.log("Braintree partial loaded.");

                // ✅ FIX: Init first payment tab AFTER partial is loaded
                var firstMethod = '@firstPaymentMethod';
                if (firstMethod) {
                    paymentbind(firstMethod);
                }

                // Ensure PayPal shows after render
                setTimeout(function () {
                    if ($('#PaymentMethod').val() === 'PayPal') {
                        $('#paypalbuttonshow').show();
                        $('#paypal-button-container').show();
                        $('#button-show').hide();
                        $('#submit-button').hide();
                    }
                }, 1500);
            },
            error: function () {
                $("#tabcredit-card").html('<p class="text-danger">Failed to load payment form.</p>');
                braintreePartialLoaded = true;

                // Still init tabs even if Braintree fails
                var firstMethod = '@firstPaymentMethod';
                if (firstMethod) { paymentbind(firstMethod); }
            }
        });

        // ── Performance Category Amount ──
        var memberId = @ViewBag.MemberId;
        var isUserMember = memberId !== 0;

        $('#PerformanceCategoryId').change(function () {
            var selectedValue = $(this).val();
            if (!selectedValue) return;
            $.ajax({
                url: '@Url.Action("GetPerformanceCategoryById", "PerformanceCategory")',
                type: 'POST',
                data: { PerformanceCategoryID: selectedValue },
                dataType: 'json',
                success: function (result) {
                    if (result.ok) {
                        var obj = result.data;
                        var amountToUse = isUserMember ? obj.MemberAmount : obj.NonMemberAmount;
                        $('#payamount, #totalamountzelle, #totalamountcash, #totalstripe, #totalswirepay, #squareamount').html(amountToUse + ".00");
                   $('#AmountPaid').val(amountToUse);
                        $('#PerformanceCategory').val(obj.CategoryName);
                        $('#RegistrationTitle').val("Cultural Registration###" + amountToUse);
                        $(document).trigger("amount-updated");
                        if (actionStatus) { paypalReadyCheck(); }
                    }
                }
            });
        });

        // ── Custom validator ──
        $.validator.addMethod('validImageExtension', function (value, element) {
            if (element.files && element.files.length > 0) {
                var ext = element.files[0].name.split('.').pop().toLowerCase();
                return ['jpg','png','gif','jpeg'].indexOf(ext) !== -1;
            }
            return true;
        }, 'Only allowed extensions are: jpg, png, gif, jpeg');

        // ── Form Validation ──
        $("#SignupForm").validate({
            ignore: ':hidden:not(#recaptchaResponse)',
            rules: {
                FirstName:             { required: true },
                LastName:              { required: true },
                Email:                 { required: true, email: true },
                PhoneNo:               { required: true },
                Address1:              { required: true, minlength: 5 },
                State:                 { required: true },
                City:                  { required: true },
                ZipCode:               { required: true },
                AAALifetimeMember:     { required: true },
                NameofthePerformance:  { required: true },
                NumberofParticipants:  { required: true },
                CoordinatorName:       { required: true },
                PerformanceCategoryId: { required: true },
                checkboxid:            { required: true }
            },
            messages: {
                FirstName:             "Please enter your First Name",
                LastName:              "Please enter your Last Name",
                Email:                 { required: "Please enter email address", email: "Please enter valid email address" },
                PhoneNo:               { required: "Please enter phone number" },
                Address1:              { required: "Please enter address", minlength: "At least 5 characters" },
                State:                 { required: "Please Select State" },
                City:                  { required: "Please enter City" },
                ZipCode:               { required: "Please enter Zip Code" },
                AAALifetimeMember:     { required: "Please select an option" },
                NameofthePerformance:  { required: "Please enter name of the performance" },
                NumberofParticipants:  { required: "Please select number of participants" },
                CoordinatorName:       { required: "Please enter coordinator name" },
                PerformanceCategoryId: { required: "Please select Performance Category" },
                checkboxid:            { required: "Please accept the terms & conditions." }
               
            },
         
            errorElement: "em",
            errorPlacement: function (error, element) {
                // Add the `help-block` class to the error element
                error.addClass("help-block");

                if (element.prop("type") === "checkbox") {
                    error.insertAfter(element.parent("label"));
                } else {
                    error.insertAfter(element);
                }

                // Move the error element after the fieldset element
                if (element.closest("fieldset").length) {
                    element.closest("fieldset").after(error);
                }
            },
            highlight: function (element, errorClass, validClass) {
                $(element).parents("fieldset").addClass("has-error").removeClass("has-success");
            },
            unhighlight: function (element, errorClass, validClass) {
                $(element).parents("fieldset").addClass("has-success").removeClass("has-error");
            },
        });

        // ── Submit button ──
        $("#submit-button").on("click", function (e) {
        e.preventDefault();

        var form = $("#SignupForm");
        var paymentMethod = $('#PaymentMethod').val();

        function scrollToFirstError() {
            var $firstError = $('#SignupForm em.help-block:visible').first();

            if ($firstError.length) {
                $('html, body').animate({
                    scrollTop: $firstError.offset().top - 100
                }, 500);
            }
        }

        if (paymentMethod === 'Credit Card') {
            if (!form.valid()) {
                scrollToFirstError();
                return;
            }

            if (!window.dropinInst) {
                alert('Payment form not ready. Please wait and try again.');
                return;
            }

            if (!window.dropinInst.isPaymentMethodRequestable()) {
                alert('Please fill in your card details before submitting.');
                return;
            }

            // Disable button while Braintree tokenizes
            var btn = document.getElementById('submit-button');
            btn.disabled = true;
            btn.innerText = 'Processing...';

            window.dropinInst.requestPaymentMethod(function (err, payload) {
                if (err) {
                    btn.disabled = false;
                    btn.innerText = 'Submit';
                    alert('Card error: ' + err.message);
                    return;
                }

                $('#nonce').val(payload.nonce);
                $('<input>').attr({
                    type: 'hidden',
                    name: 'ClientValidationStatus',
                    value: 'true'
                }).appendTo(form);

                form.submit();
            });

            return;
        }

        // Non-Credit-Card methods
        if (!form.valid()) {
            scrollToFirstError();
            return;
        }

        var btn = document.getElementById('submit-button');
        btn.disabled = true;
        btn.innerText = 'Processing...';

        $('<input>').attr({
            type: 'hidden',
            name: 'ClientValidationStatus',
            value: 'true'
        }).appendTo(form);

        form.submit();
    });

        // ── PayPal SDK ──
        if (typeof paypal !== 'undefined') {
            paypal.Buttons({
                fundingSource: paypal.FUNDING.PAYPAL,
                style: { layout: 'horizontal', color: 'blue', shape: 'pill', label: 'pay', height: 40 },

              onInit: function (data, actions) {
                    actionStatus = actions;
                    actions.disable();
                    var debounceTimer;
                    $('#SignupForm').on('change keyup', function () {
                        clearTimeout(debounceTimer);
                        debounceTimer = setTimeout(function () {
                            paypalReadyCheck();
                        }, 300);
                    });
                },

                    onClick: function (data, actions) {
        if (!$('#SignupForm').valid()) {
            var $firstError = $('#SignupForm em.help-block:visible').first();
            if ($firstError.length) {
                $('html, body').animate({
                    scrollTop: $firstError.offset().top - 100
                }, 500);
            }

          
            return actions.reject();
        }

        var amt = parseFloat($('#AmountPaid').val());
        if (isNaN(amt) || amt <= 0) {
            var $ticketSection = $('.aws-event-ticket-box-sec');
            if ($ticketSection.length) {
                $('html, body').animate({
                    scrollTop: $ticketSection.offset().top - 100
                }, 500);
            }

            alert('Please select a performance category first.');
            return actions.reject();
        }

        return actions.resolve();
    },

                createOrder: function (data, actions) {
                    var amount = parseFloat($('#AmountPaid').val()).toFixed(2);
                    var registrationTitle = $('#RegistrationTitle').val() || "Cultural Registration";
                    var item = registrationTitle.split('###');
                    return actions.order.create({
                        purchase_units: [{
                            amount: { currency_code: 'USD', value: amount },
                            description: item[0] ? item[0].trim() : "Cultural Registration"
                        }],
                        application_context: { shipping_preference: 'NO_SHIPPING' }
                    });
                },

                onApprove: function (data, actions) {
                    return actions.order.capture().then(function (details) {
                        var transactionId = details.id;
                        var amount        = details.purchase_units[0].amount.value;
                        var status        = details.status;

                        if (status === 'COMPLETED') {
                            $('#TransactionId').val(transactionId);
                            $('#PaymentAmount').val(amount);
                            $('#PaymentStatus').val(status);
                            $('#PayerName').val(details.payer.name.given_name + ' ' + details.payer.name.surname);
                            $('#PayerEmail').val(details.payer.email_address);
                            $('#payment-status').html('<div class="alert alert-success">Payment completed! Submitting...</div>');
                            $('#paypal-button-container').hide();

                            var formData = new FormData(document.getElementById('SignupForm'));
                            $.ajax({
                                url:         '@Url.Action("AddCulturalRegistration", "CulturalRegistrations", new { area = "User" })',
                                type:        'POST',
                                data:        formData,
                                processData: false,
                                contentType: false,
                                headers:     { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                                success: function (response) {
                                    if (response && response.redirectUrl) {
                                        window.location.href = response.redirectUrl;
                                    } else {
                                        window.location.href = '/cultural-reg-acknowledgement?CulturalRegistrationId=' + ($('#CulturalRegistrationId').val() || 0);
                                    }
                                },
                                error: function (xhr) {
                                    console.error('Submit error:', xhr.status, xhr.responseText);
                                    $('#payment-status').html('<div class="alert alert-danger">Submission failed. Transaction ID: ' + transactionId + '</div>');
                                }
                            });
                        } else {
                            $('#payment-status').html('<div class="alert alert-warning">Payment status: ' + status + '</div>');
                        }
                    }).catch(function (err) {
                        $('#payment-status').html('<div class="alert alert-danger">Error: ' + err.message + '</div>');
                    });
                },

                onError:  function (err)  { $('#payment-status').html('<div class="alert alert-danger">PayPal error: ' + (err.message || 'Unknown') + '</div>'); },
                onCancel: function ()      { $('#payment-status').html('<div class="alert alert-info">Payment was cancelled.</div>'); }

            }).render('#paypal-button-container');

        } else {
            console.error('PayPal SDK not loaded.');
        }
                  DynamicCustomFields.wireValidation('#SignupForm', '.dynamic-custom-fields');

    }); // end document.ready

  
</script>

