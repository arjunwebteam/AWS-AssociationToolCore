    List<AWS_AssociationToolCore.Entities.PaymentStatus> lstPaymentStatus = ViewBag.lstpaymentstatus;
    var Memberdetails = (AWS_AssociationToolCore.Entities.Members)ViewBag.Memberdetails;

    Int64 EventId = ViewBag.EventId;
