        <input type="hidden" name="ddlPerformanceCategory" id="ddlPerformanceCategory" value="" />
        <input type="hidden" name="ParticipantAgeGroup" id="ddlParticipantAgeGroup" value="" />
        <input type="hidden" id="EventId" name="EventId" value="@EventId" />
        <input type="hidden" id="PaymentMethod" name="PaymentMethod" value="@firstPaymentMethod" />
        <input type="hidden" id="AmountPaid" name="AmountPaid" />
        <input type="hidden" id="nonce" name="payment_method_nonce" value="" />
        <input type="hidden" id="BT_Amount" name="BT_Amount" value="" />
        <input type="hidden" id="PayerName" name="PayerName" />
        <input type="hidden" id="PayerEmail" name="PayerEmail" />
        <input type="hidden" id="PaymentAmount" name="PaymentAmount" />
        <input type="hidden" id="PaymentStatus" name="PaymentStatus" />
        <input type="hidden" id="RegistrationTitle" name="RegistrationTitle" />
        <input type="hidden" id="TransactionId" name="TransactionId" />
        <input type="hidden" id="PerformanceCategory" name="PerformanceCategory" />
        <input type="hidden" id="CulturalRegistrationId" name="CulturalRegistrationId" />
        <input type="hidden" name="ValidationCode" value="@ViewBag.ValidationCode" />
        <input type="hidden" id="cname" name="cname" value="@cname" />
        <input type="hidden" name="Suareurl" id="Suareurl" value="" />
        <input type="hidden" id="SquareNonce" name="SquareNonce" />

        <div class="cmn-inner-form">
            <div class="row justify-content-center">
                <div class="col-lg-12">
                    <div class="row inner-form-row">

                        <div class="aws-title3 mb-3">Personal Information</div>

                        <div class="col-md-6">
