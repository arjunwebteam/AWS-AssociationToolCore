<script type="text/javascript">

    function CheckEmailAvailability(email) {

        var returnval = null;

        $.ajax({
            type: "POST",
            url: '@Url.Action("CheckEmailAvailability", "Volunteer")', // the URL of the controller action method
            data: { Email: email }, // optional data
            datatype: "JSON",
            async: false,
            success: function (result) {
                if (result.ok) {
                    returnval = result.data;
                    $('#volunteeralert').show();
                }
            }
        });
        return returnval;
    }

     function StatesBind() {
        var CountryID = $('#Country').val();
        $.ajax({
            url: '@Url.Action("GetStatesByCountryID", "Volunteer")',
            type: 'POST',
            data: { CountryID: CountryID }, // optional data
            datatype: "JSON",
            success: function (result) {
                if (result.ok) {
                    var sb = "<option value=\"\">-- Select --</option>";
                    States = result.data;
                    if (States != null) {
                        for (var i = 0; i < States.length; i++) {
                            sb = sb + "<option value=\"" + States[i].StateID + "\">" + States[i].StateName + "</option>";
                        }
                    }
                    $('#State').html(sb);
                }
            }
        });
    }

    var specialKeys = new Array();
    specialKeys.push(8); //Backspace
    specialKeys.push(9); //Tab
    specialKeys.push(32); //Space
    specialKeys.push(46); //Delete
    specialKeys.push(36); //Home
    specialKeys.push(35); //End
    specialKeys.push(37); //Left
    specialKeys.push(39); //Right



    // function onRecaptchaSuccess(token) {
    //     $("#recaptchaResponse").val(token);
    //      $("#recaptchaResponse").valid();
    // }


    
    function PhoneNochange(event) {
        if (event.keyCode == 8 || event.keyCode == 46) {
        }
        else {
            var ph = $('#PhoneNo').val();
            if (ph.length == 3) { $('#PhoneNo').val(ph + '-'); }
            if (ph.length == 7) { $('#PhoneNo').val(ph + '-'); }
        }
    }

    function cphonenochange(event) {
        if (event.keyCode == 8 || event.keyCode == 46) {
        }
        else {
            var ph = $('#SelfPhoneNo').val();
            if (ph.length == 3) { $('#SelfPhoneNo').val(ph + '-'); }
            if (ph.length == 7) { $('#SelfPhoneNo').val(ph + '-'); }
        }
    }

</script>
<script type="text/javascript">
    $(document).ready(function () {
        $("#VolunteerForm").validate({
            rules: {
                FirstName: "required",
                LastName: "required",

                Email: {
                    required: true,
                    validate_email: true,
                    remote: {
                        type: "POST",
                        url: "/User/Members/CheckEmailAvailability",
                        datatype: "JSON",
                        async: false,
                        data: {
                            Email: function () {
                                return $("#Email").val();
                            }
                        },
                        dataFilter: function (data) {
                            var responseData = JSON.parse(data);
                            return responseData.data === true;
                        }
                    }
                },
                PhoneNo: {
                    required: true,
                    phoneFormat: true
                },
                Address: {
                    required: true,
                    minlength: 5
                },
                State: "required",
                Country: "required",
                City: "required",
                ZipCode: {
                    required: false,
                    digits: true,
                    number: true,
                    minlength: 5,
                    maxlength: 6
                },
                VolunteerCategoryId: "required",
                ItemValue: "required"
            },
            messages: {
                FirstName: "Please enter your first name",
                LastName: "Please enter your last name",
                Email: {
                    required: "Please enter email address",
                    validate_email: "Please enter valid email address",
                    remote: "This email address is already in use."
                },
                PhoneNo: {
                    required: "Please enter phone number",
                    phoneFormat: "Please enter valid phone number"
                },
                Address: {
                    required: "Please enter address",
                    minlength: "Your text must be at least 5 characters long"
                },
                State: { required: "Please Select State" },
                Country: { required: "Please Select Country" },
                City: { required: "Please Select City" },
                ZipCode: {
                    digits: "Please enter only numeric characters",
                    maxlength: "ZipCode must be exactly 6 digits"
                },
                VolunteerCategoryId: { required: "Please select at least one type." },
                ItemValue: { required: "Please select Terms & Conditions" },
                recaptcha: { required: "Please confirm that you are not a robot." }
            },

            // ── SINGLE source of truth for what happens on a valid submit ──
            submitHandler: function (form) {
                $("<input>")
                    .attr({
                        type: "hidden",
                        name: "ClientValidationStatus",
                        value: "true"
                    })
                    .appendTo(form);

                form.submit();
            },

            // ── SINGLE source of truth for what happens on an invalid submit ──
            invalidHandler: function (event, validator) {
                var $firstError = $("#VolunteerForm em.help-block:visible").first();
                if ($firstError.length) {
                    $('html, body').animate({
                        scrollTop: $firstError.offset().top - 100
                    }, 500);
                }
            },

            errorElement: "em",
            errorPlacement: function (error, element) {
                error.addClass("help-block");

                if (element.prop("type") === "checkbox") {
                    error.insertAfter(element.parent("label"));
                } else {
                    error.insertAfter(element);
                }

                if (element.closest("fieldset").length) {
                    element.closest("fieldset").after(error);
                }
            },
            highlight: function (element, errorClass, validClass) {
                $(element).parents("fieldset").addClass("has-error").removeClass("has-success");
            },
            unhighlight: function (element, errorClass, validClass) {
                $(element).parents("fieldset").addClass("has-success").removeClass("has-error");
            }
        });
                DynamicCustomFields.wireValidation('#VolunteerForm', '.dynamic-custom-fields');

    });
</script>

