@{
    Layout = "~/Areas/User/Views/Shared/_MainLayout.cshtml";

    var lstCommittees = (List<AWS_AssociationToolCore.Entities.Members>)ViewBag.lstCommittees;
    List<AWS_AssociationToolCore.Entities.CommitteeCategoryMaster> lstCommitteeCategories = ViewBag.lstCommitteeCategories;
    List<AWS_AssociationToolCore.Entities.CommitteeCategories> lstCommitteeTypes = ViewBag.lstCommitteeTypes;

    List<AWS_AssociationToolCore.Entities.Members> lstCommitteeMembers = ViewBag.lstCommitteeMembers;
    List<AWS_AssociationToolCore.Entities.CommitteeCategoryMaster> lstCommitteeCategoriesyears = ViewBag.lstCommitteeCategoriesyears;

    var Type = ViewBag.Type;

    var Year = ViewBag.Year;

    string cname = ViewBag.cname;

    int status1 = 0;
    AWS_AssociationToolCore.BLL.AppInfo _AppInfo1 = new AWS_AssociationToolCore.BLL.AppInfo();
    AWS_AssociationToolCore.Entities.AppInfo objAppInfo = new AWS_AssociationToolCore.Entities.AppInfo();
    objAppInfo = _AppInfo1.GetAppInfoDetails(ref status1);

    var imglocNormal = objAppInfo.BaseUrl + "Content/MemberProfileImages/";

    AWS_AssociationToolCore.Entities.PageDetails MenuPageDetails = ViewBag.objMenuPageDetails;

    Int64 ActiveId = 0;

    if (MenuPageDetails.ParentName != null && MenuPageDetails.ParentName != "")
    {
        ActiveId = MenuPageDetails.PageParentId;
    }
    else
    {
        ActiveId = MenuPageDetails.MenuItemId;
    }

    var honorcommittee = lstCommitteeMembers.FindAll(x => x.CategoryName == "Honorary Board of Directors");

    var chaptercommittee = lstCommitteeMembers.FindAll(x => x.CategoryName == "Chapter Coordinator");

    var coordinatorcommittee = lstCommitteeMembers.FindAll(x => x.CategoryName == "Jt. Chapter Coordinator");


    ViewBag.Title = "Committees | " + objAppInfo.SiteName + " – Leadership & Community Initiatives";
    ViewBag.MetaDescription = "Discover the committees of our " + objAppInfo.SiteName + ".Learn about leadership teams, cultural programs, event planning, and community service initiatives";

    ViewBag.PageHeading = "Leadership";
}

<script type="text/javascript">

    $(document).ready(function () {
        $('#M-@ActiveId').addClass('active');
    });

    function Committeeinfo(CommitteeId) {
        $.ajax({
            url: '@Url.Action("CommitteeInfo", "Committee")',
            type: 'POST',
            data: { CommitteeId: CommitteeId },
            datatype: "JSON",
            success: function (result) {
                if (result.ok) {
                    var objCommitteeMember = result.data;
                    $('#CommitteeId').html(objCommitteeMember.CommitteeId);
                    $('#Name').html(objCommitteeMember.Name);
                    $('#Description').html(objCommitteeMember.Description.replace('Content/images/', 'Content/User/images/'));
                    $('Designation').html(objCommitteeMember.Designation)

                    $("#committeeinfo").dialog('open');
                }
            }
        });
    }

</script>


<script type="text/javascript">

    function PagerClickBind() {
        $(".pagination a").bind("click", function () {
            PhotosBind($(this).text());
        });
    }

    function PhotosBind() {

        var Year = $('#Sort').val();
        var url = '@objAppInfo.BaseUrl' + '@cname' + +  Year + '-leadership';
        window.location.href = url;

    }
</script>
