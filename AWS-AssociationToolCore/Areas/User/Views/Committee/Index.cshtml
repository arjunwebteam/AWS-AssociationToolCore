<style>
    #RenewalAlert {
        background-color: #000000a1;
    }

    /* ===== COMMITTEE POPUP STYLES ===== */
    .committee-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.55);
        z-index: 9999;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

        .committee-overlay.active {
            display: flex;
        }

    .popup {
        background: #fff;
        border-radius: 20px;
        padding: 0;
        width: 90%;
        max-width: 500px;
        text-align: center;
        position: relative;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    }

    .popup-top {
        background: linear-gradient(135deg, #8b0000 0%, #c0392b 50%, #8b0000 100%);
        height: 110px;
        position: relative;
    }

        .popup-top::after {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 0;
            right: 0;
            height: 30px;
            background: #fff;
            border-radius: 50% 50% 0 0 / 30px 30px 0 0;
        }

    .popup-close {
        position: absolute;
        top: 12px;
        right: 16px;
        background: rgba(255,255,255,0.2);
        border: none;
        cursor: pointer;
        font-size: 18px;
        color: #fff;
        z-index: 10;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s;
    }

        .popup-close:hover {
            background: rgba(255,255,255,0.35);
        }

    .popup-avatar-wrap {
        width: 110px;
        height: 110px;
        border-radius: 50%;
        border: 4px solid #fff;
        overflow: hidden;
        margin: -55px auto 14px;
        background: #f0f0f0;
        position: relative;
        z-index: 2;
        box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    }

        .popup-avatar-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .popup-body {
        padding: 0 2rem 2rem;
    }

    .popup-name {
        font-size: 22px;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 8px;
        letter-spacing: 0.3px;
    }

    .popup-divider {
        width: 50px;
        height: 3px;
        background: linear-gradient(90deg, #8b0000, #c0392b);
        margin: 0 auto 14px;
        border-radius: 2px;
    }

    .popup-desig {
        font-size: 14px;
        color: #888;
        background: #f8f8f8;
        border-radius: 20px;
        padding: 6px 18px;
        display: inline-block;
        margin-bottom: 6px;
    }

    /* ===== EYE BUTTON ===== */
    .eye-btn {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #e53935;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 17px;
    }

        .eye-btn:hover {
            background: #c62828;
        }

    .popup-desc {
        text-align: center !important;
        color: black !important;
        font-size: 15px !important;
    }
</style>
