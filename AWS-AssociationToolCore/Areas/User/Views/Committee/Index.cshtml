@if (lstCommitteeCategories != null && lstCommitteeCategories.Count != 0 && lstCommitteeCategories.Count != 0)
{
    if (lstCommittees != null && lstCommittees.Count != 0)
    {
        int i = 1;
        foreach (var CommitteeCategories in lstCommitteeCategories)
        {



            if (lstCommittees != null && lstCommittees.Count != 0)
            {
                <div class="aws-title mt-lg-5 mt-4 mb-3">
                    <h5>@CommitteeCategories.CategoryName</h5>
                </div>
            }


            <div class="aws-committee-main">

                @if (lstCommittees != null && lstCommittees.Count != 0)
                {

                    foreach (var item in lstCommittees)
                    {

                        if (item.CommitteeCategoryId == CommitteeCategories.CommitteeCategoryId)
                        {
                            if (item.Designation == "President")
                            {
                                <div class="aws-committee-main-card">
                                    <div class="aws-committee-card pos-relative">
                                        @if (item.ProfileImage != null && item.ProfileImage != "")
                                        {

                                            <div class="aws-committee-icon-bar"><img class="aws-committee-icon" src="@AWS_AssociationToolCore.BLL.Common.ValidateImage((imglocNormal + item.ProfileImage), imglocNormal + "no-image.jpeg")" alt="img"></div>
                                        }
                                        else
                                        {

                                            <div class="aws-committee-icon-bar"><img class="aws-committee-icon" src="Content/User/images/President.png" alt="img"></div>


                                        }
                                        <div class="aws-committee-cnt">
                                            <div class="aws-title4">@item.Name</div>
                                            <div class="aws-desgination">@item.Designation</div>
                                            <div class="aws-desgination">@item.MobilePhone</div>
                                            <div class="aws-desgination">@item.Email</div>
