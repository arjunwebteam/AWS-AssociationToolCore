@using Microsoft.AspNetCore.Http.Extensions
@using Microsoft.AspNetCore.Http
@{
    int status = 0;
    AWS_AssociationToolCore.BLL.AppInfo _AppInfo = new AWS_AssociationToolCore.BLL.AppInfo();
    AWS_AssociationToolCore.Entities.AppInfo objAppInfo = new AWS_AssociationToolCore.Entities.AppInfo();
    objAppInfo = _AppInfo.GetAppInfoDetails(ref status);

    var location = System.Configuration.ConfigurationManager.AppSettings["adminimgurl"] + "MemberProfileImages/";

    AWS_AssociationToolCore.Entities.EventRegTickets objEventRegTickets = ViewBag.objEventRegTickets;

    var imglocNormal = System.Configuration.ConfigurationManager.AppSettings["adminimgurl"] + "Content/CulturalEvent/";

    var type = ViewBag.type;
    var uid = ViewBag.uid;
    var MembershipType = ViewBag.MembershipType;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Individual Ticket Check-in - @objAppInfo.SiteName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        /* =========================================================
                           INDIVIDUAL TICKET CHECK-IN  -  CSS ONLY REDESIGN
                           ========================================================= */
        :root {
            --maroon: #800020;
            --red: #c81515;
            --red-dark: #a11212;
            --ink: #1f2328;
            --muted: #6b7280;
            --line: #e5e7eb;
            --soft: #faf6f6;
            --page: #f3efef;
            --green-bg: #e7f6ec;
            --green-tx: #17663a;
            --amber-bg: #fff4e0;
            --amber-tx: #b45309;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            -webkit-text-size-adjust: 100%;
        }

        body {
            font-family: 'Poppins', 'Segoe UI', Tahoma, Arial, sans-serif;
            background: var(--page);
            color: var(--ink);
            min-height: 100vh;
            padding: 24px 12px;
            line-height: 1.5;
        }

        /* ---------- Main card ---------- */
        .container {
            max-width: 780px;
            margin: 0 auto;
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 16px;
            box-shadow: 0 8px 28px rgba(60, 20, 20, .10);
            overflow: hidden;
        }

        /* ---------- Header ---------- */
        .header {
            position: relative;
            display: grid;
            grid-template-columns: auto 1fr auto;
            grid-template-areas: "logo title actions";
            align-items: center;
            gap: 16px;
            padding: 20px 24px;
            color: #fff;
            background: linear-gradient(135deg, var(--maroon) 0%, var(--red) 100%);
            overflow: hidden;
        }

            .header::before {
                content: '';
                position: absolute;
                right: -60px;
                top: -80px;
                width: 240px;
                height: 240px;
                border-radius: 50%;
                background: rgba(255, 255, 255, .07);
                pointer-events: none;
            }

        .header-logo {
            grid-area: logo;
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 0;
        }

        .logo-container {
            flex-shrink: 0;
            width: 52px;
            height: 52px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,.18);
        }

            .logo-container img {
                width: 36px !important;
                height: 36px;
                object-fit: contain;
            }

        .logo-icon {
            width: 30px;
            height: 30px;
            fill: white;
        }

        .header-content {
            grid-area: title;
            position: relative;
            z-index: 1;
            text-align: center;
            min-width: 0;
        }

        .ticket-badge {
            display: inline-block;
            margin-bottom: 6px;
            padding: 3px 14px;
            font-size: .72rem;
            font-weight: 500;
            letter-spacing: .4px;
            background: rgba(255,255,255,.18);
            border: 1px solid rgba(255,255,255,.35);
            border-radius: 20px;
        }

        .header h1 {
            font-size: 1.55rem;
            font-weight: 600;
            line-height: 1.25;
            margin: 0 0 2px;
        }

        .header p {
            font-size: .82rem;
            font-weight: 300;
            opacity: .92;
        }

        .header-actions {
            grid-area: actions;
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            justify-content: flex-end;
        }

        .login-btn {
            font-family: inherit;
            padding: 9px 26px;
            font-size: .9rem;
            font-weight: 600;
            color: var(--maroon);
            background: #fff;
            border: 0;
            border-radius: 24px;
            cursor: pointer;
            box-shadow: 0 2px 8px rgba(0,0,0,.18);
            transition: transform .2s ease, box-shadow .2s ease;
        }

            .login-btn:hover {
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(0,0,0,.25);
            }

        /* ---------- Content ---------- */
        .content {
            padding: 24px;
            background: #fff;
        }

        /* ---------- Ticket overview ---------- */
        .ticket-overview {
            background: var(--soft);
            border: 1px solid var(--line);
            border-left: 5px solid var(--red);
            border-radius: 12px;
            padding: 22px;
            margin-bottom: 22px;
        }

        .ticket-header {
            display: grid;
            grid-template-columns: auto 1fr;
            align-items: center;
            gap: 12px 16px;
            padding-bottom: 20px;
            margin-bottom: 20px;
            border-bottom: 1px dashed #dcc3c8;
        }

        .ticket-label {
            font-size: .9rem;
            font-weight: 500;
            color: var(--muted);
        }

            .ticket-label.pn {
                padding-left: 0;
            }

        .ticket-id-display {
            justify-self: start;
            font-family: 'Courier New', monospace;
            font-size: 1.35rem;
            font-weight: 700;
            letter-spacing: .5px;
            color: var(--red);
            background: #fff;
            padding: 8px 18px;
            border: 2px solid var(--red);
            border-radius: 8px;
        }

        .ticket-status-large {
            justify-self: start;
            padding: 7px 22px;
            font-size: .9rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .6px;
            border-radius: 24px;
        }

        .status-checked-in {
            background: var(--green-bg);
            color: var(--green-tx);
        }

        .status-pending {
            background: var(--amber-bg);
            color: var(--amber-tx);
        }

        /* ---------- Detail / info grids ---------- */
        .ticket-details-grid,
        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
            gap: 16px;
        }

        .detail-item,
        .info-item {
            display: flex;
            flex-direction: column;
            gap: 6px;
            min-width: 0;
        }

        .detail-label,
        .info-label {
            font-size: .75rem;
            font-weight: 500;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: .5px;
        }

        .detail-value,
        .info-value {
            font-size: .92rem;
            font-weight: 500;
            color: var(--ink);
            padding: 10px 14px;
            background: #fff;
            border: 1px solid var(--line);
            border-left: 3px solid var(--red);
            border-radius: 8px;
            word-break: break-word;
            overflow-wrap: anywhere;
        }

        /* ---------- Sections ---------- */
        .section {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 12px;
            padding: 0;
            margin-bottom: 20px;
            overflow: hidden;
            box-shadow: 0 1px 3px rgba(0,0,0,.05);
        }

        .section-title {
            display: flex;
            align-items: center;
            margin: 0;
            padding: 13px 20px;
            font-size: 1.05rem;
            font-weight: 600;
            color: var(--maroon);
            background: var(--soft);
            border-bottom: 1px solid var(--line);
            border-left: 4px solid var(--maroon);
        }

            .section-title::before {
                display: none;
            }

        .section > .info-grid,
        .section > .checkin-history {
            margin: 20px;
        }

            .section > .info-grid + .info-grid {
                margin-top: 0;
            }

        .section .info-value {
            background: #fcfcfc;
        }

        /* ---------- Forms ---------- */
        .checkin-form {
            background: var(--soft);
            border: 1px solid var(--line);
            border-radius: 12px;
            padding: 24px;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-label {
            display: block;
            margin-bottom: 8px;
            font-size: .92rem;
            font-weight: 500;
            color: var(--ink);
        }

        .form-select,
        .form-textarea {
            width: 100%;
            padding: 12px 14px;
            font-family: inherit;
            font-size: .95rem;
            color: var(--ink);
            background: #fff;
            border: 1px solid #cfd4da;
            border-radius: 8px;
            transition: border-color .2s ease, box-shadow .2s ease;
        }

            .form-select:focus,
            .form-textarea:focus {
                outline: none;
                border-color: var(--red);
                box-shadow: 0 0 0 3px rgba(200,21,21,.12);
            }

        .form-textarea {
            resize: vertical;
            min-height: 110px;
        }

        .button-group {
            display: flex;
            gap: 12px;
            justify-content: center;
            flex-wrap: wrap;
            margin-top: 6px;
        }

        .btn {
            display: inline-block;
            padding: 12px 34px;
            font-family: inherit;
            font-size: 1rem;
            font-weight: 600;
            text-align: center;
            text-decoration: none;
            border: 0;
            border-radius: 8px;
            cursor: pointer;
            transition: background .2s ease, box-shadow .2s ease, transform .2s ease;
        }

        .btn-primary {
            color: #fff;
            background: var(--maroon);
            box-shadow: 0 3px 10px rgba(128,0,32,.25);
        }

            .btn-primary:hover {
                background: var(--red-dark);
                transform: translateY(-1px);
                box-shadow: 0 6px 16px rgba(128,0,32,.32);
            }

        .btn-secondary {
            color: #fff;
            background: #6b7280;
        }

            .btn-secondary:hover {
                background: #4b5563;
            }

        .btn-success {
            color: #fff;
            background: #1a7f4b;
        }

            .btn-success:hover {
                background: #146c3f;
            }

        /* ---------- Alerts / notes ---------- */
        .alert {
            padding: 14px 18px;
            margin-bottom: 18px;
            font-weight: 500;
            border-radius: 8px;
        }

        .alert-success {
            background: var(--green-bg);
            color: var(--green-tx);
            border: 1px solid #b7e3c6;
        }

        .alert-warning {
            background: var(--amber-bg);
            color: var(--amber-tx);
            border: 1px solid #f6d9a3;
        }

        .login-note {
            margin-top: 20px;
            padding: 16px 18px;
            font-size: .92rem;
            color: var(--ink);
            background: #fff;
            border: 1px dashed #d9b3bb;
            border-radius: 10px;
        }

        .login-link {
            display: inline-block;
            margin: 0 2px;
            padding: 3px 14px;
            font-weight: 600;
            color: #fff !important;
            background: var(--maroon);
            border-radius: 6px;
            text-decoration: none;
            transition: background .2s ease;
        }

            .login-link:hover {
                background: var(--red-dark);
            }

        .form-section .event-details h4 {
            font-size: 1rem;
            font-weight: 600;
            color: var(--green-tx);
        }

        /* ---------- History ---------- */
        .checkin-history {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 15px;
            margin-top: 15px;
        }

        .history-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid var(--line);
        }

            .history-item:last-child {
                border-bottom: none;
            }

        .history-action {
            font-weight: 600;
        }

        .history-time {
            font-size: .88rem;
            color: var(--muted);
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 20px;
            padding: 8px 15px;
            font-weight: 500;
            color: var(--red);
            text-decoration: none;
            background: rgba(200,21,21,.08);
            border-radius: 20px;
        }

        /* ---------- Login modal ---------- */
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            inset: 0;
            background: rgba(20, 10, 10, .55);
        }

            .modal.show {
                display: flex;
                align-items: center;
                justify-content: center;
            }

        .modal-content {
            width: 92%;
            max-width: 400px;
            margin: 20px;
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 20px 40px rgba(0,0,0,.3);
            overflow: hidden;
            animation: modalSlideIn .25s ease;
        }

        @@keyframes modalSlideIn {
            from {
                opacity: 0;
                transform: translateY(-30px) scale(.96);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .modal-header {
            position: relative;
            padding: 18px 50px 18px 20px;
            color: #fff;
            text-align: center;
            background: linear-gradient(135deg, var(--maroon), var(--red));
        }

            .modal-header h2 {
                margin: 0;
                font-size: 1.1rem;
                font-weight: 600;
            }

        .close {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            line-height: 1;
            color: #fff;
            cursor: pointer;
            border-radius: 50%;
            transition: background .2s ease;
        }

            .close:hover {
                background: rgba(255,255,255,.22);
            }

        .modal-body {
            padding: 24px;
        }

        .login-form-group {
            margin-bottom: 18px;
        }

        .login-form-label {
            display: block;
            margin-bottom: 6px;
            font-size: .88rem;
            font-weight: 500;
        }

        .login-form-input {
            width: 100%;
            padding: 11px 14px;
            font-family: inherit;
            font-size: .95rem;
            background: #fff;
            border: 1px solid #cfd4da;
            border-radius: 8px;
            transition: border-color .2s ease, box-shadow .2s ease;
        }

            .login-form-input:focus {
                outline: none;
                border-color: var(--red);
                box-shadow: 0 0 0 3px rgba(200,21,21,.12);
            }

        .login-submit-btn {
            width: 100%;
            padding: 12px;
            font-family: inherit;
            font-size: 1rem;
            font-weight: 600;
            color: #fff;
            background: var(--maroon);
            border: 0;
            border-radius: 8px;
            cursor: pointer;
            transition: background .2s ease;
        }

            .login-submit-btn:hover {
                background: var(--red-dark);
            }

        .forgot-password {
            margin-top: 14px;
            text-align: center;
        }

            .forgot-password a {
                font-size: .9rem;
                color: var(--red);
                text-decoration: none;
            }

        /* =========================================================
                           TABLET
                           ========================================================= */
        @@media (max-width: 768px) {
            body {
                padding: 12px 8px;
            }

            .header {
                padding: 18px;
            }

                .header h1 {
                    font-size: 1.35rem;
                }

            .content {
                padding: 16px;
            }

            .ticket-overview {
                padding: 18px;
            }
        }

        /* =========================================================
                           MOBILE
                           ========================================================= */
        @@media (max-width: 576px) {
            body {
                padding: 0;
                background: #fff;
            }

            .container {
                border: 0;
                border-radius: 0;
                box-shadow: none;
            }
            /* Header: logo + Login button on row 1, title centered on row 2 */
            .header {
                grid-template-columns: 1fr auto;
                grid-template-areas:
                    "logo actions"
                    "title title";
                gap: 14px 10px;
                padding: 16px 16px 20px;
            }

            .logo-container {
                width: 46px;
                height: 46px;
            }

                .logo-container img {
                    width: 32px !important;
                    height: 32px;
                }

            .header-content {
                padding-top: 12px;
                border-top: 1px solid rgba(255,255,255,.25);
            }

            .header h1 {
                font-size: 1.35rem;
            }

            .header p {
                font-size: .78rem;
            }

            .login-btn {
                padding: 8px 22px;
                font-size: .85rem;
            }

            .content {
                padding: 14px;
            }

            .ticket-overview {
                padding: 16px 14px;
                border-left-width: 4px;
            }
            /* Ticket number / status: label above value, centered */
            .ticket-header {
                grid-template-columns: 1fr;
                justify-items: center;
                text-align: center;
                gap: 6px;
                padding-bottom: 16px;
                margin-bottom: 16px;
            }

            .ticket-label.pn {
                margin-top: 8px;
            }

            .ticket-id-display {
                justify-self: center;
                width: 100%;
                text-align: center;
                font-size: 1.2rem;
            }

            .ticket-status-large {
                justify-self: center;
                min-width: 150px;
                text-align: center;
            }

            .ticket-details-grid,
            .info-grid {
                grid-template-columns: 1fr;
                gap: 14px;
            }

            .section {
                margin-bottom: 16px;
            }

            .section-title {
                padding: 12px 14px;
                font-size: 1rem;
            }

            .section > .info-grid,
            .section > .checkin-history {
                margin: 14px;
            }
            /* Check-in form: force full width dropdown */
            .ticket-overview form > div[style*="grid"] {
                grid-template-columns: 1fr !important;
                gap: 0 !important;
            }

            .button-group {
                flex-direction: column;
            }

            .btn {
                width: 100%;
                padding: 12px 20px;
            }

            .checkin-form {
                padding: 18px 14px;
            }
            /* Login note: text then full-width button */
            .login-note {
                padding: 16px 14px;
                text-align: center;
            }

            .login-link {
                display: block;
                margin: 12px 0 4px;
                padding: 11px 16px;
                font-size: 1rem;
            }
        }

        @@media only screen and (max-width:450px) {
            .ticket-label.pn {
                padding-left: 0px;
            }
        }
    </style>
    <script type="text/javascript">
        $(document).ready(function () {

            if ('@ViewBag.strcul' == 'login-failed') {
                CulLoginShow();
                $('#ErrorMessageCul').show();
            }
            $('#newsshow').hide();
            $('#hideleft').hide();

        });

        function CulLoginShow() {
            $('#EmailC1').val('').removeClass('validate');
            $('#PasswordC1').val('').removeClass('validate');
            $('#ErrorMessageCul').hide();
            $('#cullogin').dialog('open');
        }

    </script>
    <script type="text/javascript">
        $(document).ready(function () {
            Common.mfadeout();

        });

        function CulLoginValidate() {
            if ($('#EmailC1').val() == "") { $('#EmailC1').focus().addClass("validate"); return false; } else { $('#EmailC1').removeClass("validate"); }
            if (!Common.CheckEmail($('#EmailC1').val())) { $('#EmailC1').val(''); document.getElementsByName('Email')[0].placeholder = 'Invalid email address'; $('#EmailC1').focus().addClass("validate"); return false; } else { $('#EmailC1').removeClass("validate"); }
            if ($('#PasswordC1').val() == '') { $('#PasswordC1').focus().addClass("validate"); return false; } else { $('#PasswordC1').focus().removeClass("validate"); }


            return true;
        }

    </script>
</head>
<body>
    <div class="container">
        <div id="divmessage">
            @if (TempData["message"] != null)
            {
                @Html.Raw(TempData["message"].ToString())
            }

            @if (ViewBag.message != null)
            {
                @Html.Raw(ViewBag.message.ToString())
            }
        </div>


        <div class="header">
            <div class="header-logo">
                <div class="logo-container">
                    <!-- Temple Icon SVG -->
                    <img src="Content/User/images/favicon.png" style="width: 40px;" alt="@objAppInfo.SiteName" title="@objAppInfo.SiteName" />
                </div>
                <div>
                    <div style="font-weight: 600; font-size: 0.9rem;">@objAppInfo.SiteName</div>
                    <div style="font-size: 0.75rem; opacity: 0.8;">Individual Ticket</div>
                </div>
            </div>

            <div class="header-content">
                <div class="ticket-badge">Individual Ticket</div>
                <h1>Ticket Check-In</h1>
                <p>Scan-based Individual Ticket Management</p>
            </div>
            @if (this.User.Identity.IsAuthenticated && this.User.Identity.Name != null && Context.Session != null && Context.Session.GetString("username") != null)
            {
                if (objEventRegTickets.Status == "Yes")
                {


                }
                else
                {
                    <div class="header-actions">
                        <button class="login-btn">Check-In</button>
                    </div>
                }

            }
            else
            {
                <div class="header-actions">
                    <button class="login-btn" onclick="openLoginModal()">Login</button>
                </div>
            }
        </div>

        @*<div class="header">
                <div class="header-content">
                    <div class="ticket-badge">Individual Ticket</div>
                    <h1>Ticket Check-In</h1>
                    <p>Scan-based Individual Ticket Management</p>
                </div>
            </div>*@

        <div class="content">
            <!-- Back Navigation -->
            @*<a href="#" class="back-link">
                ← Back to Registration Overview
            </a>*@

            <!-- Individual Ticket Overview -->
            <div class="ticket-overview">
                <div class="ticket-header">
                    <label class="ticket-label">Ticket Number :</label>
                    <div class="ticket-id-display">@objEventRegTickets.TicketId</div>
                    <label class="ticket-label pn">Check-In :</label>
                    <div class="ticket-status-large @(objEventRegTickets.Status == "Yes" ? "status-checked-in" : "status-pending")">@(objEventRegTickets.Status != null && objEventRegTickets.Status != "" ? objEventRegTickets.Status : "Pending")</div>
                </div>

                <div class="ticket-details-grid">
                    <div class="detail-item">
                        <div class="detail-label">Registration Type</div>
                        <div class="detail-value">@objEventRegTickets.RegistrationTitle Ticket @objEventRegTickets.SequenceNo</div>
                    </div>
                    @*<div class="detail-item">
                        <div class="detail-label">Sequence Number</div>
                        <div class="detail-value">003</div>
                    </div>*@
                    <div class="detail-item">
                        <div class="detail-label">Amount</div>
                        <div class="detail-value">$@objEventRegTickets.PaidAmount</div>
