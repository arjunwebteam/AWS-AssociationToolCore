            <div class="ev-section-body">
                <div class="ev-grid">
                    <div class="ev-field">
                        <span class="ev-label">Competition Name</span>
                        <span class="ev-value">@objEventUserInfo.ItemCategory</span>
                    </div>
                    <div class="ev-field">
                        <span class="ev-label">No of Participants</span>
                        <span class="ev-value">@objEventUserInfo.ItemName</span>
                    </div>
                </div>
            </div>
        </section>
    }

    @* ===================== REGISTRATION TYPES - CHECK-IN ===================== *@
    @if (lstEventRegistrationCounts != null && lstEventRegistrationCounts.Count != 0)
    {
        int k = 0;
        <section class="ev-section">
            <h3 class="ev-section-title">Registration Types - Check-In</h3>
            <div class="ev-section-body">
                <div class="ev-table-wrap">
                    <table id="regtypes" class="ev-table">
                        <thead>
                            <tr>
                                <th>Registration Title</th>
                                <th class="c">Reg. Count</th>
                                <th class="c">Amount ($)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in lstEventRegistrationCounts)
                            {
                                <tr>
                                    <td data-label="Registration Title">@item.RegistrationTitle</td>

                                    @if (isLoggedIn)
                                    {
                                        if (item.Count - Convert.ToInt32(item.CheckinCount) == 0)
                                        {
                                            <td class="c" data-label="Check-In">
                                                <span class="ev-done">Check-In Completed</span>
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="c" data-label="Check-In">
                                                <select id="CheckinCount_@(k)"
                                                        class="form-control reg-checkin"
                                                        data-index="@(k)"
                                                        data-id="@item.EventRegistrationTypeId"
                                                        data-title="@item.RegistrationTitle"
                                                        data-total="@item.Count"
                                                        data-amount="@item.Amount">
                                                    <option value="">-- Select --</option>
                                                    @for (int i = 1; i <= item.Count - Convert.ToInt32(item.CheckinCount); i++)
                                                    {
                                                        <option value="@i">@i</option>
                                                    }
                                                </select>
                                            </td>
                                        }
                                    }
                                    else
                                    {
                                        <td class="c" data-label="Reg. Count">@item.Count</td>
                                    }

                                    <td class="c" data-label="Amount ($)">$ @item.Amount</td>
                                </tr>
                                k++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    }

    @* ===================== PARTICIPANTS ===================== *@
    @if (objEventUserInfo.lstEventParticipant != null && objEventUserInfo.lstEventParticipant.Count() != 0)
    {
        <section class="ev-section">
            <h3 class="ev-section-title">Participants</h3>
            <div class="ev-section-body">
                <div class="ev-table-wrap">
                    <table id="participants" class="ev-table">
                        <thead>
                            <tr>
                                <th>First Name</th>
                                <th>Last Name</th>
                                <th class="c">Age</th>
                                <th class="c">Parents Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var Item in objEventUserInfo.lstEventParticipant)
                            {
                                <tr>
                                    <td data-label="First Name">@Item.FirstName</td>
                                    <td data-label="Last Name">@Item.LastName</td>
                                    <td class="c" data-label="Age">@Item.Age</td>
                                    <td class="c" data-label="Parents Name">@Item.Mobile</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    }

    @* ===================== PAYMENT DETAILS (hidden as before) ===================== *@
    <div class="d-none">
        <div class="cus-sub-head">Payment Details</div>
        <div class="row">
            <div class="col-xs-12 col-lg-3 col-sm-6">
                <label>Payment Method :</label>
                <label class="t-p5 black-t" style="font-weight:600">@(objEventUserInfo.objEventOrderDetails.PaymentMethod == null ? "N/A" : objEventUserInfo.objEventOrderDetails.PaymentMethod)</label>
            </div>
            <div class="col-xs-12 col-lg-3 col-sm-6">
                <label>Transaction Id  :</label>
                <label class="t-p5 black-t" style="font-weight:600">@(objEventUserInfo.objEventOrderDetails.TransactionId == null ? "N/A" : objEventUserInfo.objEventOrderDetails.TransactionId)</label>
            </div>
            <div class="col-xs-12 col-lg-3 col-sm-6">
                <label>Amount :</label>
                <label class="t-p5 black-t" style="font-weight:600"> $ @(objEventUserInfo.objEventOrderDetails.AmountPaid == null ? "N/A" : objEventUserInfo.objEventOrderDetails.AmountPaid.ToString())<span id="payamount"></span></label>
            </div>
            <div class="col-xs-12 col-lg-3 col-sm-6">
                <label>Payment Status :</label>
                <label class="t-p5 black-t" style="font-weight:600">@(objEventUserInfo.objEventOrderDetails.PaymentStatus == null ? "Pending" : objEventUserInfo.objEventOrderDetails.PaymentStatus)</label>
            </div>
        </div>
    </div>

    @* ===================== CHECK-IN STATUS ===================== *@
    @if (lstEventRegistrationCounts != null && lstEventRegistrationCounts.Count != 0)
    {
        <section class="ev-section">
            <h3 class="ev-section-title">Check-In Status with Comments</h3>
            <div class="ev-section-body">
                <div class="ev-status-list">
                    @foreach (var item in lstEventRegistrationCounts)
                    {
                        <div class="ev-status-row">
                            <span class="ev-status-name">@item.RegistrationTitle Check-In Count</span>
                            <span class="ev-status-count">@(item.CheckinCount != null && item.CheckinCount != "" ? item.CheckinCount : "0") / @(item.Count)</span>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    @* ===================== CHECK-IN FORM / LOGIN NOTE ===================== *@
    @if (isLoggedIn)
    {
        <section class="ev-section" id="checkin">
            <h3 class="ev-section-title">Update Check-In</h3>
            <div class="ev-section-body">
                <input id="EventUserInfoId" type="hidden" value="@objEventUserInfo.EventUserInfoId" />
                <input id="EventId" type="hidden" value="@objEventUserInfo.EventId" />
                <input id="EmployeeCode" type="hidden" value="@Context.Session.GetString("username")" />

                <label for="Comment" class="ev-form-label">Comments *</label>
                <textarea id="Comment" name="Comment" placeholder="Enter your comments here..." class="ev-textarea"></textarea>
                <span id="spanComment" class="ev-error"></span>

                <div class="ev-actions">
                    <button type="button" class="ev-btn" onclick="SubmitCheckInJSON();">Update Comments</button>
                </div>
            </div>
        </section>
    }
    else
    {
        <div class="ev-login-note">
            <p class="ev-login-text"><strong>Note:</strong> Do you have a login? If yes, sign in to submit check-in details.</p>
            <a href="#" data-bs-target="#loginpop" data-bs-toggle="modal" class="ev-btn">Click here to Login</a>
        </div>
    }

    <div class="adminfooter"></div>
</article>

<script>
    $(document).ready(function () {
        $("#MLogin").validate({
            rules: {
                Email: { required: true, email: true },
                Password: { required: true, minlength: 5 }
            },
            messages: {
                Email: { required: "Please enter email address", email: "Please enter valid email address" },
                Password: {
                    required: "Please provide a password",
                    minlength: "Your password must be at least 5 characters long"
                }
            },
            errorElement: "em",
            errorPlacement: function (error, element) {
                error.addClass("help-block");
                if (element.prop("type") === "checkbox") {
                    error.insertAfter(element.parent("label"));
                } else {
                    error.insertAfter(element);
                }
                if (element.closest("fieldset").length) {
                    element.closest("fieldset").after(error);
                }
            },
            highlight: function (element) {
                $(element).parents("fieldset").addClass("has-error").removeClass("has-success");
            },
            unhighlight: function (element) {
                $(element).parents("fieldset").addClass("has-success").removeClass("has-error");
            }
        });
    });
</script>
