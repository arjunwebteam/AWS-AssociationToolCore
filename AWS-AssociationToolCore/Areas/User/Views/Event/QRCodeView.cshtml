<script type="text/javascript">
    function SubmitCheckInJSON() {

        // Validate comment
        var comment = $('#Comment').val().trim();

        if (comment === '') {
            $('#spanComment').html('Required.');
            $('#Comment').focus().addClass("red-border");
            return false;
        }
        else {
            $('#spanComment').html('');
            $('#Comment').removeClass("red-border");
        }

        // Collect registration items
        var registrationItems = [];

        $('.reg-checkin').each(function () {

            var checkinCount = $(this).val();

            if (checkinCount !== '' && checkinCount !== undefined) {

                registrationItems.push({
                    EventRegistrationTypeId: $(this).data('id'),
                    RegistrationTitle: $(this).data('title'),
                    CheckinCount: parseInt(checkinCount),
                    TotalCount: parseInt($(this).data('total')),
                    Amount: parseFloat($(this).data('amount'))
                });
            }
        });

        if (registrationItems.length === 0) {
            alert('Please select check-in count for at least one registration type.');
            return false;
        }

        var eventRegistrationTypeId = registrationItems
            .map(function (item) { return item.EventRegistrationTypeId; })
            .join(',');

        var jsonData = {
            EventUserInfoId: $('#EventUserInfoId').val(),
            EventId: $('#EventId').val(),
            EmployeeCode: $('#EmployeeCode').val(),
            EventRegistrationTypeId: eventRegistrationTypeId,
            Status: 'Yes',
            Comment: comment,
            RegistrationItems: registrationItems
        };

        $.ajax({
            type: "POST",
            url: '@Url.Action("InsertCommentsJson", "Event")',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            data: JSON.stringify(jsonData),

            success: function (response) {
                if (response.success) {
                    alert(response.message);
                    if (response.redirectUrl != null) {
                        window.location.href = response.redirectUrl;
                    }
                }
                else {
                    alert(response.message);
                }
            },

            error: function (xhr, status, error) {
                console.log(xhr.responseText);
                alert("Error : " + error);
            }
        });
    }
</script>

