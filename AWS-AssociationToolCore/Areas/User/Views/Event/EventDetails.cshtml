<script>
    $(document).ready(function () {
        $('#MEvents').addClass('active');
            PagerClickBind();
        $('#disclaimer').dialog
            ({
                autoOpen: false,
                width: 550,
                modal: true
            });
        $('#edisclaimer').dialog
            ({
                autoOpen: false,
                width: 550,
                modal: true
            });
        });

    function PagerClickBind() {
        $("ul.pagination li a").bind("click", function () {
                EventBind($(this).text());
            });
        }

        function sortresult(sortcolumn) {

        $('#hdnsortorder').val(($('#hdnsortorder').val() == 'ASC' ? 'DESC' : 'ASC'));
        $('#hdnsortcolumn').val(sortcolumn);
            EventBind(1);
        }

        function EventBind(Pageno) {
            var pageno = Common.Pageno(Pageno);
            var search = $('#keyword').val();
            var sortcolumn = $('#hdnsortcolumn').val();
            var sortorder = $('#hdnsortorder').val();
            var items = $('#txtitems').val();
            var ChapterId = $('#ChapterId').val();;

        $.ajax({
                url: '@Url.Action("EventsList", "Event")',
            type: 'GET',
            cache: false,
            data: { ChapterId:ChapterId,search: search, PageNo: pageno, SortColumn: sortcolumn, SortOrder: sortorder, Items: items, Type: '@Type' },
            success: function (result) {
                $('#divEventsList').html(result);
                    PagerClickBind();
                }
            });
        }

        function DisclaimerShow() {
        $('#disclaimer').dialog('open');
        }
        function EDisclaimerShow() {
        $('#edisclaimer').dialog('open');
        }
</script>

<script>
    // Input datetime string
    const datetimeString = "7/11/2024 12:00:00 AM";

        // Function to parse date from string
        function parseDateTime(datetimeString) {
            const [datePart, timePart, period] = datetimeString.split(" ");
            const [month, day, year] = datePart.split("/");
            let [hours, minutes, seconds] = timePart.split(":");

            if (period === "PM" && hours !== "12") {
                hours = parseInt(hours) + 12;
            } else if (period === "AM" && hours === "12") {
                hours = "00";
            }

            return new Date(year, month - 1, day, hours, minutes, seconds);
        }

        // Create a Date object from the input string
        const dateObject = parseDateTime(datetimeString);

        // Define arrays for month and day names
        const months = ["January", "February", "March", "April", "May", "June",
            "July", "August", "September", "October", "November", "December"];
        const days = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];

        // Extract the month, date, and day from the Date object
        const month = months[dateObject.getMonth()];
        const date = dateObject.getDate();
        const day = days[dateObject.getDay()];

        // Set the values to the respective elements
        document.getElementById('month').textContent = month + " ";
    document.getElementById('date').textContent = date;
    document.getElementById('day').textContent = day;
</script>

