                                                <option value="@i">
                                                    @i
                                                </option>
                                            }
                                        </select>
                                    </td>
                                }

                            }
                            else
                            {
                                <td width="180" style="text-align:center;">@item.Count</td>
                            }
                            <td width="100" style="text-align:center;">
                                <label class="t-p5 black-t">$ @item.Amount</label>
                            </td>
                        </tr>
                        k++;
                    }
                </thead>
            </table>
        </div>
    }

