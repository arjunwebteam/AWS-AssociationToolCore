@{
    Layout = null;
    int status = 0;
    AWS_AssociationToolCore.BLL.AppInfo _AppInfo = new AWS_AssociationToolCore.BLL.AppInfo();
    AWS_AssociationToolCore.Entities.AppInfo objAppInfo = new AWS_AssociationToolCore.Entities.AppInfo();
    objAppInfo = _AppInfo.GetAppInfoDetails(ref status);

    var location = objAppInfo.AdminImageUrl + "MemberProfileImages/";

    var objEventUserInfo = (AWS_AssociationToolCore.Entities.EventUserInfo)ViewBag.objEventUserInfo;
    List<AWS_AssociationToolCore.Entities.EventRegistrationCounts> lstEventRegistrationCounts = ViewBag.lstEventRegCounts;
    List<AWS_AssociationToolCore.Entities.EventRegTickets> lstEventRegTickets = ViewBag.lstEventRegTickets;

    var imglocNormal = objAppInfo.AdminImageUrl + "CulturalEvent/";
    var type = ViewBag.type;
    var uid = ViewBag.uid;
    var MembershipType = ViewBag.MembershipType;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@objEventUserInfo.EventName Ticket</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&family=Great+Vibes&display=swap&family=Audiowide&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">

    <style>
        body {
            background: #f8d8e7 url('https://www.transparenttextures.com/patterns/stardust.png') repeat;
            color: #fff;
            font-family: 'Poppins', sans-serif;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 30px;
            flex-direction: column;
        }

        .ticket {
            background: linear-gradient(180deg, #490921 0%, #290921 100%);
            background: url(@objAppInfo.UserSiteUrl/Content/User/images/bg.jpg);
            background-position: center;
            background-repeat: no-repeat;
            background-size: cover;
            border-radius: 20px;
            padding: 30px;
            max-width: 1000px;
            width: 100%;
            color: #fff;
            box-shadow: 0 8px 25px rgba(0,0,0,0.4);
            margin-bottom: 30px;
        }

        .ticket .logo img {
            max-width: 200px;
        }

        .title {
            font-weight: 700;
            font-size: 1.2rem;
            color: #ffeb3b;
        }

        .subtitle {
            font-size: 3rem;
            font-family: 'Great Vibes', cursive;
            color: #ffd700;
            max-width: 250px;
            margin: auto;
            line-height: 140%;
            font-weight: 700;
        }

        p.event-date > span {
            font-size: 24px;
        }

        .event-date {
            font-size: 1rem;
            font-weight: 600;
            margin-top: 10px;
            border-right: 3px solid #601631;
        }

        .highlight {
            color: #ffeb3b;
            font-family: "Audiowide", sans-serif;
        }

        .ticket-box strong {
            display: block;
            font-weight: 600;
            margin-bottom: 5px;
        }

        span.highlight.ds sup {
            font-size: 17px;
            position: relative;
            top: -20px;
        }

        span.highlight.ds {
            font-size: 40px;
            line-height: 100%;
        }

        .title3 {
            text-transform: uppercase;
            padding-block: 20px 30px;
        }

        .sponser-sub-title {
            background-color: #fff;
            color: #000000;
            font-size: 16px;
            font-weight: 600;
            border-radius: 7px;
            padding: 10px;
        }

        .ticket-img {
            background-color: #ffff;
            padding: 10px;
            border-radius: 10px;
        }

        .ticket-img img {
            width: 100%;
            max-width: 113px;
            height: 113px;
        }

        .spon-title {
            text-transform: uppercase;
            font-size: 13px;
            font-weight: 600;
        }

        .color2 {
            color: #f1d2c0;
        }

        .download-btn {
            padding: 12px 40px;
            font-size: 18px;
            font-weight: 600;
            border-radius: 25px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(255, 193, 7, 0.4);
        }

        .download-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(255, 193, 7, 0.6);
        }

        .download-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .spinner-border-sm {
            width: 1rem;
            height: 1rem;
            border-width: 0.2em;
        }

        .download-arrow {
            position: absolute;
            top: -60px;
            right: 50%;
            transform: translateX(50%);
            font-size: 48px;
            color: #ffeb3b;
            animation: blink-arrow 1.5s ease-in-out infinite;
            text-shadow: 0 0 10px rgba(255, 235, 59, 0.8);
        }

        @@keyframes blink-arrow {
            0%, 100% {
                opacity: 1;
                transform: translateX(50%) translateY(0);
            }
            50% {
                opacity: 0.3;
                transform: translateX(50%) translateY(10px);
            }
        }

        @@media (max-width: 768px) {
            .ticket {
                padding: 20px;
            }

            .subtitle {
                font-size: 1.6rem;
            }

            .event-date {
                font-size: 1.2rem;
                border-right: none;
                border-bottom: 3px solid #601631;
                padding-bottom: 15px;
                margin-bottom: 15px;
            }

            .download-btn {
                padding: 10px 30px;
                font-size: 16px;
            }
        }
    </style>
</head>
<body>

    @if (lstEventRegTickets != null && lstEventRegTickets.Any())
    {
        <!-- Download All Tickets as PDF Button (at the top) -->
        <div class="text-center mb-5" style="position: relative;">
            <div class="download-arrow">⬇</div>
            <button type="button" class="btn btn-success download-btn" id="downloadAllPdfBtn" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none; font-size: 20px; padding: 15px 50px;">
                📄 Download All Tickets as PDF
            </button>
        </div>

        foreach (var item1 in lstEventRegTickets)
        {
            var ticketRefCode = objAppInfo.SiteName+"-Ticket-" + item1.EventRegTicketId;
            var qrCodePath = objAppInfo.UserSiteUrl + "Content/QRCodeGeneration/QR-of-" + ticketRefCode + ".jpg";

            <div class="ticket text-center" id="ticket-@item1.EventRegTicketId">
                <div class="row align-items-center">
                    <!-- Left Logo Section -->
                    <div class="col-md-5 mb-3 mb-md-0 logo">
                        <img src="@objAppInfo.UserSiteUrl/Content/User/images/logo_left.png" alt="Logo">
                        <h5 class="mt-4 title">@objAppInfo.SiteName</h5>
                        <small>(501(C)3 Non-Profit Organization)</small>

                        <p class="title3">Proudly Presents</p>
                        <p class="mt-3 subtitle">@objEventUserInfo.EventName Celebrations</p>
                    </div>

                    <!-- Right Event Info -->
                    <div class="col-md-7 pt-md-5 text-center">
                        <h6 class="text-uppercase fw-bold mb-2 color2">Event Ticket</h6>
                        <h2 class="highlight">@objEventUserInfo.EventName</h2>

                        <div class="row align-items-center">
                            <!-- Event Date -->
                            <div class="col-md-6">
                                <p class="event-date color2">
                                    <span>@objEventUserInfo.StartDate.ToString("MMM").ToUpper()</span>
                                    @objEventUserInfo.StartDate.ToString("yyyy")
                                    <span class="highlight ds" style="display: block;">
                                        @objEventUserInfo.StartDate.ToString("dd")<sup>TH</sup>
                                    </span>
                                    at @objEventUserInfo.StartDate.ToString("hh:mm tt")
                                </p>
                            </div>

                            <!-- Event Location -->
                            <div class="col-md-6">
                                <p class="mt-3">
                                    <strong>Event Location:</strong>
                                    <b class="color2 d-block">
                                        @objEventUserInfo.Location
                                    </b>
                                </p>
                            </div>
                        </div>

                        <!-- Ticket Details -->
                        <div class="row mt-4 align-items-center">
                            <div class="col-md-6">
                                <!-- Name -->
                                <div class="col-md-12 ticket-box mb-3">
                                    <strong class="spon-title color2">Name</strong>
                                    <div class="sponser-sub-title">@objEventUserInfo.FirstName @objEventUserInfo.LastName</div>
                                </div>

                                <!-- Ticket Number -->
                                <div class="row align-items-center">
                                    <div class="col-md-6 offset-md-3">
                                        <strong class="spon-title color2">Ticket #</strong>
                                        <div class="sponser-sub-title">@item1.TicketId</div>
                                    </div>
                                </div>
                            </div>

                            <!-- QR Code -->
                            <div class="col-md-6 mt-3 mt-md-0">
                                <strong class="spon-title color2">Ticket QR Code</strong>
                                <div class="ticket-img">
                                    <img src="@qrCodePath" alt="QR Code" onerror="this.src='@objAppInfo.UserSiteUrl/Content/User/images/qr-placeholder.png'">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Download Button for Each Ticket -->
            <div class="text-center mb-5" style="position: relative;">
                <div class="download-arrow">⬇</div>
                <button type="button" class="btn btn-warning download-btn download-ticket-btn"
                        data-ticket-id="@item1.EventRegTicketId"
                        data-ticket-number="@item1.TicketId">
                    Download Ticket Image
                </button>
            </div>
        }
    }
    else
    {
        <div class="alert alert-warning text-center">
            <p>No tickets available for this event.</p>
        </div>
    }

    <!-- jQuery (MUST be loaded first) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- html2canvas library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <!-- jsPDF library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

    <script>
        $(document).ready(function() {
            console.log('Document ready - Individual ticket download enabled');

            // Download All Tickets as PDF
            $('#downloadAllPdfBtn').on('click', function(e) {
                e.preventDefault();

                var btn = $(this);
                console.log('Downloading all tickets as PDF');

                // Disable button and show loading state
                btn.prop('disabled', true);
                var originalText = btn.html();
                btn.html('<span class="spinner-border spinner-border-sm me-2"></span>Generating PDF...');

                // Get all ticket elements
                var ticketElements = document.querySelectorAll('[id^="ticket-"]');

                if (ticketElements.length === 0) {
                    console.error('No ticket elements found');
                    alert('Error: No tickets found');
                    btn.prop('disabled', false);
                    btn.html(originalText);
                    return;
                }

                // Import jsPDF
                const { jsPDF } = window.jspdf;
                const pdf = new jsPDF({
                    orientation: 'landscape',
                    unit: 'px',
                    format: [1000, 700]
                });

                let processedTickets = 0;
                const totalTickets = ticketElements.length;

                // Function to process each ticket
                function processTicket(index) {
                    if (index >= totalTickets) {
                        // All tickets processed, save PDF
                        var eventName = '@objEventUserInfo.EventName'.replace(/\s+/g, '_');
                        var userName = '@objEventUserInfo.FirstName'.replace(/\s+/g, '_') + '_' + '@objEventUserInfo.LastName'.replace(/\s+/g, '_');
                        var timestamp = new Date().getTime();
                        var filename = eventName + '_All_Tickets_' + userName + '_' + timestamp + '.pdf';

                        pdf.save(filename);

                        console.log('PDF download completed');
                        btn.prop('disabled', false);
                        btn.html(originalText);
                        return;
                    }

                    var ticketElement = ticketElements[index];

                    // Update button text with progress
                    btn.html('<span class="spinner-border spinner-border-sm me-2"></span>Generating PDF... (' + (index + 1) + '/' + totalTickets + ')');

                    html2canvas(ticketElement, {
                        scale: 2,
                        useCORS: true,
                        allowTaint: true,
                        backgroundColor: null,
                        logging: false,
                        imageTimeout: 0,
                        width: ticketElement.offsetWidth,
                        height: ticketElement.offsetHeight,
                        onclone: function(clonedDoc) {
                            var clonedTicket = clonedDoc.getElementById(ticketElement.id);
                            if (clonedTicket) {
                                clonedTicket.style.margin = '0';
                                clonedTicket.style.transform = 'none';
                            }
                        }
                    }).then(function(canvas) {
                        var imgData = canvas.toDataURL('image/png', 1.0);

                        // Add new page for each ticket after the first one
                        if (index > 0) {
                            pdf.addPage();
                        }

                        // Calculate dimensions to fit the page
                        var imgWidth = pdf.internal.pageSize.getWidth() - 40;
                        var imgHeight = (canvas.height * imgWidth) / canvas.width;

                        // Center the image on the page
                        var xPos = 20;
                        var yPos = (pdf.internal.pageSize.getHeight() - imgHeight) / 2;

                        pdf.addImage(imgData, 'PNG', xPos, yPos, imgWidth, imgHeight);

                        // Process next ticket
                        processTicket(index + 1);

                    }).catch(function(error) {
                        console.error('Error generating ticket image:', error);
                        alert('Failed to generate PDF. Please try again.');
                        btn.prop('disabled', false);
                        btn.html(originalText);
                    });
                }

                // Start processing from first ticket
                processTicket(0);
            });

            // Handle download button click for each ticket
            $('.download-ticket-btn').on('click', function(e) {
                e.preventDefault();

                var btn = $(this);
                var ticketId = btn.data('ticket-id');
                var ticketNumber = btn.data('ticket-number');

                console.log('Downloading ticket:', ticketId);

                // Disable button and show loading state
                btn.prop('disabled', true);
                var originalText = btn.text();
                btn.html('<span class="spinner-border spinner-border-sm me-2"></span>Generating Image...');

                // Get the specific ticket element
                var ticketElement = document.getElementById('ticket-' + ticketId);

                if (!ticketElement) {
                    console.error('Ticket element not found:', ticketId);
                    alert('Error: Ticket not found');
                    btn.prop('disabled', false);
                    btn.text(originalText);
                    return;
                }

                // Capture the ticket as image using html2canvas
                html2canvas(ticketElement, {
                    scale: 3, // High quality
                    useCORS: true,
                    allowTaint: true,
                    backgroundColor: null, // Transparent background
                    logging: false,
                    imageTimeout: 0,
                    width: ticketElement.offsetWidth,
                    height: ticketElement.offsetHeight,
                    onclone: function(clonedDoc) {
                        var clonedTicket = clonedDoc.getElementById('ticket-' + ticketId);
                        if (clonedTicket) {
                            clonedTicket.style.margin = '0';
                            clonedTicket.style.transform = 'none';
                        }
                    }
                }).then(function(canvas) {
                    console.log('Canvas created successfully for ticket:', ticketId);

                    // Convert canvas to blob
                    canvas.toBlob(function(blob) {
                        if (!blob) {
                            console.error('Failed to create blob');
                            alert('Failed to generate image. Please try again.');
                            btn.prop('disabled', false);
                            btn.text(originalText);
                            return;
                        }

                        // Create download link
                        var url = URL.createObjectURL(blob);
                        var link = document.createElement('a');

                        // Generate filename
                        var eventName = '@objEventUserInfo.EventName'.replace(/\s+/g, '_');
                        var userName = '@objEventUserInfo.FirstName'.replace(/\s+/g, '_') + '_' + '@objEventUserInfo.LastName'.replace(/\s+/g, '_');
                        var timestamp = new Date().getTime();

                        link.download = eventName + '_Ticket_' + userName + '_' + ticketNumber + '_' + timestamp + '.png';
                        link.href = url;

                        // Trigger download
                        document.body.appendChild(link);
                        link.click();

                        // Cleanup
                        document.body.removeChild(link);
                        URL.revokeObjectURL(url);

                        console.log('Download completed for ticket:', ticketId);

                        // Reset button
                        btn.prop('disabled', false);
                        btn.text(originalText);

                    }, 'image/png', 1.0); // High quality PNG

                }).catch(function(error) {
                    console.error('Error generating ticket image:', error);
                    alert('Failed to generate ticket image. Please try again.');

                    // Reset button on error
                    btn.prop('disabled', false);
                    btn.text(originalText);
                });
            });
        });
    </script>

</body>
</html>