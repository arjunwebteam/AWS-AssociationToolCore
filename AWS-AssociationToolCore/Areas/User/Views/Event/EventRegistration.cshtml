<script>
        $(document).ready(function () {
         
        var isPageLoading = true;
        var originalPaymentBind = window.paymentbind;

        window.paymentbind = function(type) {
            if (isPageLoading) {
                console.log('⏳ Skipping paymentbind during load:', type);
                return;
            }
            console.log('📞 paymentbind called:', type);
            originalPaymentBind(type);
        };

        setTimeout(function() {
            isPageLoading = false;
            console.log('✅ paymentbind now active');
        }, 2000);
            // Custom image extension validator
            $.validator.addMethod("validImageExtension", function (value, element) {
                if (element.files && element.files.length > 0) {
                    var ext = element.files[0].name.split('.').pop().toLowerCase();
                    return ['jpg','png','gif','jpeg'].indexOf(ext) !== -1;
                }
                return true;
            }, "Only allowed extensions are: jpg, png, gif, jpeg");

           
            $("#SignupForm").validate({
                ignore: ':hidden:not(#recaptchaResponse)', // ← ADD THIS
                rules: {
                    FirstName: "required",
                    LastName:  "required",
                    Email:     { required: true, email: true },
                    Mobile:    { required: true },
                    Comments:  { required: true, minlength: 5 },
                    State:     "required",
                    City:      "required",
                    ZipCode:   { required: false, digits: true, minlength: 5, maxlength: 6 },

          
                },
                messages: {
                    FirstName: "Please enter your first name",
                    LastName:  "Please enter your last name",
                    Email:     { required: "Please enter email address", email: "Please enter valid email address" },
                    Mobile:    { required: "Please enter phone number" },
                    Comments:  { required: "Please enter Comments", minlength: "Your text must be at least 5 characters long" },

                    State:     { required: "Please Select State" },
                    City:      { required: "Please enter your city name" }
                    // recaptcha: { required: "Please confirm that you are not a robot." }
                },
                errorElement: "em",
                errorPlacement: function (error, element) {
                    error.addClass("help-block");
                    if (element.prop("type") === "checkbox") { error.insertAfter(element.parent("label")); }
                    else { error.insertAfter(element); }
                    if (element.closest("fieldset").length) { element.closest("fieldset").after(error); }
                },
                highlight:   function (element) { $(element).parents("fieldset").addClass("has-error").removeClass("has-success"); },
                unhighlight: function (element) { $(element).parents("fieldset").addClass("has-success").removeClass("has-error"); }
            });

            // Amount validation helper
    // Amount validation helper
         function validateAmount() {
        var amount = parseFloat($('#AmountPaid').val());
        return !isNaN(amount) && amount > 0;
    }

            // ── NEW: only enable PayPal button once amount + all required fields are actually valid ──
         function paypalReadyCheck() {
        var isReady = validateAmount() && $('#SignupForm').valid();

        if (typeof actionStatus !== 'undefined' && actionStatus) {
            try {
                if (isReady) {
                    actionStatus.enable();
                } else {
                    actionStatus.disable();
                }
            } catch (e) {
                console.log('PayPal action status error:', e);
            }
        }
        return isReady;
    }
            // ================================================================
            // SUBMIT BUTTON - handles Credit Card (nonce) and all other methods
            // ================================================================
         $("#submit-button").on("click", function (e) {
            e.preventDefault();

            var form = $("#SignupForm");
            var paymentMethod = $('#PaymentMethod').val();

            // ── Amount / ticket-category check FIRST (same as PayPal path) ──
            if (!validateAmount()) {
                var ticketSection = document.querySelector('.aws-event-ticket-box-sec');

                var $msg = $('#ticket-select-error');
                if ($msg.length === 0) {
                    $msg = $('<div id="ticket-select-error" style="font-size:16px;color:#ff3737;font-weight:600;margin-top:8px;"></div>');
                    $(ticketSection).before($msg);
                }
                $msg.html('⚠️ Please select at least one Registration Category.').show();

                if (ticketSection) {
                    ticketSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
                } else {
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }
                return;
            }
            $('#ticket-select-error').hide();

            if (paymentMethod === 'Credit Card') {
                if (!form.valid()) {
                    var $firstErrorCC = $('#SignupForm em.help-block:visible').first();
                    if ($firstErrorCC.length) {
                        $firstErrorCC[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
                    } else {
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    }
                    return;
                }

                if (!window.dropinInst) {
                    alert('Payment form not ready. Please wait and try again.');
                    return;
                }
                if (!window.dropinInst.isPaymentMethodRequestable()) {
                    alert('Please fill in your card details before submitting.');
                    return;
                }

                // ✅ DISABLE button immediately when Credit Card processing starts
                var btn = document.getElementById("submit-button");
                btn.disabled = true;
                btn.innerText = "Processing...";

                window.dropinInst.requestPaymentMethod(function (err, payload) {
                    if (err) {
                        // ✅ Re-enable on error
                        btn.disabled = false;
                        btn.innerText = "Submit";
                        alert('Card error: ' + err.message);
                        return;
                    }
                    $('#nonce').val(payload.nonce);
                    // Button stays disabled — form is submitting
                       btn.innerText = "Processing...";
                    $('<input>').attr({ type: 'hidden', name: 'ClientValidationStatus', value: 'true' }).appendTo(form);
                    form.submit();
                });
                return;
            }

            // Non-Credit-Card methods
            if (form.valid()) {
                var btn = document.getElementById("submit-button");
                btn.disabled = true;
                   btn.innerText = "Processing...";
                $('<input>').attr({ type: 'hidden', name: 'ClientValidationStatus', value: 'true' }).appendTo(form);
                form.submit();
            } else {
                var $firstError = $('#SignupForm em.help-block:visible').first();
                if ($firstError.length) {
                    $firstError[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
                } else {
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }
            }
        });

            // Show/hide PayPal container based on AmountPaid
            var amountPaidEl = document.getElementById("AmountPaid");
            if (amountPaidEl) {
                amountPaidEl.addEventListener('input', function () {
                    var amount = parseFloat(this.value);
                    var paypalContainer = document.getElementById("paypal-button-container");
                    if (paypalContainer) {
                        paypalContainer.style.display = (amount > 0) ? 'block' : 'none';
                    }
                });
            }

            // Card number formatting
            $("#CardNumber").on("input", function () {
                var value = $(this).val().replace(/\D/g, '');
                if (value.length > 0) { value = value.match(new RegExp('.{1,4}', 'g')).join(' '); }
                $(this).val(value);
            });

            // CVV numbers only
            $("#Cvv").on("input", function () {
                $(this).val($(this).val().replace(/\D/g, ''));
            });

    if (typeof paypal !== 'undefined') {
        // Prevent multiple renders
        if (!window.paypalButtonRendered) {
            window.paypalButtonRendered = true;

            console.log('Initializing PayPal button...');

            // ── LOG: setup starting ──
            $.post('/User/Event/PayPalSaveLog', { message: 'PayPal button setup starting (Event Registration). EventId: ' + $('#EventId').val() });

            paypal.Buttons({
                fundingSource: paypal.FUNDING.PAYPAL,
                style: {
                    layout: 'horizontal',
                    color: 'blue',
                    shape: 'pill',
                    label: 'pay',
                    height: 40
                },

                onInit: function (data, actions) {
                    console.log('PayPal onInit called');
                    actionStatus = actions;

                    // Disable by default, enable only when valid
                    try {
                        actions.disable();
                    } catch(e) {
                        console.log('PayPal init error:', e);
                    }

                    // Show PayPal container
                    $('#paypal-button-container').show();
                    $('#paypal-show').show();
                    $('#button-show').hide();

                    // ── LOG: init ──
                    $.post('/User/Event/PayPalSaveLog', { message: 'PayPal button initialized (Event Registration). EventId: ' + $('#EventId').val() });

                    // Setup validation listener
                    var debounceTimer;
                    $('#SignupForm').off('change keyup.paypal').on('change keyup.paypal', function () {
                        clearTimeout(debounceTimer);
                        debounceTimer = setTimeout(function () {
                            if (typeof paypalReadyCheck === 'function') {
                                paypalReadyCheck();
                            }
                        }, 300);
                    });

                    setTimeout(function () {
                        if (typeof paypalReadyCheck === 'function') {
                            paypalReadyCheck();
                        }
                    }, 500);
                },

                onClick: function (data, actions) {
                    console.log('PayPal onClick fired');

                    // Check amount
                    var amount = parseFloat($('#AmountPaid').val());
                    if (!amount || isNaN(amount) || amount <= 0) {
                        var ticketSection = document.querySelector('.aws-event-ticket-box-sec');
                        if (ticketSection) {
                            var $msg = $('#ticket-select-error');
                            if ($msg.length === 0) {
                                $msg = $('<div id="ticket-select-error" style="font-size: 16px;color:#ff3737;font-weight:600;margin-top:8px;"></div>');
                                $(ticketSection).before($msg);
                            }
                            $msg.html('⚠️ Please select at least one Registration Category.').show();
                            ticketSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        }
                        // ── LOG: rejected, no amount ──
                        $.post('/User/Event/PayPalSaveLog', { message: 'PayPal onClick rejected: no valid amount selected.' });
                        return actions.reject();
                    }
                    $('#ticket-select-error').hide();

                    // Check form validity
                    if (!$('#SignupForm').valid()) {
                        // if ('capcha' === 'Yes' && $('#recaptchaResponse').val().trim() === '') {
                        //     alert('⚠️ Please confirm you are not a robot (reCAPTCHA).');
                        //     // ── LOG: rejected, recaptcha ──
                        //     $.post('/User/Event/PayPalSaveLog', { message: 'PayPal onClick rejected: reCAPTCHA not completed.' });
                        //     return actions.reject();
                        // }

                        var $firstError = $('#SignupForm em.help-block:visible').first();
                        if ($firstError.length) {
                            $firstError[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
                        } else {
                            window.scrollTo({ top: 0, behavior: 'smooth' });
                        }
                        // ── LOG: rejected, form invalid ──
                        $.post('/User/Event/PayPalSaveLog', { message: 'PayPal onClick rejected: form validation failed.' });
                        return actions.reject();
                    }

                    console.log('✅ PayPal validation passed, opening popup...');
                    // ── LOG: click accepted ──
                    $.post('/User/Event/PayPalSaveLog', { message: 'PayPal onClick accepted. Amount: ' + amount });
                    return actions.resolve();
                },

                createOrder: function (data, actions) {
                    console.log('PayPal createOrder called');
                    var amount = parseFloat($('#AmountPaid').val());
                    if (!amount || isNaN(amount) || amount <= 0) {
                        console.error('Invalid amount for PayPal order');
                        // ── LOG: invalid amount at createOrder ──
                        $.post('/User/Event/PayPalSaveLog', { message: 'createOrder failed: invalid amount ' + amount });
                        return Promise.reject('Invalid amount');
                    }

                    var amountFormatted = amount.toFixed(2);
                    var registrationTitle = $('#RegistrationTitle').val() || "Event Registration";
                    var item = registrationTitle.split('###');
                    var description = item[0] ? item[0].trim() : "Event Registration";

                    // ── LOG: order create attempt ──
                    $.post('/User/Event/PayPalSaveLog', { message: 'createOrder called. Amount: ' + amountFormatted + ', Description: ' + description });

                    return actions.order.create({
                        purchase_units: [{
                            amount: {
                                currency_code: 'USD',
                                value: amountFormatted
                            },
                            description: description
                        }],
                        application_context: {
                            shipping_preference: 'NO_SHIPPING'
                        }
                    }).then(function (orderId) {
                        console.log('✅ Order created successfully:', orderId);
                        // ── LOG: order created ──
                        $.post('/User/Event/PayPalSaveLog', { message: 'Order created successfully. OrderId: ' + orderId });
                        return orderId;
                    }).catch(function (err) {
                        console.error('createOrder FAILED:', err);
                        $('#payment-status').html('<div class="alert alert-danger">Could not start PayPal checkout. Please try again or use a different payment method.</div>');
                        // ── LOG: order create failed ──
                        $.post('/User/Event/PayPalSaveLog', { message: 'createOrder promise FAILED: ' + (err && err.message ? err.message : JSON.stringify(err)) });
                        throw err;
                    });
                },

                onApprove: function (data, actions) {
                    console.log('PayPal onApprove called');
                    return actions.order.capture().then(function (details) {
                        var transactionId = details.id;
                        var amount = details.purchase_units[0].amount.value;
                        var status = details.status;
                        var payerName = details.payer.name.given_name + ' ' + details.payer.name.surname;
                        var payerEmail = details.payer.email_address;

                        // ── LOG: capture result ──
                        $.post('/User/Event/PayPalSaveLog', {
                            message: 'Payment captured. TransactionId: ' + transactionId + ', Amount: ' + amount +
                                      ', Status: ' + status + ', Payer: ' + payerName + ' (' + payerEmail + ')'
                        });

                        if (status === 'COMPLETED') {
                            $('#TransactionId').val(transactionId);
                            $('#PaymentAmount').val(amount);
                            $('#PaymentStatus').val(status);
                            $('#PayerName').val(payerName);
                            $('#PayerEmail').val(payerEmail);

                            $('#payment-status').html('<div class="alert alert-success">Payment completed! Submitting registration...</div>');
                            $('#paypal-button-container').hide();

                            var formData = new FormData(document.getElementById('SignupForm'));
                            $.ajax({
                                url: '@Url.Action("EventRegistration", "Event", new { area = "User" })',
                                type: 'POST',
                                data: formData,
                                processData: false,
                                contentType: false,
                                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                                success: function (response) {
                                    // ── LOG: registration submit success ──
                                    $.post('/User/Event/PayPalSaveLog', { message: 'EventRegistration submit success. TransactionId: ' + transactionId + ', Response: ' + JSON.stringify(response) });

                                    if (response && response.redirectUrl) {
                                        window.location.href = response.redirectUrl;
                                    } else {
                                        window.location.href = '@Url.Action("ThankYou", "Event", new { area = "User" })' +
                                            '?EventUserInfoId=' + ($('#EventUserInfoId').val() || 0) +
                                            '&cname=' + encodeURIComponent(cnameValue);
                                    }
                                },
                                error: function (xhr) {
                                    console.error('Submit error:', xhr.status, xhr.responseText);
                                    $('#payment-status').html('<div class="alert alert-danger">Submission failed. Payment captured. Transaction ID: ' + transactionId + '</div>');
                                    // ── LOG: registration submit failed (payment already captured!) ──
                                    $.post('/User/Event/PayPalSaveLog', { message: 'EventRegistration submit FAILED after successful capture. TransactionId: ' + transactionId + ', Status: ' + xhr.status + ', Response: ' + xhr.responseText });
                                }
                            });
                        } else {
                            $('#payment-status').html('<div class="alert alert-warning">Payment status: ' + status + '</div>');
                            // ── LOG: non-completed status ──
                            $.post('/User/Event/PayPalSaveLog', { message: 'Payment status not COMPLETED: ' + status + '. TransactionId: ' + transactionId });
                        }
                    }).catch(function (err) {
                        console.error('Capture error:', err);
                        $('#payment-status').html('<div class="alert alert-danger">Error: ' + err.message + '</div>');
                        // ── LOG: capture error ──
                        $.post('/User/Event/PayPalSaveLog', { message: 'Error capturing PayPal payment: ' + err.message });
                    });
                },

                onError: function (err) {
                    console.error('PayPal Error:', err);
                    var msg = (err && err.message) ? err.message : 'Unknown error';
                    $('#payment-status').html('<div class="alert alert-danger">PayPal error: ' + msg + '</div>');
                    // ── LOG: paypal error ──
                    $.post('/User/Event/PayPalSaveLog', { message: 'PayPal onError: ' + msg });
                    if (actionStatus) {
                        try { actionStatus.enable(); } catch(e) {}
                    }
                },

                onCancel: function () {
                    console.log('PayPal onCancel called');
                    $('#payment-status').html('<div class="alert alert-info">Payment was cancelled.</div>');
                    // ── LOG: cancelled ──
                    $.post('/User/Event/PayPalSaveLog', { message: 'User canceled PayPal payment (Event Registration).' });
                    if (actionStatus) {
                        try { actionStatus.enable(); } catch(e) {}
                    }
                }
            }).render('#paypal-button-container').then(function () {
                console.log('✅ PayPal button rendered successfully');

                // ── LOG: rendered ──
                $.post('/User/Event/PayPalSaveLog', { message: 'PayPal button rendered successfully (Event Registration).' });

                // Set default UI state WITHOUT calling paymentbind
                var firstMethod = '@firstPaymentMethod';
                if (firstMethod && firstMethod === 'PayPal') {
                    $('#PaymentMethod').val('PayPal');
                    $('.cus-tab-pane').removeClass('active').hide();
                    $('#tabpaypal').addClass('active').show();
                    $('.cus-tab-label').removeClass('active');
                    $('.cus-tab-label[value="PayPal"]').addClass('active');
                    $('#paypal-button-container').show();
                    $('#paypal-show').show();
                    $('#button-show').hide();
                }

                if (typeof paypalReadyCheck === 'function') {
                    paypalReadyCheck();
                }
            }).catch(function (err) {
                console.error('❌ PayPal button render failed:', err);
                $('#paypal-button-container').hide();
                $('#paypal-show').hide();
                $('#button-show').show();
                // ── LOG: render failed ──
                $.post('/User/Event/PayPalSaveLog', { message: 'PayPal button render FAILED: ' + (err && err.message ? err.message : JSON.stringify(err)) });
            });
        } else {
            console.log('PayPal already rendered, showing...');
            $('#paypal-button-container').show();
            $('#paypal-show').show();
            $('#button-show').hide();
            // ── LOG: already rendered ──
            $.post('/User/Event/PayPalSaveLog', { message: 'PayPal button already rendered, re-showing container (Event Registration).' });
        }
    } else {
        console.error('❌ PayPal SDK not loaded.');
        $('#paypal-button-container').hide();
        $('#paypal-show').hide();
        $('#button-show').show();
        // ── LOG: SDK not loaded ──
        $.post('/User/Event/PayPalSaveLog', { message: 'PayPal SDK not loaded (Event Registration).' });
    }
      DynamicCustomFields.wireValidation('#SignupForm', '.dynamic-custom-fields');
        }); 

</script>
<script>


// REPLACE WITH:
 function hideCheque() {
        // Radio 1 selected: show file upload, hide text input
        $('#cheque-show').show();
        $('.cheque-hide').hide();

        var validator = $('#SignupForm').data('validator');
        if (validator) {
            // Remove ChequeHolderName rule — it's hidden
            $("#ChequeHolderName").rules("remove");

            // Add file2 rule back — it's visible
            $("#file2").rules("add", {
                required: true,
                validImageExtension: true
            });

            // Allow validator to see file2
            validator.settings.ignore = ':hidden:not(#file2)';

            // Clear errors
            validator.resetForm();
            $('.has-error').removeClass('has-error');
            $('.has-success').removeClass('has-success');
        }
    }

    function ShowCheque() {
        // Radio 2 selected: hide file upload, show text input
        $('#cheque-show').hide();
        $('.cheque-hide').show();

        var validator = $('#SignupForm').data('validator');
        if (validator) {
            // Remove file2 rule — it's hidden
            $("#file2").rules("remove");

            // Reset ignore back to default (ChequeHolderName is visible)
            validator.settings.ignore = ':hidden';

            // Add ChequeHolderName rule — it's visible
            $("#ChequeHolderName").rules("add", {
                required: true,
                messages: { required: 'Please enter the name of the person' }
            });

            // Clear errors
            validator.resetForm();
            $('.has-error').removeClass('has-error');
            $('.has-success').removeClass('has-success');
        }
    }
