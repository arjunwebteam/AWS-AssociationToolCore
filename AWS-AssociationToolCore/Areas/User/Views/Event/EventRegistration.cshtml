        if ($('#CardNumber').val() != "") { $('#CardNumber').addClass('valid'); }
        if ($('#Cvv').val()        != "") { $('#Cvv').addClass('valid'); }
        if ($('#CSVMonth').val()   != "") { $('#CSVMonth').addClass('valid'); }
        if ($('#CSVYear').val()    != "") { $('#CSVYear').addClass('valid'); }
    }
