<script type="text/javascript" src="Scripts/User/jquery.validate.js"></script>

<script type="text/javascript">
    $(document).ready(function () { 
        $('.closable').append('<span class="closelink" title="Close"></span>');
        $('.closelink').click(function () {
            $(this).parent().fadeOut('600', function () { $(this).remove(); });
        }); 
        $("#DateofBirth").datepicker({ changeMonth: true, changeYear: true, yearRange: "-40:+0", altField: '.date', altFormat: 'mm/dd/yy' });

            $("#EventForm1").validate({
                rules: {
                    FirstName: "required",
                    LastName: "required",
                    ContactEmail: "required",
                    ContactEmail: { required: true, email: true }, 
                    DateofBirth: "required",
                    GradeinSchool: "required",
                    /*SchoolName: "required",*/
                    Notes: "required",
                    ContactFullName: "required",
                    ContactPhone: { required: true, phone: true },
                    MCaptcha: "required"
                },
                messages: {
                    FirstName: "First Name Required",
                    LastName: "Last Name Required",
                    ContactEmail: "Email Required",
                    ContactEmail: { required: "Email Required", email: "Please enter valid email address" },
                    DateofBirth: "Date of Birth Required",
                    GradeinSchool: "Gender Required",
                   /* SchoolName: "Class Attending Required",*/
                    Notes: "Address Required",
                    ContactFullName: "Contact FullName Required",
                    ContactPhone: { required: "Phone Number Required", phone: "Please enter valid Phone Number" },
                    MCaptcha: "Captcha Required",
                },
                onfocusout: function (element) {
                    this.element(element);
                },
            }); 
    });

    function Validate(stype) {

        var return_val = true;
        var alertvalidation = '';
        var validationcount = 0;
        var alertimg = '<img src="Content/User/images/alert-icon.png" alt="alert" width="20" height="19"> ';

        if ($('#FirstName').val() == "") { alertvalidation = alertvalidation + alertimg + ' First Name Required <br/>'; }
        if ($('#LastName').val() == "") { alertvalidation = alertvalidation + alertimg + ' Last Name Required <br/>'; }
        if ($('#ContactEmail').val() == "") { alertvalidation = alertvalidation + alertimg + ' Email Address Required <br/>'; }
        if ($('#ContactEmail').val() != "") {
            if (!Common.CheckEmail($.trim($('#ContactEmail').val()))) { alertvalidation = alertvalidation + alertimg + ' Please enter valid email address <br/>'; }
        }
        if ($('#DateofBirth').val() == "") { alertvalidation = alertvalidation + alertimg + ' Dateof Birth Required <br/>'; }
        /*if ($('#SchoolName').val() == "") { alertvalidation = alertvalidation + alertimg + ' Class Attending Required <br/>'; }*/
        if ($('#Notes').val() == "") { alertvalidation = alertvalidation + alertimg + ' Address Required <br/>'; }
        if ($('#ContactFullName').val() == "") { alertvalidation = alertvalidation + alertimg + ' Contact Full Name Required <br/>'; }
        if ($('#ContactPhone').val() == "") { alertvalidation = alertvalidation + alertimg + ' Contact Phone Required <br/>'; }

        if(@objEvents.MemberAmount != 0) {
            if ($('#CardNumber').val() == "") { alertvalidation = alertvalidation + alertimg + ' Card Number Required <br/>'; }
            if ($('#CSVMonth').val() == "") { alertvalidation = alertvalidation + alertimg + ' CSV Month Required <br/>'; }
            if ($('#CSVYear').val() == "") { alertvalidation = alertvalidation + alertimg + ' CSV Year Required <br/>'; }
            if ($('#Cvv').val() == "") { alertvalidation = alertvalidation + alertimg + ' CVV Required <br/>'; }
        }

        if ($('#txtCaptcha').val() == "") { alertvalidation = alertvalidation + alertimg + ' Captcha Required <br/>'; }

        var str = Common.GetCaptcha();

        if ($('#txtCaptcha').val() != "") {
            if ($('#txtCaptcha').val() != str) { document.getElementsByName('MCaptcha')[0].placeholder = 'Captcha Mismatched.'; $('#spantxtCaptcha').show().html('Captcha Mismatched. <span>&nbsp;</span><i>&nbsp;</i><abbr onclick="closeValidation(this);">&nbsp;</abbr>'); $('#txtCaptcha').focus().addClass("validate"); return_val = false; } else { $('#spantxtCaptcha').hide().html(''); $('#txtCaptcha').focus().removeClass("validate"); }
        }

        if ($('#txtCaptcha').val() != "") {
            if ($('#txtCaptcha').val() != str) { alertvalidation = alertvalidation + alertimg + ' Captcha Mismatched <br/>'; }
        }
        $('#txtCaptcha').focus();
        if (alertvalidation != "" && stype == "final") {
            $('#alertvalidation').html(alertvalidation);
            ValidationAlertShow();
        }

        return return_val;
    }



    function ResetValidateClass() {
        $('#ItemName').removeClass("validate");
        $('#ItemCategory').removeClass("validate");
        $('#ItemDuration').removeClass("validate");
        $('#ItemDescription').removeClass("validate");
        $('#FirstName').removeClass("validate");
        $('#LastName').removeClass("validate");
        $('#EmailId').removeClass("validate");
        $('#Mobile').removeClass("validate");
        $('#City').removeClass("validate");
        $('#State').removeClass("validate");
        $('#txtCaptcha').removeClass("validate");

            }
            function CreloadCaptcha() {
                document.getElementById('CUcaptcha').src = document.getElementById('CUcaptcha').src + '/';
            }

            var specialKeys = new Array();
            specialKeys.push(8); //Backspace
    specialKeys.push(9); //Tab
    specialKeys.push(32); //Space
    specialKeys.push(46); //Delete
    specialKeys.push(36); //Home
    specialKeys.push(35); //End
    specialKeys.push(37); //Left
    specialKeys.push(39); //Right


    function onlyAlphabets(e, t) {
                try {
                    if (window.event) {
                var charCode = window.event.keyCode;
            }
            else if (e) {
                var charCode = e.which;
        }
            else { return true; }
            if ((charCode == 32) || (charCode > 64 && charCode < 91) || (charCode > 96 && charCode < 123) || (specialKeys.indexOf(e.keyCode) != -1 && e.charCode != e.keyCode))
                return true;
            else
                return false;
        }
        catch (err) {
            alert(err.Description);
        }
    }
    function phonenochange(event) {
        if (event.keyCode == 8 || event.keyCode == 46) {
        }
        else {
            var ph = $('#ContactPhone').val();
            if (ph.length == 3) { $('#ContactPhone').val(ph + '-'); }
            if (ph.length == 7) { $('#ContactPhone').val(ph + '-'); }
        }
    }

    function calculate_total() {
        total5 = 0;
        total5 = '@objEvents.MemberAmount';
        total5 = parseInt(total5);
        total5 = parseFloat(total5 + (total5 * parseInt(2) / 100)).toFixed(2);
        document.getElementById("total").innerHTML = "$" + (total5);
        $('#AmountPaid').val(total5);
    }
</script>

<script type="text/javascript">
    $(document).ready(function () {
