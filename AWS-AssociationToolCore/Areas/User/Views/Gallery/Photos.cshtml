<script>
    $(document).ready(function () {

        $('#photoiframe').dialog
            ({
                autoOpen: false,
                width: 840,
                modal: true
            });

        FilterPhoto();
    });

    function iframe(Albumlink, Title) {
        if (Albumlink != "") {
            $('#photo').html(Albumlink);
            $('#title').html(Title);
            $('#photoiframe').dialog('open');
        }
        else {

        }

    }

    function FilterPhoto() {
        var id = $('#Year').val();
        if (id == 'All') {
            $('.catlist_class').show();
        }
        else {
            $('.catlist_class').hide();
            $('.pht-' + id).show();
        }
    }
</script>

<script type="text/javascript">

    function PagerClickBind() {
        $(".pagination a").bind("click", function () {
            PhotosBind($(this).text());
        });
    }

    function PhotosBind() {
        var Year = $('#Sort').val();
        var url = '@System.Configuration.ConfigurationManager.AppSettings["baseurl"]' + Year + '/photo-gallery';
        window.location.href = url;
    }
</script>


