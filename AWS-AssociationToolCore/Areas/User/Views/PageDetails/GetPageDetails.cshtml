@{
    Layout = "~/Areas/User/Views/Shared/_MainLayout.cshtml";
    var heading = "";
    var desc = "";
    var dhd = "";
    string ChapterName = "";

    ChapterName = ViewBag.cname;
    // ✅ No session setting here - done in controller

    var PageUrl = ViewBag.PageUrl;
    AWS_AssociationToolCore.Entities.PageDetails innerpage = ViewBag.objPageDetails;
    AWS_AssociationToolCore.Entities.PageDetails MenuPageDetails = ViewBag.objMenuPageDetails;

    if (innerpage != null)
    {
        heading = innerpage.PageUrl;
        desc = innerpage.Description;
        dhd = AWS_AssociationToolCore.BLL.Common.EncodeURL(heading);
    }

    int status = 0;
    AWS_AssociationToolCore.BLL.AppInfo _AppInfo = new AWS_AssociationToolCore.BLL.AppInfo();
    AWS_AssociationToolCore.Entities.AppInfo objAppInfo = new AWS_AssociationToolCore.Entities.AppInfo();
    objAppInfo = _AppInfo.GetAppInfoDetails(ref status);

    ViewBag.Title = heading;

    if (innerpage != null)
    {
        ViewBag.Title = (innerpage.PageTitle == ""
            ? innerpage.Heading + " - " + objAppInfo.SiteName
            : innerpage.PageTitle);
        ViewBag.MetaDescription = (innerpage.MetaDescription == ""
            ? innerpage.Heading
            : innerpage.MetaDescription);
        ViewBag.MetaKeywords = (innerpage.MetaKeywords == ""
            ? innerpage.Heading
            : innerpage.MetaKeywords);
        ViewBag.heading = innerpage.Heading;
    }

    Int64 ActiveId = 0;

    if (MenuPageDetails != null && !string.IsNullOrEmpty(MenuPageDetails.ParentName))
    {
        ActiveId = MenuPageDetails.PageParentId;
    }
    else
    {
        ActiveId = ViewBag.MenuItemId;
    }

    var pagename = ViewBag.heading;
    ViewBag.PageHeading = ViewBag.heading;
}
<script type="text/javascript">

    $(document).ready(function () {
        $('#M-@ActiveId').addClass('active');
    });

</script>

                <div class="aws-editior">
                    @if (@desc != "")
                    {
                        @Html.Raw(desc.Replace("src=\"Content/images/", "src=\"Content/User/images/").Replace("src=\"/content/", "src=\"" + objAppInfo.AdminSiteUrl + "Content/").Replace("href=\"Content/images/", "href=\"" + objAppInfo.BaseUrl + "Content/User/images/").Replace("href=\"/content/", "href=\"" + objAppInfo.AdminSiteUrl + "Content/"))
                    }
                    else
                    {

                        <h4 class="sec-title2 t-t-c font22" style="text-align:center;">Content Will Update Soon..</h4>
                    }
                </div>
           