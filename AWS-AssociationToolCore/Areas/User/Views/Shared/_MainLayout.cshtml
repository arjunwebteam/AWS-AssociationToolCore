    <!-- ===== COMMITTEE POPUP SCRIPT ===== -->
<script>
function openCommitteePopupFromBtn(btn) {
    var name  = btn.getAttribute('data-name');
    var desig = btn.getAttribute('data-desig');
    var desc  = btn.getAttribute('data-desc');
    var img   = btn.getAttribute('data-img');
    openCommitteePopup(name, desig, desc, img);
}

function openCommitteePopup(name, desig, desc, img) {
    document.getElementById('popupName').textContent  = name;
    document.getElementById('popupDesig').textContent = desig;
    document.getElementById('popupImg').src           = img;

    // If you have a description element in the popup:
    var descEl = document.getElementById('popupDesc');
    if (descEl) descEl.innerHTML = desc; // use innerHTML since Description may have HTML tags

    var el = document.getElementById('committeePopup');
    el.style.display        = 'flex';
    el.style.position       = 'fixed';
    el.style.inset          = '0';
    el.style.background     = 'rgba(0,0,0,0.55)';
    el.style.zIndex         = '999999';
    el.style.alignItems     = 'center';
    el.style.justifyContent = 'center';
    el.style.padding        = '20px';
}

function closeCommitteePopup() {
    document.getElementById('committeePopup').style.display = 'none';
}

document.getElementById('committeePopup').addEventListener('click', function(e) {
    if (e.target === this) closeCommitteePopup();
});
</script>
