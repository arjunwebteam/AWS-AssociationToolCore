    <script>
        function togglePassword(inputId, iconElement) {
            //  debugger;
            var inputField = document.getElementById(inputId);
            if (inputField.type === "password") {
                inputField.type = "text"; // Show password
                iconElement.classList.remove("bi-eye-slash"); // Change icon to "eye"
                iconElement.classList.add("bi-eye");
            } else {
                inputField.type = "password"; // Hide password
                iconElement.classList.remove("bi-eye"); // Change icon back to "eye-slash"
                iconElement.classList.add("bi-eye-slash");
            }
        }
        $(document).ready(function () {
            $(window).scroll(function () {
                if ($(document).scrollTop() > 160) {
                    $("#header").addClass("fixed-tab");
                } else {
                    $("#header").removeClass("fixed-tab");
                }
            });
        });
    </script>


