    <div class="modal aws-modal" id="RenewalAlert">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="border-radius:12px; padding: 10px 20px;">
            
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:10px;">
                <span style="font-size:28px;">⚠️</span>
                <div class="aws-title2" style="margin:0; font-size:22px; color:#1e0002;">
                    Membership Renewal Alert
                </div>
            </div>

            <hr style="margin: 8px 0 16px 0; border-color:#f0e0e0;" />

            <div class="col-md-12 px-0">

                <p class="mb-1">
                    <b>Dear @objMember.FirstName @objMember.LastName,</b>
                </p>

                <p style="line-height:1.7; color:#333;">
                    Your membership at <b>@objAppInfo.SiteName</b> has <span style="color:red; font-weight:600;">expired</span> 
                    or is due for renewal. We truly value your continued support and would love to have you stay 
                    as part of our community. Renew today to continue enjoying exclusive member benefits, 
                    discounts, and premium access without interruption.
                </p>

                <div style="background:#fff5f5; border-left: 4px solid #cc0000; border-radius:6px; padding:12px 16px; margin: 14px 0;">
                    <p style="margin:0; font-size:13px; color:#888;">Membership Expired On</p>
                    <p style="margin:4px 0 0; font-size:20px; font-weight:700; color:#1e0002;">
                        📅 @objMember.ExpiryDate.ToString("MMMM dd, yyyy")
                    </p>
                </div>

                <p style="font-size:13px; color:#888; margin-bottom:18px;">
                    ⚡ Renew now to avoid losing access to member-only features and upcoming events.
                </p>

                <div class="text-center" style="margin-bottom:10px;">
                    <a href="@Url.Action("MembershipRenewal", "Members", new { Area = "User", Astr = "renewal" })"
                       class="aws-btn3"
                       style="display:inline-block; font-size:17px; padding:12px 50px; 
                              font-weight:bold; color:white; border-radius:8px; 
                              text-decoration:none; background:#cc0000;">
                        🔄 Renew My Membership Now
                    </a>
                </div>
            
            
                <div class="text-center" style="margin-bottom:10px;">
                    <a href="@Url.Action("LogOff", "Members", new { Area = "User"})"
                       class="bi bi-box-arrow-left"
                       style="display:inline-block;
                              font-size: 15px;
                              padding: 5px 27px;
                              font-weight:bold;
                              width: 18%;
                              color:white;
                              border-radius:8px;
                              text-decoration:none;
                              background:#cc0000;">
                        Log Out
                    </a>
                </div>
                <p class="text-center" style="font-size:12px; color:#aaa; margin-top:10px;">
                    Need help? <a href="contact-us" style="color:#cc0000;">Contact Support</a>
                </p>

            </div>
        </div>
    </div>
</div>


