                    @using (Html.BeginForm("ProfileEmailUpdate", "WebAPI", FormMethod.Post, new { enctype = "multipart/form-data", @class = "validation", id = "EmailVal", name = "EmailVal" }))
                    {
                        @Html.Hidden("CEMemberId", (Int64)objMember.MemberId)
                        <div class="row">
                            <div class="col-md-12">
                                <fieldset class="toggle-password">
                                    <legend class="float-none w-auto px-1">Email<span class="input-imp">*</span></legend>
                                    <input class="input-box" type="text" id="CHEmail" name="CHEmail" value="@objMember.Email" placeholder="Email*" />
                                </fieldset>
                            </div>
                            <div class="col-md-12 text-end">
                                <div class="d-flex g-2" style="justify-content: end; gap: 10px;">
                                    <div><button type="button" class="aws-btn3" data-bs-dismiss="modal" aria-label="Close" style="background-color: rgb(130, 163, 49);">Close</button></div>
                                    <div><button type="submit" class="aws-btn3">UPDATE</button></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade aws-modal" id="changePassword" aria-labelledby="changePasswordLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="aws-title2 mb-3">Change Password</div>
                <div class="aws-alert-info mb-3" style="font-size: 12px;">
                    <span class="text-danger"><i class="bi bi-filetype-key"></i> Note:- </span>
                    Password format should be like 'Minimum 8 characters (atleast one special character &amp; one numeric character)'
                </div>
                <div class="aws-form">
                    @using (Html.BeginForm("ChangePassword", "WebAPI", FormMethod.Post, new { enctype = "multipart/form-data", @class = "validation", id = "ChangePassword", name = "ChangePassword" }))
                    {
                    @Html.Hidden("CPMemberId", (Int64)objMember.MemberId)

                    @Html.Hidden("ReturnUrl", !string.IsNullOrEmpty(Context.Request.Query["ReturnUrl"])
                                        ? Context.Request.Query["ReturnUrl"].ToString()
                                        : Context.Request.GetDisplayUrl())

                    <input id="ddlEmail" name="Email" type="hidden" value="@objMember.Email" />
                    <div class="row">
                        <div class="col-md-12">
                            <fieldset class="toggle-password">
                                <legend class="float-none w-auto px-1">Current password <span class="input-imp">*</span></legend>
                                <input class="input-box" type="password" id="OldPassword" name="OldPassword" placeholder="Old Password*" />
                                <i class="bi bi-eye-slash toggle-icon" onclick="togglePassword('OldPassword', this)"></i>
                            </fieldset>
                        </div>
                        <div class="col-md-12">
                            <fieldset class="toggle-password">
                                <legend class="float-none w-auto px-1">New Password <span class="input-imp">*</span></legend>
                                <input class="input-box" type="password" id="NewPassword" name="NewPassword" placeholder="New Password*" />
                                <i class="bi bi-eye-slash toggle-icon" onclick="togglePassword('NewPassword', this)"></i>
                            </fieldset>
                        </div>
                        <div class="col-md-12">
                            <fieldset class="toggle-password">
                                <legend class="float-none w-auto px-1">Retype Password <span class="input-imp">*</span></legend>
                                <input class="input-box" type="password" id="ConfPassword1" name="ConfPassword1" placeholder="Retype Password*" />
                                <i class="bi bi-eye-slash toggle-icon" onclick="togglePassword('ConfPassword1', this)"></i>
                            </fieldset>
                        </div>
                        <div class="col-md-12 text-end">
                            <div class="d-flex g-2" style="justify-content: end; gap: 10px;">
                                <div><button type="button" class="aws-btn3" data-bs-dismiss="modal" aria-label="Close" style="background-color: rgb(130, 163, 49);">Close</button></div>
                                <div><button type="submit" class="aws-btn3">Submit</button></div>
                            </div>
                        </div>
                    </div>
                                        }
                </div>
            </div>
        </div>
    </div>

    <div class="main-bg position-relative">
        <div class="container">
            <div class="aws-inner-content">
                @* ✅ Fix: Request.Url.AbsoluteUri → Context.Request.GetDisplayUrl() *@
                @if (Context.Request.GetDisplayUrl().Contains("profile"))
                {
                    <div class="aws-profile-grid-two">
                        @RenderBody()
                    </div>
                }
                else
                {
                    <div class="">
                        <div class="aws-left-sec">
                            <div class="aws-title">
                                @if (ViewBag.PageHeading != null && ViewBag.PageHeading != "")
                                {
                                    @ViewBag.PageHeading
                                }
                                else
                                {
                                    @ViewBag.pagename
                                }
                                @if (ViewBag.PageHeading == "Photo Gallery")
                                {
                                    <div style="font-size: 16px;">
                                        <div class="d-flex flex-row align-items-center gap-2">
                                            <div class="">
                                                <label for="Sort" class="mb-0">Year</label>
                                            </div>
                                            <div class="select_style">
                                                <select class="input-box px-2" id="Sort" style="border-radius: 50px;" onchange="PhotosBind();">
                                                    @for (int i = (DateTime.Now.Year); i >= (DateTime.Now.Year - 6); i--)
                                                    {
                                                        <option @(ViewBag.Year == i ? "selected=selected" : "") value="@i">@i</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="aws-bdr"></div>
                            @RenderBody()
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <script src="Scripts/User/owl.carousel.min.js?ver=@objAppInfo.DesktopVersion.ToString()"></script>
    <script src="Scripts/User/easy-ticker.min.js?ver=@objAppInfo.DesktopVersion.ToString()"></script>
    <script src="Scripts/User/external.js?ver=@objAppInfo.DesktopVersion.ToString()"></script>
    <script src="Scripts/User/js.js?ver=@objAppInfo.DesktopVersion.ToString()"></script>

    <script>
        $(document).ready(function () {
            $("#editProfileDetails").click(function () {
                $("#awsEditForm").css("display", "block");
                $("#showevents").css("display", "none");
                $("#awsPersonalInformation").css("display", "none");
            });
        });
    </script>

    <script>
        function togglePassword(inputId, iconElement) {
            var inputField = document.getElementById(inputId);
            if (inputField.type === "password") {
                inputField.type = "text";
                iconElement.classList.remove("bi-eye-slash");
                iconElement.classList.add("bi-eye");
            } else {
                inputField.type = "password";
                iconElement.classList.remove("bi-eye");
                iconElement.classList.add("bi-eye-slash");
            }
        }

        $(document).ready(function () {
            $(window).scroll(function () {
                if ($(document).scrollTop() > 160) {
                    $("#header").addClass("fixed-tab");
                } else {
                    $("#header").removeClass("fixed-tab");
                }
            });
        });
    </script>
</body>
</html>