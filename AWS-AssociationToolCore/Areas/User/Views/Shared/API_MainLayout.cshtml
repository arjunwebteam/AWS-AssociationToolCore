@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Http.Extensions
@inject IHttpContextAccessor HttpContextAccessor
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    int status = 0;
    AWS_AssociationToolCore.BLL.AppInfo _AppInfo = new AWS_AssociationToolCore.BLL.AppInfo();
    AWS_AssociationToolCore.Entities.AppInfo objAppInfo = new AWS_AssociationToolCore.Entities.AppInfo();
    objAppInfo = _AppInfo.GetAppInfoDetails(ref status);

    var baseurl = objAppInfo.BaseUrl;
    var adminurl = objAppInfo.BaseUrl;

    // ✅ Fix 1: ConfigurationManager → Configuration
    var HomeUrl = Configuration["HomeUrl"];

    // ✅ Fix 2: Request.Url.AbsoluteUri → GetDisplayUrl()
    string refurl = Context.Request.GetDisplayUrl();
    refurl = refurl.Replace(baseurl, "");

    var location = objAppInfo.AdminImageUrl + "MemberProfileImages/";
    var objuser = new AWS_AssociationToolCore.Entities.Users();

    AWS_AssociationToolCore.Entities.PageDetails objInnerPages = new AWS_AssociationToolCore.Entities.PageDetails();
    AWS_AssociationToolCore.Entities.PageDetails objPInnerPages = new AWS_AssociationToolCore.Entities.PageDetails();
    List<AWS_AssociationToolCore.Entities.News> lstNews = new List<AWS_AssociationToolCore.Entities.News>();
    List<AWS_AssociationToolCore.Entities.MenuItems> lstMenuItems = new List<AWS_AssociationToolCore.Entities.MenuItems>();
    List<AWS_AssociationToolCore.Entities.MenuItems> lstMenuItems2 = new List<AWS_AssociationToolCore.Entities.MenuItems>();
    List<AWS_AssociationToolCore.Entities.MenuItems> lstMenuItems3 = new List<AWS_AssociationToolCore.Entities.MenuItems>();
    List<AWS_AssociationToolCore.Entities.MenuItems> lstMenuItems4 = new List<AWS_AssociationToolCore.Entities.MenuItems>();
    List<AWS_AssociationToolCore.Entities.MenuItems> FooterMenuItems = new List<AWS_AssociationToolCore.Entities.MenuItems>();
    List<AWS_AssociationToolCore.Entities.MenuItems> MenuItems = new List<AWS_AssociationToolCore.Entities.MenuItems>();
    List<AWS_AssociationToolCore.Entities.Events> lstEvents = new List<AWS_AssociationToolCore.Entities.Events>();
    AWS_AssociationToolCore.Entities.PageDetails objChapterInnerPages = new AWS_AssociationToolCore.Entities.PageDetails();
    AWS_AssociationToolCore.Entities.PageDetails objAksharaInnerPages = new AWS_AssociationToolCore.Entities.PageDetails();

    var imglocEvent = objAppInfo.AdminImageUrl + "events/banners/";

    List<AWS_AssociationToolCore.Entities.Sponsors> lstSponsors = new List<AWS_AssociationToolCore.Entities.Sponsors>();
    List<AWS_AssociationToolCore.Entities.SponsorCategories> lstSponsorCategories = new List<AWS_AssociationToolCore.Entities.SponsorCategories>();
    List<AWS_AssociationToolCore.Entities.Sponsors> lstMediaSponsors = new List<AWS_AssociationToolCore.Entities.Sponsors>();
    List<AWS_AssociationToolCore.Entities.Chapters> lstChapters = new List<AWS_AssociationToolCore.Entities.Chapters>();
    List<AWS_AssociationToolCore.Entities.MenuItems> lstQuickLinkItems = new List<AWS_AssociationToolCore.Entities.MenuItems>();
    AWS_AssociationToolCore.Entities.Chapters objcChapters = new AWS_AssociationToolCore.Entities.Chapters();
    AWS_AssociationToolCore.BLL.Chapters _Chapters = new AWS_AssociationToolCore.BLL.Chapters();
    AWS_AssociationToolCore.Entities.PageDetails objseodetails = new AWS_AssociationToolCore.Entities.PageDetails();

    int Status = 0;
    int AStatus = 0;
    Int64 ChapterId = 0;
    var cname = "";
    string ChapterName = "";

    cname = ViewBag.cname;

    int qstatus = 0;

    // ✅ Declare outside if block
    var userroles = Context.Session.GetString("UserRole") ?? "";

    if (!string.IsNullOrEmpty(cname))
    {
        objcChapters = _Chapters.GetChaptersListByName(cname, ref qstatus);
        ChapterName = cname;
    }

    ChapterId = objcChapters.ChapterId;

    if (ChapterId == 0)
    {
        ChapterId = 1;
        ChapterName = "global";
    }

    // ✅ Extract last segment from Request.Path
    string path = Context.Request.Path;
    string headingName = "";

    if (path.StartsWith("/api-"))
    {
        path = path.Replace("api-", "");
    }

    if (!string.IsNullOrEmpty(path))
    {
        var segments = path.Trim('/').Split('/');
        if (segments.Length > 2)
        {
            headingName = segments[2];
        }
        if (segments.Length > 0)
        {
            headingName = segments.Last();
        }
    }

    objInnerPages = _AppInfo.FEGetListMainLayout(
        ChapterId,
        headingName,
        this.User.Identity.Name,
        ref lstNews,
        ref lstSponsors,
        ref lstSponsorCategories,
        ref objAppInfo,
        ref lstMenuItems, ref lstMenuItems2, ref lstMenuItems3, ref lstMenuItems4, ref FooterMenuItems,
        ref objPInnerPages,
        ref lstEvents,
        ref objChapterInnerPages,
        ref objAksharaInnerPages,
        ref lstMediaSponsors,
        ref lstChapters,
        ref lstQuickLinkItems,
        ref objseodetails,
        ref Status);

    if (objseodetails.Heading != null && objseodetails.Heading != "")
    {
        ViewBag.PageHeading = objseodetails.Heading;
        ViewBag.MetaDescription = objseodetails.MetaDescription;
        ViewBag.MetaKeywords = objseodetails.MetaKeywords;
        ViewBag.Title = objseodetails.PageTitle;
    }

    lstMenuItems = objInnerPages.lstMenuItems;
    lstMenuItems2 = objInnerPages.lstMenuItems2;
    lstMenuItems3 = objInnerPages.lstMenuItems3;
    lstMenuItems4 = objInnerPages.lstMenuItems4;
    FooterMenuItems = objInnerPages.FooterMenuItems;
    lstChapters = objInnerPages.lstChapters;
    lstNews = objInnerPages.lstNews;
    lstSponsors = objInnerPages.lstSponsors;
    lstSponsorCategories = objInnerPages.lstSponsorCategories;
    objPInnerPages = objInnerPages.objPInnerPages;
    lstEvents = objInnerPages.lstEvents;
    lstQuickLinkItems = objInnerPages.lstQuickLinkItems;
    objseodetails = objInnerPages.objseodetails;

    var imglocsponsor = objAppInfo.AdminImageUrl + "Sponsors/";

    MenuItems = lstMenuItems.Concat(lstMenuItems2).Concat(lstMenuItems3).Concat(lstMenuItems4).ToList();

    objAppInfo = _AppInfo.GetAppInfoDetails(ref AStatus);

    string str = "";
    if (ViewBag.str != null && ViewBag.str != "")
    {
        str = ViewBag.str;
    }

    AWS_AssociationToolCore.Entities.Chapters objChapters = lstChapters.FirstOrDefault(x => x.ChapterId == (ChapterId == 0 ? 1 : ChapterId));

    // ✅ Fix 3: Request.Browser.IsMobileDevice → User-Agent parsing
    var userAgent = Context.Request.Headers["User-Agent"].ToString().ToLower();
    var IsMobile = userAgent.Contains("mobile") ||
                   userAgent.Contains("android") ||
                   userAgent.Contains("iphone") ||
                   userAgent.Contains("ipad");

    AWS_AssociationToolCore.Entities.Members objMember = new AWS_AssociationToolCore.Entities.Members();
    AWS_AssociationToolCore.BLL.Members _Members = new AWS_AssociationToolCore.BLL.Members();
    int pcurrentYear = DateTime.Now.Year;

    string Email = "";
    Email = ViewBag.Email;

    if (!string.IsNullOrEmpty(Email))
    {
        int _qstatus = 0;
        objMember = _Members.GetMemberFullDetailsByEmail(Email, ref _qstatus);
    }

    // ✅ Fix 4: SetString for writing session
    Context.Session.SetString("AppName", objAppInfo.SiteName ?? "");
    Context.Session.SetString("AppEmail", objAppInfo.CompanyEmail ?? "");

    string reneve = "";
    if (objMember.ExpiryDate != null &&
        objMember.ExpiryDate != DateTime.MinValue &&
        objMember.ExpiryDate < DateTime.Now)
    {
        reneve = "yes";
    }

    var lstfChapters = lstChapters.FindAll(ch => !ch.ChapterName.Contains(objChapters.ChapterName));

    // ✅ Fix 5: Current URL for display
    var chapterName = Context.Session.GetString("ChapterName");
    var currentUrl = Context.Request.GetDisplayUrl();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <base href="@(baseurl)" />
    <meta name="description" content="@((string)ViewBag.MetaDescription != "" && (string)ViewBag.MetaDescription != null ? (string)ViewBag.MetaDescription :
                                     (objAppInfo.MetaDescription != null && objAppInfo.MetaDescription != "" ? objAppInfo.MetaDescription : "Enhance your data management with our advanced Association Tool."))" />
    <meta name="keywords" content="@((string)ViewBag.MetaKeywords != "" && (string)ViewBag.MetaKeywords != null ? (string)ViewBag.MetaKeywords :
                                  (objAppInfo.MetaKeywords != null && objAppInfo.MetaKeywords != "" ? objAppInfo.MetaKeywords : "Association tool, data mapping software"))" />
    <title>
        @((string)ViewBag.Title != "" && (string)ViewBag.Title != null ? (string)ViewBag.Title :
                (objAppInfo.PageTitle != null && objAppInfo.PageTitle != "" ? objAppInfo.PageTitle : "Powerful Association Tool"))
    </title>

    <link rel="shortcut icon" href="Content/User/images/favicon.png" />
    <meta name="author" content="Your Name or Company" />
    <meta name="robots" content="index, follow" />

    <meta property="og:title" content="@(objAppInfo.SiteName)" />
    <meta property="og:description" content="A brief description of your website." />
    <meta property="og:image" content="@(baseurl)image.jpg" />
    <meta property="og:url" content="@(baseurl)" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="@(objAppInfo.SiteName)" />

    <link rel="icon" href="@(baseurl)favicon.ico" type="image/x-icon" />
    <link rel="shortcut icon" href="@(baseurl)favicon.ico" type="image/x-icon" />

    <link rel="stylesheet" href="Content/User/css/bootstrap.min.css?ver=@objAppInfo.DesktopVersion.ToString()" />
    <link rel="stylesheet" href="Content/User/css/style.css?ver=@objAppInfo.DesktopVersion.ToString()" />
    <link rel="stylesheet" href="Content/User/css/responsive.css?ver=@objAppInfo.DesktopVersion.ToString()" />
    <link rel="stylesheet" href="Content/User/css/external.css?ver=@objAppInfo.DesktopVersion.ToString()" />
    <link rel="stylesheet" href="Content/User/css/owl.carousel.min.css?ver=@objAppInfo.DesktopVersion.ToString()" />
    <link rel="stylesheet" href="Content/User/css/owl.theme.default.min.css?ver=@objAppInfo.DesktopVersion.ToString()" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css?ver=@objAppInfo.DesktopVersion.ToString()" />

    <script src="Scripts/User/jquery.min.js?ver=@objAppInfo.DesktopVersion.ToString()"></script>
    <script src="Scripts/User/Common.js?ver=@objAppInfo.DesktopVersion.ToString()"></script>
    <script src="Scripts/User/bootstrap.min.js?ver=@objAppInfo.DesktopVersion.ToString()"></script>
    <script src="Scripts/User/jquery-validate.min.js?ver=@objAppInfo.DesktopVersion.ToString()"></script>

    <script>
        $('#ZipCode').on('input', function () {
            var zip = $(this).val().replace(/\D/g, '');
            if (zip.length > 3) {
                zip = zip.slice(0, 3) + '-' + zip.slice(3, 5);
            }
            $(this).val(zip);
        });

        $(document).ready(function () {
            $.validator.addMethod("phoneUS", function (phone_number, element) {
                phone_number = phone_number.replace(/\s+/g, "");
                return this.optional(element) || phone_number.length == 12 && /^\d{3}-\d{3}-\d{4}$/.test(phone_number);
            }, "Please specify a valid phone number (e.g., 123-456-7890)");

            getamount();

            $('#PhoneNo').on('input', function () {
                var ph = $(this).val().replace(/\D/g, '');
                if (ph.length > 3 && ph.length <= 6) {
                    ph = ph.slice(0, 3) + '-' + ph.slice(3);
                } else if (ph.length > 6) {
                    ph = ph.slice(0, 3) + '-' + ph.slice(3, 6) + '-' + ph.slice(6, 10);
                }
                $(this).val(ph);
            });
        });
    </script>

    <style>
