    <script type="text/javascript">
        function openPopup() {
            document.getElementById('RenewalAlert').style.display = 'block';
            document.body.onclick = function (event) {
                if (!document.getElementById('RenewalAlert').contains(event.target)) {
                }
            };
        }

        $(document).ready(function () {
            if ('@reneve' == 'yes') {
                openPopup();
            }
            if ('@userroles' != '' && '@userroles' != 'null') {
                $('#LogoutModel').modal("show");
            }
        });
    </script>

    <script type="text/javascript">
        function NewletterShow() {
            $('#NLSubscription').modal('show');
        }
    </script>

    <script>
        function Chapter(ChapterName) {
            let chapterButton = document.getElementById('chapterButton');
            if (chapterButton) {
                chapterButton.innerHTML = '<i class="bi bi-list-ul"></i> ' + ChapterName;
            } else {
                console.error("Element with ID 'chapterButton' not found.");
            }
            window.location.href = '@baseurl' + ChapterName + '/index';
        }
    </script>
</head>

<body>
    <div class="modal aws-modal" id="RenewalAlert">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="aws-title2 mb-3">Membership Renewal Alert</div>
                <div class="col-md-12 px-0">
                    <p class="mb-0"><b>Dear @objMember.FirstName @objMember.LastName!</b></p>
                    <p>We hope you've enjoyed the exclusive benefits of being a valued member at <b>@objAppInfo.SiteName</b>. Your membership is due for renewal.</p>
                    <h4 class="pres-name aws-title2 mb-3 mt-2 text-start">
                        <span style="color:#1e0002;">Renewal Deadline:</span> @objMember.ExpiryDate.ToString("MM/dd/yyyy")
                    </h4>
                    <div class="aws-btn3 dis-in text-center m-2 font16" style="margin-left: 213px !important;">
                        <a href="@Url.Action("MembershipRenewal", "Members", new { str = "renewal" })" style="font-size: 18px;padding: 10px 28px;font-weight: bold;color:white;">Renew Now</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade aws-modal" id="loginpop" aria-labelledby="changePasswordLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="aws-title2 mb-3">Login</div>
                <div class="aws-alert-info mb-3" style="font-size: 12px;">
                    <span class="text-danger"><i class="bi bi-filetype-key"></i> Note:- </span>
                    Password format should be like 'Minimum 8 characters (atleast one special character &amp; one numeric character)'
                </div>
                <div class="aws-form">
                    @using (Html.BeginForm("CULLogOn", "Members", FormMethod.Post, new { name = "MLogin", id = "MLogin" }))
                    {
                        <input type="hidden" name="ReturnUrl" value="@Context.Request.GetDisplayUrl()" />
                        <input id="MemberId" name="MemberId" type="hidden" value="@objMember.MemberId" />
                        <div class="row">
                            <div class="col-md-12">
                                <fieldset class="toggle-password">
                                    <legend class="float-none w-auto px-1">Email <span class="input-imp">*</span></legend>
                                    <input class="input-box" type="text" id="EmailC1" name="CulturalEmail" placeholder="Email Id" />
                                    <i class="bi bi-eye-slash"></i>
                                </fieldset>
                            </div>
                            <div class="col-md-12">
                                <fieldset class="toggle-password">
                                    <legend class="float-none w-auto px-1">password <span class="input-imp">*</span></legend>
                                    <input class="input-box" type="password" id="PasswordC1" name="Password" placeholder="password" />
                                    <i class="bi bi-eye-slash"></i>
                                </fieldset>
                            </div>
                            <div class="col-md-12 text-end">
                                <div class="d-flex g-2" style="justify-content: end; gap: 10px;">
                                    <div><button type="button" class="aws-btn3" data-bs-dismiss="modal" aria-label="Close">Close</button></div>
                                    <div><button type="submit" class="aws-btn3">Submit</button></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade aws-modal" id="renewalConfirm-popup" aria-labelledby="editProfileLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <div class="aws-title2 mb-3">Change profile picture</div>
                <div class="cmn-inner-form w-100">
                    @if (objMember.objMembershipOrder.ExpiryDate != null && objMember.objMembershipOrder.ExpiryDate != DateTime.MinValue)
                    {
                        if (ViewBag.daysRemaining <= 60)
                        {
                            <h4 class="black-t font18 poppins-medium t-c t-m0" style="font-size: 16px; font-weight: bold; line-height: 30px;">
                                Dear <span style="color:#ff6a00">@objMember.FirstName @objMember.LastName,</span> Your membership expires on
                                <span style="color:#ff6a00">(@objMember.objMembershipOrder.ExpiryDate.ToString("MM/dd/yyyy")), </span>
                                Please <u class="px-2 clr1"><a href="@Url.Action("MembershipRenewal", "Members")" class="clr1 d-inline-block">Click here to Renew.</a></u>
                            </h4>
                        }
                        else if (ViewBag.daysRemaining == 0)
                        {
                            <h4 class="black-t font18 poppins-medium t-c t-m0" style="font-size: 16px; font-weight: bold; line-height: 30px;">
                                Dear <span style="color:#ff6a00">@objMember.FirstName @objMember.LastName,</span> The expiry date has passed,
                                <u class="px-2 clr1"><a href="@Url.Action("MembershipRenewal", "Members")" class="clr1 d-inline-block">Click here to Renew.</a></u>
                            </h4>
                        }
                        else
                        {
                            <h4 class="black-t font18 poppins-medium t-c t-m0" style="font-size: 16px; font-weight: bold; line-height: 30px;">
                                Dear <span style="color:#ff6a00">@objMember.FirstName @objMember.LastName,</span> Your membership expires on
                                <span style="color:#ff6a00">(@objMember.objMembershipOrder.ExpiryDate.ToString("MM/dd/yyyy")),</span>
                                Please <a href="@Url.Action("MembershipRenewal", "Members")">Click here to Renew.</a>
                            </h4>
                        }
                    }
                    <article class="clearfix p8 white-bg t-c">
                        <article class="clearfix" style="margin-left: auto; margin-right: auto; display: inherit; margin-right: 20px; margin-bottom:20px;">
                            <a href="@Url.Action("MembershipRenewal", "Members", new { str = "renewal" })" title="Proceed To Pay Now">
                                <input type="submit" value="Proceed To Pay Now" class="cmn-form-btn" />
                            </a>
                        </article>
                    </article>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade aws-modal" id="editProfile" aria-labelledby="editProfileLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="aws-title2 mb-3">Change profile picture</div>
                @using (Html.BeginForm("ProfilePic", "WebAPI", FormMethod.Post, new { enctype = "multipart/form-data", @class = "validation", id = "pic", name = "pic" }))
