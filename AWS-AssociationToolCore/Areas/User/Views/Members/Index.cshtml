        <div class="container">
            <div class="header-nav">
                <div class="text-end">


                    @if (isAuthenticated && userName != null && chapterName != null)
                    {
                        <a href="@Url.Action("Profile", "Members")">
                            <i class="mobile-nav-toggle mobile-nav-show bi bi-list"></i>
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("LogOn", "Members")">
                            <i class="mobile-nav-toggle mobile-nav-hide d-none bi bi-x"></i>
                        </a>
                    }

                </div>



                <nav id="navbar" class="navbar">
                    @if (lstMenuItems != null && lstMenuItems.Count != 0)
                    {
                        <ul class="">
                            <li class="menu-active"><a href="@Url.Action("Index", "Home")">Home</a></li>
                            @foreach (var item in lstMenuItems)
                            {
                                Int64 menu2Count = lstMenuItems2.Count(x => x.PageParentId == item.MenuItemId);

                                <li class="menu-item-has-children">
                                    <a href="@(item.DocumentUrl != null && item.DocumentUrl != "" ? adminurl + "Content/PageDocuments/" + item.DocumentUrl : (item.OtherUrl != null && item.OtherUrl != "" ? item.OtherUrl : (item.PageUrl != null && item.PageUrl != "" ? "p/" + item.PageUrl + "?mrid=" + item.MenuItemId : Context.Session.GetString("ChapterName") + "/update-soon")))" target="@item.Target">@item.DisplayName<i class="bi dropdown-indicator bi-chevron-down"></i></a>
                                    @if (lstMenuItems2 != null && lstMenuItems2.Count != 0)
                                    {
                                        if (item.SubMenuItemCount != 0)
                                        {

                                            <ul class="sub-menu ">

                                                @foreach (var item2 in lstMenuItems2)
                                                {
                                                    if (item.MenuItemId == item2.PageParentId)
                                                    {
                                                        Int64 menu3Count = lstMenuItems3.Count(x => x.PageParentId == item2.MenuItemId);
                                                        if (isAuthenticated && userName != null && chapterName != null)
                                                        {
                                                            if (item2.DisplayName != "Become a Member")
                                                            {
                                                                <li><a href="@(item2.DocumentUrl != null && item2.DocumentUrl != "" ? adminurl + "Content/PageDocuments/" + item2.DocumentUrl : (item2.OtherUrl != null && item2.OtherUrl != "" ? item2.OtherUrl : (item2.PageUrl != null && item2.PageUrl != "" ? "p/" + item2.PageUrl + "?mrid=" + item2.MenuItemId : Context.Session.GetString("ChapterName") + "/update-soon")))" target="@item2.Target">@item2.DisplayName</a></li>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <li><a href="@(item2.DocumentUrl != null && item2.DocumentUrl != "" ? adminurl + "Content/PageDocuments/" + item2.DocumentUrl : (item2.OtherUrl != null && item2.OtherUrl != "" ? item2.OtherUrl : (item2.PageUrl != null && item2.PageUrl != "" ? "p/" + item2.PageUrl + "?mrid=" + item2.MenuItemId : Context.Session.GetString("ChapterName") + "/update-soon")))" target="@item2.Target">@item2.DisplayName</a></li>
                                                        }
                                                    }
                                                }

                                            </ul>
                                        }
                                    }
                                </li>
                            }


                            @if (isAuthenticated && userName != null && chapterName != null)
                            {
                                <li class="login-n"><a href="@Url.Action("Profile", "Members", new { cname = Context.Session.GetString("ChapterName") })"><img class="lock-icon pe-1" src="Content/User/images/login.png">Profile </a></li>
                            }

                            else
                            {
                                <li class="login-n"><a href="@Url.Action("LogOn", "Members", new { cname = Context.Session.GetString("ChapterName") })"><img class="lock-icon pe-1" src="Content/User/images/login.png">Login</a></li>
                            }
                        </ul>
                    }
                </nav>
            </div>
        </div>
    </header>


