                                                                    else
                                                                    {
                                                                        <img src="@(imglocsponsor + item.LogoUrl)" alt="">
                                                                    }

                                                                </li>
                                                            }
                                                        }
                                                    </ul>
                                                </div>
                                            </div>

                                        </div>
                                    }
                                    i++;
                                }
                            </div>

                        </div>
                    }

                </div>
