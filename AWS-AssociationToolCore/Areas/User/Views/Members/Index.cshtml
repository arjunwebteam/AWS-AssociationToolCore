    AWS_AssociationToolCore.BLL.Chapters _Chapters = new AWS_AssociationToolCore.BLL.Chapters();


    var imglocNormal = objAppInfo.AdminImageUrl + "WebsiteBanners/NormalImages/";
    var imglocsponsor = objAppInfo.AdminImageUrl + "Sponsors/";
    var imglocEvent = objAppInfo.AdminImageUrl + "events/banners/";
    var gnimgloc = objAppInfo.AdminImageUrl + "photogallery/normalphoto/";
    var gtimgloc = objAppInfo.AdminImageUrl + "photogallery/thumbphoto/";

    Int64 ChapterId = 0;
    var cname = "";
    string ChapterName = "";

    cname = ViewBag.cname;

    int qstatus = 0;
    if (cname != null && cname != "")
    {
        objcChapters = _Chapters.GetChaptersListByName(cname, ref qstatus);

        ChapterName = cname;
    }

    ChapterId = objcChapters.ChapterId;

    if (ChapterId == 0)
    {
        ChapterId = 1;

        ChapterName = "global";
    }


    var Type = ViewBag.Type;
    ViewBag.heading = "Home";

    string str = "";
    if (ViewBag.str != null && ViewBag.str != "")
    {
        str = ViewBag.str;
    }

    string str1 = "";
    if (TempData["forgot"] != null)
    {
        str1 = TempData["forgot"].ToString();
    }

    string accyear = "";
    int year = 0;
    int mnt = DateTime.Now.Month;
    year = (mnt >= 4 ? DateTime.Now.Year : DateTime.Now.Year - 1);
    accyear = year + "-" + (year + 1);

    ViewBag.ACStart = objAppInfo.SecretaryPhone;
    ViewBag.ACEnd = objAppInfo.CustomerCareNumber;
    // ✅ Session Set - ASP.NET Core
    // ✅ Cast dynamic ViewBag to string before SetString

    // ✅ Use Context.Session in Razor Views (.cshtml)
    string sessionChapterId = ViewBag.ChapterId != null ? ViewBag.ChapterId.ToString() : string.Empty;
    string sessionChapterName = ViewBag.cname != null ? ViewBag.cname.ToString() : string.Empty;

    Context.Session.SetString("ChapterId", sessionChapterId);
    Context.Session.SetString("ChapterName", sessionChapterName);


    // ✅ Use Context.Request in Razor Views
    string userAgentStr = Context.Request.Headers["User-Agent"].ToString().ToLower();
    bool IsMobile = userAgentStr.Contains("mobile")  ||
                    userAgentStr.Contains("android") ||
                    userAgentStr.Contains("iphone")  ||
                    userAgentStr.Contains("ipad");


    var launch = ViewBag.w;
    int pcurrentYear = DateTime.Now.Year;


    var lstfChapters = lstChapters.FindAll(ch => !ch.ChapterName.Contains(objChapters.ChapterName));
}
@{
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var userName = User.Identity?.Name;
    var chapterName = Context.Session?.GetString("ChapterName");
}
                        Html.RenderAction("UpcomingEvents", "Home");
<script>
 $(document).ready(function () {
        LoadUpcomingEventsList();
        });

    function LoadUpcomingEventsList() {
            $.ajax({
                type: "GET",
                url: '@Url.Action("UpcomingEvents", "Home")',
        

            success: function (data) {
                    $("#divUpcomingEventsList").html(data);
                },
                error: function () {
                    $("#divUpcomingEventsList").html('<p class="text-danger">Failed to load events.</p>');
                }
            });
        }
</script>
