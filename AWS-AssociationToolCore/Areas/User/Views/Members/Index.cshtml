    <script>
        function Chapter(ChapterName) {

            document.getElementById('chapterButton').innerHTML = '<i class="bi bi-list-ul"></i> ' + ChapterName;
            window.location.href = '@baseurl' + ChapterName + '/index';

        }
        Chapter(ChapterName);
    </script>

