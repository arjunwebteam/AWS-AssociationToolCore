
@{
    Layout = "~/Areas/User/Views/Shared/_MainLayout.cshtml";

    ViewBag.Heading = "Profile";

    int _qstatus = 0;
    AWS_AssociationToolCore.BLL.AppInfo _AppInfo = new AWS_AssociationToolCore.BLL.AppInfo();
    AWS_AssociationToolCore.Entities.AppInfo objAppInfo = new AWS_AssociationToolCore.Entities.AppInfo();
    List<AWS_AssociationToolCore.Entities.EventUserInfo> lstEventUserInfo = ViewBag.lstEventUserInfo;

    objAppInfo = _AppInfo.GetAppInfoDetails(ref _qstatus);

    AWS_AssociationToolCore.Entities.Members objMember = ViewBag.objMember;
    var objMembersType = (AWS_AssociationToolCore.Entities.Members)ViewBag.objMembersType;

    var location = objAppInfo.AdminImageUrl + "MemberProfileImages/";
    var objEventUserInfo = (AWS_AssociationToolCore.Entities.EventUserInfo)ViewBag.objEventUserInfo;
    List<AWS_AssociationToolCore.Entities.EventRegistrationCounts> lstEventRegistrationCounts = ViewBag.lstEventRegistrationCounts;


}
<script src="Scripts/Admin/Common.js" type="text/javascript"></script>
<!-- button list start -->
<style>
    td .bi.bi-eye-fill {
        font-size: 1rem;
        color: #373737;
    }

    .pn__set thead tr th:nth-child(6) {
        width: 60px;
    }

    .pn__set thead tr th:nth-child(1) {
        width: 100px;
    }

    .veiw__title__name {
        display: flex;
        gap: 5px;
    }

    .profile__set {
        display: grid;
        gap: 10px;
        grid-template-columns: repeat( auto-fit, minmax(300px, 1fr) );
    }


    .aws-event-box .event__box__title {
        color: #3fa2a9;
    }
</style>
<script>
        $(document).ready(function () {
            LoadLatestNewsList();
        });

        function LoadLatestNewsList() {
            $.ajax({
                type: "GET",
                url: '@Url.Action("ProfileMenu", "Members")',
             data: {
    tab    : 'EventsList'

        },

            success: function (data) {
                    $("#EventsList").html(data);
                },
                error: function () {
                    $("#EventsList").html('<p class="text-danger">Failed to load events.</p>');
                }
            });
        }
</script>

<div class="aws-profile-left-sec">

    <!-- profile Here information -->
    <div class="" id="EventsList">
        <div class="aws-profile-img">
            <button class="aws-edit-icon" title="edit profile" data-bs-toggle="modal" data-bs-target="#editProfile"><i class="bi bi-pencil"></i></button>
            @if (objMember.ProfileImage != null && objMember.ProfileImage != "")
            {
                <img src="@AWS_AssociationToolCore.BLL.Common.ValidateImage((location + objMember.ProfileImage), "Content/user/images/com-main.png")" alt="Profile" class="border-radius10 profshd" width="159" height="159" />
            }
            else
            {
                <img src="Content/user/images/com-main.png" alt="Profile" class="border-radius10 profshd" width="159"
                     height="159" />
            }
        </div>


@*         @{Html.RenderAction("ProfileMenu", "Members", new { tab = "EventsList" });}
 *@


    </div>
    <!-- profile Here  -->

</div>

<div class="aws-profile-right-sec">
    

    <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap">
        <div class="aws-title">Event Registration Info</div>
        <div><a href="profile-event" class="btn px-3" style="background: #d5181f; color:#fff;"><i class="bi bi-box-arrow-left pe-1"></i> Back</a></div>
    </div>




    <div class="aws-bdr"></div>
    <div class="aws-profile-dashboard-sec">
        <div class="">

            <div class="row">
                <div class="aws-event-box">
                    <h5 class="event__box__title">Personal Details</h5>
                </div>
                <div class="col-12">
                    <div class="profile__set">
                        <div class="">
                            <div class="aws-committee-cnt  veiw__title__name">
                                <div class="aws-title4">First Name :</div>
                                <div class="aws-desgination">@objEventUserInfo.FirstName</div>
                            </div>
                        </div>
                        <div class="">
                            <div class="aws-committee-cnt  veiw__title__name">
                                <div class="aws-title4">Last Name :</div>
                                <div class="aws-desgination">@objEventUserInfo.LastName</div>
                            </div>
                        </div>
                        <div class="">
                            <div class="aws-committee-cnt  veiw__title__name">
                                <div class="aws-title4">Email :</div>
                                <div class="aws-desgination">@objEventUserInfo.Email</div>
                            </div>
                        </div>
                        <div class="">
                            <div class="aws-committee-cnt  veiw__title__name">
                                <div class="aws-title4">City :</div>
                                <div class="aws-desgination">@objEventUserInfo.City</div>
                            </div>
                        </div>
                        <div class="">
                            <div class="aws-committee-cnt  veiw__title__name">
                                <div class="aws-title4">State :</div>
                                <div class="aws-desgination">@objEventUserInfo.State</div>
                            </div>
                        </div>
                        <div class="">
                            <div class="aws-committee-cnt  veiw__title__name">
                                <div class="aws-title4">Mobile Number :</div>
                                <div class="aws-desgination">@objEventUserInfo.Mobile</div>
                            </div>
                        </div>
                        @*<div class="">
                            <div class="aws-committee-cnt  veiw__title__name">
                                <div class="aws-title4">Additional Info :</div>
                                <div class="aws-desgination">@objEventUserInfo.Comments</div>
                            </div>
                        </div>*@
                    </div>
                </div>
            </div>

            @if (lstEventRegistrationCounts != null && lstEventRegistrationCounts.Count != 0)
            {
                <div class="row mt-3">
                    <div class="aws-left-sec">

                        <div class="aws-event-box">
                            <h5 class="event__box__title">Registration Types</h5>
                        </div>


                        <div class="aws-table-card">
                            <table class="table  table-bordered table-hover table-stripped">
                                <thead>
                                    <tr>
                                        <th style="width: 60px;" scope="col">S.No</th>
                                        <th scope="col">Registration Title </th>
                                        <th scope="col">Reg.Count</th>
                                        <th scope="col">Amount($)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in lstEventRegistrationCounts)
                                    {
                                        int i = 1;
                                        <tr>
                                            <td data-label="Donar Id">@i</td>
                                            <td data-label="Donar Id">@item.RegistrationTitle</td>
                                            <td data-label="First Name">@item.Count</td>
                                            <td data-label="last Name">$@item.Amount</td>
                                        </tr>
                                        i++;
                                    }


                                </tbody>
                            </table>
                        </div>
                        <!-- content End Here  -->

                    </div>
                </div>
            }
            <div class="aws-bdr"></div>
            <div class="row mt-3">
                <div class="aws-event-box">
                    <h5 class="event__box__title">Payment Details</h5>
                </div>
                <div class="col-12">
                    <div class="profile__set">
                        <div class="">
                            <div class="aws-committee-cnt  veiw__title__name">
                                <div class="aws-title4"> Payment Method :</div>
                                <div class="aws-desgination">@(objEventUserInfo.objEventOrderDetails.PaymentMethod == null ? "N/A" : objEventUserInfo.objEventOrderDetails.PaymentMethod)</div>
                            </div>
                        </div>



                        @if (objEventUserInfo.objEventOrderDetails.PaymentStatus == "Completed")
                        {


                            <div class="">
                                <div class="aws-committee-cnt  veiw__title__name">
                                    <div class="aws-title4">Payment Status :</div>
                                    <div class="aws-desgination">Paid</div>
                                </div>
                            </div>

                        }


                        <div class="">
                            <div class="aws-committee-cnt  veiw__title__name">
                                <div class="aws-title4"> Transaction Id :</div>
                                <div class="aws-desgination">@(objEventUserInfo.objEventOrderDetails.TransactionId == null ? "N/A" : objEventUserInfo.objEventOrderDetails.TransactionId)</div>
                            </div>
                        </div>

                        <div class="">
                            <div class="aws-committee-cnt  veiw__title__name">
                                <div class="aws-title4">Amount Paid :</div>
                                <div class="aws-desgination">$@(objEventUserInfo.objEventOrderDetails.AmountPaid == 0 ? "N/A" : objEventUserInfo.objEventOrderDetails.AmountPaid.ToString())<span id="payamount"></span></div>
                            </div>
                        </div>


                    </div>
                </div>
            </div>
        </div>

    </div>


</div>

