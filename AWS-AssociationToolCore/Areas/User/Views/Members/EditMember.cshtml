        $(document).ready(function () {
         $('#IwMembers, #wMembers').addClass('active');
        getamount();
        Insurance();
        Billing();
        NoofPaym();
        DonatAmount();
        $(".Odate").datepicker({ changeMonth: true, changeYear: true, yearRange: "-90:+0", altField: '.Odate', altFormat: 'mm/dd/yy' });
        $(".Edate").datepicker({ changeMonth: true, changeYear: true, yearRange: "-90:+0", altField: '.Edate', altFormat: 'mm/dd/yy' });
        $(".Cdate").datepicker({ changeMonth: true, changeYear: true, yearRange: "-0:+40", altField: '.Cdate', altFormat: 'mm/dd/yy' });
        $('#MMembers').addClass('active');
    });
    function getamount() {
        var membershipid = $('#MembershipTypeId').val();
        $.ajax({
            url: '@Url.Action("EditMembershipTypes", "MembershipTypes")',
            type: 'POST',
            data: { MembershipTypeId: membershipid },
            datatype: "JSON",
            success: function (result) {
                if (result.ok) {
                    var objMembershipType = result.data;
                    $('#payamount').html(objMembershipType.Price);
                    $('#MemberAmount').val(objMembershipType.Price);
                    $('#TMemberAmount').val(objMembershipType.Price);
                    $('#total').html(objMembershipType.Price);
                    if (Common.ConvertDate(objMembershipType.Validity) != '1/1/1') {
                        var d = new Date();
                        d.setMonth((d.getMonth()) + objMembershipType.Validity);
                        $('#ExpiryDate').val(Common.ConvertDate(objMembershipType.Validity));
                    } else { $('#ExpiryDate').val('Life Time'); }
                }
                else {
                    alert(result.data);
                }
            }
        });
    }


       function CheckProfileEmailAvailability(email, userid) {
        var returnval = null;
        $.ajax({
            type: "POST",
            url: '@Url.Action("CheckProfileEmailAvailability", "Members")', // the URL of the controller action method
            data: { MemberId: userid, Email: email }, // optional data
            datatype: "JSON",
            async: false,
            success: function (result) {
                if (result.ok) {
                    returnval = result.data;
                }
            }
        });
        return returnval;
        }

        function CheckProfilePhoneNoAvailability(MobilePhone, userid) {
        var returnval = null;
        $.ajax({
            type: "POST",
            url: '@Url.Action("CheckProfilePhoneNoAvailability", "Members")', // the URL of the controller action method
            data: { MemberId: userid, MobilePhone: MobilePhone }, // optional data
            datatype: "JSON",
            async: false,
            success: function (result) {
                if (result.ok) {
                    returnval = result.data;
                }
            }
        });
        return returnval;
    }


    function Billing() {
        var type = $('#SameBilling').val();
        if (type == 'No') {
            $('#TTTD').show();

        }
        else {
            $('#TTTD').hide();
        }

    }

    function Insurance() {
        var type = $('#Field2').val();
        if (type == 'Yes') {
            $('#Beneficiary').show();
            $('#University').show();

        }


        else {
            $('#Beneficiary').hide();
            $('#University').hide();


        }

        }

        function NoofPaym() {
            var type = $('#FrequencyofDonation').val();
            if (type == 'OneTimeDonation') {

                $('#TAmount').hide();
                $('#NoofPay').hide();
                $('#TStarts').hide();
            }
            else {
                $('#TAmount').show();
                $('#NoofPay').show();
                $('#TStarts').show();
            }

        }

        function DonatAmount() {
            var type = $('#Donate').val();
            if (type == 'Yes') {
                $('#Frequency').show();

            }
            else {
                // alert(type);
                $('#Frequency').show();
            }

        }

        function AmountChange(AAmount) {
            $('#OtherAmount').attr('readonly', 'readonly');
            if (AAmount == 'Other') {
                $('#Amount').val('');
                $('#OtherAmount').removeAttr('readonly');
            }
            else {

                var mamt = $('#TMemberAmount').val();
                AAmount = parseFloat(AAmount) + parseFloat(mamt);
                $('#MemberAmount').val(AAmount);
                $('#total').html(AAmount);
                $('#OtherAmount').val('');
            }
        }

        function OtherNewAmount() {
            var OtherAmount = $('#OtherAmount').val();

            if (OtherAmount != '') {
                var mamt = $('#TMemberAmount').val();
                OtherAmount = parseFloat(OtherAmount) + parseFloat(mamt);
                $('#MemberAmount').val(OtherAmount);
                $('#total').html(OtherAmount);
            }
        }

</script>
