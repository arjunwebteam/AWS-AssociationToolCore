<script>
   
                function addRow() {

                    var rowCount = $('.child-row').length;
                    var newRow = `<div class="child-row row gx-3  align-items-center">
                    <div class="col-md-5">
                        <fieldset class="">
                            <legend class="float-none w-auto px-1">Name</legend>
