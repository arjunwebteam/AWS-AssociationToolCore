                    <div class="col-md-2">
                        <div class="">

                            <a class="aws-remove-btn" onclick="deleteRow(this)"><i class="bi bi-trash3"></i> Remove</a>
                        </div>
                    </div>
                </div>`;
                    $('#childinfo').append(newRow);
                }

                function deleteRow(button) {
                    var row = $(button).closest('.child-row');
                    if (row.index() !== 0) { // Check if the row is not the first row
                        row.remove();
                    }
                }


   

