<script>
    function toggleVisibility() {
        var element = document.getElementById("showevents");

        if (element.style.display === "none") {
            element.style.display = "block";
            $('#showevents').show();
            $('#hideprofile').hide();
        } else {
            element.style.display = "none";
            $('#hideprofile').hide();
            $('#showevents').show();
