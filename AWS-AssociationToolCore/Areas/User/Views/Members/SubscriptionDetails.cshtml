@{
    Layout = "~/Areas/User/Views/Shared/_MainLayout.cshtml";
    string ChapterName = ViewBag.cname;
    int _qstatus = 0;
    AWS_AssociationToolCore.BLL.AppInfo _AppInfo = new AWS_AssociationToolCore.BLL.AppInfo();
    AWS_AssociationToolCore.Entities.AppInfo objAppInfo = _AppInfo.GetAppInfoDetails(ref _qstatus);
    AWS_AssociationToolCore.Entities.Members objMember  = ViewBag.objMember;
        var location = objAppInfo.BaseUrl + "Content/MemberProfileImages/";

    string subStatus  = ViewBag.SubStatus  ?? "";
    string startDate  = ViewBag.StartDate  ?? "";
    string createdAt  = ViewBag.CreatedAt  ?? "";
    string chargeAt   = ViewBag.ChargeAt   ?? "";
    string cardBrand  = ViewBag.CardBrand  ?? "";
    string cardLast4  = ViewBag.CardLast4  ?? "";
    string cardExpMonth = ViewBag.CardExpMonth ?? "";
    string cardExpYear  = ViewBag.CardExpYear  ?? "";
    string subLink    = ViewBag.SubscriptionLink ?? "";
    string subError   = ViewBag.SubError   ?? "";

    var invoices = ViewBag.Invoices as List<dynamic> ?? new List<dynamic>();

    ViewBag.Title = "Subscription Details | " + objAppInfo.SiteName + " Member Portal";
    ViewBag.PageHeading = "Subscription Details";
}
<script src="Scripts/Admin/Common.js" type="text/javascript"></script>
<!-- button list start -->

<script>
        $(document).ready(function () {
            LoadLatestNewsList();
        });

        function LoadLatestNewsList() {
            $.ajax({
                type: "GET",
                url: '@Url.Action("ProfileMenu", "Members")',
             data: {
    Type    : 'MemberInfo'

        },

            success: function (data) {
                    $("#divProfileMenuList").html(data);
                },
                error: function () {
                    $("#divProfileMenuList").html('<p class="text-danger">Failed to load events.</p>');
                }
            });
        }
</script>
<style>
/* ✅ Add these to your existing badge styles */
.badge-start-scheduled {
    background: #cce5ff;
    color: #004085;
    padding: 4px 14px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
}
.badge-paused {
    background: #d1ecf1;
    color: #0c5460;
    padding: 4px 14px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
}
.badge-scheduled {
    background: #cce5ff;   /* ✅ Blue for scheduled */
    color: #004085;
    padding: 4px 14px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
}
    .badge-active {
        background: #d4edda;
        color: #155724;
        padding: 4px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }
    .badge-scheduled {
        background: #fff3cd;
        color: #856404;
        padding: 4px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }
    .badge-cancelled {
        background: #f8d7da;
        color: #721c24;
        padding: 4px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }
    .badge-pending {
        background: #fff3cd;
        color: #856404;
        padding: 4px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }
</style>

<style>
    .profile__set {
        display: grid;
        gap: 10px;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    }
    .aws-event-box .event__box__title {
        color: #ff3f3e !important;
    }
    .sub-badge {
        padding: 4px 10px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 13px;
    }
    .sub-badge.active     { background:#d4edda; color:#155724; }
    .sub-badge.pending    { background:#fff3cd; color:#856404; }
    .sub-badge.canceled   { background:#f8d7da; color:#721c24; }
    .sub-badge.deactivated{ background:#f8d7da; color:#721c24; }
    .sub-badge.na         { background:#e2e3e5; color:#383d41; }
</style>
<style>
    .subscription-empty-state {
        background: #fee8cb;
        border-radius: 16px;
        padding: 50px 30px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.06);
        max-width: 520px;
        margin: 30px auto;
    }

    .empty-circle {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: linear-gradient(135deg, #fff3cd, #ffe69c);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        box-shadow: 0 4px 16px rgba(255, 193, 7, 0.3);
    }

    .empty-circle i {
        font-size: 38px;
        color: #e08c00;
    }

    .empty-title {
        font-size: 22px;
        font-weight: 700;
        color: #2d2d2d;
        margin-bottom: 10px;
    }

    .empty-desc {
        font-size: 14px;
        color: #6c757d;
        line-height: 1.7;
        margin-bottom: 0;
    }

    .contact-card {
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 12px;
        padding: 18px 24px;
        display: inline-flex;
        align-items: center;
        gap: 20px;
        margin: 0 auto;
    }

    .contact-item {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .contact-icon {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, #f7941d, #f0a500);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 15px;
    }

    .contact-text {
        font-size: 14px;
        font-weight: 600;
        color: #333;
    }

    .contact-divider {
        width: 1px;
        height: 36px;
        background: #dee2e6;
    }

    .btn-renew {
        background: linear-gradient(135deg, #f7941d, #f0a500);
        color: #fff;
        border: none;
        border-radius: 30px;
        padding: 12px 32px;
        font-size: 15px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        transition: all 0.3s ease;
        box-shadow: 0 4px 14px rgba(240, 165, 0, 0.35);
    }

    .btn-renew:hover {
        background: linear-gradient(135deg, #e0820d, #d49200);
        color: #fff;
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(240, 165, 0, 0.45);
    }
</style>

<div class="aws-profile-left-sec">
    <div id="divProfileMenuList">
        <div class="aws-profile-img">
            @if (objMember.ProfileImage != null && objMember.ProfileImage != "")
            {
              <img class="border-radius10 profshd" src="@(AWS_AssociationToolCore.BLL.Common.ValidateImage(location + objMember.ProfileImage, location + "no-imagefinal.jpg"))" alt="@objMember.FirstName" width="159" height="159"/>

            }
            else
            {
                <img src="Content/user/images/com-main.png"
                     alt="Profile" class="border-radius10 profshd" width="159" height="159" />
            }
        </div>
    </div>
</div>

<div class="aws-profile-right-sec">
    <div class="aws-title">
        Subscription Details
        <div class="cmn-event-btn">
        </div>
    </div>
    <div class="aws-bdr"></div>

    @* ── No Subscription ── *@

    @* ── No Subscription ── *@
 @if (string.IsNullOrEmpty(objMember.SubscriptionId))
{
    <div class="aws-profile-dashboard-sec">
        <div class="subscription-empty-state text-center py-5">
            <div class="empty-icon-wrapper mb-4">
                <div class="empty-circle">
                    <i class="bi bi-credit-card-2-front"></i>
                </div>
            </div>
            <h4 class="empty-title">No Active Subscription</h4>
            <p class="empty-desc">
                You don't have an active subscription linked to your account yet.<br />
                To get started, please renew your membership or contact us below.
            </p>
            <div class="contact-card mt-4">
                <div class="contact-item">
                    <span class="contact-icon"><i class="bi bi-telephone-fill"></i></span>
                    <span class="contact-text">@objAppInfo.CompanyPhone</span>
                </div>
                <div class="contact-divider"></div>
                <div class="contact-item">
                    <span class="contact-icon"><i class="bi bi-envelope-fill"></i></span>
                    <span class="contact-text">@objAppInfo.CompanyEmail</span>
                </div>
            </div>
            <a href="@Url.Action("MembershipRenewal", "Members", new { Area = "User", Astr = "renewal" })" class="btn btn-renew mt-4">
                <i class="bi bi-arrow-clockwise me-2"></i> Renew Membership
            </a>
        </div>
    </div>
}

    else if (!string.IsNullOrEmpty(subError))
    {
        <div class="aws-profile-dashboard-sec">
            <div class="alert alert-danger mt-3">
                <i class="bi bi-x-circle me-2"></i> @subError
            </div>
        </div>
    }
    else
    {
        <div class="aws-profile-dashboard-sec">

            @* ── Subscription Info ── *@
            <div class="row">
                <div class="aws-event-box">
                    <h5 class="event__box__title">Subscription Info</h5>
                </div>
                <div class="col-12">
                    <div class="profile__set">

                                         <!-- Status row in your view -->
<div class="receipt-row">
    <div class="aws-title4">Status :</div>
    <span class="receipt-value">
        <span class="@ViewBag.SubStatusClass">
            ● @ViewBag.SubStatus
        </span>
    </span>
</div>
@if (!string.IsNullOrEmpty(ViewBag.CancelledDate?.ToString()))
{
    <div class="receipt-row">
      <div class="aws-title4">Subscription Ends On :</div>

        <span class="receipt-value" style="color:#856404; font-weight:600;">
   
            @ViewBag.CancelledDate
        </span>
    </div>
    // <div class="receipt-row">
    //     <span class="receipt-label">Next Subscription Billing</span>
    //     <span class="receipt-value" style="color:#721c24;">
    //         Cancelled
    //     </span>
    // </div>
}

                        <div class="">
                            <div class="aws-committee-cnt veiw__title__name">
                                <div class="aws-title4">Subscription Id :</div>
                                <div class="aws-desgination">
                                    <small>@objMember.SubscriptionId</small>
                                </div>
                            </div>
                        </div>
@* ── CORRECT: Next Subscription Date using chargeAt ── *@
@if (ViewBag.StartScheduled == true)
{
    <div class="receipt-row">
        <div class="aws-title4">Next Billing Date :</div>
        <span class="receipt-value" style="color:#856404; font-weight:600;">
            <i class="bi bi-calendar-check me-1"></i>
            @ViewBag.StartDate
        </span>
    </div>
}

                    

               <div class="">
    <div class="aws-committee-cnt veiw__title__name">
        <div class="aws-title4">Subscription Created At :</div>
        <div class="aws-desgination">
            @(string.IsNullOrEmpty(createdAt) ? "N/A" : createdAt)
        </div>
    </div>
</div>
                       
                        <div class="">
                            <div class="aws-committee-cnt veiw__title__name">
                                <div class="aws-title4">Recurring Type :</div>
                                <div class="aws-desgination">Annual</div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <div class="aws-bdr mb-0"></div>

            @* ── Card Info ── *@
            <div class="row mt-3">
                <div class="aws-event-box">
                    <h5 class="event__box__title">Card Details</h5>
                </div>
                <div class="col-12">
                    <div class="profile__set">

                        <div class="">
                            <div class="aws-committee-cnt veiw__title__name">
                                <div class="aws-title4">Card :</div>
                                <div class="aws-desgination">
                                    @if (!string.IsNullOrEmpty(cardLast4))
                                    {
                                        @cardBrand @: **** **** **** @cardLast4
                                    }
                                    else
                                    {
                                        <span>N/A</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="">
                            <div class="aws-committee-cnt veiw__title__name">
                                <div class="aws-title4">Expiry :</div>
                                <div class="aws-desgination">
                                    @(string.IsNullOrEmpty(cardExpMonth)
                                        ? "N/A"
                                        : cardExpMonth + "/" + cardExpYear)
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <div class="aws-bdr mb-0"></div>
            <div class="aws-bdr mb-0"></div>

@* ── Cancel Subscription ── *@
            @if(@objMember.RecurringType 
                != "Cancelled")
            {
                         <div class="row mt-3">
    <div class="aws-event-box">
        <h5 class="event__box__title">Cancel Subscription</h5>
    </div>
    <div class="col-12">
        <div class="cancel-sub-box">
            <div class="cancel-sub-icon">
                <i class="bi bi-exclamation-circle-fill"></i>
            </div>
            <p class="cancel-sub-title">Do you wish to cancel your subscription?</p>
            <p class="cancel-sub-msg">
                If you cancel, your membership benefits will remain active until
                <strong>@(string.IsNullOrEmpty(chargeAt) ? "the end of your current billing period" : chargeAt)</strong>.
                After that, your subscription will not be renewed and access to
                membership benefits will expire. This action cannot be undone.
            </p>
            <div class="cancel-sub-btn-wrap">
                <form method="post"
                      action="@Url.Action("CancelSubscription", "Members")"
                      onsubmit="return confirm('Are you sure you want to cancel your subscription? This action cannot be undone.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="cancel-sub-btn">
                        <i class="bi bi-x-circle me-2"></i> Cancel Subscription
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>   
            }

            @* ── Invoices ── *@
            <div class="row mt-3" style="display:none;">
                <div class="aws-event-box">
                    <h5 class="event__box__title">Invoices</h5>
                </div>
                <div class="col-12">
                    @if (invoices.Count == 0)
                    {
                        <div class="alert alert-info">No invoices found.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-sm table-hover">
                                <thead style="background:#f7971e; color:#000;">
                                    <tr>
                                        <th>#</th>
                                        <th>Invoice ID</th>
                                        <th>Status</th>
                                        <th>Amount</th>
                                        <th>Issued At</th>
                                        <th>Paid At</th>
                                        <th>Link</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int i = 1; }
                                    @foreach (var inv in invoices)
                                    {
                                        <tr>
                                            <td>@i</td>
                                            <td><small>@inv.InvoiceId</small></td>
                                            <td>
                                                <span class="sub-badge @(inv.Status == "PAID" ? "active" : "pending")">
                                                    @inv.Status
                                                </span>
                                            </td>
                                            <td>USD @inv.Amount.ToString("0.00")</td>
                                            <td>@(string.IsNullOrEmpty((string)inv.IssuedAt) ? "N/A" : inv.IssuedAt)</td>
                                            <td>@(string.IsNullOrEmpty((string)inv.PaidAt)   ? "N/A" : inv.PaidAt)</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty((string)inv.InvoiceLink))
                                                {
                                                    <a href="@inv.InvoiceLink" target="_blank"
                                                       class="btn btn-xs btn-info btn-sm">
                                                        <i class="fa fa-external-link"></i> View
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span>--</span>
                                                }
                                            </td>
                                        </tr>
                                        i++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

        </div>
    }
</div>
<style>
    .cancel-sub-box {
        background: #fff8f8;
        border: 1px solid #f5c6cb;
        border-radius: 12px;
        padding: 20px 30px;        /* ✅ reduced from 35px */
        text-align: center;
        margin-top: 10px;
    }
    .cancel-sub-icon {
        font-size: 2rem;           /* ✅ reduced from 2.8rem */
        color: #fff;
        background: #dc3545;
        border-radius: 50%;
        width: 42px;               /* ✅ smaller circle */
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 10px auto;  /* ✅ centered */
    }
    .cancel-sub-title {
        font-size: 15px;           /* ✅ reduced */
        font-weight: 700;
        color: #333;
        margin-bottom: 8px;
    }
    .cancel-sub-msg {
        font-size: 13px;           /* ✅ reduced */
        color: #666;
        max-width: 550px;
        margin: 0 auto 18px auto;  /* ✅ reduced bottom margin */
        line-height: 1.6;
    }
    .cancel-sub-btn-wrap {
        display: flex;
        justify-content: center;
    }
    .cancel-sub-btn {
        background-color: #dc3545 !important;
        color: #ffffff !important;
        font-weight: 600;
        font-size: 14px;           /* ✅ slightly smaller */
        padding: 9px 30px;         /* ✅ reduced padding */
        border-radius: 50px;
        border: none !important;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: background 0.2s;
    }
    .cancel-sub-btn:hover {
        background-color: #b02a37 !important;
        color: #fff !important;
    }
</style>