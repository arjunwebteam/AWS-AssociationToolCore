@{
    Layout = "~/Areas/User/Views/Shared/_MainLayout.cshtml";

    var objMembers = (AWS_AssociationToolCore.Entities.Members)ViewBag.objMembers;
    var lstMembershipType = (List<AWS_AssociationToolCore.Entities.MembershipTypes>)objMembers.lstMembershipType;
    var lstPaymentMethod = (List<AWS_AssociationToolCore.Entities.PaymentMethods>)objMembers.lstPaymentMethod;
    var lstPaymentStatus = (List<AWS_AssociationToolCore.Entities.PaymentStatus>)objMembers.lstPaymentStatus;
    ViewBag.PageHeading = "Membership";

    int status = 0;
    AWS_AssociationToolCore.BLL.AppInfo _AppInfo = new AWS_AssociationToolCore.BLL.AppInfo();
    AWS_AssociationToolCore.Entities.AppInfo objAppInfo = new AWS_AssociationToolCore.Entities.AppInfo();
    objAppInfo = _AppInfo.GetAppInfoDetails(ref status);

    var capcha = objAppInfo.ShowCapcha;
    List<AWS_AssociationToolCore.Entities.Chapters> lstChapters = ViewBag.lstChapters;
    string cname = ViewBag.cname ?? "";
    Int64 ChapterId = ViewBag.ChapterId;

    int status2 = 0;
    AWS_AssociationToolCore.BLL.PaymentSettings _paymentSettings = new AWS_AssociationToolCore.BLL.PaymentSettings();
    AWS_AssociationToolCore.Entities.PaymentSettings objPaymentSettings = _paymentSettings.GetPaymentSettingsDetails(0, "PayPal", ref status2);

    string firstPaymentMethod = (lstPaymentMethod != null && lstPaymentMethod.Count > 0)
        ? lstPaymentMethod[0].PaymentMethod : "PayPal";
}

<script src="https://www.google.com/recaptcha/api.js" async defer></script>
<script src="https://www.paypal.com/sdk/js?client-id=@objPaymentSettings.PaymentUrl&components=buttons"></script>
<link href="content/user/css/magnific-popup.min.css" rel="stylesheet" />
<script>
    var actionStatus = null;
    var cnameValue = '@Html.Raw(cname)';
    var squareCard = null;
    var SQUARE_APP_ID = null;
    var SQUARE_LOCATION_ID = null;
    var SQUARE_ENV = null;
    var squarePrePaymentDone = false;
    var squarePrePaymentInProgress = false;

    // ================================================================
    // UTILITY HELPERS
    // ================================================================
    function onlyAlphabets(e) {
        var c = e.which || e.keyCode;
        return c === 32 || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || [8, 9, 46, 37, 39].indexOf(c) !== -1;
    }

    function formatPhone(val) {
        var ph = val.replace(/\D/g, '');
        if (ph.length > 6) return ph.slice(0, 3) + '-' + ph.slice(3, 6) + '-' + ph.slice(6, 10);
        if (ph.length > 3) return ph.slice(0, 3) + '-' + ph.slice(3);
        return ph;
    }

    function bindspouse() {
        var type = $('#MaritalStatus').val();
        if (type === 'Married') {
            $('#showspouse').show();
            $('#showchidinfo').show();
        } else {
            $('#showspouse').hide();
            $('#showchidinfo').hide();
        }
    }

    function awsAddRow() {
        var rowCount = $('.child-row').length;
        var newRow = '<div class="child-row row gx-3 align-items-center">' +
            '<div class="col-md-5"><fieldset><legend class="float-none w-auto px-1">Name</legend>' +
            '<input class="input-box" type="text" name="[' + rowCount + '].FirstName" placeholder="Name"></fieldset></div>' +
            '<div class="col-md-2"><fieldset><legend class="float-none w-auto px-1">Age</legend>' +
            '<input class="input-box numberkey" type="text" maxlength="2" name="[' + rowCount + '].Age" placeholder="Age"></fieldset></div>' +
            '<div class="col-md-2"><a class="aws-remove-btn" onclick="deleteRow(this)"><i class="bi bi-trash3"></i> Remove</a></div>' +
            '</div>';
        $('#childinfo').append(newRow);
    }

    function deleteRow(btn) {
        if ($('.child-row').length > 1) $(btn).closest('.child-row').remove();
    }

    function resetSquareState() {
        squareCard = null;
        squarePrePaymentDone = false;
        squarePrePaymentInProgress = false;
        var btnProceed = document.getElementById("btnProceedPay");
        if (btnProceed) {
            btnProceed.style.display = "inline-block";
            btnProceed.disabled = false;
            btnProceed.innerText = "Proceed to Pay";
        }
        var cardBtn = document.getElementById("card-button");
        if (cardBtn) cardBtn.style.display = "none";
        var container = document.getElementById("card-container");
        if (container) container.innerHTML = "";
    }

    async function initializeSquareCard() {
        if (squareCard) return;

        if (!SQUARE_APP_ID || !SQUARE_LOCATION_ID) {
            try {
                var result = await $.ajax({
                    url: '@Url.Action("GetSquareSettings", "Services")',
                    type: 'POST',
                    dataType: 'json'
                });

                if (typeof result === 'string') result = JSON.parse(result);

                if (!result.ok || !result.data.AppId || !result.data.LocationId) {
                    throw new Error(result.message || "Square is not configured correctly.");
                }

                SQUARE_APP_ID = result.data.AppId;
                SQUARE_LOCATION_ID = result.data.LocationId;
                SQUARE_ENV = result.data.Mode;
            } catch (err) {
                console.error("Square init error:", err);
                throw err;
            }
        }

        if (typeof Square === "undefined") {
            var scriptUrl = SQUARE_ENV === "Test"
                ? "https://sandbox.web.squarecdn.com/v1/square.js"
                : "https://web.squarecdn.com/v1/square.js";
            await loadScript(scriptUrl);
        }

        var payments = Square.payments(SQUARE_APP_ID, SQUARE_LOCATION_ID);
        squareCard = await payments.card();
        await squareCard.attach("#card-container");
    }

    function loadScript(src) {
        return new Promise(function (resolve, reject) {
            if (document.querySelector("script[src='" + src + "']")) {
                resolve();
                return;
            }
            var s = document.createElement("script");
            s.src = src;
            s.onload = resolve;
            s.onerror = reject;
            document.head.appendChild(s);
        });
    }

    // ================================================================
    // GET MEMBERSHIP AMOUNT
    // ================================================================
    function getamount(mid) {
        var membershipid = (mid != null && mid != 0) ? mid : $('input[name="MembershipTypeId"]:checked').val();
        if (!membershipid) return;

        $.ajax({
            url: '@Url.Action("GetMemberAmount", "Members")',
            type: 'POST',
            data: { MembershipTypeId: membershipid },
            dataType: 'json',
            success: function (result) {
                if (typeof result === 'string') result = JSON.parse(result);
                if (result.ok) {
                    var t = result.data;
    $('#payamount,#totalamountzelle,#totalstripe,#totalswirepay,#totalamountcash').html(t.Price + '.00');
    $('#creditamount').html('$' + t.Price + '.00');      
$('#MemberAmount').val(t.Price).trigger('change');
                    $('#creditamount').val(t.Price).trigger('input');
                    $('#MembershipType').val(t.MembershipType);
                    $('#MembershipType1').val(t.MembershipType + '###' + t.Price);

                    $(document).trigger("amount-updated");

                    // Enable PayPal if ready
                    setTimeout(function () {
                        paypalReadyCheck();
                    }, 100);
                }
            }
        });
    }

    // ================================================================
    // PAYMENT SETTINGS
    // ================================================================
    function paymentsettings(type) {
        $.ajax({
            url: '@Url.Action("GetPayment", "Members")',
            type: 'POST',
            data: { PaymentMethod: type },
            dataType: 'json',
            success: function (result) {
                if (typeof result === 'string') result = JSON.parse(result);
                if (result.ok) {
                    var s = result.data;
                    $('#PaymentUrl,#PaymentUrl1,#PaymentUrl2,#PaymentUrl3,#PaymentUrl4').html(s.PaymentUrl);
                    $('#SuccessUrl').html(s.SuccessUrl);
                }
            }
        });
    }

    // ================================================================
    // PAYPAL READY CHECK - FIXED
    // ================================================================
    function paypalReadyCheck() {
        var amount = $('#MemberAmount').val();
        var isValidAmount = amount && parseFloat(amount) > 0;
        
        // Check if form is valid without triggering validation errors
        var form = $('#SignupForm');
        var isValid = true;
        
        // Check required fields manually
        var requiredFields = ['FirstName', 'LastName', 'Email', 'MobilePhone', 
                             'Password', 'ConfPassword', 'Address', 'State', 'City'];
        
        $.each(requiredFields, function(i, field) {
            var val = $('#' + field).val();
            if (!val || val.trim() === '') {
                isValid = false;
                return false;
            }
        });
        
        // Check email format
        var email = $('#Email').val();
        if (email && !isValidEmail(email)) {
            isValid = false;
        }
        
        // Check membership type
        if (!$('input[name="MembershipTypeId"]:checked').val()) {
            isValid = false;
        }

        var isReady = isValidAmount && isValid;

        if (actionStatus) {
            try {
                if (isReady) {
                    actionStatus.enable();
                } else {
                    actionStatus.disable();
                }
            } catch (e) {
                console.log('PayPal actions not available yet');
            }
        }
        return isReady;
    }

    function isValidEmail(email) {
        var re = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
        return re.test(email);
    }

    // ================================================================
    // CHEQUE HANDLERS
    // ================================================================
    function hideCheque() {
        $('#cheque-show').show();
        $('.cheque-hide').hide();

        var validator = $('#SignupForm').data('validator');
        if (validator) {
            $("#ChequeHolderName").rules("remove");
            $("#file2").rules("add", {
                required: true,
                validImageExtension: true
            });
            validator.settings.ignore = ':hidden:not(#file2):not(#recaptchaResponse)';
            validator.resetForm();
            $('.has-error').removeClass('has-error');
            $('.has-success').removeClass('has-success');
        }
    }

    function ShowCheque() {
        $('#cheque-show').hide();
        $('.cheque-hide').show();

        var validator = $('#SignupForm').data('validator');
        if (validator) {
            $("#file2").rules("remove");
            validator.settings.ignore = ':hidden:not(#recaptchaResponse)';
            $("#ChequeHolderName").rules("add", {
                required: true,
                messages: { required: 'Please enter the name of the person' }
            });
            validator.resetForm();
            $('.has-error').removeClass('has-error');
            $('.has-success').removeClass('has-success');
        }
    }

    // ================================================================
    // PAYMENT BIND - SINGLE DEFINITION (FIXED)
    // ================================================================
    function paymentbind(type) {
        console.log('paymentbind called with type:', type);

        var validator = $('#SignupForm').data('validator');
        if (validator) {
            validator.settings.ignore = ':hidden:not(#recaptchaResponse)';
        }

        // ── Teardown Braintree when switching away from Credit Card ──
        if (type !== "Credit Card" && window.dropinInst) {
            try {
                window.dropinInst.teardown(function () {
                    window.dropinInst = null;
                    console.log('Braintree torn down');
                });
            } catch (e) {}
            $('#dropin-container').hide().empty();
        }

        // ── Reset square state ──
        if (type !== "Square") {
            resetSquareState();
        }

        // ── Show/hide buttons based on payment type ──
        if (type === "PayPal") {
            $('#paypalbuttonshow').show();
            $('#paypal-button-container').show();
            $('#button-show').hide();
            $('#submit-button').hide();
            $('#dropin-container').hide();
            $('#proceedtopay').hide();
            $('#btnProceedPay').hide();
            $('#card-button').hide();
        } else if (type === "Square") {
            $('#paypalbuttonshow').hide();
            $('#paypal-button-container').hide();
            $('#button-show').hide();
            $('#submit-button').hide();
            $('#dropin-container').hide();
            $('#proceedtopay1').hide();
            $('#proceedtopay').hide();
            $('#submitbtn').hide();
            $('#btnCashProceed').hide();
            $('#btnZelleProceed').hide();
            $('#btnProceedPay').show().prop('disabled', false).text('Proceed to Pay');
            $('#card-button').hide();
            $('#hidebutton').hide();
            $('#square-timer-display').hide();
        } else if (type === "Credit Card") {
            $('#button-show').show();
            $('#submit-button').show();
            $('#paypalbuttonshow').hide();
            $('#paypal-button-container').hide();
            $('#dropin-container').show();
        } else {
            $('#button-show').show();
            $('#submit-button').show();
            $('#paypalbuttonshow').hide();
            $('#paypal-button-container').hide();
            $('#dropin-container').hide();
        }

        $('#PaymentMethod').val(type);

        // ── Handle validation rules ──
        if (validator) {
            // Remove ALL conditional rules first
            $("#CardNumber, #CardName, #Cvv, #CSVYear, #CSVMonth").rules("remove");
            $("#Zelle, #ZellePartnerName, #filezelle").rules("remove");
            $("#file2").rules("remove");
            $("#ChequeHolderName").rules("remove");

            // Reset cheque UI
            $('#Mailed-1').prop('checked', true);
            $('#cheque-show').show();
            $('.cheque-hide').hide();

            // Add rules based on selected payment type
            if (type === "AuthorizeNet") {
                $("#CardNumber").rules("add", { required: true });
                $("#CardName").rules("add", { required: true });
                $("#Cvv").rules("add", { required: true });
                $("#CSVYear").rules("add", { required: true });
                $("#CSVMonth").rules("add", { required: true });
            } else if (type === "Credit Card") {
                var amount = parseFloat($('#MemberAmount').val());
                if (!amount || isNaN(amount) || amount < 5) {
                    alert("Please select a membership type with a valid amount first.");
                    paymentbind('PayPal');
                    return;
                }
                function tryInitBT() {
                    if (typeof window.startBraintree === "function") {
                        if (!window.dropinInst) {
                            window.startBraintree();
                        }
                    } else {
                        setTimeout(tryInitBT, 200);
                    }
                }
                tryInitBT();
            } else if (type === "Zelle") {
                $("#Zelle").rules("add", { required: true });
                $("#ZellePartnerName").rules("add", { required: true });
                $("#filezelle").rules("add", {
                    required: true,
                    validImageExtension: true
                });
            } else if (type === "Cash/Cheque") {
                paymentsettings(type);
                $("#file2").rules("add", {
                    required: true,
                    validImageExtension: true
                });
                validator.settings.ignore = ':hidden:not(#file2):not(#recaptchaResponse)';
            }

            // Clear all error states
            validator.resetForm();
            $('.has-error').removeClass('has-error');
            $('.has-success').removeClass('has-success');
        }

        // ── Activate correct tab panel ──
        var cleanedTabId = "tab" + type.toLowerCase().replace(/[^a-z0-9\s]/g, '').trim().replace(/\s+/g, '-');
        $('.cus-tab-pane').removeClass('active').hide();
        $('#' + cleanedTabId).addClass('active').show();

        $('.cus-tab-label').removeClass('active');
        $('.cus-tab-label[value="' + type + '"]').addClass('active');
    }

    // ================================================================
    // RECAPTCHA SUCCESS
    // ================================================================
    // function onRecaptchaSuccess(token) {
    //     $('#recaptchaResponse').val(token);
    //     $('#recaptchaResponse').valid();
    // }

    // ================================================================
    // DOCUMENT READY - MAIN INITIALIZATION
    // ================================================================
    $(document).ready(function () {

        // ── Phone formatting ──
        $('#MobilePhone, #SpouseCell').on('input', function () {
            $(this).val(formatPhone($(this).val()));
        });

        // ── Card number spacing ──
        $('#CardNumber').on('input', function () {
            var v = $(this).val().replace(/\D/g, '');
            if (v.length > 0) v = v.match(/.{1,4}/g).join(' ');
            $(this).val(v);
        });

        // ── CVV numbers only ──
        $('#Cvv').on('input', function () {
            $(this).val($(this).val().replace(/\D/g, ''));
        });

        // ── Custom image extension validator ──
        $.validator.addMethod('validImageExtension', function (value, element) {
            if (element.files && element.files.length > 0) {
                var ext = element.files[0].name.split('.').pop().toLowerCase();
                return ['jpg', 'png', 'gif', 'jpeg'].indexOf(ext) !== -1;
            }
            return true;
        }, 'Only allowed extensions are: jpg, png, gif, jpeg');

        // ── Load initial membership amount ──
        setTimeout(function () {
            getamount(null);
        }, 500);

        // ── Tab switch detection ──
        $(document).on("click", ".cus-tab-label", function () {
            var clickedTab = $(this).data("tab");
            var currentMethod = $("#PaymentMethod").val();
            if (currentMethod === "Square" && clickedTab !== "tabsquare") {
                resetSquareState();
            }
        });

        // ── FORM VALIDATION ──
        var validator = $('#SignupForm').validate({
            ignore: ':hidden:not(#recaptchaResponse)',
            rules: {
                FirstName: { required: true },
                LastName: { required: true },
                gender: { required: true },
                MaritalStatus: { required: true },
                Email: {
                    required: true,
                    email: true,
                    remote: {
                        type: 'POST',
                        url: '@Url.Action("CheckEmailAvailability", "Members")',
                        dataType: 'json',
                        data: { Email: function () { return $('#Email').val().trim(); } },
                        dataFilter: function (response) {
                            var r = JSON.parse(response);
                            return r.data === true ? 'true' : 'false';
                        }
                    }
                },
                MobilePhone: { required: true },
                ZipCode: { digits: true, minlength: 5, maxlength: 6 },
                Password: { required: true },
                ConfPassword: { required: true, minlength: 5, equalTo: '#Password' },
                Address: { required: true, minlength: 5 },
                State: { required: true },
                City: { required: true },
                MembershipTypeId: { required: true },
                SpouseEmail: { email: true }
                // recaptcha: {
                //     required: function () {
                //         var showCapcha = 'capcha';
                //         return showCapcha === 'Yes' && $("#recaptchaResponse").val().trim() === "";
                //     }
                // }
            },
            messages: {
                FirstName: 'Please enter your First Name',
                LastName: 'Please enter your Last Name',
                MaritalStatus: 'Please Select Marital Status',
                gender: 'Please Select gender',
                Email: {
                    required: 'Please enter email address',
                    email: 'Please enter valid email address',
                    remote: 'This email address is already in use.'
                },
                MobilePhone: 'Please enter phone number',
                ZipCode: { digits: 'Please enter only numeric characters', maxlength: 'ZipCode must be exactly 6 digits' },
                Password: { required: 'Please provide a password' },
                ConfPassword: { required: 'Please confirm your password', minlength: 'At least 5 characters', equalTo: 'Passwords do not match' },
                Address: { required: 'Please enter address', minlength: 'At least 5 characters' },
                State: { required: 'Please select State' },
                City: { required: 'Please enter city' },
                MembershipTypeId: { required: 'Please select membership type' }
                // recaptcha: { required: 'Please confirm that you are not a robot.' }
            },
            errorElement: 'em',
            errorPlacement: function (error, element) {
                error.addClass('help-block');
                if (element.prop('type') === 'checkbox') {
                    error.insertAfter(element.parent('label'));
                } else if (element.attr('name') === 'recaptcha') {
                    error.insertAfter('.g-recaptcha');
                } else {
                    error.insertAfter(element);
                }
            },
            highlight: function (element) {
                $(element).parents('fieldset').addClass('has-error').removeClass('has-success');
            },
            unhighlight: function (element) {
                $(element).parents('fieldset').addClass('has-success').removeClass('has-error');
            }
        });

        // ── SUBMIT BUTTON HANDLER ──
        $('#submit-button').on('click', function (e) {
            e.preventDefault();

            var form = $('#SignupForm');
            var paymentMethod = $('#PaymentMethod').val();

            if (paymentMethod === 'Credit Card') {
                if (!form.valid()) {
                    var $firstError = $('#SignupForm em.help-block:visible').first();
                    if ($firstError.length) {
                        $('html, body').animate({
                            scrollTop: $firstError.offset().top - 100
                        }, 500);
                    }
                    return;
                }

                if (!window.dropinInst) {
                    alert('Payment form not ready. Please wait and try again.');
                    return;
                }

                if (!window.dropinInst.isPaymentMethodRequestable()) {
                    alert('Please fill in your card details before submitting.');
                    return;
                }

                var btn = document.getElementById('submit-button');
                btn.disabled = true;
                btn.innerText = 'Processing...';

                window.dropinInst.requestPaymentMethod(function (err, payload) {
                    if (err) {
                        btn.disabled = false;
                        btn.innerText = 'Submit';
                        alert('Card error: ' + err.message);
                        return;
                    }

                    $('#nonce').val(payload.nonce);
                    $('<input>').attr({
                        type: 'hidden',
                        name: 'ClientValidationStatus',
                        value: 'true'
                    }).appendTo(form);

                    form.submit();
                });
                return;
            }

            // Non-Credit-Card methods
            if (!form.valid()) {
                var $firstError = $('#SignupForm em.help-block:visible').first();
                if ($firstError.length) {
                    $('html, body').animate({
                        scrollTop: $firstError.offset().top - 100
                    }, 500);
                }
                return;
            }

            var btn = document.getElementById('submit-button');
            btn.disabled = true;
            btn.innerText = 'Processing...';

            $('<input>').attr({
                type: 'hidden',
                name: 'ClientValidationStatus',
                value: 'true'
            }).appendTo(form);

            form.submit();
        });

        // ── PROCEED TO PAY BUTTON (SQUARE) ──
        $("#btnProceedPay").on("click", async function () {
            var paymentMethod = $("#PaymentMethod").val();
            if (paymentMethod !== "Square") return;

            if (!$("#SignupForm").valid()) {
                $("#SignupForm").validate().form();
                $('html, body').animate({
                    scrollTop: $("em.help-block:first").offset().top - 100
                }, 500);
                return;
            }

            var amount = $("#MemberAmount").val();
            if (!amount || parseFloat(amount) <= 0) {
                alert("⚠️ Please enter a donation amount.");
                return;
            }

            var btn = document.getElementById("btnProceedPay");

            if (squarePrePaymentDone) {
                btn.style.display = "none";
                document.getElementById("card-button").style.display = "inline-block";
                return;
            }

            if (squarePrePaymentInProgress) return;

            squarePrePaymentInProgress = true;
            btn.disabled = true;
            btn.innerText = "Loading payment form...";

            try {
                await initializeSquareCard();
                squarePrePaymentDone = true;
                document.getElementById("card-button").style.display = "inline-block";
                btn.style.display = "none";
            } catch (err) {
                btn.disabled = false;
                btn.innerText = "Proceed to Pay";
                squarePrePaymentInProgress = false;
                alert("❌ Error loading payment form: " + (err.message || "Unexpected error."));
                console.error("Square init error:", err);
            }
        });

        // ── SQUARE PAY BUTTON ──
        $("#card-button").on("click", async function () {
            if (!squareCard) {
                alert("Card form not ready. Please try again.");
                return;
            }

            var btn = this;
            btn.disabled = true;
            btn.innerText = "Processing...";

            try {
                var result = await squareCard.tokenize();
                if (result.status === "OK") {
                    $("#SquareNonce").val(result.token);
                    btn.innerText = "Processing payment...";
                    document.getElementById("SignupForm").submit();
                } else {
                    btn.disabled = false;
                    btn.innerText = "Pay";
                    var errors = result.errors
                        ? result.errors.map(function (e) { return e.message; }).join(", ")
                        : "Unknown error";
                    alert("⚠️ Card error: " + errors);
                }
            } catch (err) {
                btn.disabled = false;
                btn.innerText = "Pay";
                alert("❌ Error processing payment: " + (err.message || "Unexpected error"));
            }
        });

        // ── Show/hide PayPal container based on MemberAmount ──
        $('#MemberAmount').on('input', function () {
            if ($(this).val() && parseFloat($(this).val()) > 0) {
                $('#paypal-button-container').show();
                paypalReadyCheck();
            } else {
                $('#paypal-button-container').hide();
            }
        });

        // ── PAYPAL SDK ──
        if (typeof paypal !== 'undefined') {
            paypal.Buttons({
                fundingSource: paypal.FUNDING.PAYPAL,
                style: { layout: 'horizontal', color: 'blue', shape: 'pill', label: 'pay', height: 40 },

                onInit: function (data, actions) {
                    actionStatus = actions;
                    // Disable by default, will be enabled by paypalReadyCheck
                    actions.disable();

                    if ($('#PaymentMethod').val() === 'PayPal') {
                        $('#paypalbuttonshow').show();
                        $('#paypal-button-container').show();
                        $('#button-show').hide();
                    }

                    var debounceTimer;
                    $('#SignupForm').on('change keyup', function () {
                        clearTimeout(debounceTimer);
                        debounceTimer = setTimeout(function () {
                            paypalReadyCheck();
                        }, 300);
                    });

                    // Initial check after form is ready
                    setTimeout(function () {
                        paypalReadyCheck();
                    }, 1000);
                },

                onClick: function (data, actions) {
                    if (!$('#SignupForm').valid()) {
                        var $firstError = $('#SignupForm em.help-block:visible').first();
                        if ($firstError.length) {
                            $('html, body').animate({
                                scrollTop: $firstError.offset().top - 100
                            }, 500);
                        }
                        return actions.reject();
                    }
                    var amount = $('#MemberAmount').val();
                    if (!amount || parseFloat(amount) <= 0) {
                        var $membershipSection = $('input[name="MembershipTypeId"]').first().closest('fieldset');
                        if ($membershipSection.length) {
                            $('html, body').animate({
                                scrollTop: $membershipSection.offset().top - 100
                            }, 500);
                        }
                        return actions.reject();
                    }
                    return actions.resolve();
                },

                createOrder: function (data, actions) {
                    var amount = $('#MemberAmount').val();
                    var membershipTypeValue = $('#MembershipType1').val();
                    var item = membershipTypeValue.split('###');

                    return actions.order.create({
                        purchase_units: [{
                            amount: { currency_code: 'USD', value: amount },
                            description: item[0] || "Membership",
                            custom_id: $('#MembershipType1').val()
                        }],
                        application_context: { shipping_preference: 'NO_SHIPPING' }
                    });
                },

                onApprove: function (data, actions) {
                    return actions.order.capture().then(function (details) {
                        var transactionId = details.id;
                        var amount = details.purchase_units[0].amount.value;
                        var status = details.status;
                        var payerName = details.payer.name.given_name + ' ' + details.payer.name.surname;
                        var payerEmail = details.payer.email_address;

                        if (status === 'COMPLETED') {
                            $('#TransactionId').val(transactionId);
                            $('#PaymentAmount').val(amount);
                            $('#PaymentStatus').val(status);
                            $('#PayerName').val(payerName);
                            $('#PayerEmail').val(payerEmail);

                            $('#payment-status').html('<div class="alert alert-success">Payment completed! Submitting registration...</div>');
                            $('#paypal-button-container').hide();

                            var formData = new FormData(document.getElementById('SignupForm'));
                            $.ajax({
                                url: '@Url.Action("AddMember", "Members", new { area = "User" })',
                                type: 'POST',
                                data: formData,
                                processData: false,
                                contentType: false,
                                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                                success: function (response) {
                                    if (response && response.redirectUrl) {
                                        window.location.href = response.redirectUrl;
                                    } else {
                                        window.location.href = '@Url.Action("Acknowledgement", "Members", new { area = "User" })' +
                                            '?MemberId=' + ($('#ddMembersId').val() || 0) +
                                            '&cname=' + encodeURIComponent(cnameValue);
                                    }
                                },
                                error: function (xhr) {
                                    console.error('Submit error:', xhr.status, xhr.responseText);
                                    $('#payment-status').html('<div class="alert alert-danger">Submission failed. Payment captured. Transaction ID: ' + transactionId + '</div>');
                                }
                            });
                        } else {
                            $('#payment-status').html('<div class="alert alert-warning">Payment status: ' + status + '</div>');
                        }
                    }).catch(function (err) {
                        console.error('Capture error:', err);
                        $('#payment-status').html('<div class="alert alert-danger">Error: ' + err.message + '</div>');
                    });
                },

                onError: function (err) {
                    console.error('PayPal Error:', err);
                    $('#payment-status').html('<div class="alert alert-danger">PayPal error: ' + (err.message || 'Unknown error') + '</div>');
                },

                onCancel: function () {
                    $('#payment-status').html('<div class="alert alert-info">Payment was cancelled.</div>');
                }

            }).render('#paypal-button-container');
        } else {
            console.error('PayPal SDK not loaded.');
        }

        // ── Init first payment method tab ──
        var firstMethod = '@firstPaymentMethod';
        if (firstMethod) {
            setTimeout(function () {
                paymentbind(firstMethod);
            }, 500);
        }

        // ── File validation triggers ──
        $(document).on('change', '#file2', function () {
            if ($(this).val()) {
                $(this).valid();
            }
        });

        $(document).on('change', '#filezelle', function () {
            if ($(this).val()) {
                $(this).valid();
            }
        });
          DynamicCustomFields.wireValidation('#SignupForm', '.dynamic-custom-fields');

    }); // end document.ready
</script>

