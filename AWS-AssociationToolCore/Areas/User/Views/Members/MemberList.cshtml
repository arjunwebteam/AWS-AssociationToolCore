            <input type="reset" value="Clear" class="btn btn-danger px-3 mt-3 font14" onclick="ClearSearch();" style="background-color: #756b6b;border: 1px solid#756b6b;">
                        </div>
                        <article class="clearfix t-p20" id="divMemberDetails">
@*                             @{Html.RenderAction("FEMembersList", "Members");}
 *@                        </article>
                    </div>
