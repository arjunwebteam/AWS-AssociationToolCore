    <input type="hidden" id="Honeypot" name="Honeypot" />
    <input type="hidden" id="MType" value="" />
    <input type="hidden" id="RecurringType" name="RecurringType" value="Yearly" />

    <div class="aws-form">
        <div class="row gx-3">

            <!-- First Name -->
            <div class="col-md-6">
                <div class="pos-relative">
                    <fieldset>
                        <legend class="float-none w-auto px-1">First Name <span class="input-imp">*</span></legend>
                        <input class="input-box" type="text" onkeypress="return onlyAlphabets(event,this);"
                               name="FirstName" id="FirstName" value="@objMemberDetails.FirstName" placeholder="First Name">
                    </fieldset>
                </div>
            </div>

            <!-- Last Name -->
            <div class="col-md-6">
                <div class="pos-relative">
                    <fieldset>
                        <legend class="float-none w-auto px-1">Last Name <span class="input-imp">*</span></legend>
                        <input class="input-box" type="text" onkeypress="return onlyAlphabets(event,this);"
                               name="LastName" id="LastName" value="@objMemberDetails.LastName" placeholder="Last Name">
                    </fieldset>
                </div>
            </div>

            <div class="col-md-12"><div class="dot-line mb-3"></div></div>

            <!-- Membership Type — SINGLE block, no duplicate -->
            <div class="col-md-12">
                <fieldset class="h-auto">
                    <legend class="float-none w-auto px-1">Membership Type <span class="input-imp">*</span></legend>
                    <div class="row radio-btn-group">
                        @if (lstMembershipType != null)
                        {
                            int i = 1;
                            foreach (var item in lstMembershipType)
                            {
                                  var yesOptions = (i == 1 ? new { @checked = "checked" } : null);
                                if (item.MembershipType != "Committees" && item.MembershipType != "Committe" && item.MembershipType != "Cultural Admin")
                                {
                                    <div class="col-md-6">
                                        <div class="radio-btn">
                                            <input type="radio" name="MembershipTypeId" @(item.MembershipTypeId == objMemberDetails.MembershipTypeId ? "checked='checked'" : "") onclick="getamount(@item.MembershipTypeId); validatespouse('@item.MembershipType');" id="MembershipTypeId-@i" value="@item.MembershipTypeId" />

@*                                             <input type="radio" name="MembershipTypeId"@(item.MembershipTypeId == objMemberDetails.MembershipTypeId ? "checked='checked'" : "")onclick="getamount(@item.MembershipTypeId); validatespouse('@item.MembershipType');"id="MembershipTypeId-@i" value="@item.MembershipTypeId" />
 *@                                            <label for="MembershipTypeId-@i">
                                                <strong>@item.MembershipType</strong>
                                                (@(item.Price == 0 ? "Free" : "$" + Math.Round(item.Price, 0)))
                                            </label>
                                        </div>
                                    </div>
                                    i++;
                                }
                            }
                        }
                    </div>
                </fieldset>
            </div>

            <div id="MemberDiscounttxt" style="display:none;" class="col-md-12 mt-2"></div>

            <div class="col-md-12"><div class="dot-line my-3"></div></div>

            <!-- Payment Method -->
            <div class="col-md-12">
                <fieldset class="h-auto">
                    <legend class="float-none w-auto px-1">Payment Method <span class="input-imp">*</span></legend>
                    <div class="payment-mode">
                        <div class="cus-tabs-container">
                            <div class="cus-tabs-nav">
                                @if (lstPaymentMethod != null && lstPaymentMethod.Count != 0)
                                {
                                    int k = 1;
                                    foreach (var item in lstPaymentMethod)
                                    {
                                        string tab = "tab" + item.PaymentMethod.ToLower().Replace(" ", "-");
                                        <input type="text"
                                               class="cus-tab-label @(k == 1 ? "active" : "")"
                                               onclick="paymentbind('@item.PaymentMethod');"
                                               data-tab="@tab"
                                               value="@item.PaymentMethod"
                                               readonly>
                                        k++;
                                    }
                                }
                            </div>

                            <div class="cus-tabs-content mt-3" style="margin-inline:5px;">

                                <!-- PayPal Tab -->
                                <div id="tabpaypal" class="cus-tab-pane" style="display:none;">
                                    <div class="paypal-sec paymnet-cmn-sec">
                                        <div class="row gy-2">
                                            <div class="col-md-8">
                                                <img src="Content/User/images/paypal.png" class="img-fluid" alt="" style="height:80px;">
                                            </div>
                                            <div class="col-md-4">
                                                <div class="member-amount">
                                                    <div class="aws-amount-total">Total Amount</div>
                                                    <span id="payamount" class="aws-amount">0.00</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Square Tab -->
                                <div id="tabsquare" class="cus-tab-pane" style="display:none;">
                                    <div class="credi-card-sec paymnet-cmn-sec">
                                        <div class="row justify-content-end form-row">
                                            <div class="col-md-12">
                                                <div class="card-payment-details d-flex flex-wrap justify-content-between">
                                                    <div class="cus-sub-head">Payment details</div>
                                                    <div><img src="Content/User/images/creditcards-acceptable.png" alt=""></div>
                                                </div>
                                                <div class="row form-row-2">
                                                    <div id="card-container"></div>
                                                </div>
                                            </div>
                                            <div class="col-md-8">
                                                <p class="mb-0 font15 text-black mt-3">We do not store any credit card information.</p>
                                                <p class="mb-0"><i class="fa fa-lock" style="color:#ffa327;"></i> Payments securely processed by Square.</p>
                                            </div>
                                            <div class="col-md-4">
                                                <div style="text-align:center; min-width:160px;">
                                                    <div style="font-size:13px; font-weight:600; color:#555; margin-bottom:4px;">Total Amount</div>
                                                    <span id="creditamount" class="grandtotal" style="display:block; font-size:20px; font-weight:bold; color:#fff; background:#f3a620; padding:10px 20px; border-radius:6px; text-align:center; min-width:150px;">Amount</span>
                                                </div>
                                            </div>
                                            <div id="square-timer-display" style="display:none;"></div>
                                            <div class="mt-3">
                                                <button id="btnProceedPay" type="button" class="cmn-form-btn" style="float:right;">Proceed to Pay</button>
                                            </div>
                                            <div class="mt-2">
                                                <button id="card-button" type="button" class="cmn-form-btn" style="display:none; float:right;">Pay</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Credit Card Tab (Braintree) -->
                                <div id="tabcredit-card" class="cus-tab-pane" style="display:none;">
                                    <div class="paymnet-cmn-sec"></div>
                                </div>
                                <script>
                                    $(document).ready(function () {
                                        $.ajax({
                                            type: "GET",
                                            url: '@Url.Action("BrainTree", "BrainTreePayment", new { area = "User" })',
                                            success: function (data) {
                                                $("#tabcredit-card").html(data);
                                                console.log("Braintree partial loaded (Renewal).");
                                            },
                                            error: function () {
                                                $("#tabcredit-card").html('<p class="text-danger">Failed to load payment form.</p>');
                                            }
                                        });
                                    });
                                </script>

                                <!-- AuthorizeNet Tab -->
                                <div id="tabauthorizenet" class="cus-tab-pane" style="display:none;">
                                    <div class="credi-card-sec paymnet-cmn-sec">
                                        <div class="row justify-content-end form-row">
                                            <div class="col-md-12">
                                                <div class="card-payment-details d-flex flex-wrap justify-content-between">
                                                    <div class="cus-sub-head">Payment details</div>
                                                    <div><img src="Content/User/images/creditcards-acceptable.png" alt=""></div>
                                                </div>
                                                <div class="row form-row-2">
                                                    <div class="col-md-6">
                                                        <fieldset>
                                                            <legend class="float-none w-auto px-1">Card <span class="input-imp">*</span></legend>
                                                            <input class="input-box" type="text" id="CardNumber" maxlength="19" name="CardNumber" placeholder="Card Number">
                                                        </fieldset>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <fieldset>
                                                            <legend class="float-none w-auto px-1">Card Name <span class="input-imp">*</span></legend>
                                                            <input class="input-box" type="text" id="CardName" name="CardName" placeholder="Name on Card">
                                                        </fieldset>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <fieldset>
                                                            <legend class="float-none w-auto px-1">Exp.Month <span class="input-imp">*</span></legend>
                                                            <select id="CSVMonth" name="CSVMonth" class="input-box">
                                                                <option value="">Expiry Month</option>
                                                                <option value="01">January (01)</option>
                                                                <option value="02">February (02)</option>
                                                                <option value="03">March (03)</option>
                                                                <option value="04">April (04)</option>
                                                                <option value="05">May (05)</option>
                                                                <option value="06">June (06)</option>
                                                                <option value="07">July (07)</option>
                                                                <option value="08">August (08)</option>
                                                                <option value="09">September (09)</option>
                                                                <option value="10">October (10)</option>
                                                                <option value="11">November (11)</option>
                                                                <option value="12">December (12)</option>
                                                            </select>
                                                        </fieldset>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <fieldset>
                                                            <legend class="float-none w-auto px-1">Exp.Year <span class="input-imp">*</span></legend>
                                                            <select id="CSVYear" class="input-box" name="CSVYear">
                                                                <option value="">Expiry Year</option>
                                                                @for (int i = DateTime.Now.Year; i <= DateTime.Now.Year + 20; i++)
                                                                {
                                                                    <option value="@i">@i</option>
                                                                }
                                                            </select>
                                                        </fieldset>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <fieldset>
                                                            <legend class="float-none w-auto px-1">CVV <span class="input-imp">*</span></legend>
                                                            <input class="input-box" type="text" maxlength="3" id="Cvv" name="Cvv" placeholder="CVV">
                                                        </fieldset>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-8">
                                                <p class="mb-0 font15 text-black mt-3">We do not store any credit card information.</p>
                                                <p class="mb-0"><i class="fa fa-lock" style="color:#ffa327;"></i> Payments securely processed.</p>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="member-amount">
                                                    <div class="aws-amount-total">Total Amount</div>
                                                    <span id="creditamount2" class="aws-amount">0.00</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Cash/Cheque Tab -->
                                <div id="tabcashcheque" class="cus-tab-pane" style="display:none;">
                                    <div class="paymnet-cmn-sec">
                                        <div class="row">
                                            <div class="col-md-8">
                                                <img src="Content/User/images/cash-cheque.png" alt="" height="80" style="margin-right:15px;float:left;margin-bottom:6px;">
                                                <div>You will receive a confirmation email once payment is credited to @objAppInfo.SiteName account.</div>
                                                <div class="radio-btn mt-3">
                                                    <input type="radio" id="Mailed-1" name="Mailed" checked="checked" onclick="hideCheque();">
                                                    <label for="Mailed-1">Upload the cheque image to @objAppInfo.SiteName</label>
                                                </div>
                                                <div class="my-1 cheque-image" id="cheque-show">
                                                    <fieldset>
                                                        <legend class="float-none w-auto px-1">Upload cheque image here</legend>
                                                        <input type="file" name="file" id="file" class="input-box">
                                                    </fieldset>
                                                </div>
                                                <div class="radio-btn">
                                                    <input type="radio" id="Mailed-2" name="Mailed" onclick="ShowCheque();">
                                                    <label for="Mailed-2">Handed the cash/cheque to @objAppInfo.PresidentPhone board</label>
                                                </div>
                                                <div class="cheque-hide" id="cheque-hide" style="display:none;">
                                                    <fieldset>
                                                        <legend class="float-none w-auto px-1">Cheque</legend>
                                                        <input type="text" class="input-box" placeholder="Handed the cash/cheque to" id="ChequeHolderName" name="ChequeHolderName">
                                                    </fieldset>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="member-amount">
                                                    <div class="aws-amount-total">Total Amount</div>
                                                    <span id="totalamountcash" class="aws-amount">0.00</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Zelle Tab -->
                                <div id="tabzelle" class="cus-tab-pane" style="display:none;">
                                    <div class="zelle-sec paymnet-cmn-sec">
                                        <div class="row">
                                            <div class="col-md-8">
                                                <img src="Content/User/images/zelle.png" alt="" height="60" style="margin-right:15px;float:left;margin-bottom:6px;">
                                                <div>
                                                    <div>Zelle Name: <a class="fnt-pop clr1">@objAppInfo.SiteName</a></div>
                                                    <div>Zelle Email Id: <a href="mailto:@objAppInfo.CompanyEmail" class="fnt-pop clr1">@objAppInfo.CompanyEmail</a></div>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="member-amount">
                                                    <div class="aws-amount-total">Total Amount</div>
                                                    <span id="totalamountzelle" class="aws-amount">0.00</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="aws-alert-info my-3">Please enter Zelle transaction details:</div>
                                        <div class="clearfix row">
                                            <div class="col-md-4">
                                                <fieldset>
                                                    <legend class="float-none w-auto px-1">Zelle Transaction <span class="input-imp">*</span></legend>
                                                    <input type="text" placeholder="Zelle Transaction Id" name="Zelle" id="Zelle" class="input-box">
                                                </fieldset>
                                            </div>
                                            <div class="col-md-4">
                                                <fieldset>
                                                    <legend class="float-none w-auto px-1">Person Name <span class="input-imp">*</span></legend>
                                                    <input type="text" placeholder="Name of the Person" name="ZellePartnerName" id="ZellePartnerName" class="input-box">
                                                </fieldset>
                                            </div>
                                            <div class="col-md-4">
                                                <fieldset>
                                                    <legend class="float-none w-auto px-1">Upload receipt image <span class="input-imp">*</span></legend>
                                                    <input type="file" name="filezelle" id="filezelle" class="input-box">
                                                </fieldset>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Stripe Tab -->
                                <div id="tabstripe" class="cus-tab-pane" style="display:none;">
                                    <div class="zelle-sec paymnet-cmn-sec">
                                        <div class="row">
                                            <div class="col-md-8">
                                                <img src="Content/User/images/Stripe.png" class="img-fluid" alt="" style="height:102px;">
                                            </div>
                                            <div class="col-md-4">
                                                <div class="member-amount">
                                                    <div class="aws-amount-total">Total Amount</div>
                                                    <span id="totalstripe" class="aws-amount">0.00</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- SwirePay Tab -->
                                <div id="tabswire-pay" class="cus-tab-pane" style="display:none;">
                                    <div class="zelle-sec paymnet-cmn-sec">
                                        <div class="row">
                                            <div class="col-md-8">
                                                <img src="Content/User/images/swirepay-new-image.png" class="img-fluid" alt="" style="height:50px;">
                                            </div>
                                            <div class="col-md-4">
                                                <div class="member-amount">
                                                    <div class="aws-amount-total">Total Amount</div>
                                                    <span id="totalswirepay" class="aws-amount">0.00</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div><!-- end cus-tabs-content -->
                        </div><!-- end cus-tabs-container -->
                    </div><!-- end payment-mode -->
                </fieldset>
            </div>

         

            <!-- PayPal + Submit Buttons -->
            <div class="col-md-12 text-end">
                <div class="col-md-12 text-end">
                    <div class="col-md-12 text-end" id="paypalbuttonshow" style="display:none;">
                        <div id="paypal-button-container" style="width:250px;float:right;min-height:45px;"></div>
                        <div id="payment-status"></div>
                    </div>
                    <div class="col-md-12 text-end" id="button-show" style="display:none;">
                        <button class="aws-btn" type="submit" id="submit-button">Submit</button>
                    </div>
                </div>
            </div>


        </div><!-- end row -->
    </div>

    <!-- end aws-form -->
}

<style>
    .cus-tabs-nav {
        position: relative;
        z-index: 10;
    }

    .cus-tabs-content {
        position: relative;
        z-index: 1;
    }

    .member-amount {
        display: block;
    }

    .cmn-form-btn {
        display: inline-block;
        background-image: linear-gradient(90deg, #ff3228 0%, #ff9b1a 100%);
        background-color: #fd2e2c;
        color: #fff;
        padding: 8px 50px;
        border: none;
        margin-top: 10px;
        cursor: pointer;
    }

    .cus-sub-head {
        font-size: 21px;
        font-family: "Muli-SemiBold";
        line-height: 25px;
        padding-bottom: 8px;
        color: #ef3b3b;
    }

    .radio-btn input[type="radio"] {
        margin-right: 8px;
    }

    .radio-btn label {
        font-weight: 500;
        cursor: pointer;
    }
</style>

<script src="https://js.stripe.com/v3/"></script>
