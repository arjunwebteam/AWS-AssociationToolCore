<script>
    // ================================================================
    // SQUARE STATE
    // ================================================================
    var squareCard = null;
    var SQUARE_APP_ID = null;
    var SQUARE_LOCATION_ID = null;
    var SQUARE_ENV = null;
    var squarePrePaymentDone = false;
    var squarePrePaymentInProgress = false;

    function resetSquareState() {
        squareCard = null;
        squarePrePaymentDone = false;
        squarePrePaymentInProgress = false;
        var btnProceed = document.getElementById("btnProceedPay");
        if (btnProceed) { btnProceed.style.display = "inline-block"; btnProceed.disabled = false; btnProceed.innerText = "Proceed to Pay"; }
        var cardBtn = document.getElementById("card-button");
        if (cardBtn) cardBtn.style.display = "none";
        var container = document.getElementById("card-container");
        if (container) container.innerHTML = "";
    }

    async function initializeSquareCard() {
        if (squareCard) return;

        // ── Fetch Square settings only when needed (first time Proceed to Pay is clicked) ──
        if (!SQUARE_APP_ID || !SQUARE_LOCATION_ID) {
            var result = await $.ajax({
                url: '@Url.Action("GetSquareSettings", "Services")',
                type: 'POST',
                dataType: 'json'
            });

            if (typeof result === 'string') result = JSON.parse(result);

            if (!result.ok || !result.data.AppId || !result.data.LocationId) {
                throw new Error(result.message || "Square is not configured correctly. Please contact support.");
            }

            SQUARE_APP_ID      = result.data.AppId;
            SQUARE_LOCATION_ID = result.data.LocationId;
            SQUARE_ENV         = result.data.Mode;
        }

        if (typeof Square === "undefined") {
            var scriptUrl = SQUARE_ENV === "Test"
                ? "https://sandbox.web.squarecdn.com/v1/square.js"
                : "https://web.squarecdn.com/v1/square.js";
            await loadScript(scriptUrl);
        }

        var payments = Square.payments(SQUARE_APP_ID, SQUARE_LOCATION_ID);
        squareCard = await payments.card();
        await squareCard.attach("#card-container");
    }

    function loadScript(src) {
        return new Promise(function (resolve, reject) {
            if (document.querySelector("script[src='" + src + "']")) { resolve(); return; }
            var s = document.createElement("script");
            s.src = src; s.onload = resolve; s.onerror = reject;
            document.head.appendChild(s);
        });
    }

    $(document).ready(function () {
        // Square tab switch detection
        $(document).on("click", ".cus-tab-label", function () {
            var clickedTab = $(this).data("tab");
            var currentMethod = $("#PaymentMethod").val();
            if (currentMethod === "Square" && clickedTab !== "tabsquare") { resetSquareState(); }
        });

        // Proceed to Pay (Square Step 1)
        $("#btnProceedPay").on("click", async function () {
            if ($("#PaymentMethod").val() !== "Square") return;
            if (!$("#SignupForm").valid()) {
                $('html, body').animate({ scrollTop: $("em.help-block:first").offset().top - 100 }, 500);
                return;
            }
            var amount = $("#MemberAmount").val();
            if (!amount || parseFloat(amount) <= 0) { alert("⚠️ Please select a membership type."); return; }
            var btn = document.getElementById("btnProceedPay");
            if (squarePrePaymentDone) { btn.style.display = "none"; document.getElementById("card-button").style.display = "inline-block"; return; }
            if (squarePrePaymentInProgress) return;
            squarePrePaymentInProgress = true; btn.disabled = true; btn.innerText = "Loading payment form...";
            try {
                await initializeSquareCard();
                squarePrePaymentDone = true;
                document.getElementById("card-button").style.display = "inline-block";
                btn.style.display = "none";
            } catch (err) {
                btn.disabled = false; btn.innerText = "Proceed to Pay"; squarePrePaymentInProgress = false;
                alert("❌ Error loading payment form: " + (err.message || "Unexpected error."));
            }
        });

        // Pay (Square Step 2)
        $("#card-button").on("click", async function () {
            if (!squareCard) { alert("Card form not ready. Please try again."); return; }
            var btn = this; btn.disabled = true; btn.innerText = "Processing...";
            try {
                var result = await squareCard.tokenize();
                if (result.status === "OK") {
                    $("#SquareNonce").val(result.token);
                    btn.innerText = "Processing payment...";
                    document.getElementById("SignupForm").submit();
                } else {
                    btn.disabled = false; btn.innerText = "Pay";
                    var errors = result.errors ? result.errors.map(function (e) { return e.message; }).join(", ") : "Unknown error";
                    alert("⚠️ Card error: " + errors);
                }
            } catch (err) {
                btn.disabled = false; btn.innerText = "Pay";
                alert("❌ Error processing payment: " + (err.message || "Unexpected error"));
            }
        });
    });
</script>

<script>
    var actionStatus = null;
    var cnameValue = '@Html.Raw(cname)';

    // ================================================================
    // UTILITY
    // ================================================================
    function onlyAlphabets(e, t) {
        var c = e.which || e.keyCode;
        return c === 32 || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || [8, 9, 46, 37, 39].indexOf(c) !== -1;
    }
    function formatPhone(val) {
        var ph = val.replace(/\D/g, '');
        if (ph.length > 6) return ph.slice(0,3)+'-'+ph.slice(3,6)+'-'+ph.slice(6,10);
        if (ph.length > 3) return ph.slice(0,3)+'-'+ph.slice(3);
        return ph;
    }
      function hideCheque() {
        // Mailed-1: "Upload the cheque image" selected
        $('#cheque-show').show();
        $('#cheque-hide').hide();
        toggleChequeRules('upload');
    }
    function ShowCheque() {
        // Mailed-2: "Handed the cash/cheque to board" selected
        $('#cheque-show').hide();
        $('#cheque-hide').show();
        toggleChequeRules('handed');
    }
    function toggleChequeRules(mode) {
        var validator = $('#SignupForm').data('validator');
        if (!validator) return;

        $('#file').rules('remove');
        $('#ChequeHolderName').rules('remove');

        if (mode === 'upload') {
            $('#file').rules('add', { required: true, fileExtension: true });
        } else if (mode === 'handed') {
            $('#ChequeHolderName').rules('add', { required: true });
        }

        // re-validate immediately so error/success shows right away
        $('#file, #ChequeHolderName').valid();
    }
    function validatespouse(type) { $('#MType').val(type); }
    function paypalyhide() { $('#paypalbuttonshow').hide(); $('#paypal-button-container').hide(); }
    function paypalbyshow() { $('#paypalbuttonshow').show(); $('#paypal-button-container').show(); }

    // ================================================================
    // GET AMOUNT
    // ================================================================
    function getamount(membershipid) {
        var amt = '@amt';
        var str = "";
        $.ajax({
            url: '@Url.Action("GetAmount", "Members")',
            type: 'POST',
            data: { MembershipTypeId: membershipid },
            dataType: 'json',
            success: function (result) {
                if (result.ok) {
                    var t = result.data;
                    if (amt != 0) {
                        if (t.MembershipType == 'Life Membership' || t.MembershipType == 'Life Membership Single') {
                            var acprice = t.Price;
                            var amt2 = amt;
                            amt = parseInt(acprice) - parseInt(amt);
                            str = '<span class="red-t">Note: </span>You already paid (' + Math.round(amt2, 0) + ' $) amount has been deducted.';
                        } else { amt = t.Price; }
                    } else { amt = t.Price; }

                    $('#MemberAmount').val(amt);
                    $('#MembershipType').val(t.MembershipType);
                    $('#MemberDiscounttxt').html(str).show();
                    $('#AmountPayable').html(amt + ".00");
                        $('#payamount,#totalamountzelle,#totalstripe,#totalswirepay,#totalamountcash').html(t.Price + '.00');
    $('#creditamount').html('$' + t.Price + '.00');

                    $('#MembershipType1').val(t.MembershipType + '###' + amt);

                    // Fire amount-updated for Braintree
                    $(document).trigger("amount-updated");

                      // getamount() success callback lo, existing "if (actionStatus) { try { actionStatus.enable(); } catch (e) {} }" ki badulu:
    if (actionStatus) {
        try {
            if (t.Price && parseFloat(t.Price) > 0) {
                actionStatus.enable();
            } else {
                actionStatus.disable();
            }
        } catch (e) {}
    }

                    if (t.Price == 0) { paypalyhide(); } else { paypalbyshow(); }
                } else { alert(result.data); }
            }
        });
    }

    // ================================================================
    // PAYMENT TAB SWITCHER
    // ================================================================
    function paymentbind(type) {
        console.log('paymentbind:', type);

        // Teardown Braintree when switching away from Credit Card
        if (type !== "Credit Card" && window.dropinInst) {
            try {
                window.dropinInst.teardown(function () {
                    window.dropinInst = null;
                    console.log('Braintree torn down');
                });
            } catch (e) {}
            $('#dropin-container').hide().empty();
        }

        // Button visibility
        if (type === "PayPal") {
            $('#paypalbuttonshow').show();
            $('#paypal-button-container').show();
            $('#button-show').hide();
            $('#submit-button').hide();
        } else if (type === "Square") {
            $('#paypalbuttonshow').hide();
            $('#paypal-button-container').hide();
            $('#button-show').hide();
            $('#submit-button').hide();
            $('#btnProceedPay').show().prop('disabled', false).text('Proceed to Pay');
            $('#card-button').hide();
            $('#square-timer-display').hide();
        } else if (type === "Credit Card") {
            $('#paypalbuttonshow').hide();
            $('#paypal-button-container').hide();
            $('#button-show').show();
            $('#submit-button').show();
        } else {
            // Cash/Cheque, Zelle, Stripe, SwirePay, AuthorizeNet
            $('#paypalbuttonshow').hide();
            $('#paypal-button-container').hide();
            $('#button-show').show();
            $('#submit-button').show();
        }

        $('#PaymentMethod').val(type);

        // Rules only if validator initialized
        var validator = $('#SignupForm').data('validator');
        if (validator) {
              $("#CardNumber, #CardName, #Cvv, #CSVYear, #CSVMonth").rules("remove");
    $("#Zelle, #ZellePartnerName, #filezelle").rules("remove");
    $("#file, #ChequeHolderName").rules("remove");   // was #file1

            if (type === "AuthorizeNet") {
                $("#CardNumber").rules("add", { required: true });
                $("#CardName").rules("add",   { required: true });
                $("#Cvv").rules("add",        { required: true });
                $("#CSVYear").rules("add",    { required: true });
                $("#CSVMonth").rules("add",   { required: true });
            } else if (type === "Credit Card") {
                var amount = parseFloat($('#MemberAmount').val());
                if (!amount || isNaN(amount) || amount < 1) {
                    alert("Please select a membership type with a valid amount first.");
                    paymentbind('PayPal');
                    return;
                }
                $('#dropin-container').show();
                function tryInitBT() {
                    if (typeof window.startBraintree === "function") {
                        if (!window.dropinInst) { window.startBraintree(); }
                    } else { setTimeout(tryInitBT, 200); }
                }
                tryInitBT();
            } else if (type === "Zelle") {
                $("#Zelle").rules("add",           { required: true });
                $("#ZellePartnerName").rules("add", { required: true });
                $("#filezelle").rules("add",        { required: true });
              } else if (type === "Cash/Cheque") {
        var mode = $('#Mailed-2').is(':checked') ? 'handed' : 'upload';
        toggleChequeRules(mode);
    }

            validator.resetForm();
            $('.has-error').removeClass('has-error');
            $('.has-success').removeClass('has-success');
        }

        // Activate tab
        var cleanedTabId = "tab" + type.toLowerCase().replace(/[^a-z0-9\s]/g, '').trim().replace(/\s+/g, '-');
        $('.cus-tab-pane').removeClass('active').hide();
        $('#' + cleanedTabId).addClass('active').show();

        $('.cus-tab-label').removeClass('active');
        $('.cus-tab-label[value="' + type + '"]').addClass('active');
    }
</script>

<script>
    $(document).ready(function () {
            $.validator.addMethod("fileExtension", function (value, element) {
        if (this.optional(element)) return true;
        if (element.files && element.files.length > 0) {
            var allowed = ['jpg', 'jpeg', 'png'];
            var ext = element.files[0].name.split('.').pop().toLowerCase();
            return allowed.indexOf(ext) !== -1;
        }
        return true;
    }, "Only JPG, JPEG or PNG images are allowed.");
        // Phone formatting
        $('#MobilePhone').on('input', function () { $(this).val(formatPhone($(this).val())); });

        // Card number spacing
        $('#CardNumber').on('input', function () {
            var v = $(this).val().replace(/\D/g, '');
            if (v.length > 0) v = v.match(/.{1,4}/g).join(' ');
            $(this).val(v);
        });

        // CVV numbers only
        $('#Cvv').on('input', function () { $(this).val($(this).val().replace(/\D/g, '')); });

        // Load amount on page load (silent — no side effects)
        getamount(@objMemberDetails.MembershipTypeId);

        // ── Form validation ──
        $('#SignupForm').validate({
        rules: {
            FirstName:        { required: true },
            LastName:         { required: true },
            MembershipTypeId: { required: true }
        },
        messages: {
            FirstName:        'Please enter your First Name',
            LastName:         'Please enter your Last Name',
            MembershipTypeId: { required: 'Please select membership type' },
            file: {
                required:      'Please upload the cheque image',
                fileExtension: 'Only JPG, JPEG or PNG images are allowed'
            },
            ChequeHolderName: { required: 'Please enter the name of the person' }
        },
        errorElement: 'em',
        errorPlacement: function (error, element) {
            error.addClass('help-block');
            if (element.prop('type') === 'checkbox') { error.insertAfter(element.parent('label')); }
            else { error.insertAfter(element); }
        },
        highlight:   function (element) { $(element).parents('fieldset').addClass('has-error').removeClass('has-success'); },
        unhighlight: function (element) { $(element).parents('fieldset').addClass('has-success').removeClass('has-error'); }
    });

        // ── Submit button ──
        $('#submit-button').on('click', function (e) {
            e.preventDefault();
            var form = $('#SignupForm');
            var paymentMethod = $('#PaymentMethod').val();

            if (paymentMethod === 'Credit Card') {
                if (!form.valid()) return;
                if (!window.dropinInst) { alert('Payment form not ready. Please wait and try again.'); return; }
                if (!window.dropinInst.isPaymentMethodRequestable()) { alert('Please fill in your card details before submitting.'); return; }
                window.dropinInst.requestPaymentMethod(function (err, payload) {
                    if (err) { alert('Card error: ' + err.message); return; }
                    $('#nonce').val(payload.nonce);
                    $('<input>').attr({ type: 'hidden', name: 'ClientValidationStatus', value: 'true' }).appendTo(form);
                    form.submit();
                });
                return;
            }

            if (form.valid()) {
                $('<input>').attr({ type: 'hidden', name: 'ClientValidationStatus', value: 'true' }).appendTo(form);
                form.submit();
            }
        });

        // ── PayPal SDK ──
        if (typeof paypal !== 'undefined') {
            paypal.Buttons({
                fundingSource: paypal.FUNDING.PAYPAL,
                style: { layout: 'horizontal', color: 'blue', shape: 'pill', label: 'pay', height: 40 },

                onInit: function (data, actions) {
        actionStatus = actions;

        // Initial check — don't just blindly disable
        var amt = parseFloat($('#MemberAmount').val());
        if (amt && amt > 0) {
            actions.enable();
        } else {
            actions.disable();
        }

        if ($('#PaymentMethod').val() === 'PayPal') {
            $('#paypalbuttonshow').show();
            $('#paypal-button-container').show();
            $('#button-show').hide();
        }

        var debounceTimer;
        $('#SignupForm').on('change keyup', function () {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(function () {
                if ($('#MemberAmount').val() && parseFloat($('#MemberAmount').val()) > 0) {
                    actionStatus.enable();
                } else { actionStatus.disable(); }
            }, 300);
        });
    },

                onClick: function (data, actions) {
                    if (!$('#SignupForm').valid()) {
                        alert('Please fill all required fields');
                        return actions.reject();
                    }
                    var amount = $('#MemberAmount').val();
                    if (!amount || parseFloat(amount) <= 0) {
                        alert('Please select a membership type');
                        return actions.reject();
                    }
                    return actions.resolve();
                },

                createOrder: function (data, actions) {
                    var amount = $('#MemberAmount').val();
                    var membershipTypeValue = $('#MembershipType1').val();
                    var item = membershipTypeValue.split('###');
                    return actions.order.create({
                        purchase_units: [{
                            amount: { currency_code: 'USD', value: amount },
                            description: item[0] || "Membership Renewal",
                            custom_id: $('#MembershipType1').val()
                        }],
                        application_context: { shipping_preference: 'NO_SHIPPING' }
                    });
                },

                onApprove: function (data, actions) {
                    return actions.order.capture().then(function (details) {
                        var transactionId = details.id;
                        var amount        = details.purchase_units[0].amount.value;
                        var status        = details.status;
                        var payerName     = details.payer.name.given_name + ' ' + details.payer.name.surname;
                        var payerEmail    = details.payer.email_address;

                        if (status === 'COMPLETED') {
                            $('#TransactionId').val(transactionId);
                            $('#PaymentAmount').val(amount);
                            $('#PaymentStatus').val(status);
                            $('#PayerName').val(payerName);
                            $('#PayerEmail').val(payerEmail);

                            $('#payment-status').html('<div class="alert alert-success">Payment completed! Submitting...</div>');
                            $('#paypal-button-container').hide();

                            var formData = new FormData(document.getElementById('SignupForm'));
                            $.ajax({
                                url:         '@Url.Action("MembershipRenewal", "Members", new { area = "User" })',
                                type:        'POST',
                                data:        formData,
                                processData: false,
                                contentType: false,
                                headers:     { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                                success: function (response) {
                                    if (response && response.redirectUrl) {
                                        window.location.href = response.redirectUrl;
                                    } else {
                                        window.location.href = '@Url.Action("RenewalAcknowledgement", "Members", new { area = "User" })'
                                            + '?MemberId=' + ($('#MemberId').val() || 0)
                                            + '&cname=' + encodeURIComponent(cnameValue);
                                    }
                                },
                                error: function (xhr) {
                                    console.error('Submit error:', xhr.status, xhr.responseText);
                                    $('#payment-status').html('<div class="alert alert-danger">Submission failed. Transaction ID: ' + transactionId + '</div>');
                                }
                            });
                        } else {
                            $('#payment-status').html('<div class="alert alert-warning">Payment status: ' + status + '</div>');
                        }
                    }).catch(function (err) {
                        $('#payment-status').html('<div class="alert alert-danger">Error: ' + err.message + '</div>');
                    });
                },

                onError:  function (err)  { $('#payment-status').html('<div class="alert alert-danger">PayPal error: ' + (err.message || 'Unknown error') + '</div>'); },
                onCancel: function ()      { $('#payment-status').html('<div class="alert alert-info">Payment was cancelled.</div>'); }

            }).render('#paypal-button-container');
        } else {
            console.error('PayPal SDK not loaded.');
        }

        // Init first payment tab AFTER validator is set up
        var firstMethod = '@firstPaymentMethod';
        if (firstMethod) { paymentbind(firstMethod); }

        setTimeout(function () {
            if ($('#PaymentMethod').val() === 'PayPal') {
                $('#paypalbuttonshow').show();
                $('#paypal-button-container').show();
                $('#button-show').hide();
            }
        }, 1000);

    }); // end document.ready
</script>

