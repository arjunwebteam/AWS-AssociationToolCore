                                        }
                                        <input type="hidden" id="cname" name="cname" value="@cname" />
                                        <input type="hidden" id="rs" name="rs" value="@rs" />
                                        <div class="row">

                                            <div class="col-md-12">
                                                <fieldset>
                                                    <legend class="float-none w-auto px-1">Email Id <span class="input-imp">*</span></legend>
                                                    <input class="input-box" type="text" name="Email" id="Email1" placeholder="Email Id" />
                                                    <span class="errormsg" id="spanEmail1"></span>
                                                </fieldset>
                                            </div>
                                            <div class="col-md-12">
                                                <fieldset>
