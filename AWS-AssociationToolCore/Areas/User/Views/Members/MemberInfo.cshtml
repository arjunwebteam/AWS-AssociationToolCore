
@{
    Layout = "~/Areas/User/Views/Shared/_MainLayout.cshtml";

    string ChapterName = "";
    ChapterName = ViewBag.cname;

    int _qstatus = 0;
    AWS_AssociationToolCore.BLL.AppInfo _AppInfo = new AWS_AssociationToolCore.BLL.AppInfo();
    AWS_AssociationToolCore.Entities.AppInfo objAppInfo = new AWS_AssociationToolCore.Entities.AppInfo();
    List<AWS_AssociationToolCore.Entities.EventUserInfo> lstEventUserInfo = ViewBag.lstEventUserInfo;

    objAppInfo = _AppInfo.GetAppInfoDetails(ref _qstatus);

    AWS_AssociationToolCore.Entities.Members objMember = ViewBag.objMember;
    var objMembersType = (AWS_AssociationToolCore.Entities.Members)ViewBag.objMembersType;

    var location = objAppInfo.AdminImageUrl + "MemberProfileImages/";
    var objEventUserInfo = (AWS_AssociationToolCore.Entities.EventUserInfo)ViewBag.objEventUserInfo;
    List<AWS_AssociationToolCore.Entities.EventRegistrationCounts> lstEventRegistrationCounts = ViewBag.lstEventRegistrationCounts;

    ViewBag.Title = "Membership Info | " + objAppInfo.SiteName + " Member Portal";
    ViewBag.MetaDescription = "Manage your " + objAppInfo.SiteName + " profile, update details, and track your membership activities.";
    ViewBag.MetaKeywords = objAppInfo.SiteName + " profile, member profile, update account, Telugu community account settings";

    ViewBag.PageHeading = "Membership Info";
}
<script src="Scripts/Admin/Common.js" type="text/javascript"></script>
<!-- button list start -->
<style>
    td .bi.bi-eye-fill {
        font-size: 1rem;
        color: #373737;
    }

    .pn__set thead tr th:nth-child(6) {
        width: 60px;
    }

    .pn__set thead tr th:nth-child(1) {
        width: 100px;
    }

    .veiw__title__name {
        display: flex;
        gap: 5px;
    }

    .profile__set {
        display: grid;
        gap: 10px;
        grid-template-columns: repeat( auto-fit, minmax(300px, 1fr) );
    }


    .aws-event-box .event__box__title {
        color: #3fa2a9;
    }
</style>
<script>
        $(document).ready(function () {
            LoadLatestNewsList();
        });

        function LoadLatestNewsList() {
            $.ajax({
                type: "GET",
                url: '@Url.Action("ProfileMenu", "Members")',
             data: {
    Type    : 'MemberInfo'

        },

            success: function (data) {
                    $("#divProfileMenuList").html(data);
                },
                error: function () {
                    $("#divProfileMenuList").html('<p class="text-danger">Failed to load events.</p>');
                }
            });
        }
</script>

<div class="aws-profile-left-sec">

    <!-- profile Here information -->
    <div class="" id="divProfileMenuList">
        <div class="aws-profile-img">
            <button class="aws-edit-icon" title="edit profile" data-bs-toggle="modal" data-bs-target="#editProfile"><i class="bi bi-pencil"></i></button>
            @if (objMember.ProfileImage != null && objMember.ProfileImage != "")
            {
                <img src="@AWS_AssociationToolCore.BLL.Common.ValidateImage((location + objMember.ProfileImage), "Content/user/images/com-main.png")" alt="Profile" class="border-radius10 profshd" width="159" height="159" />
            }
            else
            {
                <img src="Content/user/images/com-main.png" alt="Profile" class="border-radius10 profshd" width="159"
                     height="159" />
            }
        </div>


@*         @{Html.RenderAction("ProfileMenu", "Members", new { tab = "MemberInfo" });}
 *@


    </div>
    <!-- profile Here  -->

</div>
<div class="aws-profile-right-sec">
    <div class="aws-title">
        Membership Info
        <div class="cmn-event-btn">
            <a href="/@ChapterName/profile" class="back-btn">Back To Profile</a>
        </div>
    </div>
    <div class="aws-bdr"></div>
    <div class="aws-profile-dashboard-sec">
        <div class="">
            <div class="row">
                <div class="aws-event-box">
                    <h5 class="event__box__title">Personal Details</h5>
                </div>
                <div class="col-12">
                    <div class="profile__set">

                        <div class="">
                            <div class="aws-committee-cnt  veiw__title__name">
                                <div class="aws-title4">MemberId :</div>
                                <div class="aws-desgination">@objMember.MemberSkils</div>
                            </div>
                        </div>


                        <div class="">
                            <div class="aws-committee-cnt  veiw__title__name">
                                <div class="aws-title4">First Name :</div>
                                <div class="aws-desgination">@objMember.FirstName</div>
                            </div>
                        </div>
                        <div class="">
                            <div class="aws-committee-cnt  veiw__title__name">
                                <div class="aws-title4">Last Name :</div>
                                <div class="aws-desgination">@objMember.LastName</div>
                            </div>
                        </div>
                        <div class="">
                            <div class="aws-committee-cnt  veiw__title__name">
                                <div class="aws-title4">Email :</div>
                                <div class="aws-desgination">@objMember.Email</div>
                            </div>
                        </div>


                        <div class="">
                            <div class="aws-committee-cnt  veiw__title__name">
                                <div class="aws-title4">Mobile Phone :</div>
                                <div class="aws-desgination">@objMember.MobilePhone</div>
                            </div>
                        </div>

                    </div>

                </div>
            </div>
            <div class="aws-bdr mb-0"></div>
            <div class="row mt-3">
                <div class="aws-event-box">
                    <h5 class="event__box__title">Payment Details</h5>
                </div>
                <div class="col-12">
                    <div class="profile__set">



                        <div class="">
                            <div class="aws-committee-cnt  veiw__title__name">
                                <div class="aws-title4">Membership  Type :</div>
                                <div class="aws-desgination">@objMember.objMembershipOrder.MembershipType</div>
                            </div>
                        </div>




                        <div class="">
                            <div class="aws-committee-cnt  veiw__title__name">
                                <div class="aws-title4"> Payment Method :</div>
                                <div class="aws-desgination">  @objMember.objMembershipOrder.PaymentMethod</div>
                            </div>
                        </div>


                        @if (objMember.objMembershipOrder.PaymentStatus == "Completed")
                        {

                            <div class="">
                                <div class="aws-committee-cnt  veiw__title__name">
                                    <div class="aws-title4">Payment Status :</div>
                                    <div class="aws-desgination">Paid</div>
                                </div>
                            </div>

                        }


                        <div class="">
                            <div class="aws-committee-cnt  veiw__title__name">
                                <div class="aws-title4"> Transaction Id :</div>
                                <div class="aws-desgination">@objMember.objMembershipOrder.TransactionId</div>
                            </div>
                        </div>

                        <div class="">
                            <div class="aws-committee-cnt  veiw__title__name">
                                <div class="aws-title4">Amount Paid :</div>
                                <div class="aws-desgination">$ @objMember.MemberAmount</div>
                            </div>
                        </div>

                        <div class="">
                            <div class="aws-committee-cnt  veiw__title__name">
                                <div class="aws-title4">Expiry Date :</div>
                                <div class="aws-desgination">  @(objMember.objMembershipOrder.ExpiryDate == DateTime.MinValue ? "LifeTime" : objMember.objMembershipOrder.ExpiryDate.ToString("MM/dd/yyyy"))</div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>







<style>
    .profile__set {
        display: grid;
        gap: 0;
        grid-template-columns: repeat( auto-fit, minmax(300px, 1fr) );
    }

    .aws-event-box .event__box__title {
        color: #ff3f3e !important;
    }
</style>










