@{Layout = null;}
@{

    var tab = ViewBag.tab;

    var cname = ViewBag.cname;
    
    AWS_AssociationToolCore.Entities.Members objMember = ViewBag.objMembers;
}

<div class="aws-profile-btn-list">
    <div>
        <a href="@Url.Action("Profile", "Members", new { tab = "Profile", cname= objMember.ChapterName })" class="@(tab == "Profile" ? "active" : "")"><i class="bi bi-person-circle"></i> Profile</a>
    </div>
    <div>
        <button title="change password" class="@(tab == "change" ? "active" : "")" data-bs-toggle="modal" data-bs-target="#changePassword"><i class="bi bi-shield-lock"></i> Change Password</button>
    </div>


    <div>
        <a href="@Url.Action("MemberInfo", "Members")" class="@(tab == "MemberInfo" ? "active" : "")"><i class="bi bi-person-circle"></i>Membership Info</a>
    </div>

    <div>
        <a href="@Url.Action("DonorsList", "Members")" class="@(tab == "DonorsList" ? "active" : "")"><i class="bi bi-person-circle"></i> Donations</a>
    </div>

    <div>
        <a href="@Url.Action("FEMemEventsList", "Members")" class="@(tab == "FEMemEventsList" ? "active" : "")"><i class="bi bi-person-circle"></i>Event Registrations</a>
    </div>
