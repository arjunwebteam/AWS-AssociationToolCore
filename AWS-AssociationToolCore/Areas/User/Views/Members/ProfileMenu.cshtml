        if (ViewBag.daysRemaining <= 60)
        {
            <div>
                <a href="@Url.Action("MembershipRenewal", "Members", new { str = "renewal",cname=@cname })"><i class="bi bi-person-circle"></i>Membership Renewal</a>
            </div>
        }
       

    }
