@{
    Layout = "~/Areas/User/Views/Shared/_MainLayout.cshtml";
    var ChapterId = ViewBag.ChapterId;
    string cname = ViewBag.cname;

    int status = 0;
    AWS_AssociationToolCore.BLL.AppInfo _AppInfo = new AWS_AssociationToolCore.BLL.AppInfo();
    AWS_AssociationToolCore.Entities.AppInfo objAppInfo = new AWS_AssociationToolCore.Entities.AppInfo();
    objAppInfo = _AppInfo.GetAppInfoDetails(ref status);

    ViewBag.Title = "Page Not Found | " + objAppInfo.SiteName;
    ViewBag.MetaDescription = "Oops! The page you are looking for is not available. Return to the homepage";
    ViewBag.MetaKeywords = "Telugu association 404 error, page not found, broken link, Telugu website error";

    ViewBag.PageHeading = "Page Not Found";
} 


                <div class="aws-acknowledgement-box aws-ac-error">
