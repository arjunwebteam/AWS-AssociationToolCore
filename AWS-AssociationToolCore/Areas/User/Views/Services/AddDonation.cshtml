                                <input type="text" onkeypress="ResetValidateClass();" onclick="ResetValidateClass();" class="form-control" placeholder="Payment By" style="min-height: 40px;" name="PaymentBy" id="PaymentBy">
                            </article>
                        </article>
                    </article>
                    <article class="part-row clearfix">
                        <article class="part-6">
                            <article class="clearfix r-p10 tablet-r-p5 mobile-r-p0">
