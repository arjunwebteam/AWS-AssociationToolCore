<script type="text/javascript">
    $(document).ready(function () {
        $("#Field2").datepicker({ changeMonth: true, changeYear: true, yearRange: "-0:+20", minDate: new Date(), altField: '.date', altFormat: 'mm/dd/yy' });
        $("#OrderDate").datepicker({ changeMonth: true, changeYear: true, yearRange: "-0:+20", minDate: new Date(), altField: '.date', altFormat: 'mm/dd/yy' });
