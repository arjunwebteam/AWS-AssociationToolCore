    function AmountChange(AAmount) {
        $('#OtherAmount').attr('readonly', 'readonly');
        if (AAmount == '25') {
            $('#Amount').val('25');
            $('#Amount').html('25');
        }
        else if (AAmount == '50') {
            $('#Amount').val('50');
            $('#Amount').html('50');
        }
        else if (AAmount == '100') {
            $('#Amount').val('100');
            $('#Amount').html('100');
        }
        else if (AAmount == '250') {
            $('#Amount').val('250');
            $('#Amount').html('250');
        }
        else if (AAmount == '500') {
            $('#Amount').val('500');
            $('#Amount').html('500');
        }
        else if (AAmount == 'Other') {
            $('#Amount').val('');
            $('#Amount').html('0');
            $('#OtherAmount').removeAttr('readonly');
        }
    }

    function OtherNewAmount() {
        alert(1);
        var OtherAmount = $('#OtherAmount').val();

        if (OtherAmount != '') {
            $('#Amount').val(OtherAmount);
            $('#Amount').html(OtherAmount);
        }
    }
</script>
<script type="text/javascript">

    var specialKeys = new Array();
    specialKeys.push(8); //Backspace
    specialKeys.push(9); //Tab
    specialKeys.push(32); //Space
    specialKeys.push(46); //Delete
    specialKeys.push(36); //Home
    specialKeys.push(35); //End
    specialKeys.push(37); //Left
    specialKeys.push(39); //Right


    function onlyAlphabets(e, t) {
        try {
            if (window.event) {
                var charCode = window.event.keyCode;
            }
            else if (e) {
                var charCode = e.which;
            }
            else { return true; }
            if ((charCode == 32) || (charCode > 64 && charCode < 91) || (charCode > 96 && charCode < 123) || (specialKeys.indexOf(e.keyCode) != -1 && e.charCode != e.keyCode))
                return true;
            else
                return false;
        }
        catch (err) {
            alert(err.Description);
        }
    }

    function getDonationamount() {

        var DonationCategoryId = $('#DonationCategoryId').val();
        $.ajax({
            url: '@Url.Action("GetDonationAmount", "Donation")',
            type: 'POST',
            data: { DonationCategoryId: DonationCategoryId },
            datatype: "JSON",
            success: function (result) {
                if (result.ok) {
                    var objDonationCategories = result.data;
                    $('#payamount').html(objDonationCategories.Price);
                    $('#Amount').val(objDonationCategories.Price);

                    if (objDonationCategories.Price != 0) {
                        $('#Amount').attr('readonly', 'readonly');
                    }
                    else {
                        $('#Amount').removeAttr('readonly');
                    }

                    total5 = 0;
                    total5 = objDonationCategories.Price;
                    total5 = parseInt(total5);
                    $('#totalamount').html("$" + total5);
                    $('#totalamount2').html("$" + total5);
                    total5 = parseFloat(total5 + (total5 * parseInt(2) / 100)).toFixed(2);
                    document.getElementById("total").innerHTML = "$" + (total5);
                    $('#MemberAmount').val(total5);
                    if (objDonationCategories.Validity != 0) {
                        var d = new Date();
                        d.setMonth((d.getMonth()) + objDonationCategories.Validity);
                        $('#ExpiryDate').val(d.toDateString("MM/dd/yyyy"));
                    } else { $('#ExpiryDate').val(0); }
                }
            }
        });
    }

    function CreloadCaptcha() {
        document.getElementById('CUcaptcha').src = document.getElementById('CUcaptcha').src + '/';
    }

</script>

