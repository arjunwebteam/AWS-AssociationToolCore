    function addCauseRow() { 
        var table = document.getElementById("contributionfo");

        var rowCount = table.rows.length;
        var row = table.insertRow(rowCount);
        row.id = rowCount;

        var cell1 = row.insertCell(0);
        var element1 = document.createElement("article");
        element1.className = "clearfix dropdown";
        element1.innerHTML = " <select class=\"dropdown-select ui-select\" id=\"ServiceId-" + (rowCount - 1) + "\" name=\"[" + (rowCount - 1) + "].ServiceId\" style=\"min-height:40px; background-color:#fff;\" onchange=\"contributionupdate();\" ></select>";
        element1.style = "min-height:40px; background-color:#fff;"
        cell1.appendChild(element1);

        var cell2 = row.insertCell(1);
        var element2 = document.createElement("input");
        element2.type = "text";
        element2.name = "[" + (rowCount - 1) + "].Percentage";
        element2.id = "Percentage-" + (rowCount - 1);
        element2.className = "form-control dis-in per_class";
        element2.style = "min-height:40px; background-color:#fff";
        cell2.appendChild(element2);


        var cell3 = row.insertCell(2);
        cell3.align = 'center';
        cell3.innerHTML = '<span id="del-' + (rowCount - 1)+'"><a onclick="javascript:deleteRow(' + rowCount + ')" class="darkgray-text"><img alt="Delete" title="Delete" src="Content/User/images/delete.gif" class="margin-top-5" /></a></span>';
        $('#hdnRowCount').val(rowCount);

        $("#Percentage-" + (rowCount - 1)).attr('onchange', 'sumpercentage()').attr('onkeypress', 'return Common.isNumberKey(event)');

        ServicesList(rowCount - 1);
        $('#del-' + (rowCount - 2)).html('');
        if ((rowCount) == @TotalServices) {
            $('#spp2').hide();
        }
    }

    function deleteRow(i) {
        try {
            var row = document.getElementById(i);
            row.parentNode.removeChild(row);
            contributionupdate();
            $('#del-' + (i - 2)).html('<a onclick="javascript:deleteRow(' + (i-1) + ')" class="darkgray-text"><img alt="Delete" title="Delete" src="Content/User/images/delete.gif" class="margin-top-5" /></a>');
            var table = document.getElementById("contributionfo");
            var rowCount = table.rows.length;
            if ((rowCount - 2) < 4) {
                $('#spp2').show();
            }

        } catch (e) {
            alert(e);
        }
    }

    function round_off(mystring) {
        mystring = mystring.replace(/\./g, '');
        mystring = mystring.substring(0, 10);

        mystring1 = mystring.substring(0, mystring.length - 2);
        mystring2 = mystring.substring(mystring.length, mystring.length - 2);

        mystring2 = "" + mystring1 + "." + mystring2 + "";
        if (mystring != "" && mystring.length > 2) {
            document.getElementById("round_no").value = mystring2;
        }
    }

    function RECAMTBIND() {
        if ($('#RecurrCheckbox').prop("checked") == true) {
            $('#Field1').val($('#round_no').val());
        }
    }
    function RecurrDivFunction() {
        if ($('#RecurrCheckbox').prop("checked") == true) {
            $('#Field1').val($('#round_no').val());
            $('#RecurrDiv').show('slow');
        }
        else {
            $('#RecurringAmount').val('');
            $('#RecurringType').val('');
            $('#RecurringStartTime').val('');
            $('#RECDate').val('');
            $('#RType').val('');
            $('#ReccurId').val('');
            $('#RecurrDiv').hide('slow');
        }
    }

    function contributionupdate() {
        var table = document.getElementById("contributionfo");
        var rowCount = table.rows.length;
        var rows = rowCount - 1;
        var per = (100 / rows).toFixed(2);
        $('.per_class').val(per);
        sumpercentage();
        
    }

    function sumpercentage() {
        var sum = 0;
        $(".per_class").each(function () {
            sum += +$(this).val();
        });
        $("#TotalPercent").val(sum);
    }

    function ServicesList(rowid) {
        $.ajax({
            url: '@Url.Action("ServicesGetListByChapterId", "Services")',
            type: 'POST',
            cache: false,
            success: function (result) {
                if (result.ok) {
                    var lstServices = result.data;
                    var sb1 = "";
                    if (lstServices != null) {
                        var table = document.getElementById("contributionfo");
                        var rowCount = table.rows.length;
                        var rows = rowCount - 1;

                        for (var k = 0; k < lstServices.length; k++) {
                            var x = 0;
                            for (var i = 0; i <= rows; i++) {
                                if (lstServices[k].ServiceId == $('#ServiceId-' + i).val()) {
                                    x = 1;
                                }
                            }
                            if (x == 0) {
                                sb1 = sb1 + "<option value=\"" + lstServices[k].ServiceId + "\">" + lstServices[k].ServiceTitle + "</option>";
                            }
                        }
                    }
                    $('#ServiceId-' + rowid).append(sb1);
                    
                    contributionupdate();
                }
            }
        });
    }

    function Validate() {

        if ($('#TotalPercent').val() > 100 || $('#TotalPercent').val() < 99) { alert('Total contributions % is Invalid'); return false; }

        var amt = $('#round_no').val();
        var needamt = Math.round((500000), 0);
        if (amt == 0) { alert('Please enter donation amount.'); $('#round_no').focus(); returnval = false; }
        else {
            $('#spanAmount').html('');
            if (amt < 5) { alert('Please enter amount atleast $ 5.'); $('#round_no').focus(); returnval = false; }
            else if(amt > needamt && '@objServices.ServiceId' != 0){alert('Entered amount is exceeded.'); $('#round_no').focus(); returnval = false;}
            else { $('#spanAmount').html(''); }

        }

        
        if ($('#FirstName').val() == "") { $('#FirstName').focus().addClass("validate"); $('#spanFirstName').show().html('Please enter first name.<span>&nbsp;</span><i>&nbsp;</i><abbr onclick="closeValidation(this);">&nbsp;</abbr>'); return false; } else { $('#spanFirstName').hide().html(''); $('#FirstName').focus().removeClass("validate"); }
        if ($('#LastName').val() == "") { $('#LastName').focus().addClass("validate"); $('#spanLastName').show().html('Please enter last name.<span>&nbsp;</span><i>&nbsp;</i><abbr onclick="closeValidation(this);">&nbsp;</abbr>'); return false; } else { $('#spanLastName').hide().html(''); $('#LastName').focus().removeClass("validate"); }
        if ($.trim($('#Email').val()) == '') { $('#Email').focus().addClass('redborder'); $('#spanEmail').show().html('Email Id Required <span>&nbsp;</span><i>&nbsp;</i><abbr onclick="closeValidation(this);">&nbsp;</abbr>'); return false; } else { $('#spanEmail').hide().html(''); $('#Email').removeClass("redborder"); }
        if (!Common.CheckEmail($.trim($('#Email').val()))) { $('#spanEmail').show().html('Please enter valid email address.<span>&nbsp;</span><i>&nbsp;</i><abbr onclick="closeValidation(this);">&nbsp;</abbr>'); $('#Email').focus().addClass("red-border"); return false; } else { $('#spanEmail').html(''); }
        if ($('#PhoneNo').val() == "") { $('#PhoneNo').focus().addClass("validate"); $('#spanPhoneNo').show().html('Please enter Phone No.<span>&nbsp;</span><i>&nbsp;</i><abbr onclick="closeValidation(this);">&nbsp;</abbr>'); return false; } else { $('#spanPhoneNo').hide().html(''); $('#PhoneNo').focus().removeClass("validate"); }

        if ($('#Country').val() == "") { $('#Country').focus().addClass("validate"); $('#spanCountry').show().html('Please enter Country.<span>&nbsp;</span><i>&nbsp;</i><abbr onclick="closeValidation(this);">&nbsp;</abbr>'); return false; } else { $('#spanCountry').hide().html(''); $('#Country').focus().removeClass("validate"); }
        if ($('#ZipCode').val() == "") { $('#ZipCode').focus().addClass("validate"); $('#spanZipCode').show().html('Please enter ZipCode.<span>&nbsp;</span><i>&nbsp;</i><abbr onclick="closeValidation(this);">&nbsp;</abbr>'); return false; } else { $('#spanZipCode').hide().html(''); $('#ZipCode').focus().removeClass("validate"); }

        if ($('#RecurrCheckbox').prop("checked") == true) {
            if ($('#FrequencyofDonation').val() == "") { $('#FrequencyofDonation').focus().addClass("validate"); $('#spanFrequencyofDonation').show().html('Required.<span>&nbsp;</span><i>&nbsp;</i><abbr onclick="closeValidation(this);">&nbsp;</abbr>'); return false; } else { $('#spanFrequencyofDonation').hide().html(''); $('#FrequencyofDonation').focus().removeClass("validate"); }
            if ($('#Field2').val() == "") { $('#Field2').focus().addClass("validate"); $('#spanField2').show().html('Required.<span>&nbsp;</span><i>&nbsp;</i><abbr onclick="closeValidation(this);">&nbsp;</abbr>'); return false; } else { $('#spanField2').hide().html(''); $('#Field2').focus().removeClass("validate"); }
            if ($('#NoofPayments').val() == "") { $('#NoofPayments').focus().addClass("validate"); $('#spanNoofPayments').show().html('Required.<span>&nbsp;</span><i>&nbsp;</i><abbr onclick="closeValidation(this);">&nbsp;</abbr>'); return false; } else { $('#spanNoofPayments').hide().html(''); $('#NoofPayments').focus().removeClass("validate"); }
            if ($('#Field1').val() == "") { $('#Field1').focus().addClass("validate"); $('#spanField1').show().html('Required.<span>&nbsp;</span><i>&nbsp;</i><abbr onclick="closeValidation(this);">&nbsp;</abbr>'); return false; } else { $('#spanField1').hide().html(''); $('#Field1').focus().removeClass("validate"); }
        }
        else {
            $('#FrequencyofDonation').val('');
            $('#Field2').val('');
            $('#NoofPayments').val('');
            $('#Field1').val('');
        }

         if ($.trim($('#txtCaptcha').val()) == '') { $('#txtCaptcha').focus().addClass('redborder'); $('#spantxtCaptcha').show().html('Captcha Required <span>&nbsp;</span><i>&nbsp;</i><abbr onclick="closeValidation(this);">&nbsp;</abbr>'); return false; } else { $('#spantxtCaptcha').hide().html(''); $('#txtCaptcha').removeClass('redborder'); }
        var str = Common.GetCaptcha();

        if ($('#txtCaptcha').val() != str) { $('#txtCaptcha').val(''); document.getElementsByName('MCaptcha')[0].placeholder = 'wrong captcha.'; $('#txtCaptcha').focus().addClass("validate"); return false; } else { $('#txtCaptcha').focus().removeClass("validate"); }

        return true;
    }

