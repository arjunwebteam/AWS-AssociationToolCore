        $(document).ready(function () {

            // Card number formatting
            $('#CardNumber').on('input', function () {
                let v = $(this).val().replace(/\D/g, '');
                if (v.length > 0) v = v.match(/.{1,4}/g).join(' ');
                $(this).val(v);
            });

            // CVV numbers only
            $('#Cvv').on('input', function () {
                $(this).val($(this).val().replace(/\D/g, ''));
            });

            // Custom validator: min $5
            $.validator.addMethod("validImageExtension", function (value, element) {
                if (element.files && element.files.length > 0) {
                    let ext = element.files[0].name.split('.').pop().toLowerCase();
                    return ['jpg', 'png','jpeg'].includes(ext);
                }
                return true;
            }, "Only allowed extensions are: jpg, png, jpeg");

            $.validator.addMethod("customMin", function (value, element) {
                return parseFloat(value) >= 5;
            }, "Enter Min $5.00");

            // ================================================================
            // FORM VALIDATION
            // ================================================================
            $('#SignupForm').validate({
                rules: {
                    FirstName:  { required: true },
                    LastName:   { required: true },
                    Email:      { required: true, email: true },
                    PhoneNo:    { required: true },
                    Address:    { required: true, minlength: 5 },
                    Country:    { required: true },
                    ServiceId:  { required: true },
                    pmethod:    { required: true },
                    CardNumber: { required: true },
                    CardName:   { required: true },
                    Cvv:        { required: true },
                    CSVYear:    { required: true },
                    CSVMonth:   { required: true },
                    Zelle:          { required: true },
                    ZellePartnerName: { required: true },
                    file1:      { required: true, validImageExtension: true },
                    filezelle:  { required: true, validImageExtension: true },
                    Amount: { required: true, number: true, customMin: true },
                    recaptcha: {
                        required: function () {
                            var capcha = '@capcha';
                            return capcha === 'Yes' && $("#recaptchaResponse").val().trim() === "";
                        }
                    }
                },
                messages: {
                    FirstName:  "Enter First Name",
                    LastName:   "Enter Last Name",
                    Email:      "Enter valid Email",
                    PhoneNo:    { required: "Please enter a phone number" },
                    Address:    "Enter Address",
                    Country:    "Select Country",
                    ServiceId:  "Select Cause",
                    pmethod:    "Select Payment Method",
                    Amount:     { required: "Required", number: "Enter a valid amount", customMin: "Enter Min $5.00" },
                    recaptcha:  { required: "Please confirm that you are not a robot." }
                },
                errorElement: "em",
                errorPlacement: function (error, element) {
                    error.addClass("help-block");
                    if (element.attr("name") === "Amount") {
                        if ($('#amount-error-container').length === 0) {
                            element.closest('.col-md-5').append('<div id="amount-error-container"></div>');
                        }
                        error.appendTo('#amount-error-container');
                    } else {
                        error.insertAfter(element);
                    }
                }
            });

            // ================================================================
            // SUBMIT BUTTON - handles Credit Card (Braintree nonce) and others
            // ================================================================
        $('#submit-button').on('click', function (e) {
            e.preventDefault();

            var form = $('#SignupForm');
            var paymentMethod = $('#PaymentMethod').val();

            function scrollToFirstError() {
                var $firstError = $('#SignupForm em.help-block:visible').first();

                if ($firstError.length) {
                    $('html, body').animate({
                        scrollTop: $firstError.offset().top - 100
                    }, 500);
                }
            }

            if (paymentMethod === 'Credit Card') {

                if (!form.valid()) {
                    scrollToFirstError();
                    return;
                }

                if (!window.dropinInst) {
                    alert('Payment form not ready. Please wait and try again.');
                    return;
                }

                if (!window.dropinInst.isPaymentMethodRequestable()) {
                    alert('Please fill in your card details before submitting.');
                    return;
                }

                // Disable button while Braintree tokenizes
                var btn = document.getElementById('submit-button');
                btn.disabled = true;
                btn.innerText = 'Processing...';

                window.dropinInst.requestPaymentMethod(function (err, payload) {
                    if (err) {
                        btn.disabled = false;
                        btn.innerText = 'Submit';
                        alert('Card error: ' + err.message);
                        return;
                    }

                    $('#nonce').val(payload.nonce);
                    console.log('Nonce set:', payload.nonce);

                    $('<input>').attr({
                        type: 'hidden',
                        name: 'ClientValidationStatus',
                        value: 'true'
                    }).appendTo(form);

                    form.submit();
                });

                return;
            }

            // Non-Credit-Card methods
            if (!form.valid()) {
                scrollToFirstError();
                return;
            }

            var btn = document.getElementById('submit-button');
            btn.disabled = true;
            btn.innerText = 'Processing...';

            $('<input>').attr({
                type: 'hidden',
                name: 'ClientValidationStatus',
                value: 'true'
            }).appendTo(form);

            form.submit();
        });
            // PayPal button container show/hide on amount input
            $('#round_no').on('input', function () {
                if ($(this).val()) { $('#paypal-button-container').show(); }
                else               { $('#paypal-button-container').hide(); }
            });

            // ================================================================
            // PAYPAL INTEGRATION
            // ================================================================
            if (typeof paypal !== 'undefined') {
                paypal.Buttons({
                    fundingSource: paypal.FUNDING.PAYPAL,
                    style: { layout: 'horizontal', color: 'blue', shape: 'pill', label: 'pay', height: 40 },


                     onInit: function (data, actions) {
            actionStatus = actions;

            // ── Don't call .valid() here — it triggers validation on page load ──
            // Just disable by default, enable only when user interacts
            actions.disable();

                        if ($('#PaymentMethod').val() === 'PayPal') {
                            $('#paypalbuttonshow').show();
                            $('#paypal-button-container').show();
                            $('#button-show').hide();
                        }

           var debounceTimer;
                $('#SignupForm').on('change keyup', function () {
                    clearTimeout(debounceTimer);
                    debounceTimer = setTimeout(function () {
                        paypalReadyCheck();
                    }, 300);
                });
            },
                       onClick: function (data, actions) {
            if (!$('#SignupForm').valid()) {
                var $firstError = $('#SignupForm em.help-block:visible').first();
                if ($firstError.length) {
                    $('html, body').animate({
                        scrollTop: $firstError.offset().top - 100
                    }, 500);
                }
                return actions.reject();
            }
            var amount = $('#round_no').val();
            if (!amount || parseFloat(amount) <= 0) {
                var $amountField = $('#round_no');
                $('html, body').animate({
                    scrollTop: $amountField.offset().top - 100
                }, 500);
                return actions.reject();
            }
            return actions.resolve();
        },

                    createOrder: function (data, actions) {
                        var amount             = $('#round_no').val();
                        var membershipTypeValue = $('#DonationCause1').val();
                        var item               = membershipTypeValue.split('###');

                        return actions.order.create({
                            purchase_units: [{
                                amount: { currency_code: 'USD', value: amount },
                                description: item[0] || "Donation",
                                custom_id:   $('#DonationCause1').val()
                            }],
                            application_context: { shipping_preference: 'NO_SHIPPING' }
                        });
                    },

                    onApprove: function (data, actions) {
                        return actions.order.capture().then(function (details) {
                            var transactionId = details.id;
                            var amount        = details.purchase_units[0].amount.value;
                            var status        = details.status;
                            var payerName     = details.payer.name.given_name + ' ' + details.payer.name.surname;
                            var payerEmail    = details.payer.email_address;

                            if (status === 'COMPLETED') {
                                $('#TransactionId').val(transactionId);
                                $('#PaymentAmount').val(amount);
                                $('#PaymentStatus').val(status);
                                $('#PayerName').val(payerName);
                                $('#PayerEmail').val(payerEmail);

                                $('#payment-status').html('<div class="alert alert-success">Payment completed! Submitting...</div>');
                                $('#paypal-button-container').hide();

                                var formData = new FormData(document.getElementById('SignupForm'));
                                $.ajax({
                                    url:         '@Url.Action("AddServiceDonation", "Services", new { area = "User" })',
                                    type:        'POST',
                                    data:        formData,
                                    processData: false,
                                    contentType: false,
                                    headers:     { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                                    success: function (response) {
                                        if (response && response.redirectUrl) {
                                            window.location.href = response.redirectUrl;
                                        } else {
                                            window.location.href = '@Url.Action("Acknowledgement", "Services", new { area = "User" })'
                                                + '?ServiceDonationId=' + ($('#ServiceDonationId').val() || 0)
                                                + '&cname=' + encodeURIComponent(cnameValue);
                                        }
                                    },
                                    error: function (xhr) {
                                        console.error('Submit error:', xhr.status, xhr.responseText);
                                        $('#payment-status').html('<div class="alert alert-danger">Submission failed. Payment captured. Transaction ID: ' + transactionId + '</div>');
                                    }
                                });
                            } else {
                                $('#payment-status').html('<div class="alert alert-warning">Payment status: ' + status + '</div>');
                            }
                        }).catch(function (err) {
                            console.error('Capture error:', err);
                            $('#payment-status').html('<div class="alert alert-danger">Error: ' + err.message + '</div>');
                        });
                    },

                    onError: function (err) {
                        console.error('PayPal Error:', err);
                        $('#payment-status').html('<div class="alert alert-danger">PayPal error: ' + (err.message || 'Unknown error') + '</div>');
                    },

                    onCancel: function () {
                        $('#payment-status').html('<div class="alert alert-info">Payment was cancelled.</div>');
                    }

                }).render('#paypal-button-container');
            } else {
                console.error('PayPal SDK not loaded.');
            }

            // Init first payment tab
            if ('@(lstpaymentmethods != null && lstpaymentmethods.Count > 0 ? lstpaymentmethods[0].PaymentMethod : "PayPal")' !== '') {
                paymentbind('@(lstpaymentmethods != null && lstpaymentmethods.Count > 0 ? lstpaymentmethods[0].PaymentMethod : "PayPal")');
            }

        }); // end document.ready
</script>

