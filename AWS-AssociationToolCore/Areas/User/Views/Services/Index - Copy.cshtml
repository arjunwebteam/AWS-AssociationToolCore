                                                    <label for="Mailed-2">Handed the cash/cheque to - Name of the @objAppInfo.PresidentPhone board</label>
                                                </div>
                                                <div class="cheque-hide" id="cheque-hide" style="display:none">
                                                    <fieldset class="border p-3" style="width:350px;">
                                                        <legend class="float-none w-auto px-1">Cheque</legend>
                                                        <input type="text" class="input-box" placeholder="Handed the cash/cheque to" id="ChequeHolderName" name="ChequeHolderName">
                                                    </fieldset>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="member-amount">
                                                    <div>
                                                        <div class="aws-amount-total">Total Amount</div>
                                                        <span id="totalamountcash" class="aws-amount">0.00</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Stripe Tab -->
                                <div id="tabstripe" class="cus-tab-pane" style="display:none;">
                                    <div class="zelle-sec paymnet-cmn-sec">
                                        <div class="row">
                                            <div class="col-md-8">
                                                <img src="Content/User/images/Stripe.png" class="img-fluid" alt="" style="height:100px;">
                                            </div>
                                            <div class="col-md-4">
                                                <div class="member-amount">
                                                    <div>
                                                        <div class="aws-amount-total">Total Amount</div>
                                                        <span id="totalstripe" class="">0.00</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- SwirePay Tab -->
                                <div id="tabswire-pay" class="cus-tab-pane" style="display:none;">
                                    <div class="zelle-sec paymnet-cmn-sec">
                                        <div class="row">
                                            <div class="col-md-8">
                                                <img src="Content/User/images/swirepay-new-image.png" class="img-fluid" alt="" style="height:50px;">
                                            </div>
                                            <div class="col-md-4">
                                                <div class="member-amount">
                                                    <div>
                                                        <div class="aws-amount-total">Total Amount</div>
                                                        <span id="totalswirepay" class="">0.00</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>

            <!-- reCAPTCHA -->
            @if (objAppInfo.CAPTCHA == "Yes")
            {
                <div class="col-md-6">
                    <div class="g-recaptcha" data-sitekey="@secreatkey" data-callback="onRecaptchaSuccess"></div>
                    <div class="clearfix mt-4">
                        <input type="hidden" id="recaptchaResponse" name="recaptcha">
                    </div>
                </div>
            }

            <!-- PayPal Button -->
            <div class="col-md-6" id="paypalbuttonshow" style="display:none;">
                <div class="text-md-end text-center">
                    <div id="paypal-button-container" style="width:250px;float:right;"></div>
                    <div id="payment-status"></div>
                </div>
            </div>

            <!-- Submit Button -->
            <div class="col-md-6" style="display:none;" id="button-show">
                <div class="text-md-end text-center">
                    <button class="aws-btn" type="submit" id="submit-button">Submit</button>
                </div>
            </div>


        </div>
    }
</div>

