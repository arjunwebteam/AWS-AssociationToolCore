            cell3.align     = 'center';
            cell3.innerHTML = '<span id="del-' + (rowCount - 1) + '"><a onclick="javascript:deleteRow(' + rowCount + ')" class="darkgray-text"><img alt="Delete" title="Delete" src="Content/User/images/delete.gif" class="margin-top-5" /></a></span>';
            $('#hdnRowCount').val(rowCount);

            $("#Percentage-" + (rowCount - 1)).attr('onchange', 'sumpercentage()').attr('onkeypress', 'return Common.isNumberKey(event)');

            ServicesList(rowCount - 1);
            $('#del-' + (rowCount - 2)).html('');
            if ((rowCount) == @TotalServices) { $('#spp2').hide(); }
        }

        function deleteRow(i) {
            try {
                var row = document.getElementById(i);
                row.parentNode.removeChild(row);
                contributionupdate();
                $('#del-' + (i - 2)).html('<a onclick="javascript:deleteRow(' + (i - 1) + ')" class="darkgray-text"><img alt="Delete" title="Delete" src="Content/User/images/delete.gif" class="margin-top-5" /></a>');
                var table    = document.getElementById("contributionfo");
                var rowCount = table.rows.length;
                if ((rowCount - 2) < 4) { $('#spp2').show(); }
            } catch (e) { alert(e); }
        }

        $(document).ready(function () {
            $('#round_no').on('input', function () {
                let amt = $(this).val().replace(/\D/g, '');
                $(this).val(amt);
                round_off();
            });
        });

        // ================================================================
        // ROUND OFF - amount entry handler
        // ================================================================
        function round_off() {
            var type = $('#PaymentMethod').val();

            // -- Button visibility
            if (type === "PayPal") {
                $('#paypal-button-container').show();
                $('#submit-button').hide();
                $('#button-show').show();
                $('#paypalbuttonshow').show();
            } else if (type === "Credit Card") {
                $('#paypal-button-container').hide();
                $('#paypalbuttonshow').hide();
                $('#button-show').show();
                $('#submit-button').show();
            }
            else if (type == "Square") {
                $('#paypalbuttonshow').hide();
                $('#paypal-button-container').hide();
                $('#button-show').hide();
                $('#submit-button').hide();
                $('#proceedtopay1').hide();
                $('#proceedtopay').hide();
                $('#submitbtn').hide();
                $('#btnCashProceed').hide();
                $('#btnZelleProceed').hide();
                $('#btnProceedPay').show().prop('disabled', false).text('Proceed to Pay');
                $('#card-button').hide();
                $('#hidebutton').hide();
                $('#square-timer-display').hide();
            } else {
                $('#paypal-button-container').hide();
                $('#paypalbuttonshow').hide();
                $('#button-show').show();
                $('#submit-button').show();
            }

            // -- Amount empty check
            if ($('#round_no').val() === "") {
                $('#spanAmount').hide().html('');
                $('#Disblbtn').show();
                $('#Mainbtn').hide();
                $('#BT_Amount').val('');
                window.NEW_PAYMENT_AMOUNT = '';
                return false;
            }

            var amt  = $('#round_no').val();
            var amt1 = parseInt(amt, 10);

            if (isNaN(amt1)) {
                $('#spanAmount').html('Please enter a valid amount.');
                return false;
            }

            $('#amount1').val(amt1);
            $('#round_no').val(amt1);
            $('#BT_Amount').val(amt1);         // ← Braintree reads this field
            window.NEW_PAYMENT_AMOUNT = amt1;  // ← fallback

            var formattedAmt = amt1.toFixed(2);

            // -- Update all amount display spans
            $('#payamount').html(formattedAmt);
            $('#totalamountzelle').html(formattedAmt);
            $('#creditamount').html(formattedAmt);
            $('#totalamountcash').html(formattedAmt);
            $('#totalstripe').html(formattedAmt);
            $('#totalswirepay').html(formattedAmt);

            // -- Fire amount-updated so Braintree partial re-inits
            $(document).trigger("amount-updated");

            // -- Debounced Braintree re-init when typing stops
            if (type === "Credit Card" && typeof window.startBraintree === 'function') {
                clearTimeout(braintreeInitTimer);
                braintreeInitTimer = setTimeout(function () {
                    window.startBraintree();
                }, 800);
            }

            // -- Donation cause hidden field
            $('#DonationCause1').val("Donation Registration###" + formattedAmt);

            // -- Validation
               if (amt1 >= 5) {
                    $('#spanAmount').html('');
                    $('#Disblbtn').hide();
                    $('#Mainbtn').show();
                    if (type === "PayPal") {
                        paypalReadyCheck();
                    }
                } else {
                    $('#spanAmount').html('Amount &lt; 5.00 USD.');
                    $('#Disblbtn').show();
                    $('#Mainbtn').hide();
                    if (typeof actionStatus !== 'undefined') {
                        try { actionStatus.disable(); } catch (e) {}
                    }
                    return false;
                }

                return true;
            }

            // ── NEW: only enable PayPal button when ALL required fields for payment are ready ──
            function paypalReadyCheck() {
                var amt = parseFloat($('#round_no').val());
                var causeSelected = $('#ServiceId').val();
                var isReady = amt >= 5 && !!causeSelected;

                if (typeof actionStatus !== 'undefined') {
                    try {
                        if (isReady) { actionStatus.enable(); }
                        else { actionStatus.disable(); }
                    } catch (e) {}
                }
                return isReady;
            }

        // ================================================================
        // PAYMENT BIND - tab switcher
        // ================================================================
    function paymentbind(type) {
        console.log('paymentbind:', type);

        if (type === "PayPal") {
            $('#paypalbuttonshow').show();
            $('#paypal-button-container').show();
            $('#button-show').hide();
            $('#submit-button').hide();
        } else if (type == "Square") {
            $('#paypalbuttonshow').hide();
            $('#paypal-button-container').hide();
            $('#button-show').hide();
            $('#submit-button').hide();
            $('#proceedtopay1').hide();
            $('#proceedtopay').hide();
            $('#submitbtn').hide();
            $('#btnCashProceed').hide();
            $('#btnZelleProceed').hide();
            $('#btnProceedPay').show().prop('disabled', false).text('Proceed to Pay');
            $('#card-button').hide();
            $('#hidebutton').hide();
            $('#square-timer-display').hide();
        } else {
            $('#paypalbuttonshow').hide();
            $('#paypal-button-container').hide();
            $('#button-show').show();
            $('#submit-button').show();
        }

        $('#PaymentMethod').val(type);

        // ── ONLY run rules/resetForm if validator is already initialized ──
        var validator = $('#SignupForm').data('validator');
        if (validator) {
            $("#CardNumber, #CardName, #Cvv, #CSVYear, #CSVMonth").rules("remove");
            $("#Zelle, #ZellePartnerName, #filezelle").rules("remove");
            $("#file1").rules("remove");

            if (type === "AuthorizeNet") {
                $("#CardNumber").rules("add", { required: true });
                $("#CardName").rules("add",   { required: true });
                $("#Cvv").rules("add",        { required: true });
                $("#CSVYear").rules("add",    { required: true });
                $("#CSVMonth").rules("add",   { required: true });
            } else if (type === "Credit Card") {
                var amount = parseFloat($('#round_no').val());
                if (!amount || isNaN(amount) || amount < 5) {
                    alert("Please enter a minimum $5 donation amount first.");
                    paymentbind('PayPal');
                    return;
                }
                $('#paypal-button-container').hide();
                $('#dropin-container').show();
                function tryInitBT() {
                    if (typeof window.startBraintree === "function") {
                        if (!window.dropinInst) { window.startBraintree(); }
                    } else {
                        setTimeout(tryInitBT, 200);
                    }
                }
                tryInitBT();
            } else if (type === "Zelle") {
                $("#Zelle").rules("add",           { required: true });
                $("#ZellePartnerName").rules("add", { required: true });
                $("#filezelle").rules("add",        { required: true });
            } else if (type === "Cash/Cheque") {
                $("#file1").rules("add",           { required: true });
            }

            validator.resetForm();
            $('.has-error').removeClass('has-error');
            $('.has-success').removeClass('has-success');
        }

        // Activate tab panel
        var cleanedTabId = "tab" + type.toLowerCase().replace(/[^a-z0-9\s]/g, '').trim().replace(/\s+/g, '-');
        $('.cus-tab-pane').removeClass('active').hide();
        $('#' + cleanedTabId).addClass('active').show();

        // Highlight tab button
        $('.cus-tab-label').removeClass('active');
        $('.cus-tab-label[value="' + type + '"]').addClass('active');
    }
        // ================================================================
        // CONTRIBUTION helpers (General Donation)
        // ================================================================
        function contributionupdate() {
            var table    = document.getElementById("contributionfo");
            var rowCount = table.rows.length;
            var rows     = rowCount - 1;
            var per      = (100 / rows).toFixed(2);
            $('.per_class').val(per);
            sumpercentage();
        }

        function sumpercentage() {
            var sum = 0;
            $(".per_class").each(function () { sum += +$(this).val(); });
            $("#TotalPercent").val(sum);
            if ($('#GID').val() == 1) { $('#GID').val(0); }
            else { Validate(); }
        }

        function ServicesList(rowid) {
            $.ajax({
                url:   '@Url.Action("ServicesGetListByChapterId", "Services")',
                type:  'POST',
                cache: false,
                success: function (result) {
                    if (result.ok) {
                        var lstServices = result.data;
                        var sb1 = "";
                        if (lstServices != null) {
                            var table    = document.getElementById("contributionfo");
                            var rowCount = table.rows.length;
                            var rows     = rowCount - 1;
                            for (var k = 0; k < lstServices.length; k++) {
                                var x = 0;
                                for (var i = 0; i <= rows; i++) {
                                    if (lstServices[k].ServiceId == $('#ServiceId-' + i).val()) { x = 1; }
                                }
                                if (x == 0) {
                                    sb1 = sb1 + "<option value=\"" + lstServices[k].ServiceId + "\">" + lstServices[k].ServiceTitle + "</option>";
                                }
                            }
                        }
                        $('#ServiceId-' + rowid).append(sb1);
                        contributionupdate();
                    }
                }
            });
        }

        function Validates(stype) {
            var return_val = true;
            var amt        = $('#round_no').val();
            var needamt    = Math.round((500000), 0);
            if (amt == 0) { $('#spanAmount').hide().html(''); return_val = false; }
            else {
                $('#spanAmount').hide().html('');
                if (amt < 5) { $('#spanAmount').html('Please enter amount atleast $5.'); return_val = false; }
                else if (amt > needamt && '@objServices.ServiceId' != 0) { $('#spanAmount').html('Entered amount is exceeded.'); return_val = false; }
                else { $('#spanAmount').html(''); RECAMTBIND(); }
            }
            return return_val;
        }

        function RECAMTBIND() {
            if ($('#RecurrCheckbox').prop("checked") == true) {
                $('#Field1').val($('#round_no').val());
                $('#RecurringAmount').val($('#round_no').val());
            }
        }

        function RecurrDivFunction() {
            if ($('#RecurrCheckbox').prop("checked") == true) {
                $('#Field1').val($('#round_no').val());
                $('#RecurrDiv').show('slow');
            } else {
                $('#RecurringAmount').val('');
                $('#RecurringType').val('');
                $('#RecurringStartTime').val('');
                $('#RECDate').val('');
                $('#RType').val('');
                $('#ReccurId').val('');
                $('#RecurrDiv').hide('slow');
            }
        }

        function PhoneNochange(event) {
            if (event.keyCode != 8 && event.keyCode != 46) {
                var ph = $('#PhoneNo').val();
                if (ph.length == 3) { $('#PhoneNo').val(ph + '-'); }
                if (ph.length == 7) { $('#PhoneNo').val(ph + '-'); }
            }
        }

        function EmailValidate() {
            if ($.trim($('#Email').val()) != '') {
                if (!Common.CheckEmail($.trim($('#Email').val()))) {
                    $('#spanEmail').show().html('Please enter valid email address.<span>&nbsp;</span><i>&nbsp;</i><abbr onclick="closeValidation(this);">&nbsp;</abbr>');
                    $('#Email').focus().addClass("error2"); return false;
                } else { $('#spanEmail').hide().html(''); }
            }
        }

        function ZipValidate() {
            if ($.trim($('#ZipCode').val()) != '') {
                if ($('#ZipCode').val().length < 5) {
                    $('#spanZipCode').show().html('Please enter valid Zip Code.<span>&nbsp;</span><i>&nbsp;</i><abbr onclick="closeValidation(this);">&nbsp;</abbr>');
                    $('#ZipCode').focus().addClass("error2"); return false;
                } else { $('#spanZipCode').hide().html(''); }
            }
        }

        function onRecaptchaSuccess(token) {
            $("#recaptchaResponse").val(token);
              $("#recaptchaResponse").valid();
        }

        var specialKeys = [8, 9, 32, 46, 36, 35, 37, 39];

        function onlyAlphabets(e, t) {
            try {
                var charCode = window.event ? window.event.keyCode : (e ? e.which : 0);
                if (!charCode) return true;
                if ((charCode == 32) || (charCode > 64 && charCode < 91) || (charCode > 96 && charCode < 123) || (specialKeys.indexOf(e.keyCode) != -1 && e.charCode != e.keyCode))
                    return true;
                else return false;
            } catch (err) { alert(err.Description); }
        }
</script>

