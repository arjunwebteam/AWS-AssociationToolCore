@using System.Configuration
@{    
    int status = 0;

    AWSFormBuilder.Areas.FormBuilder.BLL.AppInfo _AppInfo = new AWSFormBuilder.Areas.FormBuilder.BLL.AppInfo();
    AWSFormBuilder.Entities.AppInfo objAppInfo = new AWSFormBuilder.Entities.AppInfo();

    objAppInfo = _AppInfo.GetAppInfoDetails(ref status);
    ViewBag.Title = "User Validate - " + objAppInfo.SiteName;
    Layout = null;
}
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" class="bg-black">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta content='width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no' name='viewport' />
    @{var baseurl = objAppInfo.BaseUrl;}
    <base href="@(baseurl)" />
    <title>@objAppInfo.SiteName - Control Panel</title>
    <link rel="shortcut icon" href="Areas/FormBuilder/Content/Admin/images/fevicon.ico" />
    <!-- Bootstrap -->
    <link href="Areas/FormBuilder/Content/Admin/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="Areas/FormBuilder/Content/Admin/common-styles.css" rel="stylesheet" type="text/css" />
    <link href="Areas/FormBuilder/Content/Admin/fullcalendar/fullcalendar.css" rel="stylesheet" type="text/css" />
    <link href="Areas/FormBuilder/Content/Admin/daterangepicker/daterangepicker-bs3.css" rel="stylesheet" type="text/css" />
    <link href="Areas/FormBuilder/Content/Admin/bootstrap-wysihtml5/bootstrap3-wysihtml5.min.css" rel="stylesheet" type="text/css" />
    <link href="Areas/FormBuilder/Content/Admin/admin-styles.css" rel="stylesheet" type="text/css" />
    <!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
          <script src="https://oss.maxcdn.com/libs/html5shiv/3.7.0/html5shiv.js"></script>
          <script src="https://oss.maxcdn.com/libs/respond.js/1.3.0/respond.min.js"></script>
        <![endif]-->
    <!-- add new calendar event modal -->
    <script src="Scripts/Admin/jquery-1.8.3.js" type="text/javascript"></script>
    <script src="Scripts/Admin/jquery-ui-1.9.2.custom.min.js" type="text/javascript"></script>
    <!-- Bootstrap -->

    <script src="Scripts/Admin/bootstrap.min.js" type="text/javascript"></script>
    <script src="Scripts/Admin/Common.js" type="text/javascript"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
            $('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
        });
    </script>

    <style>
        .login-sec {
            background: #fff;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
            text-align: center;
            width: 90%;
            max-width: 450px;
            position: absolute;
            top: 0;
            right: 30%;
        }

            .login-sec img {
                max-width: 200px;
                margin-bottom: 15px;
            }

        .login-head {
            font-size: 22px;
            font-weight: bold;
            margin-bottom: 25px;
            color: #333;
        }

        .alert {
            background: #ffeaea;
            padding: 18px;
            border: 1px solid #f3b5b5;
            border-radius: 6px;
            color: #a40000;
            font-weight: 500;
            margin-bottom: 25px;
            position: relative;
        }

            .alert .close {
                position: absolute;
                top: 10px;
                right: 15px;
                background: none;
                border: none;
                font-size: 18px;
                color: #a40000;
                cursor: pointer;
            }

        .red-t {
            color: #b30000;
            text-decoration: underline;
        }

        .login-btn {
            background-color: #ff6600;
            color: white;
            border: none;
            padding: 12px 28px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
            font-size: 15px;
            transition: background 0.3s ease;
        }

            .login-btn:hover {
                background-color: #e65300;
            }

        .bg-black {
            position: relative;
        }
    </style>





</head>
<body class="bg-black">
   

    <div class="bg-black">
        <div class="login-sec">
            <div class="login-form">
                <div class="text-center">
                    <a href="#"><img src="Content/Admin/images/logo1.png" alt="@objAppInfo.SiteName" title="@objAppInfo.SiteName" /></a>
                </div>
                <div class="login-head text-center">@objAppInfo.SiteName</div>

                


                <div>
                    @Html.Raw(TempData["message"]) 
                  
                
                </div>
              


                    <div>
                        <button class="login-btn" type="submit" onclick="window.open('admin', '_blank');">Go to Login </button>
                    </div>
               
            </div>
    </div>







</body>
</html> 