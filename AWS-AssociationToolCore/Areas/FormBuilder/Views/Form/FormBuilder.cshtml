        var FB_MAIL_TEMPLATE_BASE_URL = '@Url.Action("EditByForm", "MailTemplates", new { formId = ViewBag.FormId })';

        var FB_HIDE_WHILE_PANEL_OPEN_IDS = ['conditionsBtn', 'customizeBtn', 'formDesignerBtn', 'previewBtn'];

        // ALL of the mutually-exclusive header buttons. Only one of these is ever
        // "active" (highlighted) at a time — Form Builder is active by default,
        // and opening Customize / Form Designer / Thank You Page / Mail Templates
        // always clears it from every other button first.
        var FB_HEADER_BUTTON_IDS = ['backToBuilderBtn', 'customizeBtn', 'formDesignerBtn', 'thankYouPageBtn', 'mailTemplateToggleBtn'];

        function setActiveHeaderButton(activeId) {
            FB_HEADER_BUTTON_IDS.forEach(function (id) {
                var el = document.getElementById(id);
                if (!el) return;
                el.classList.toggle('active', id === activeId);
            });
        }

        function setBuilderOnlyButtonsVisible(visible) {
            FB_HIDE_WHILE_PANEL_OPEN_IDS.forEach(function (id) {
                var el = document.getElementById(id);
                if (el) el.style.display = visible ? '' : 'none';
            });
        }

        function hideEmbedPanels() {
            var typ = document.getElementById('fbThankYouPanelView');
            var mtp = document.getElementById('fbMailTemplatePanelView');
            if (typ) typ.style.display = 'none';
            if (mtp) mtp.style.display = 'none';
        }

        function showFormBuilderView() {
            hideEmbedPanels();
            document.getElementById('fbWorkspaceView').style.display = '';
            setBuilderOnlyButtonsVisible(true);
            setActiveHeaderButton('backToBuilderBtn');
        }

        function showThankYouPanel() {
            closeMailDropdown();
            document.getElementById('fbWorkspaceView').style.display = 'none';
            hideEmbedPanels();
            setBuilderOnlyButtonsVisible(false);

            var frame = document.getElementById('fbThankYouFrame');
            var url = FB_THANK_YOU_URL + (FB_THANK_YOU_URL.indexOf('?') > -1 ? '&' : '?') + 'embed=1';
            if (frame.getAttribute('data-loaded-url') !== url) {
                frame.src = url;
                frame.setAttribute('data-loaded-url', url);
            }
            document.getElementById('fbThankYouPanelView').style.display = 'block';

            setActiveHeaderButton('thankYouPageBtn');
        }

        function showMailTemplatePanel(mailType) {
            closeMailDropdown();
            document.getElementById('fbWorkspaceView').style.display = 'none';
            hideEmbedPanels();
            setBuilderOnlyButtonsVisible(false);

            var frame = document.getElementById('fbMailTemplateFrame');
            var url = FB_MAIL_TEMPLATE_BASE_URL + '&mailType=' + encodeURIComponent(mailType) + '&embed=1';
            frame.src = url;
            frame.setAttribute('data-loaded-url', url);
            document.getElementById('fbMailTemplatePanelView').style.display = 'block';

            setActiveHeaderButton('mailTemplateToggleBtn');
        }

        function toggleMailDropdown(e) {
            e.stopPropagation();
            var menu = document.getElementById('mailTemplateDropdownMenu');
            if (menu) menu.classList.toggle('open');
        }

        function closeMailDropdown() {
            var menu = document.getElementById('mailTemplateDropdownMenu');
            if (menu) menu.classList.remove('open');
        }

        document.addEventListener('click', function (e) {
            var dd = document.getElementById('mailTemplateDropdown');
            if (dd && !dd.contains(e.target)) closeMailDropdown();
        });
    </script>
