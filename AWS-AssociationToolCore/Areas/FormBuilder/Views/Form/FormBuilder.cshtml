    AWSFormBuilder.Entities.AppInfo objAppInfo = _AppInfo.GetAppInfoDetails(ref status);
}

<script>

    window.zfbAppRecaptchaSiteKey = @Html.Raw(Json.Serialize(objAppInfo != null ? objAppInfo.CapchaSiteKey : null));
</script>

