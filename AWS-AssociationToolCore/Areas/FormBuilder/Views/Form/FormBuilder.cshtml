    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

</head>
<script>
    @if (ViewBag.FormSchema != null)
    {
         <text>
            document.addEventListener('DOMContentLoaded', function loadExistingForm() {
            try {
                const savedFields = JSON.parse(@Html.Raw(Json.Serialize((string)ViewBag.FormSchema)));
                formFields = savedFields || [];


                fieldCounter = formFields.reduce(function (max, f) {
                    const m = /^f(\d+)$/.exec(f.id || '');
                    return m ? Math.max(max, parseInt(m[1], 10)) : max;
                }, 0);


                const seenFieldIds = new Set();
                formFields.forEach(function (f) {
                    if (!f.id || seenFieldIds.has(f.id)) {
                        fieldCounter++;
                        f.id = 'f' + fieldCounter;
                    }
                    seenFieldIds.add(f.id);
                });

                const savedFormTitle = @Html.Raw(Json.Serialize((string)ViewBag.FormTitle));

                const logoUrl = @Html.Raw(Json.Serialize((string)ViewBag.LogoUrl));
                if (logoUrl) {
                    document.getElementById('logoUrl').value = logoUrl;

                    const savedWidth = @Html.Raw(Json.Serialize((int?)ViewBag.LogoWidth));
                    const savedHeight = @Html.Raw(Json.Serialize((int?)ViewBag.LogoHeight));
                    logoWidth = savedWidth || null;
                    logoHeight = savedHeight || 110;

                    updateLogoPreview(logoUrl);
                }

                const designJson = @Html.Raw(Json.Serialize((string)ViewBag.FormDesign));
                if (designJson) {
                    try {
                        const savedDesign = JSON.parse(designJson);
                        formDesign = Object.assign({}, formDesign, savedDesign || {});


                        if (typeof loadGoogleFont === 'function') {
                            loadGoogleFont(formDesign.fontFamily);
                        }
                    } catch (e2) {
                        console.error('Failed to parse saved form design', e2);
                    }
                }


                const submitBtnEl = document.querySelector('.fb-submit-btn');
                if (submitBtnEl) submitBtnEl.textContent = formDesign.submitButtonText || 'Submit';


                const conditionsJson = @Html.Raw(Json.Serialize((string)ViewBag.FormConditions));
                if (conditionsJson) {
                    try {
                        formConditions = JSON.parse(conditionsJson) || [];
                        conditionCounter = formConditions.reduce(function (max, c) {
                            const m = /^c(\d+)$/.exec(c.id || '');
                            return m ? Math.max(max, parseInt(m[1], 10)) : max;
                        }, 0);
                    } catch (e3) {
                        console.error('Failed to parse saved conditions', e3);
                    }
                }

                if (typeof ensureTitleField === 'function') {
                    ensureTitleField(savedFormTitle);
                }
                if (typeof lastKnownFormTitle !== 'undefined') {
                    lastKnownFormTitle = savedFormTitle || '';
                }
                if (typeof syncTitlePayloadFromField === 'function') {
                    syncTitlePayloadFromField();
                }

                renderCanvas();
                                                                    } catch (e) {
                    console.error('Failed to load existing form', e);
                    alert('LOAD ERROR: ' + e.message + '\n\nLine info:\n' + (e.stack || 'no stack'));
                }
                });
        </text>
    }

</script>
<script src="~/Areas/FormBuilder/Content/scripts/zfb-formbuilder.js?ver=@objAppInfo.DesktopVersion.ToString()"></script>
<script>
    /* Small dark toast (bottom-centre, auto-hides after 2s) that replaces the
       old blocking "Form saved! FormId: 46" browser popup. The save code lives in
       zfb-formbuilder.js and calls alert('Form saved! FormId: ...'), so that one
       message is intercepted here and shown as a toast instead — every other
       alert() in the builder (validation messages etc.) still works as before. */
    (function () {
        var TOAST_MS = 2000;
        var toastTimer = null;

        function injectToastStyle() {
            if (document.getElementById('zfbToastStyle')) return;
            var s = document.createElement('style');
            s.id = 'zfbToastStyle';

            s.textContent =
                '.zfb-toast{position:fixed;left:50%;bottom:32px;transform:translate(-50%,12px);' +
                'background-color:green;color:#fff;padding:13px 20px;border-radius:6px;font-size:14px;' +
                'font-family:inherit;box-shadow:0 4px 14px rgba(0,0,0,.28);opacity:0;' +
                'transition:opacity .25s ease,transform .25s ease;z-index:2147483647;pointer-events:none;}' +
                '.zfb-toast.show{opacity:1;transform:translate(-50%,0);}';
            document.head.appendChild(s);
        }

        window.zfbToast = function (message) {
            injectToastStyle();
            var el = document.getElementById('zfbToast');
            if (!el) {
                el = document.createElement('div');
                el.id = 'zfbToast';
                el.className = 'zfb-toast';
                el.setAttribute('role', 'status');
                document.body.appendChild(el);
            }
            el.textContent = message;
            void el.offsetWidth; // restart the transition if a toast is already showing
            el.classList.add('show');
            clearTimeout(toastTimer);
            toastTimer = setTimeout(function () { el.classList.remove('show'); }, TOAST_MS);
        };

        var nativeAlert = window.alert.bind(window);
        window.alert = function (msg) {
            if (/^\s*form saved/i.test(String(msg == null ? '' : msg))) {
                window.zfbToast('Form updated successfully');
                return;
            }
            nativeAlert(msg);
        };
    })();
</script>
<script>
    /* ✅ ADDED — page look for the builder canvas (view-only decoration).
       Adds a footer to each page (Next on page 1, Back + Next on middle pages,
       Back + Submit on the last page) and moves "+ Add New Page" under the
       form card. The added pieces are tagged .zfb-injected, are rebuilt after
       every canvas render, and never touch formFields. */
    (function () {
        var decorating = false;
        var observer = null;

        function bandColors(canvas) {

            var el = canvas.parentNode, bg = '';
            while (el && el.nodeType === 1) {
                var c = getComputedStyle(el).backgroundColor;
                if (c && c !== 'transparent' && c !== 'rgba(0, 0, 0, 0)') { bg = c; break; }
                el = el.parentNode;
            }
            var card = getComputedStyle(canvas).backgroundColor;
            if (bg) canvas.style.setProperty('--zfb-band-bg', bg);
            if (card && card !== 'rgba(0, 0, 0, 0)') canvas.style.setProperty('--zfb-card-bg', card);
        }

        function makeBtn(text, back, like) {
            var b;
            if (!back && like) {
                b = like.cloneNode(true);          // same colours as the real Submit button
                b.removeAttribute('id');
                b.className = (like.className || '') + ' zfb-fake-nav zfb-injected';
                b.textContent = text;
            } else {
                b = document.createElement('button');
                b.className = 'zfb-fake-nav zfb-fake-back zfb-injected';
                b.textContent = text;
            }
            b.type = 'button';
            b.tabIndex = -1;
            return b;
        }

        window.zfbDecoratePages = function () {
            var canvas = document.getElementById('canvas');
            if (!canvas) return;
            decorating = true;
            try {
                Array.prototype.slice.call(canvas.querySelectorAll('.zfb-injected')).forEach(function (n) { n.remove(); });
                bandColors(canvas);

                var submit = document.getElementById('canvasSubmitWrapper');
                var submitBtn = submit ? submit.querySelector('.fb-submit-btn, .zfb-submit-btn') : null;

                var addRow = document.getElementById('addPageBtnWrapper');
                if (addRow && canvas.parentNode && addRow.previousElementSibling !== canvas) {
                    canvas.parentNode.insertBefore(addRow, canvas.nextSibling);
                }

                var breaks = Array.prototype.filter.call(canvas.children, function (el) {
                    return el.classList.contains('zfb-pagebreak-item') || !!el.querySelector(':scope > .zfb-pagebreak-row');
                });

                breaks.forEach(function (brk, i) {
                    var footer = document.createElement('div');
                    footer.className = 'zfb-page-footer zfb-injected' + (i === 0 ? ' zfb-footer-first' : '');
                    if (i > 0) footer.appendChild(makeBtn('Back', true));
                    footer.appendChild(makeBtn('Next', false, submitBtn));
                    canvas.insertBefore(footer, brk);
                });

                if (submit && breaks.length) {
                    submit.insertBefore(makeBtn('Back', true), submit.firstChild);
                }
            } finally {
                if (observer) observer.takeRecords();
                decorating = false;
            }
        };


        window.zfbInjectedBefore = function (el) {
            var n = 0, s = el;
            while ((s = s.previousElementSibling)) { if (s.classList.contains('zfb-injected')) n++; }
            return n;
        };

        document.addEventListener('DOMContentLoaded', function () {
            var canvas = document.getElementById('canvas');
            if (!canvas) return;
            observer = new MutationObserver(function () {
                if (!decorating) window.zfbDecoratePages();
            });
            observer.observe(canvas, { childList: true });
            window.zfbDecoratePages();
        });
    })();
</script>
<div class="zfb-app zfb-app-embedded">

    <header class="zfb-topbar fb-header-sticky">
