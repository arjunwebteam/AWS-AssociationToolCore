<script>
    // Note: the top-nav "Form Title" (#formTitleText) is kept in sync by
    // syncTitlePayloadFromField() in zfb-formbuilder.js. It can now ALSO be
    // edited directly here — click the text or the pencil icon
    // (startTopNavTitleEdit/commitTopNavTitleEdit/cancelTopNavTitleEdit,
    // defined in zfb-formbuilder.js) — in addition to editing on the canvas
    // heading field itself (click its Customize icon), same as any other
    // heading. Both paths write to the same underlying title field, so
    // either stays in sync with the other.

    document.addEventListener("DOMContentLoaded", function () {
        var fieldSearch = document.getElementById("zfbFieldSearch");
        var clearButton = document.getElementById("zfbFieldSearchClear");
        if (!fieldSearch || !clearButton) return;

        function filterFields() {
            var searchValue = fieldSearch.value.trim().toLowerCase();
            var activeTab = document.getElementById("paletteTabLabels").style.display !== "none" ? "labels" : "payments";
            var scope = activeTab === "labels" ? document.getElementById("paletteList") : document.getElementById("paymentPaletteList");

            scope.querySelectorAll(".zfb-field-chip").forEach(function (item) {
                var fieldText = item.textContent.toLowerCase();
                item.style.display = fieldText.includes(searchValue) ? "" : "none";
            });

            clearButton.style.display = searchValue.length > 0 ? "flex" : "none";
        }

        fieldSearch.addEventListener("input", filterFields);

        clearButton.addEventListener("click", function () {
            fieldSearch.value = "";
            document.querySelectorAll(".zfb-field-chip").forEach(function (item) {
                item.style.display = "";
            });
            clearButton.style.display = "none";
            fieldSearch.focus();
        });
    });
</script>


