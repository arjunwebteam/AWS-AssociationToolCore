        </aside>

        <main class="zfb-main">
            <div class="zfb-canvas-scroll">

                <div class="zfb-canvas fb-canvas" id="canvas">

                    <!-- ✅ ADDED — "Page 1" marker so the first page is labeled
                         the same way later pages are (via the pagebreak "PAGE N"
                         markers in renderCanvas()). Static and undeletable since
                         there's always exactly one first page. -->
                    <div class="zfb-first-page-label">Page 1</div>

                    <div id="canvasLogoBanner" class="zfb-canvas-logo-banner fb-canvas-logo-banner" style="display:none;" onclick="selectLogo();" title="Click to customize logo">
                        <img id="canvasLogoImg" src="" alt="Form Logo" />
                        <div class="zfb-side-icons fb-side-icons">
                            <button type="button" class="zfb-icon-btn fb-icon-btn zfb-icon-edit" onclick="selectLogo(); event.stopPropagation();" title="Customize"><i class="icon-settings-2"></i></button>
                            <button type="button" class="zfb-icon-btn fb-icon-btn fb-icon-delete zfb-icon-delete" onclick="deleteLogo(); event.stopPropagation();" title="Delete"><i class="icon-trash-2"></i></button>
                        </div>
                    </div>
                    <!-- Form Title is no longer a separate stuck element here — it's
                         formFields[0], a normal heading field rendered by renderCanvas()
                         with the same edit/delete/drag behavior as any other heading. -->
                    <div class="zfb-empty-hint fb-empty-hint" id="emptyHint"><i class="icon-panel-left"></i>Drag fields here to build your form</div>
                    <!-- ✅ ADDED — Multi-page forms. Always sits right above the Submit
                         preview; renderCanvas() re-positions it there after every render
                         so it's always after the last field, whichever page that's on.
                         Clicking it appends a "pagebreak" marker field (addNewPage() in
                         zfb-formbuilder.js) which renders as its own draggable/deletable
                         row (see renderCanvas()'s pagebreak branch) — drag it to reorder
                         where the page split happens, or delete it to merge pages back. -->
                    <div class="zfb-add-page-row fb-add-page-row" id="addPageBtnWrapper">
                        <span class="zfb-add-page-line"></span>
                        <button type="button" class="zfb-add-page-btn" onclick="addNewPage()">+ Add New Page</button>
                        <span class="zfb-add-page-line"></span>
                    </div>
                    <div class="zfb-canvas-submit fb-canvas-submit" id="canvasSubmitWrapper" data-type="submit">
                        <button type="button" class="zfb-submit-btn fb-submit-btn">Submit</button>
                        <div class="zfb-side-icons fb-side-icons">
                            <button type="button" class="zfb-icon-btn fb-icon-btn fb-icon-delete zfb-icon-delete" onclick="deleteSubmitButton(event)" title="Delete Submit"><i class="icon-trash-2"></i></button>
                        </div>
                    </div>
                </div>
            </div>
