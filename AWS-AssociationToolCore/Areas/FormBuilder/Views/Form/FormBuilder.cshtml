    function addNewCondition() {
        const triggerable = condTriggerableFields();
        if (!triggerable.length) {
            alert('Add at least one field to the form before creating a condition.');
            return;
        }
        conditionCounter++;
        condDraft = {
            id: 'c' + conditionCounter,
            triggerFieldId: triggerable[0].id,
            operator: 'equals',
            triggerValue: '',
            category: 'showhide',
            action: 'show',
            targetFieldIds: [],
            sourceFieldId: ''
        };
        condEditingId = null;

        condModalView = 'category';
        renderConditionsModal();
    }

    function editCondition(id) {
        const rule = formConditions.find(r => r.id === id);
        if (!rule) return;
        condDraft = JSON.parse(JSON.stringify(rule));
        if (!condDraft.category) condDraft.category = condGroupForAction(condDraft.action); // ✅ ADDED — infer category for rules saved before this existed
        condEditingId = id;
        condModalView = 'editor';
        renderConditionsModal();
    }

    function selectConditionCategory(catId) {
        if (!condDraft) return;
        condDraft.category = catId;
        const group = COND_ACTION_GROUPS.find(g => g.id === catId);
        if (group && !group.actions.includes(condDraft.action)) {
            condDraft.action = group.actions[0];
        }
        renderConditionsModal();
    }

    function proceedToConditionEditor() {
        if (!condDraft || !condDraft.category) return;
        condModalView = 'editor';
        renderConditionsModal();
    }

    function backToConditionCategory() {
        if (!condDraft) return;
        condModalView = 'category';
        renderConditionsModal();
    }

    function deleteCondition(id) {
        if (!confirm('Delete this condition?')) return;
        formConditions = formConditions.filter(r => r.id !== id);
        renderConditionsModal();
    }

    function cancelConditionEditor() {
        condDraft = null;
        condEditingId = null;
        condModalView = 'list';
        renderConditionsModal();
    }

    function updateConditionDraft(key, value) {
        if (!condDraft) return;
        condDraft[key] = value;
        if (key === 'triggerFieldId') {
            condDraft.triggerValue = '';
        }
        renderConditionsModal();
    }

    function toggleConditionTarget(fieldId, checked) {
        if (!condDraft) return;
        if (!Array.isArray(condDraft.targetFieldIds)) condDraft.targetFieldIds = [];
        if (checked) {
            if (!condDraft.targetFieldIds.includes(fieldId)) condDraft.targetFieldIds.push(fieldId);
        } else {
            condDraft.targetFieldIds = condDraft.targetFieldIds.filter(id => id !== fieldId);
        }
    }

    function saveConditionDraft() {
        if (!condDraft || !condDraft.triggerFieldId) return;
        if (condDraft.category === 'update' && !condDraft.sourceFieldId) {
            alert('Choose which field\'s value should be copied.');
            return;
        }
        if (!condDraft.targetFieldIds || !condDraft.targetFieldIds.length) {
            alert(condDraft.category === 'update'
                ? 'Select at least one field to copy the value into.'
                : 'Select at least one target field for this condition.');
            return;
        }
        if (condOperatorNeedsValue(condDraft.operator) && !condDraft.triggerValue) {
            alert('Enter a value to compare against, or choose an operator that doesn\'t need one (Is Checked / Is Empty / Is Not Empty).');
            return;
        }
        if (condEditingId) {
            const idx = formConditions.findIndex(r => r.id === condEditingId);
            if (idx > -1) formConditions[idx] = condDraft;
        } else {
            formConditions.push(condDraft);
        }
        condDraft = null;
        condEditingId = null;
        condModalView = 'list';
        renderConditionsModal();
    }

    function renderConditionsModal() {
        const body = document.getElementById('condModalBody');
        const title = document.getElementById('condModalTitle');

        if (condModalView === 'category') {
            title.textContent = 'Manage Conditional Logic';
            body.innerHTML = `
                <div class="fb-cond-category">
                    <div class="fb-cond-category-grid">
                        ${COND_ACTION_GROUPS.map(g => `
                            <div class="fb-cond-category-card ${condDraft.category === g.id ? 'active' : ''}" onclick="selectConditionCategory('${g.id}')">
                                <input type="radio" name="condCategory" ${condDraft.category === g.id ? 'checked' : ''} onclick="event.stopPropagation(); selectConditionCategory('${g.id}')">
                                <div>
                                    <div class="fb-cond-category-title">${g.label}</div>
                                    <div class="fb-cond-category-desc text-muted small">${g.desc}</div>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button type="button" class="btn btn-outline-secondary" onclick="cancelConditionEditor()">Cancel</button>
                        <button type="button" class="btn btn-primary" onclick="proceedToConditionEditor()">Continue</button>
                    </div>
                </div>
            `;
            return;
        }

        if (condModalView === 'editor') {
            title.textContent = condEditingId ? '✏️ Edit Condition' : '➕ New Condition';
            const triggerable = condTriggerableFields();
            const triggerField = formFields.find(f => f.id === condDraft.triggerFieldId);
            const needsValue = condOperatorNeedsValue(condDraft.operator);
            const hasOptions = triggerField && Array.isArray(triggerField.options) && triggerField.options.length;
            const category = condDraft.category || condGroupForAction(condDraft.action);
            const group = COND_ACTION_GROUPS.find(g => g.id === category) || COND_ACTION_GROUPS[0];
            const groupActions = COND_ACTIONS.filter(a => group.actions.includes(a.id));
            const isUpdate = category === 'update';

            const targetable = isUpdate
                ? condTargetableFields(condDraft.sourceFieldId)
                : condTargetableFields(condDraft.triggerFieldId);

            body.innerHTML = `
                <div class="fb-cond-editor">
                    <a href="javascript:void(0)" class="fb-cond-back-link" onclick="backToConditionCategory()">← Select Condition Action Type</a>

                    <label class="form-label mt-2">If</label>
                    <select class="form-select mb-2" onchange="updateConditionDraft('triggerFieldId', this.value)">
                        ${triggerable.map(f => `<option value="${f.id}" ${f.id === condDraft.triggerFieldId ? 'selected' : ''}>${f.label} (${f.type})</option>`).join('')}
                    </select>

                    <label class="form-label">Condition</label>
                    <select class="form-select mb-2" onchange="updateConditionDraft('operator', this.value)">
                        ${COND_OPERATORS.map(o => `<option value="${o.id}" ${o.id === condDraft.operator ? 'selected' : ''}>${o.label}</option>`).join('')}
                    </select>

                    ${needsValue ? `
                        <label class="form-label">Value</label>
                        ${hasOptions ? `
                            <select class="form-select mb-2" onchange="updateConditionDraft('triggerValue', this.value)">
                                <option value="">-- Select a value --</option>
                                ${triggerField.options.map(o => `<option value="${o}" ${o === condDraft.triggerValue ? 'selected' : ''}>${o}</option>`).join('')}
                            </select>
                        ` : `
                            <input type="text" class="form-control mb-2" value="${condDraft.triggerValue || ''}" onchange="updateConditionDraft('triggerValue', this.value)" placeholder="Value to compare against" />
                        `}
                    ` : ''}

                    ${isUpdate ? `
                        <label class="form-label">Then copy value from</label>
                        <select class="form-select mb-2" onchange="updateConditionDraft('sourceFieldId', this.value)">
                            <option value="">-- Select a field --</option>
                            ${triggerable.map(f => `<option value="${f.id}" ${f.id === condDraft.sourceFieldId ? 'selected' : ''}>${f.label} (${f.type})</option>`).join('')}
                        </select>

                        <label class="form-label">Into field(s)</label>
                    ` : `
                        <label class="form-label">Then</label>
                        <select class="form-select mb-2" onchange="updateConditionDraft('action', this.value)">
                            ${groupActions.map(a => `<option value="${a.id}" ${a.id === condDraft.action ? 'selected' : ''}>${a.label}</option>`).join('')}
                        </select>

                        <label class="form-label">On field(s)</label>
                    `}
                    <div class="fb-cond-target-list">
                        ${targetable.length ? targetable.map(f => `
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="condTarget_${f.id}"
                                       ${condDraft.targetFieldIds && condDraft.targetFieldIds.includes(f.id) ? 'checked' : ''}
                                       onchange="toggleConditionTarget('${f.id}', this.checked)">
                                <label class="form-check-label" for="condTarget_${f.id}">${f.label} (${f.type})</label>
                            </div>
                        `).join('') : '<p class="text-muted small">No other fields available to target.</p>'}
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button type="button" class="btn btn-outline-secondary" onclick="cancelConditionEditor()">Cancel</button>
                        <button type="button" class="btn btn-primary" onclick="saveConditionDraft()">Save Condition</button>
                    </div>
                </div>
            `;
            return;
        }

        // List view
        title.textContent = '⚙️ Conditional Logic';
        const opLabel = id => (COND_OPERATORS.find(o => o.id === id) || {}).label || id;
        const actionLabel = id => (COND_ACTIONS.find(a => a.id === id) || {}).label || id;
        const thenLabel = rule => rule.action === 'update'
            ? `Copy "${condFieldLabel(rule.sourceFieldId)}" into ${(rule.targetFieldIds || []).map(condFieldLabel).join(', ') || '(none)'}`
            : `${actionLabel(rule.action)}: ${(rule.targetFieldIds || []).map(condFieldLabel).join(', ')}`;

        body.innerHTML = `
            <div class="fb-cond-list">
                ${formConditions.length ? formConditions.map(rule => `
                    <div class="fb-cond-row">
                        <div>
                            <div><strong>If</strong> ${condFieldLabel(rule.triggerFieldId)} <strong>${opLabel(rule.operator).toLowerCase()}</strong>${condOperatorNeedsValue(rule.operator) ? ` "${rule.triggerValue}"` : ''}</div>
                            <div class="text-muted small"><strong>Then</strong> ${thenLabel(rule)}</div>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="editCondition('${rule.id}')">Edit</button>
                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteCondition('${rule.id}')">Delete</button>
                        </div>
                    </div>
                `).join('') : '<p class="text-muted small">No conditions yet. Conditions let you show/hide, require, mask, or copy values between fields based on what the visitor fills in elsewhere on the form.</p>'}
            </div>
            <button type="button" class="btn btn-primary w-100 mt-3" onclick="addNewCondition()">+ Add New Condition</button>
        `;
    }


</script>

