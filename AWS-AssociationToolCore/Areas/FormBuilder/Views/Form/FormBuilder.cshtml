    // ✅ ADDED — if a field was dropped on (or right beside) an empty page's
    // "Drag fields here…" box, snap it to sit directly under that page's heading
    // (i.e. immediately before the box) and return the index it would have had
    // if it had been dropped exactly there — so it lands INSIDE that page.
    // Any other drop keeps the original evt.newIndex untouched.
    function zfbIndexAfterEmptyPageDrop(evt) {
        var item = evt.item;
        var prev = item.previousElementSibling;
        var next = item.nextElementSibling;
        var hint = (prev && prev.classList.contains('zfb-page-dropzone-hint')) ? prev
                 : (next && next.classList.contains('zfb-page-dropzone-hint')) ? next
                 : null;

        // The view-only page footers (.zfb-injected) are extra nodes in the canvas;
        // take them out of the count so the index means what it always did.
        var injected = (typeof zfbInjectedBefore === 'function') ? zfbInjectedBefore(item) : 0;
        if (!hint) return evt.newIndex - injected;

        hint.parentNode.insertBefore(item, hint);
        var idx = 0, el = item;
        while ((el = el.previousElementSibling)) {
            if (el.nodeName.toUpperCase() !== 'TEMPLATE' && !el.classList.contains('zfb-injected')) idx++;
        }
        return idx;
    }

