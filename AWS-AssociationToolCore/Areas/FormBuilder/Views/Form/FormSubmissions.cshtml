@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewBag.Title = "Forms";
    Layout = "~/Areas/FormBuilder/Views/Shared/_MainLayout.cshtml";
}
@{
    string sortcolumn = (string)ViewBag.sortcolumn;
    string sortorder = (string)ViewBag.sortorder;
    Int64 Total = (Int64)ViewBag.total;
    var PageNo = (Int64)ViewBag.pageno;
    var Items = (Int64)ViewBag.items;
    var FormId = (Int64)ViewBag.FormId;
    var FormPublicId = AWSFormBuilder.Areas.FormBuilder.BLL.FormLinkObfuscator.EncryptFormId(FormId);
    var FormTitle = (string)ViewBag.FormTitle;
    bool hasPayment = ViewBag.HasPayment == true;   
    var lstSubmissions = ViewBag.lstSubmissions as List<AWSFormBuilder.Entities.FormSubmissionModel>;
    var summaryFields = ViewBag.SummaryFields as List<dynamic>;
    var allFormFields = ViewBag.AllFormFields as List<dynamic>;
    ViewBag.Pageheading = @FormTitle;
    Int64 mid = ViewBag.mid;

    string userRole = HttpContextAccessor.HttpContext.Session.GetString("userrole") ?? "";

    bool IsEdit = Convert.ToBoolean(Context.Session.GetString("IsEdit"));
    bool IsView = Convert.ToBoolean(Context.Session.GetString("IsView"));
    bool IsDelete = Convert.ToBoolean(Context.Session.GetString("IsDelete"));
    bool IsExport = Convert.ToBoolean(Context.Session.GetString("IsExport"));
    bool IsAdd = Convert.ToBoolean(Context.Session.GetString("IsAdd"));
}

<div class="zentic-card">
    <div class="zentic-card-header">


        <div class="d-flex gap-2">
            <div class="btn btn-primarymahi">@FormTitle</div>
        </div>
    </div>

    <!-- Toolbar -->
    <div class="zentic-card-header registration-page-toolbar">
        <div class="registration-toolbar-left">
            <div class="topbar-search registration-search-box">
                <i class="icon-search search-icon" id="registrationSearchIcon"></i>

                <input type="text"
                       class="search-input"
                       id="txtsearch"
                       placeholder="Search submissions..."
                       autocomplete="off"
                       onkeydown="if(event.key==='Enter'){SearchSubmissions();}" />
            </div>
        </div>

        <div class="registration-toolbar-right">

            <a class="registration-view-btn btn btn-secondary"
               href="@Url.Action("Index", "Form", new { mid = ViewBag.mid })">
                <i class="icon-arrow-left"></i>
                Back to Form List
            </a>
            @if (IsExport == true)
            {
                <button type="button"
                        class="btn btn-success registration-export-btn"
                        onclick="ExportSubmissionsToExcel();">
                    <i class="icon-file-spreadsheet"></i>
                    Export Excel
                </button>
            }

        </div>
    </div>

    <!-- Table -->
    <div class="zentic-table-wrapper reg-page">

        <table class="zentic-table" id="bt1">

            <thead>
                <tr>

                    <th style="text-align:center">
                        S.No.
                    </th>

                    <th>
                        <a class="cursor-pointer sort-link"
                           style="color:inherit;"
                           onclick="sortresult('SubmissionId');">

                            Submission Id

                            @if (sortcolumn == "SubmissionId")
                            {
                                <img alt="@sortorder"
                                     src="Areas/FormBuilder/Content/images/sort_@(sortorder).gif" />
                            }

                        </a>
                    </th>

                    @if (summaryFields != null)
                    {
                        foreach (var field in summaryFields)
                        {
                            var fieldId = field.Id.ToString();
                            var fieldLabel = field.Label.ToString();

                            <th>
                                <a class="cursor-pointer sort-link"
                                   style="color:inherit;"
                                   onclick="sortresult('@fieldId');">

                                    @fieldLabel

                                    @if (sortcolumn == fieldId)
                                    {
                                        <img alt="@sortorder"
                                             src="Areas/FormBuilder/Content/images/sort_@(sortorder).gif" />
                                    }

                                </a>
                            </th>
                        }
                    }

                    <th>
                        <a class="cursor-pointer sort-link"
                           style="color:inherit;"
                           onclick="sortresult('SubmittedDate');">

                            Submitted Date

                            @if (sortcolumn == "SubmittedDate")
                            {
                                <img alt="@sortorder"
                                     src="Areas/FormBuilder/Content/images/sort_@(sortorder).gif" />
                            }

                        </a>
                    </th>

                    <th>
                        Action
                    </th>

                </tr>
            </thead>

            <tbody>

                @if (lstSubmissions != null && lstSubmissions.Count != 0)
                {
                    int counter = (int)((PageNo - 1) * Items + 1);

                    foreach (var item in lstSubmissions)
                    {
                        var rawSubmissionData =
                        Newtonsoft.Json.JsonConvert.DeserializeObject<Dictionary<string, object>>(
                        item.SubmittedData
                        );

                        var submissionData = rawSubmissionData != null
                        ? new Dictionary<string, object>(
                        rawSubmissionData,
                        StringComparer.OrdinalIgnoreCase
                        )
                        : null;

                        <tr data-registration-row>

                            <td style="text-align:center">
                                @counter
                            </td>

                            <td>
                                @item.SubmissionId
                            </td>

                            @if (summaryFields != null)
                            {
                                foreach (var field in summaryFields)
                                {
                                    var fieldLabel = field.Label.ToString();
                                    var displayValue = "N/A";

                                    if (submissionData != null &&
                                    submissionData.ContainsKey(fieldLabel))
                                    {
                                        var value = submissionData[fieldLabel];

                                        if (value != null)
                                        {
                                            if (value is string strValue)
                                            {
                                                displayValue =
                                                strValue.Length > 30
                                                ? strValue.Substring(0, 30) + "..."
                                                : strValue;
                                            }
                                            else if (value is bool boolValue)
                                            {
                                                displayValue =
                                                boolValue ? "Yes" : "No";
                                            }
                                            else
                                            {
                                                displayValue = value.ToString();
                                            }
                                        }
                                    }

                                    <td>
                                        <span>@displayValue</span>
                                    </td>
                                }
                            }

                            <td>
                                @item.SubmittedDate
                            </td>

                            <td>
                                @if (IsView == true)



                                {

                                    <a class="btn p-0 text-primary table-action-btn"
                                       title="PreView"
                                       onclick="viewSubmissionDetail(@item.SubmissionId)">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>

                                }
                                @if (IsDelete == true)

                                {
                                    <a class="btn p-0 text-danger table-action-btn"
                                       title="Delete"
                                       onclick="DeleteFormSubmission(@item.SubmissionId)">
                                        <i class="fa-solid fa-x"></i>
                                    </a>
                                }

                            </td>

                        </tr>

                        counter++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="@(summaryFields != null ? summaryFields.Count + 4 : 5)"
                            class="text-center">
                            No Records found
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

    <!-- Footer -->
    <div class="zentic-card-footer">

        <div class="table-entries-info">
            Showing
            @((PageNo * Items) - (Items - 1))
            -
            @((PageNo * Items) > Total ? Total : (PageNo * Items))
            of
            @Total
            entries
        </div>

        <nav class="table-pagination"
             aria-label="Page navigation">

            @Html.Raw(
            AWSFormBuilder.Areas.FormBuilder.BLL.Common.SetPaging(
            (Int64)ViewBag.items,
            ref Total,
            (Int64)ViewBag.pageno,
            "pagination mb-0"
            )
                        )

        </nav>

    </div>

</div>


<!-- ========================================================= -->
<!-- Submission Details Modal -->
<!-- ========================================================= -->

<div class="aws-submission-overlay"
     id="awsSubmissionModal"
     aria-hidden="true">

    <div class="aws-submission-modal">

        <!-- Header -->
        <div class="aws-submission-modal-header">

            <div>

                <span class="aws-submission-header-label">
                    FORM SUBMISSION
                </span>

                <h4>
                    Submission Details
                </h4>

            </div>

            <button type="button"
                    class="aws-submission-close"
                    onclick="closeSubmissionDetails()"
                    aria-label="Close submission details">

                <i class="icon-x"></i>

            </button>

        </div>

        <!-- Body -->
        <div class="aws-submission-modal-body"
             id="submissionDetailContent">

            <div class="text-center py-5">

                <div class="spinner-border text-primary"
                     role="status">

                    <span class="visually-hidden">
                        Loading...
                    </span>

                </div>

            </div>

        </div>

        <!-- Footer -->
        <div class="aws-submission-modal-footer">

            <button type="button"
                    class="aws-submission-close-btn"
                    onclick="closeSubmissionDetails()">

                Close

            </button>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- Export Excel Field Picker Modal -->
<!-- ========================================================= -->

<div class="aws-export-overlay"
     id="awsExportModal"
     aria-hidden="true">

    <div class="aws-export-modal">

        <!-- Header -->
        <div class="aws-export-modal-header">

            <div>

                <span class="aws-export-header-label">
                    EXPORT TO EXCEL
                </span>

                <h4>
                    @FormTitle
                </h4>

            </div>

            <button type="button"
                    class="aws-export-close"
                    onclick="closeExportModal()"
                    aria-label="Close export dialog">

                <i class="icon-x"></i>

            </button>

        </div>


        <!-- Body -->
        <div class="aws-export-modal-body">

            <!-- Select All -->
            <label class="aws-export-select-all-row">

                <span>
                    Select All
                </span>

                <input type="checkbox"
                       id="awsExportSelectAll"
                       checked
                       onchange="toggleExportSelectAll(this)" />

            </label>


            <!-- ================================================= -->
            <!-- SUBMISSION DETAILS (the 3 built-in columns) -->
            <!-- ================================================= -->
            @* ✅ ADDED — "Submission Id" / "Submitted By" / "Submitted Date" used to be forced into
               every export. They're now just like any other field: checked by default, and only
               end up as columns in the sheet if left checked here. *@

            <div class="aws-export-field-heading">
                Submission Details
            </div>

            <div class="aws-export-field-list">

                <label class="aws-export-field-row">

                    <span class="aws-export-field-label">
                        Submission Id
                    </span>

                    <input type="checkbox"
                           class="aws-export-field-checkbox"
                           value="Submission Id"
                           checked
                           onchange="onExportFieldToggle()" />

                </label>


                <label class="aws-export-field-row">

                    <span class="aws-export-field-label">
                        Submitted By
                    </span>

                    <input type="checkbox"
                           class="aws-export-field-checkbox"
                           value="Submitted By"
                           checked
                           onchange="onExportFieldToggle()" />

                </label>


                <label class="aws-export-field-row">

                    <span class="aws-export-field-label">
                        Submitted Date
                    </span>

                    <input type="checkbox"
                           class="aws-export-field-checkbox"
                           value="Submitted Date"
                           checked
                           onchange="onExportFieldToggle()" />

                </label>

            </div>


            <!-- ================================================= -->
            <!-- FORM FIELDS -->
            <!-- ================================================= -->

            <div class="aws-export-field-heading aws-export-field-heading-spaced">
                Form Fields
            </div>

            <div class="aws-export-field-list"
                 id="awsExportFieldList">

                @if (allFormFields != null && allFormFields.Count > 0)
                {
                    foreach (var field in allFormFields)
                    {
                        var fieldLabel = field.Label.ToString();

                        <label class="aws-export-field-row">

                            <span class="aws-export-field-label">
                                @fieldLabel
                            </span>

                            <input type="checkbox"
                                   class="aws-export-field-checkbox"
                                   value="@fieldLabel"
                                   checked
                                   onchange="onExportFieldToggle()" />

                        </label>
                    }
                }
                else
                {
                    <div class="aws-export-no-fields">
                        No fields found for this form.
                    </div>
                }

            </div>


            @if (hasPayment)
            {
                <!-- ================================================= -->
                <!-- PAYMENT FIELDS -->
                <!-- ================================================= -->

                <div class="aws-export-field-heading aws-export-field-heading-spaced">
                    Payment Fields
                </div>

                <div class="aws-export-field-list">

                    <label class="aws-export-field-row">

                        <span class="aws-export-field-label">
                            Payment Gateway
                        </span>

                        <input type="checkbox"
                               class="aws-export-field-checkbox"
                               value="Payment Gateway"
                               checked
                               onchange="onExportFieldToggle()" />

                    </label>


                    <label class="aws-export-field-row">

                        <span class="aws-export-field-label">
                            Payment Status
                        </span>

                        <input type="checkbox"
                               class="aws-export-field-checkbox"
                               value="Payment Status"
                               checked
                               onchange="onExportFieldToggle()" />

                    </label>


                    <label class="aws-export-field-row">

                        <span class="aws-export-field-label">
                            Amount
                        </span>

                        <input type="checkbox"
                               class="aws-export-field-checkbox"
                               value="Amount"
                               checked
                               onchange="onExportFieldToggle()" />

                    </label>


                    <label class="aws-export-field-row">

                        <span class="aws-export-field-label">
                            Transaction ID
                        </span>

                        <input type="checkbox"
                               class="aws-export-field-checkbox"
                               value="Transaction ID"
                               checked
                               onchange="onExportFieldToggle()" />

                    </label>

                </div>
            }

        </div>


        <!-- Footer -->
        <div class="aws-export-modal-footer">

            <button type="button"
                    class="aws-export-cancel-btn"
                    onclick="closeExportModal()">

                Cancel

            </button>

            <button type="button"
                    class="aws-export-submit-btn"
                    onclick="submitExportModal()">

                Export Data

            </button>

        </div>

    </div>

</div>


<style>

    /* ========================================================= */
    /* Payment Status */
    /* ========================================================= */

    .aws-payment-pending {
        color: #b98900;
    }

    .aws-payment-failed {
        color: #d9364f;
    }


    /* ========================================================= */
    /* Export Overlay */
    /* ========================================================= */

    .aws-export-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(20, 24, 34, 0.55);
        z-index: 1060;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

        .aws-export-overlay.aws-export-show {
            display: flex;
        }


    /* ========================================================= */
    /* Export Modal */
    /* ========================================================= */

    .aws-export-modal {
        background: #fff;
        width: 100%;
        max-width: 560px;
        max-height: 85vh;
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
    }


    /* ========================================================= */
    /* Header */
    /* ========================================================= */

    .aws-export-modal-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        padding: 18px 22px;
        border-bottom: 1px solid #eceff3;
        flex-shrink: 0;
    }

        .aws-export-modal-header h4 {
            margin: 2px 0 0;
            font-size: 18px;
            font-weight: 700;
            color: #1f2430;
        }

    .aws-export-header-label {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.06em;
        color: #7a7fbf;
    }

    .aws-export-close {
        background: transparent;
        border: none;
        font-size: 18px;
        color: #7c8598;
        cursor: pointer;
        line-height: 1;
        padding: 4px;
    }

        .aws-export-close:hover {
            color: #1f2430;
        }


    /* ========================================================= */
    /* Modal Body */
    /* ========================================================= */

    .aws-export-modal-body {
        padding: 18px 22px;
        overflow-y: auto;
        flex: 1;
    }


    /* ========================================================= */
    /* Select All */
    /* ========================================================= */

    .aws-export-select-all-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 14px;
        background: #f4f6fb;
        border-radius: 8px;
        font-weight: 700;
        color: #1f2430;
        cursor: pointer;
        margin-bottom: 14px;
    }

        .aws-export-select-all-row input[type="checkbox"] {
            width: 17px;
            height: 17px;
            cursor: pointer;
        }


    /* ========================================================= */
    /* Section Heading */
    /* ========================================================= */

    .aws-export-field-heading {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #8a92a6;
        margin-bottom: 8px;
    }

    .aws-export-field-heading-spaced {
        margin-top: 18px;
    }


    /* ========================================================= */
    /* 2 COLUMN FIELD GRID */
    /* ========================================================= */

    .aws-export-field-list {
        border: 1px solid #eceff3;
        border-radius: 8px;
        /*
                                2 fields per row
                            */
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        overflow: hidden;
        background: #fff;
    }


    /* ========================================================= */
    /* Individual Field */
    /* ========================================================= */

    .aws-export-field-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-width: 0;
        padding: 11px 14px;
        cursor: pointer;
        color: #33384a;
        background: #fff;
        border-bottom: 1px solid #f1f3f7;
        /*
                                Add right border to left column
                            */
        border-right: 1px solid #f1f3f7;
    }


        /*
                            Remove right border from every second field
                        */
        .aws-export-field-row:nth-child(even) {
            border-right: none;
        }


        /*
                            Remove bottom border from last row
                            when number of fields is even.
                        */
        .aws-export-field-row:nth-last-child(-n + 2) {
            border-bottom: none;
        }


        .aws-export-field-row:hover {
            background: #fafbfd;
        }


    /* Field label */
    .aws-export-field-label {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        padding-right: 8px;
    }


    /* Checkbox */
    .aws-export-field-row input[type="checkbox"] {
        width: 16px;
        height: 16px;
        cursor: pointer;
        flex-shrink: 0;
        margin-left: 8px;
    }


    /* ========================================================= */
    /* No Fields */
    /* ========================================================= */

    .aws-export-no-fields {
        padding: 16px;
        text-align: center;
        color: #8a92a6;
        grid-column: 1 / -1;
    }


    /* ========================================================= */
    /* Footer */
    /* ========================================================= */

    .aws-export-modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding: 14px 22px;
        border-top: 1px solid #eceff3;
        flex-shrink: 0;
    }


    /* Cancel */
    .aws-export-cancel-btn {
        background: #fff;
        border: 1px solid #d7dce1;
        color: #4a5063;
        border-radius: 6px;
        padding: 8px 18px;
        font-weight: 600;
        cursor: pointer;
    }

        .aws-export-cancel-btn:hover {
            background: #f4f6fb;
        }


    /* Submit */
    .aws-export-submit-btn {
        background: #2fa66a;
        border: 1px solid #2fa66a;
        color: #fff;
        border-radius: 6px;
        padding: 8px 20px;
        font-weight: 600;
        cursor: pointer;
    }

        .aws-export-submit-btn:hover {
            background: #26895a;
        }


    /* ========================================================= */
    /* Mobile */
    /* ========================================================= */

    @@media (max-width: 576px) {
        .aws-export-modal {
            max-width: 100%;
            max-height: 90vh;
        }
        /*
                                On mobile use one field per row
                            */
        .aws-export-field-list {
            grid-template-columns: 1fr;
        }

        .aws-export-field-row {
            border-right: none;
            border-bottom: 1px solid #f1f3f7;
        }

            .aws-export-field-row:nth-child(even) {
                border-right: none;
            }

            .aws-export-field-row:nth-last-child(-n + 2) {
                border-bottom: 1px solid #f1f3f7;
            }

            .aws-export-field-row:last-child {
                border-bottom: none;
            }
    }</style>


<script>

    /* ========================================================= */
    /* Submission Details Modal */
    /* ========================================================= */

    function openSubmissionDetails() {

        var modal = document.getElementById("awsSubmissionModal");

        if (!modal) return;

        modal.classList.add("aws-submission-show");

        modal.setAttribute("aria-hidden", "false");

        document.body.classList.add("aws-modal-open");
    }


    function closeSubmissionDetails() {

        var modal = document.getElementById("awsSubmissionModal");

        if (!modal) return;

        modal.classList.remove("aws-submission-show");

        modal.setAttribute("aria-hidden", "true");

        document.body.classList.remove("aws-modal-open");
    }


    document.addEventListener("DOMContentLoaded", function () {

        var modal = document.getElementById("awsSubmissionModal");

        if (!modal) return;

        modal.classList.remove("aws-submission-show");

        modal.setAttribute("aria-hidden", "true");


        modal.addEventListener("click", function (event) {

            if (event.target === modal) {
                closeSubmissionDetails();
            }

        });


        document.addEventListener("keydown", function (event) {

            if (
                event.key === "Escape" &&
                modal.classList.contains("aws-submission-show")
            ) {
                closeSubmissionDetails();
            }

        });

    });


    /* ========================================================= */
    /* Delete Submission */
    /* ========================================================= */

     function DeleteFormSubmission(SubmissionId) {

        var val2 = confirm(
            "Do you want to delete this submission?"
        );

        if (val2) {

            $.ajax({

                type: "POST",

                url: '@Url.Action("DeleteFormSubmission", "Form")',

                data: {
                    SubmissionId: SubmissionId
                },

                success: function (result) {

                    // success & error rendu cases lo message show avutundi
                    showLobiboxNotification(
                        result.messageType,
                        result.message
                    );

                    if (result.ok) {

                        // notification kanipinchadaniki 1.5 sec wait chesi reload
                        setTimeout(function () {
                            window.location.reload();
                        }, 1500);

                    }

                },

                error: function () {

                    showLobiboxNotification(
                        "error",
                        "Something went wrong. Please try again."
                    );

                }

            });

        }

    }



    /* ========================================================= */
    /* Sorting */
    /* ========================================================= */

    function sortresult(column) {

        var currentSortColumn =
            '@ViewBag.sortcolumn';

        var currentSortOrder =
            '@ViewBag.sortorder';

        var formId =
            '@FormPublicId';


        var newSortOrder;

        if (currentSortColumn === column) {

            newSortOrder =
                (currentSortOrder === 'asc')
                    ? 'desc'
                    : 'asc';

        } else {

            newSortOrder = 'asc';

        }


             var url =
            '@Url.Action("FormSubmissions", "Form")' +
            '?formId=' +
            encodeURIComponent(formId) +
            '&SortColumn=' +
            column +
            '&SortOrder=' +
            newSortOrder +
            '&PageNo=1' +
            '&Items=@Items' +
            '&mid=@mid';


        var searchText =
            $('#txtsearch').val();

        if (searchText) {

            url +=
                '&Search=' +
                encodeURIComponent(searchText);

        }


        window.location.href = url;
    }


    /* ========================================================= */
    /* Search */
    /* ========================================================= */

    function SearchSubmissions() {

        var formId =
            '@FormPublicId';

        var searchText =
            $('#txtsearch').val() || '';


         var url =
            '@Url.Action("FormSubmissions", "Form")' +
            '?formId=' +
            encodeURIComponent(formId) +
            '&Search=' +
            encodeURIComponent(searchText) +
            '&PageNo=1' +
            '&Items=@Items' +
            '&mid=@mid';


        window.location.href = url;
    }


    /* ========================================================= */
    /* File Helpers */
    /* ========================================================= */

    function isUploadedFileUrl(value) {

        return typeof value === 'string' &&
            /^https?:\/\/.+\/uploads\/FormSubmissionFiles\//i
                .test(value);
    }


    function getFileNameFromUrl(value) {

        var parts = value.split('/');

        return decodeURIComponent(
            parts[parts.length - 1] || value
        ).split('?')[0];
    }


    function renderFileValue(value) {

        var ext =
            (value.split('.').pop() || '')
                .toLowerCase()
                .split('?')[0];

        var isImage =
            ['jpg', 'jpeg', 'png']
                .indexOf(ext) !== -1;

        var fileName =
            getFileNameFromUrl(value);


        if (isImage) {

            return `
                <span class="aws-form-data-value aws-file-value">

                    <img src="${value}"
                         alt="Uploaded image"
                         style="
                            width:32px;
                            height:32px;
                            object-fit:cover;
                            border-radius:6px;
                            border:1px solid #d7dce1;
                         " />

                    ${fileName}

                    <a href="${value}"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="aws-file-action"
                       title="View Image">

                        <i class="icon-eye"></i>

                    </a>

                </span>
            `;

        }


        return `
            <span class="aws-form-data-value aws-file-value">

                <i class="icon-file-text"></i>

                ${fileName}

                <a href="${value}"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="aws-file-action"
                   title="View File">

                    <i class="icon-eye"></i>

                </a>

            </span>
        `;
    }


    /* ========================================================= */
    /* View Submission */
    /* ========================================================= */

    function viewSubmissionDetail(submissionId) {

        $('#submissionDetailContent').html(`

            <div class="text-center py-5">

                <div class="spinner-border text-primary"
                     role="status">

                    <span class="visually-hidden">
                        Loading...
                    </span>

                </div>

            </div>

        `);


        openSubmissionDetails();


        $.ajax({

            url: '@Url.Action("GetSubmissionDetail", "Form")',

            type: 'GET',

            data: {
                id: submissionId
            },

            success: function (response) {

                if (response.success) {

                    renderSubmissionDetail(response);

                } else {

                    $('#submissionDetailContent').html(
                        '<div class="alert alert-danger">' +
                        'Failed to load submission details.' +
                        '</div>'
                    );

                }

            },

            error: function () {

                $('#submissionDetailContent').html(
                    '<div class="alert alert-danger">' +
                    'An error occurred.' +
                    '</div>'
                );

            }

        });

    }


    /* ========================================================= */
    /* Render Submission */
    /* ========================================================= */

    function renderSubmissionDetail(data) {

        var html = `

            <div class="aws-submission-info-grid">

                <div class="aws-submission-info-card">

                    <div class="aws-submission-info-icon">
                        <i class="icon-circle-user"></i>
                    </div>

                    <div>

                        <span class="aws-submission-label">
                            Submitted By
                        </span>

                        <strong>
                            ${data.submittedBy || 'N/A'}
                        </strong>

                    </div>

                </div>


                <div class="aws-submission-info-card">

                    <div class="aws-submission-info-icon">
                        <i class="icon-calendar"></i>
                    </div>

                    <div>

                        <span class="aws-submission-label">
                            Submitted Date
                        </span>

                        <strong>
                            ${data.submittedDate || 'N/A'}
                        </strong>

                    </div>

                </div>

            </div>
        `;


        /* ===================================================== */
        /* Payment */
        /* ===================================================== */

        var hasPayment =
            data.paymentStatus ||
            data.paymentTxnId ||
            data.paymentGateway ||
            (
                data.paymentAmount !== null &&
                data.paymentAmount !== undefined
            ) ||
            data.paymentCurrency;


        if (hasPayment) {

            var paymentStatus =
                data.paymentStatus || 'N/A';

            var paymentTxnId =
                data.paymentTxnId || 'N/A';

            var paymentGateway =
                data.paymentGateway || 'N/A';

            var paymentCurrency =
                data.paymentCurrency || '';


            var paymentAmount =
                data.paymentAmount !== null &&
                data.paymentAmount !== undefined
                    ? data.paymentAmount
                    : 'N/A';


            if (paymentGateway !== 'N/A') {

                paymentGateway =
                    paymentGateway.charAt(0).toUpperCase() +
                    paymentGateway.slice(1);

            }


            var statusClass =
                'aws-payment-pending';

            var statusIcon =
                'icon-clock';


            if (
                paymentStatus.toLowerCase() ===
                'completed'
            ) {

                statusClass =
                    'aws-payment-success';

                statusIcon =
                    'icon-check';

            }
            else if (
                paymentStatus.toLowerCase() ===
                'failed'
            ) {

                statusClass =
                    'aws-payment-failed';

                statusIcon =
                    'icon-x';

            }
            else if (
                paymentStatus.toLowerCase() ===
                'pending'
            ) {

                statusClass =
                    'aws-payment-pending';

                statusIcon =
                    'icon-clock';

            }


            html += `

                <section class="aws-submission-section">

                    <div class="aws-submission-section-heading">

                        <div>

                            <span class="aws-submission-section-kicker">
                                TRANSACTION
                            </span>

                            <h5>
                                Payment Details
                            </h5>

                        </div>

                    </div>


                    <div class="aws-payment-card">


                        <div class="aws-payment-item">

                            <span>
                                Payment Gateway
                            </span>

                            <strong>
                                ${paymentGateway}
                            </strong>

                        </div>


                        <div class="aws-payment-item">

                            <span>
                                Payment Status
                            </span>

                            <strong class="${statusClass}">

                                <i class="${statusIcon}"></i>

                                ${paymentStatus}

                            </strong>

                        </div>


                        <div class="aws-payment-item">

                            <span>
                                Amount
                            </span>

                            <strong>
                                ${paymentCurrency}
                                ${paymentAmount}
                            </strong>

                        </div>


                        <div class="aws-payment-item aws-payment-transaction">

                            <span>
                                Transaction ID
                            </span>

                            <strong>
                                ${paymentTxnId}
                            </strong>

                        </div>


                    </div>

                </section>
            `;
        }


        /* ===================================================== */
        /* Form Data */
        /* ===================================================== */

        html += `

            <section class="aws-submission-section">

                <div class="aws-submission-section-heading">

                    <div>

                        <span class="aws-submission-section-kicker">
                            SUBMISSION
                        </span>

                        <h5>
                            Form Data
                        </h5>

                    </div>

                </div>


                <div class="aws-form-data-card">
        `;


        try {

            var formData =
                JSON.parse(data.data);


            if (
                typeof formData === 'object' &&
                formData !== null
            ) {

                Object.keys(formData)
                    .forEach(function (key) {

                        var value =
                            formData[key];


                        var label =
                            key.charAt(0).toUpperCase() +
                            key.slice(1)
                                .replace(/_/g, ' ');


                        if (isUploadedFileUrl(value)) {

                            html += `

                                <div class="aws-form-data-row">

                                    <span class="aws-form-data-label">
                                        ${label}
                                    </span>

                                    ${renderFileValue(value)}

                                </div>
                            `;

                        }
                        else {

                            var displayValue =
                                value !== null &&
                                value !== undefined
                                    ? value
                                    : 'N/A';


                            html += `

                                <div class="aws-form-data-row">

                                    <span class="aws-form-data-label">
                                        ${label}
                                    </span>

                                    <span class="aws-form-data-value">
                                        ${displayValue}
                                    </span>

                                </div>
                            `;

                        }

                    });

            }

        }
        catch (e) {

            html += `

                <pre class="bg-light p-3">
                    ${data.data}
                </pre>

            `;

        }


        html += `

                </div>

            </section>
        `;


        $('#submissionDetailContent')
            .html(html);
    }


    /* ========================================================= */
    /* Export Excel */
    /* ========================================================= */

    function ExportSubmissionsToExcel() {

        var hasFields =
            document.querySelectorAll(
                '.aws-export-field-checkbox'
            ).length > 0;


        if (!hasFields) {

            doExportRequest(null);

            return;
        }

        document.getElementById(
            'awsExportSelectAll'
        ).checked = true;


        document.querySelectorAll(
            '.aws-export-field-checkbox'
        ).forEach(function (cb) {

            cb.checked = true;

        });


        openExportModal();
    }


    /* ========================================================= */
    /* Open Export Modal */
    /* ========================================================= */

    function openExportModal() {

        var modal =
            document.getElementById(
                "awsExportModal"
            );


        if (!modal) return;


        modal.classList.add(
            "aws-export-show"
        );


        modal.setAttribute(
            "aria-hidden",
            "false"
        );


        document.body.classList.add(
            "aws-modal-open"
        );
    }


    /* ========================================================= */
    /* Close Export Modal */
    /* ========================================================= */

    function closeExportModal() {

        var modal =
            document.getElementById(
                "awsExportModal"
            );


        if (!modal) return;


        modal.classList.remove(
            "aws-export-show"
        );


        modal.setAttribute(
            "aria-hidden",
            "true"
        );


        document.body.classList.remove(
            "aws-modal-open"
        );
    }


    /* ========================================================= */
    /* Select All */
    /* ========================================================= */

    function toggleExportSelectAll(checkbox) {

        var checked =
            checkbox.checked;


        document.querySelectorAll(
            '.aws-export-field-checkbox'
        ).forEach(function (cb) {

            cb.checked = checked;

        });
    }


    /* ========================================================= */
    /* Individual Checkbox */
    /* ========================================================= */

    function onExportFieldToggle() {

        var all =
            document.querySelectorAll(
                '.aws-export-field-checkbox'
            );


        var checkedCount =
            document.querySelectorAll(
                '.aws-export-field-checkbox:checked'
            ).length;


        var selectAll =
            document.getElementById(
                'awsExportSelectAll'
            );


        if (selectAll) {

            selectAll.checked =
                (
                    all.length > 0 &&
                    checkedCount === all.length
                );

        }

    }


    /* ========================================================= */
    /* Submit Export */
    /* ========================================================= */

    function submitExportModal() {

        var checked =
            document.querySelectorAll(
                '.aws-export-field-checkbox:checked'
            );


        if (checked.length === 0) {

            showLobiboxNotification(
                'warning',
                'Please select at least one field to export.'
            );

            return;
        }


        var allCount =
            document.querySelectorAll(
                '.aws-export-field-checkbox'
            ).length;


        var selectedFields =
            Array.prototype.map.call(
                checked,
                function (cb) {
                    return cb.value;
                }
            );


        closeExportModal();


        /*
            If all fields are selected,
            export everything as before.
        */

        doExportRequest(
            selectedFields.length === allCount
                ? null
                : selectedFields
        );
    }


    /* ========================================================= */
    /* Export Modal Events */
    /* ========================================================= */

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            var modal =
                document.getElementById(
                    "awsExportModal"
                );


            if (!modal) return;


            modal.classList.remove(
                "aws-export-show"
            );


            modal.setAttribute(
                "aria-hidden",
                "true"
            );


            /*
                Close when clicking overlay
            */

            modal.addEventListener(
                "click",
                function (event) {

                    if (event.target === modal) {

                        closeExportModal();

                    }

                }
            );


            /*
                Close with ESC
            */

            document.addEventListener(
                "keydown",
                function (event) {

                    if (
                        event.key === "Escape" &&
                        modal.classList.contains(
                            "aws-export-show"
                        )
                    ) {

                        closeExportModal();

                    }

                }
            );

        }
    );


    /* ========================================================= */
    /* Export Request */
    /* ========================================================= */

    function doExportRequest(selectedFields) {

        var formId =
            @FormId;


        var searchText =
            $('#txtsearch').val();


        if (searchText == undefined) {

            searchText = "";

        }


           var url =
            '@Url.Action("FormSubmissionsExportToExcel", "Form")' +
            '?formId=' +
            encodeURIComponent(formId) +
            '&search=' +
            encodeURIComponent(searchText) +
            '&mid=@mid';


        if (
            selectedFields &&
            selectedFields.length > 0
        ) {

            url +=
                '&fields=' +
                encodeURIComponent(
                    selectedFields.join(',')
                );

        }


        window.location.href = url;
    }

</script>
