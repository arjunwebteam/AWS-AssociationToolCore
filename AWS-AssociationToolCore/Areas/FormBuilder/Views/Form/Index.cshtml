﻿@{
ViewBag.Title = "Forms";
Layout = "~/Areas/FormBuilder/Views/Shared/_MainLayout.cshtml";


var publishLinkTemplate = Context.Request.Scheme + "://" + Context.Request.Host + Url.Content("~/Form/__TOKEN__");

var shortUrlBase = Context.Request.Scheme + "://" + Context.Request.Host + Url.Content("~/form/");

string userRole = Context.Session.GetString("userrole") ?? string.Empty;

bool IsEdit = Convert.ToBoolean(Context.Session.GetString("IsEdit"));
bool IsView = Convert.ToBoolean(Context.Session.GetString("IsView"));
bool IsDelete = Convert.ToBoolean(Context.Session.GetString("IsDelete"));
bool IsExport = Convert.ToBoolean(Context.Session.GetString("IsExport"));
bool IsAdd = Convert.ToBoolean(Context.Session.GetString("IsAdd"));
Int64 mid = ViewBag.mid;
}

<style>

    .aws-inline-row {
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .aws-inline-row .aws-share-link-box {
            flex: 1 1 auto;
            min-width: 0;
            margin: 0 !important;
        }

        .aws-inline-row .aws-share-actions {
            flex: 0 0 auto;
            margin: 0 !important;
            padding: 0 !important;
            flex-wrap: nowrap;
        }

            .aws-inline-row .aws-share-actions button {
                white-space: nowrap;
            }
    /* no gap between "https://host/form/" and the code */
    .aws-short-box {
        gap: 0 !important;
    }

        .aws-short-box > i {
            margin-right: 10px;
        }

        .aws-short-box .aws-short-prefix {
            margin: 0 !important;
            padding: 0 !important;
        }

        .aws-short-box input {
            padding-left: 0 !important;
            margin-left: 0 !important;
        }

    @@media (max-width: 640px) {
        .aws-inline-row {
            flex-direction: column;
            align-items: stretch;
        }

            .aws-inline-row .aws-share-actions {
                justify-content: flex-end;
            }
    }

    .aws-share-ghost-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 14px;
        font-size: 13px;
        font-weight: 600;
        color: #4f46e5;
        background: #fff;
        border: 1px solid #c7d2fe;
        border-radius: 6px;
        cursor: pointer;
    }

        .aws-share-ghost-btn:hover {
            background: #eef2ff;
        }

        .aws-share-ghost-btn:disabled {
            opacity: .6;
            cursor: default;
        }

    .aws-short-section {
        margin-top: 16px;
        padding-top: 14px;
        border-top: 1px dashed #e2e8f0;
    }

        .aws-short-section > label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 8px;
        }

    .aws-short-box .aws-short-prefix {
        white-space: nowrap;
        color: #64748b;
        font-size: 13px;
    }

    .aws-short-box input {
        flex: 1;
        min-width: 0;
    }

    .aws-short-box.editing {
        border-color: #4f46e5 !important;
        box-shadow: 0 0 0 2px rgba(79,70,229,.15);
    }

    /* ADDED - while the short URL is being loaded/generated the row is already visible, buttons wait */
    .aws-short-section.loading .aws-share-actions {
        visibility: hidden;
    }

    @@media (max-width: 640px) {
        .aws-edit-spacer {
            display: none !important;
        }
    }

    .aws-short-msg {
        font-size: 12px;
        margin-top: 6px;
        min-height: 16px;
        color: #037f31;
        font-weight: 700;
    }

        .aws-short-msg.error {
            color: #dc2626;
        }
</style>

<input id="hdnPageNo" type="hidden" value="1" />
<input id="hdnsortcolumn" type="hidden" value="CreatedDate" />
<input id="hdnsortorder" type="hidden" value="DESC" />

<div class="zentic-card">

    <div class="zentic-card-header">
        <div>
            <div class="topbar-search zentic-table-search">
                <i class="icon-search search-icon"></i>
                <input type="text" class="search-input" name="keyword" id="keyword" placeholder="Search by Form Title" onkeydown="FormsBind(1);">
            </div>
        </div>
        @if (IsAdd == true)
        {
            <div class="d-flex gap-2">
                <a class="btn btn-primary"  href="@Url.Action("FormBuilder", "Form", new { mid = ViewBag.mid })" style="color:#fff;">
                    + Add New Form
                </a>
            </div>
        }
    </div>

    <div id="divForms" class="zentic-card-body"></div>

    <div class="aws-share-overlay" id="awsShareModal">
        <div class="aws-share-modal">
            <!-- Header -->
            <div class="aws-share-header">
                <div class="aws-share-title-wrap">
                    <div class="aws-share-title-icon">
                        <i class="icon-share"></i>
                    </div>
                    <div>
                        <h4>Publish</h4>
                        <p>Share your form with others or add it to your website.</p>
                    </div>
                </div>
                <button type="button" class="aws-share-close" onclick="closeAwsShareModal()">
                    <i class="icon-x"></i>
                </button>
            </div>

            <!-- Tabs -->
            <div class="aws-share-tabs">
                <button type="button" class="aws-share-tab active" data-tab="link" onclick="switchAwsShareTab('link', this)">
                    Link
                </button>
                <button type="button" class="aws-share-tab" data-tab="share" onclick="switchAwsShareTab('share', this)">
                    Share
                </button>
                <button type="button" class="aws-share-tab" data-tab="embed" onclick="switchAwsShareTab('embed', this)">
                    Embed
                </button>
            </div>

            <div class="aws-share-content aws-share-panel active" id="awsShareLinkPanel">
                <div class="aws-share-section-head">
                    <div class="aws-share-section-icon link-icon">
                        <i class="icon-link"></i>
                    </div>
                    <div>
                        <h5>Direct Link of Your Form</h5>
                        <p>Your form is published and ready to use at this address.</p>
                    </div>
                </div>

                <div class="aws-share-card">
                    <div class="aws-share-card-top">
                        <div>
                            <label>Share With Link</label>
                        </div>
                        <span class="aws-share-public-badge">
                            <i class="icon-lock"></i>
                            Public Form
                        </span>
                    </div>

                    <div class="aws-inline-row">
                        <div class="aws-share-link-box">
                            <i class="icon-link"></i>
                            <input type="text" id="awsPublishedFormLink" value="" readonly>
                        </div>
                        <div class="aws-share-actions">
                            <!-- ADDED - invisible spacer, same width as the Edit button below, so both link boxes are equal width -->
                            <span class="aws-share-ghost-btn aws-edit-spacer" aria-hidden="true" style="visibility:hidden;pointer-events:none;"><i class="fa-solid fa-pen"></i> <span>Edit</span></span>
                            <button type="button" class="aws-share-copy-btn" onclick="copyAwsFormLink()">
                                <i class="icon-copy"></i> Copy Link
                            </button>
                            <button type="button" class="aws-share-open-btn" onclick="openAwsFormLink()">
                                <i class="icon-external-link"></i> Open in New Tab
                            </button>
                        </div>
                    </div>

                    <!-- ADDED - Short URL row (auto-generated when the popup opens) -->
                    <div class="aws-short-section loading" id="awsShortSection">
                        <label>Short Url Link</label>
                        <div class="aws-inline-row">
                            <div class="aws-share-link-box aws-short-box" id="awsShortBox">
                                <i class="icon-link"></i>
                                <span class="aws-short-prefix" id="awsShortPrefix"></span>
                                <input type="text" id="awsShortCode" readonly maxlength="30" autocomplete="off">
                            </div>
                            <div class="aws-share-actions">
                                <button type="button" class="aws-share-ghost-btn" id="awsShortCancelBtn" style="display:none;" onclick="cancelAwsShortEdit()">
                                    Cancel
                                </button>
                                <button type="button" class="aws-share-ghost-btn" id="awsShortEditBtn" onclick="toggleAwsShortEdit()">
                                    <i class="fa-solid fa-pen"></i> <span>Edit</span>
                                </button>
                                <button type="button" class="aws-share-copy-btn aws-short-cp" onclick="copyAwsShortUrl(this)">
                                    <i class="icon-copy"></i> Copy Link
                                </button>
                                <button type="button" class="aws-share-open-btn aws-short-cp" onclick="openAwsShortUrl()">
                                    <i class="icon-external-link"></i> Open in New Tab
                                </button>
                            </div>
                        </div>
                        <div class="aws-short-msg" id="awsShortMsg"></div>
                    </div>
                </div>
            </div>

            <div class="aws-share-content aws-share-panel" id="awsShareSocialPanel">
                <div class="aws-share-card aws-social-card">
                    <div class="aws-social-heading">
                        <h5>Share Form</h5>
                        <p>Share your form link through social media or email.</p>
                    </div>

                    <div class="aws-social-buttons">
                        <button type="button" class="aws-social-btn aws-whatsapp" onclick="shareAwsWhatsApp()" title="WhatsApp">
                            <i class="fa-brands fa-whatsapp"></i>
                        </button>
                        <button type="button" class="aws-social-btn aws-facebook" onclick="shareAwsFacebook()" title="Facebook">
                            <i class="fa-brands fa-facebook-f"></i>
                        </button>
                        <button type="button" class="aws-social-btn aws-linkedin" onclick="shareAwsLinkedIn()" title="LinkedIn">
                            <i class="fa-brands fa-linkedin-in"></i>
                        </button>
                        <button type="button" class="aws-social-btn aws-x" onclick="shareAwsX()" title="X">X</button>
                        <button type="button" class="aws-social-btn aws-email" onclick="shareAwsEmail()" title="Email">
                            <i class="fa-solid fa-envelope"></i>
                        </button>
                    </div>
                </div>
            </div>


            <div class="aws-share-content aws-share-panel" id="awsShareEmbedPanel">
                <div class="aws-share-card">
                    <div class="aws-embed-top">
                        <div>
                            <h5>Embed Form</h5>
                            <p>Copy and paste this code into your website HTML to display your form.</p>
                        </div>
                        <select class="aws-embed-select" id="awsEmbedType">
                            <option value="iframe">iFrame</option>
                        </select>
                    </div>

                    <div class="aws-embed-code">
                        <code id="awsEmbedCode"></code>
                    </div>

                    <div class="aws-embed-actions">
                        <button type="button" class="aws-share-copy-btn" onclick="copyAwsEmbedCode()">
                            <i class="icon-copy"></i> Copy Code
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="aws-share-overlay" id="awsCopyFormModal">
        <div class="aws-share-modal" style="max-width:420px;padding:24px;">
            <h4 style="margin-bottom:8px;">Are you sure?</h4>
            <p style="margin-bottom:20px;color:#5f6368;">All the contents of this form will be copied into a new form.</p>
            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-light" onclick="closeCopyFormModal()">No</button>
                <button type="button" class="btn btn-primary" onclick="confirmCopyForm()">Yes</button>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            FormsBind(1);
        });

        function FormsBind(Pageno) {
            var sortcolumn = $('#hdnsortcolumn').val();
            var sortorder = $('#hdnsortorder').val();
            var Search = $('#keyword').val();

            $.ajax({
                url: '@Url.Action("FormsList", "Form")',
                type: 'GET',
                cache: false,
                data: { Search: Search, PageNo: Pageno, SortColumn: sortcolumn, SortOrder: sortorder ,IsEdit: '@IsEdit', IsView: '@IsView', IsDelete: '@IsDelete', IsExport: '@IsExport', IsAdd: '@IsAdd',Mid: '@mid' },
                success: function (result) {
                    $('#divForms').html(result);
                }
            });
        }

        function sortresult(sortcolumn) {
            $('#hdnsortorder').val(($('#hdnsortorder').val() == 'ASC' ? 'DESC' : 'ASC'));
            $('#hdnsortcolumn').val(sortcolumn);
            FormsBind(1);
        }

        function ClearSearch() {
            $('#keyword').val('');
            FormsBind(1);
        }

        function FormStatus(FormId) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("FormStatus", "Form")',
                data: { FormId: FormId },
                success: function (result) {
                    showLobiboxNotification(result.messageType, result.message);
                    FormsBind($('#hdnPageNo').val());
                }
            });
        }

        function UpdateFormEnable(FormId) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("UpdateFormEnable", "Form")',
                data: { FormId: FormId },
                success: function (result) {
                    showLobiboxNotification(result.messageType, result.message);
                    FormsBind($('#hdnPageNo').val());
                }
            });
        }

        function DeleteForm(FormId) {
            var val2 = confirm("Do you want to delete this form?");
            if (val2) {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("DeleteForm", "Form")',
                    data: { FormId: FormId },
                    success: function (result) {
                        showLobiboxNotification(result.messageType, result.message);
                        FormsBind($('#hdnPageNo').val());
                    }
                });
            }
        }

        var copyFormId = null;

        function openCopyFormModal(formId) {
            copyFormId = formId;
            var modal = document.getElementById('awsCopyFormModal');
            modal.classList.add('show');
            document.body.classList.add('aws-share-open');
        }

        function closeCopyFormModal() {
            var modal = document.getElementById('awsCopyFormModal');
            modal.classList.remove('show');
            document.body.classList.remove('aws-share-open');
            copyFormId = null;
        }

        function confirmCopyForm() {
            if (!copyFormId) return;
            $.ajax({
                type: "POST",
                url: '@Url.Action("CopyForm", "Form")',
                data: { FormId: copyFormId },
                success: function (result) {
                    closeCopyFormModal();
                    showLobiboxNotification(result.messageType, result.message);
                    FormsBind($('#hdnPageNo').val());
                },
                error: function () {
                    closeCopyFormModal();
                    showLobiboxNotification('error', 'Something went wrong while copying the form.');
                }
            });
        }


        var publishLinkTemplate = '@Html.Raw(publishLinkTemplate)';
        var currentPublishLink = '';
        var shortUrlBase = '@Html.Raw(shortUrlBase)';
        var currentPublishToken = '';
        var currentShortCode = '';
        var shortEditing = false;

        function openPublishModal(token, title) {
            currentPublishLink = publishLinkTemplate.replace('__TOKEN__', token);
            currentPublishToken = token;
            resetAwsShortUi();
            loadAwsShortUrl(token);

            document.getElementById('awsPublishedFormLink').value = currentPublishLink;
            updateAwsEmbedCode();
            switchAwsShareTab('link');

            var modal = document.getElementById('awsShareModal');
            modal.classList.add('show');
            document.body.classList.add('aws-share-open');
        }

        // ================= ADDED - SHORT URL =================
        function resetAwsShortUi() {
            currentShortCode = '';
            shortEditing = false;
            // row is visible by default; buttons stay hidden until the short URL is ready
            $('#awsShortSection').addClass('loading').show();
            $('#awsShortBox').removeClass('editing');
            $('#awsShortPrefix').text(shortUrlBase);
            $('#awsShortCode').prop('readonly', true).val('').attr('placeholder', 'Generating short URL...');
            $('#awsShortCancelBtn').hide();
            $('#awsShortEditBtn span').text('Edit');
            $('.aws-short-cp').show();
            setAwsShortMsg('', false);
        }

        function setAwsShortMsg(msg, isError) {
            $('#awsShortMsg').text(msg).toggleClass('error', !!isError);
        }

        function showAwsShortUrl(code) {
            currentShortCode = code;
            shortEditing = false;
            $('#awsShortPrefix').text(shortUrlBase);
            $('#awsShortCode').prop('readonly', true).val(code);
            $('#awsShortBox').removeClass('editing');
            $('#awsShortCancelBtn').hide();
            $('#awsShortEditBtn span').text('Edit');
            $('.aws-short-cp').show();
            $('#awsShortSection').removeClass('loading').show();
        }

        function getAwsShortFullUrl() {
            return shortUrlBase + currentShortCode;
        }

        function loadAwsShortUrl(token) {
            $.ajax({
                url: '@Url.Action("GetShortUrl", "Form")',
                type: 'GET',
                data: { token: token },
                success: function (r) {
                    if (token !== currentPublishToken) return;   // modal was reopened for another form
                    if (r && r.ok && r.code) showAwsShortUrl(r.code);
                    else generateAwsShortUrl(token);      // none yet -> create it automatically
                },
                error: function () {
                    if (token !== currentPublishToken) return;
                    $('#awsShortCode').attr('placeholder', 'Short URL not available');
                    setAwsShortMsg('Could not load the short URL. Please close and reopen this popup.', true);
                }
            });
        }

        function generateAwsShortUrl(token) {
            $.ajax({
                url: '@Url.Action("SaveShortUrl", "Form")',
                type: 'POST',
                data: { token: token, code: '' },
                success: function (r) {
                    if (token !== currentPublishToken) return;
                    if (r && r.ok) { showAwsShortUrl(r.code); }
                    else {
                        $('#awsShortCode').attr('placeholder', 'Short URL not available');
                        setAwsShortMsg((r && r.message) || 'Failed to generate short URL.', true);
                    }
                },
                error: function () {
                    if (token !== currentPublishToken) return;
                    $('#awsShortCode').attr('placeholder', 'Short URL not available');
                    setAwsShortMsg('Something went wrong while generating the short URL.', true);
                }
            });
        }

        function toggleAwsShortEdit() {
            if (!shortEditing) {
                shortEditing = true;
                $('#awsShortCode').prop('readonly', false).focus().select();
                $('#awsShortBox').addClass('editing');
                $('#awsShortCancelBtn').show();
                $('.aws-short-cp').hide();   // more room for the text box while editing
                $('#awsShortEditBtn span').text('Save');
                setAwsShortMsg('Use 3-30 letters, numbers, - or _', false);
                return;
            }
            var newCode = $.trim($('#awsShortCode').val());
            if (!/^[A-Za-z0-9_-]{3,30}$/.test(newCode)) {
                setAwsShortMsg('Only letters, numbers, - and _ (3-30 characters) are allowed.', true);
                return;
            }
            if (newCode === currentShortCode) { cancelAwsShortEdit(); return; }
            $.ajax({
                url: '@Url.Action("SaveShortUrl", "Form")',
                type: 'POST',
                data: { token: currentPublishToken, code: newCode },
                success: function (r) {
                    if (r && r.ok) {
                        showAwsShortUrl(r.code);
                        setAwsShortMsg('Short URL updated.', false);
                    } else {
                        setAwsShortMsg((r && r.message) || 'Failed to update short URL.', true);
                    }
                },
                error: function () { setAwsShortMsg('Something went wrong. Please try again.', true); }
            });
        }

        function cancelAwsShortEdit() {
            $('#awsShortCode').val(currentShortCode);
            showAwsShortUrl(currentShortCode);
            setAwsShortMsg('', false);
        }

        function copyAwsShortUrl(btn) {
            navigator.clipboard.writeText(getAwsShortFullUrl()).then(function () {
                var original = btn.innerHTML;
                btn.innerHTML = '<i class="icon-check"></i> Copied';
                setTimeout(function () { btn.innerHTML = original; }, 1500);
            });
        }

        function openAwsShortUrl() {
            window.open(getAwsShortFullUrl(), '_blank', 'noopener,noreferrer');
        }
        // ================= END SHORT URL =================

        function closeAwsShareModal() {
            var modal = document.getElementById('awsShareModal');
            modal.classList.remove('show');
            document.body.classList.remove('aws-share-open');
        }

        function switchAwsShareTab(tabName, button) {
            var tabs = document.querySelectorAll('.aws-share-tab');
            var panels = document.querySelectorAll('.aws-share-panel');

            tabs.forEach(function (tab) {
                tab.classList.remove('active');
            });

            panels.forEach(function (panel) {
                panel.classList.remove('active');
            });

            if (button) {
                button.classList.add('active');
            } else {
                var activeButton = document.querySelector('.aws-share-tab[data-tab="' + tabName + '"]');
                if (activeButton) {
                    activeButton.classList.add('active');
                }
            }

            var panelId = '';
            if (tabName === 'link') panelId = 'awsShareLinkPanel';
            if (tabName === 'share') panelId = 'awsShareSocialPanel';
            if (tabName === 'embed') panelId = 'awsShareEmbedPanel';

            var panel = document.getElementById(panelId);
            if (panel) {
                panel.classList.add('active');
            }
        }

        function copyAwsFormLink() {
            var input = document.getElementById('awsPublishedFormLink');
            navigator.clipboard.writeText(input.value).then(function () {
                var button = document.querySelector('.aws-share-copy-btn');
                var original = button.innerHTML;
                button.innerHTML = '<i class="icon-check"></i> Copied';
                setTimeout(function () {
                    button.innerHTML = original;
                }, 1500);
            });
        }

        function openAwsFormLink() {
            window.open(currentPublishLink, '_blank', 'noopener,noreferrer');
        }

        function updateAwsEmbedCode() {
            var type = document.getElementById('awsEmbedType').value;
            var code = type === 'script'
                ? '<script type="text/javascript" src="' + currentPublishLink + '"><' + '/script>'
                : '<iframe src="' + currentPublishLink + '" style="width:100%;height:650px;border:none;"></iframe>';
            document.getElementById('awsEmbedCode').textContent = code;
        }

        function copyAwsEmbedCode() {
            var code = document.getElementById('awsEmbedCode').innerText;
            navigator.clipboard.writeText(code).then(function () {
                var button = document.querySelector('.aws-embed-actions .aws-share-copy-btn');
                var original = button.innerHTML;
                button.innerHTML = '<i class="icon-check"></i> Copied';
                setTimeout(function () {
                    button.innerHTML = original;
                }, 1500);
            });
        }

        function getAwsFormLink() {
            return currentPublishLink || window.location.href;
        }

        function shareAwsWhatsApp() {
            var url = encodeURIComponent(getAwsFormLink());
            window.open('https://wa.me/?text=' + encodeURIComponent('Please fill out this form: ') + url, '_blank');
        }

        function shareAwsFacebook() {
            var url = encodeURIComponent(getAwsFormLink());
            window.open('https://www.facebook.com/sharer/sharer.php?u=' + url, '_blank', 'width=600,height=500');
        }

        function shareAwsLinkedIn() {
            var url = encodeURIComponent(getAwsFormLink());
            window.open('https://www.linkedin.com/sharing/share-offsite/?url=' + url, '_blank', 'width=600,height=500');
        }

        function shareAwsX() {
            var url = encodeURIComponent(getAwsFormLink());
            window.open('https://twitter.com/intent/tweet?url=' + url, '_blank', 'width=600,height=500');
        }

        function shareAwsEmail() {
            var url = getAwsFormLink();
            window.location.href = 'mailto:?subject=' + encodeURIComponent('Please fill out this form') + '&body=' + encodeURIComponent('You can access the form here:\n\n' + url);
        }

        document.addEventListener('click', function (event) {
            var modal = document.getElementById('awsShareModal');
            if (modal && modal.classList.contains('show') && event.target === modal) {
                closeAwsShareModal();
            }
            var copyModal = document.getElementById('awsCopyFormModal');
            if (copyModal && copyModal.classList.contains('show') && event.target === copyModal) {
                closeCopyFormModal();
            }
        });

        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape') {
                closeAwsShareModal();
                closeCopyFormModal();
            }
        });
    </script>
</div>
