                                            <label class="checkbox-in">
                                                <input type="checkbox" name="IsSelectAll" id="IsSelectAll-@subrole.MenuItemId" class="flat-red" onclick="selectall(@subrole.MenuItemId);" value="Yes" />
                                            </label>
                                        </td>
                                        <td style="text-align:center;">
                                        </td>
                                        <td style="text-align:center;">
                                            <span id="updatebutton-@subrole.MenuItemId" class="d-none">
                                                <a style="text-decoration: underline; color: #2aab0f; font-weight: bold; cursor:pointer"
                                                   onclick="AssignRoleUsers(@subrole.MenuItemId, @subrole.MenuItemId, @subrole.PageParentId);">Update</a>
                                            </span>


                                        </td>
                                    </tr>
                                }
                            }

                        }
                        j++;
                    }

                </tbody>
            }
        </table>
