@using System.Security.Claims
@{

    string impersonatedByName = Context.User?.FindFirst("ImpersonatedByAdminName")?.Value;
    bool isImpersonating = !string.IsNullOrEmpty(impersonatedByName);
}

@if (isImpersonating)
{
    <div style="width: 50%;
        margin-inline: auto;background:#fff3cd; color:#664d03; border-bottom:1px solid #ffe69c; padding:10px 20px; display:flex; align-items:center; justify-content:center; gap:12px; font-size:14px; position:sticky; top:0; z-index:1050;">
        <i class="bi bi-person-badge-fill" style="font-size: 21px;"></i>
        <span style="color:black !important">
            <b>
                You are viewing as <strong style="color:red !important">@Context.User.FindFirst(ClaimTypes.Name)?.Value</strong>
                (impersonated by @impersonatedByName)
            </b>
        </span>
        <a href="@Url.Action("StopImpersonating", "Users", new { area = "FormBuilder" })"
           class="btn btn-primary" style="padding:4px 12px;">
            Return to Admin
        </a>
    </div>
}
