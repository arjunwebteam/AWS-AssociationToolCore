@{
    Layout = null;

    int status = 0;
    AWSFormBuilder.Areas.FormBuilder.BLL.AppInfo _AppInfo = new AWSFormBuilder.Areas.FormBuilder.BLL.AppInfo();
    AWSFormBuilder.Entities.AppInfo objAppInfo = _AppInfo.GetAppInfoDetails(ref status);
    string baseurl = objAppInfo.BaseUrl;
}
<!doctype html>
<html lang="en" class="minimal-theme">

<head>
    <!-- Required meta tags -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Same base href as _MainLayout — every relative Content/Scripts/ckeditor path
         in the embedded views (mail.css, Common.js, ckeditor.js, ckfinder.js, etc.)
         depends on this to resolve correctly. -->
    <base href="@(baseurl)" />

    <title>@objAppInfo.SiteName - Control Panel</title>

    <link rel="stylesheet" href="~/Areas/FormBuilder/Content/css/zentic.css?ver=@objAppInfo.DesktopVersion.ToString()">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/Areas/FormBuilder/Content/css/vendor/bootstrap.min.css" id="bootstrapLtr">
    <link rel="stylesheet" href="~/Areas/FormBuilder/Content/css/zentic-icons.css">
    <link rel="stylesheet" href="~/Areas/FormBuilder/Content/css/zfb-formbuilder.css?ver=@objAppInfo.DesktopVersion.ToString()">

    <link href="~/Areas/FormBuilder/Content/plugins/notifications/css/lobibox.min.css" rel="stylesheet" />
    <link href="~/Areas/FormBuilder/Content/plugins/select2/css/select2.min.css" rel="stylesheet" />
    <link href="~/Areas/FormBuilder/Content/plugins/select2/css/select2-bootstrap4.css" rel="stylesheet" />
    <link href="~/Areas/FormBuilder/Content/plugins/simplebar/css/simplebar.css" rel="stylesheet" />
    <link href="~/Areas/FormBuilder/Content/css/bootstrap-extended.css" rel="stylesheet" />
    <link href="~/Areas/FormBuilder/Content/css/icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="Areas/FormBuilder/Content/css/vendor/bootstrap.rtl.min.css" id="bootstrapRtl" disabled>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link href="Areas/FormBuilder/Content/plugins/notifications/css/lobibox.css" rel="stylesheet" />
    <link rel="stylesheet" href="Areas/FormBuilder/Content/css/bootstrap.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- jQuery + validate — required before any of the embedded views' $(document).ready() blocks run -->
    <script src="~/Areas/FormBuilder/Content/js/jquery.min.js"></script>
    <script src="~/Areas/FormBuilder/Content/Scripts/jquery.validate.js"></script>
    <script src="~/Areas/FormBuilder/Content/js/jquery-validate.min.js"></script>

    <link href="~/Areas/FormBuilder/Content/css/pace.min.css" rel="stylesheet" />
    <script src="~/Areas/FormBuilder/Content/js/bootstrap.bundle.min.js"></script>

    <style>
        /* This layout only ever renders inside the FormBuilder iframe panel,
           so there's no sidebar/topbar — just let the page content breathe. */
        html, body { background: #fff; }
        body.fb-embed-body { margin: 0; }
    </style>
</head>

<body class="fb-embed-body">

    @if (TempData["messageType"] != null && TempData["message"] != null)
    {
        <script>
            $(document).ready(function () {
                showLobiboxNotification('@TempData["messageType"]', '@TempData["message"]');
            });
        </script>
    }

    <script>
        function showLobiboxNotification(messageType, message) {
            var iconClass;
            switch (messageType.toLowerCase()) {
                case 'success':
                    iconClass = 'bx bx-check-circle';
                    break;
                case 'warning':
                    iconClass = 'bx bx-warning-circle';
                    break;
                case 'error':
                    iconClass = 'bx bx-x-circle';
                    break;
                default:
                    iconClass = 'bx bx-info-circle';
                    break;
            }

            Lobibox.notify(messageType, {
                pauseDelayOnHover: true,
                size: 'mini',
                rounded: true,
                icon: iconClass,
                delayIndicator: false,
                continueDelayOnInactiveTab: false,
                position: 'top right',
                msg: message
            });
        }
    </script>

    @RenderBody()

    <script src="~/Areas/FormBuilder/Content/plugins/simplebar/js/simplebar.min.js"></script>
    <script src="~/Areas/FormBuilder/Content/plugins/notifications/js/lobibox.min.js"></script>
    <script src="~/Areas/FormBuilder/Content/plugins/notifications/js/notifications.min.js"></script>
    <script src="~/Areas/FormBuilder/Content/plugins/notifications/js/notification-custom-script.js"></script>
    <script src="~/Areas/FormBuilder/Content/plugins/select2/js/select2.min.js"></script>
    <script src="~/Areas/FormBuilder/Content/js/form-select2.js"></script>
    <script src="~/Areas/FormBuilder/Content/js/app.js"></script>
    <script src="~/Areas/FormBuilder/Content/Scripts/Common.js"></script>

</body>

</html>
