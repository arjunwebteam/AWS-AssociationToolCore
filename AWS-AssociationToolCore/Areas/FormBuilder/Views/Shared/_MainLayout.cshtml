                            case "products":
                                return "icon-package";

                            case "orders":
                                return "icon-shopping-cart";

                            case "calendar":
                                return "icon-calendar";

                            case "analytics":
                                return "icon-chart-column";

                            case "security":
                                return "icon-shield";

                            case "permissions":
                                return "icon-key";

                            default:
                                return "icon-circle";
                        }
                    }
                }


                @if (menuSource != null && menuSource.Count != 0)
                {
                    <div class="zfb-topbar-actions">

                        @foreach (var item in menuSource)
                        {
                            lstSubmenuCount =
                            lstSubMenu.FindAll(x => x.PageParentId == item.MenuItemId);


                            @* =====================================================
                       SUPER ADMIN / DEVELOPER ADMIN RESTRICTION
                       ===================================================== *@

                            if (isSuperOrDev &&
                            userRole.Contains("SuperAdmin") &&
                            item.DisplayName == "Developers")
                            {
                                continue;
                            }


                            @* =====================================================
                       IF PARENT HAS SUBMENU
                       SHOW ONLY SUBMENU ITEMS
                       DO NOT SHOW PARENT
                       ===================================================== *@

                            if (lstSubmenuCount != null &&
                            lstSubmenuCount.Count != 0)
                            {
                                foreach (var submenu in lstSubmenuCount)
                                {
                                    bool subActive =
                                    IsMenuActive(URL, submenu.PageUrl);


                                    string subHref =
                                    (submenu.DisplayName == "Active Members" ||
                                    submenu.DisplayName == "Inactive Members" ||
                                    submenu.DisplayName == "Pending Members")
                                    ? submenu.PageUrl +
                                    "&mid=" +
                                    submenu.MenuItemId
                                    : submenu.PageUrl +
                                    "?mid=" +
                                    submenu.MenuItemId;


                                    <a href="@subHref"
                                       class="zfb-btn zfb-btn-customize @(subActive ? "active" : "")"
                                       style="text-decoration:none">

                                        @if (!string.IsNullOrEmpty(submenu.Logo))
                                        {
                                            <img src="@(imglocNormal + submenu.Logo)" alt="@submenu.DisplayName" class="zfb-menu-logo" />
                                        }
                                        else
                                        {
                                            <i class="@MenuIcon(submenu.DisplayName)"></i>
                                        }

                                        <span>
                                            @submenu.DisplayName
                                        </span>

                                    </a>
                                }
                            }


                            @* =====================================================
                       PARENT WITHOUT SUBMENU
                       SHOW NORMAL MENU ITEM
                       ===================================================== *@

                            else
                            {
                                bool itemActive =
                                IsMenuActive(URL, item.PageUrl);


                                string itemHref =
                                item.DisplayName == "Events"
                                ? item.PageUrl +
                                "&mid=" +
                                item.MenuItemId
                                : item.PageUrl +
                                "?mid=" +
                                item.MenuItemId;


                                <a href="@itemHref"
                                   class="zfb-btn zfb-btn-customize @(itemActive ? "active" : "")">

                                    @if (!string.IsNullOrEmpty(item.Logo))
                                    {
                                        <img src="@(imglocNormal + item.Logo)" alt="@item.DisplayName" class="zfb-menu-logo" />
                                    }
                                    else
                                    {
                                        <i class="@MenuIcon(item.DisplayName)"></i>
                                    }

                                    <span>
                                        @item.DisplayName
                                    </span>

                                </a>
                            }
                        }

                    </div>
                }


