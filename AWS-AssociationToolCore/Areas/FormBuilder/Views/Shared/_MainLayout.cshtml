    <script>
        $(document).on('keyup', '#menuSearch', function () {
            var searchTerm = $(this).val().toLowerCase();

            if (searchTerm.length > 0) {
                $('#sidebarMenu .nav-item').hide().filter(function () {
                    return $(this).text().toLowerCase().indexOf(searchTerm) !== -1;
                }).show();
                $('#sidebarMenu .nav-section').each(function () {
                    var hasVisible = $(this).find('.nav-item:visible').length > 0;
                    $(this).toggle(hasVisible).removeClass('collapsed');
                });
            } else {
                $('#sidebarMenu .nav-item, #sidebarMenu .nav-section').show();
            }
        });

        $(document).on('click', '#sidebarToggle', function () {
            if ($(window).width() < 992) {
                $('#zenticSidebar').toggleClass('mobile-open');
                $('#sidebarOverlay').toggleClass('active');
            } else {
                $('#zenticSidebar').toggleClass('collapsed');
                $('#zenticMain').toggleClass('sidebar-collapsed');
            }
        });

        $(document).on('click', '#sidebarClose, #sidebarOverlay', function () {
            $('#zenticSidebar').removeClass('mobile-open');
            $('#sidebarOverlay').removeClass('active');
        });


        $(document).on('click', '.nav-section-label', function () {
            $(this).closest('.nav-section').toggleClass('collapsed');
        });


        $(document).on('click', '#topbarUserTrigger', function (e) {
            e.stopPropagation();
            $('#topbarUserDropdown').toggleClass('open');
        });

        $(document).on('click', '#sidebarUserBtn', function (e) {
            e.stopPropagation();
            $('#sidebarProfilePopup').toggleClass('open');
        });
        $(document).on('click', '#sidebarProfileClose', function (e) {
            e.stopPropagation();
            $('#sidebarProfilePopup').removeClass('open');
        });


        $(document).on('click', function (e) {
            if (!$(e.target).closest('#topbarUser').length) {
                $('#topbarUserDropdown').removeClass('open');
            }
            if (!$(e.target).closest('#sidebarUserTrigger').length) {
                $('#sidebarProfilePopup').removeClass('open');
            }
        });
    </script>
    <script>
                var $uploadCrop,
                    tempFilename,
                    rawImg,
                    imageId;

              function readFile(input) {

            if (input.files && input.files[0]) {

                var file = input.files[0];

                var allowedTypes = [
                    'image/jpeg',
                    'image/jpg',
                    'image/png',
                    'image/gif'
                ];

                if ($.inArray(file.type, allowedTypes) === -1) {

                    alert('Only JPG, JPEG, PNG and GIF images are allowed.');

                    $(input).val('');

                    return false;
                }

                var reader = new FileReader();

                reader.onload = function (e) {

                    $('.upload-demo').addClass('ready');

                    $('#cropImagePop').modal('show');

                    rawImg = e.target.result;
                }

                reader.readAsDataURL(file);

            } else {

                console.log("Sorry - your browser doesn't support the FileReader API");
            }
        }

                $uploadCrop = $('#upload-demo').croppie({
                    viewport: {
                        width: '@ViewBag.v1',
                        height: '@ViewBag.v2',
                        type: 'square'
                    },
                    enforceBoundary: false,
                    enableExif: true
                });

                $('#cropImagePop').on('shown.bs.modal', function () {
                    //$('.cr-slider-wrap').prepend('<p>Image Zoom</p>');
                    $uploadCrop.croppie('bind', {
                        url: rawImg
                    }).then(function () {

                    });
                });

                $('#cropImagePop').on('hidden.bs.modal', function () {
                    $('.item-img').val(rawImg);
                    $('.cr-slider-wrap p').remove();
                });

                $('.item-img').on('change', function () {
                    readFile(this);
                });

                $('.replacePhoto').on('click', function () {
                    $('#cropImagePop').modal('hide');
                    $('.item-img').trigger('click');
                });

                $('#cropImageBtn').on('click', function (ev) {
                    $('.ci-user-picture').show();
                    $uploadCrop.croppie('result', {
                        type: 'base64',
                        backgroundColor: "#000000",
                        format: 'png',
                        size: { width: '@ViewBag.v1', height: '@ViewBag.v2' }
                    }).then(function (resp) {
                        $('#item-img-output').attr('src', resp);
                        $('#Thumbimage').val(resp);  // Set the hidden input value
                        $('#cropImagePop').modal('hide');
                        $('.item-img').val(rawImg);
                    });
                });
    </script>


