                <div class="modal-header fa-header">
                    <h5 class="fa-title">Form Access</h5>
                    <span class="fa-form-name" id="faModalFormTitle"></span>
                    <button type="button" class="btn-close fa-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="faFormId" />
                    <div class="fa-info">
                        <i class="fas fa-info-circle"></i>
                        <span>Only the selected users will have access to this form.</span>
                    </div>
                    <div class="fa-users-heading">Users</div>
                    <div id="faUserListContainer">
                        <p class="text-muted">Loading...</p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="saveFormAccess();">Submit</button>
                </div>
            </div>
