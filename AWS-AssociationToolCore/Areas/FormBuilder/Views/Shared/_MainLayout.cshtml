    <script>
        function faEsc(t) {
            return $('<div>').text(t == null ? '' : t).html();
        }

        function openFormAccessModal(formId, formTitle) {
            $('#faFormId').val(formId);
            $('#faModalFormTitle').text(formTitle);
            $('#faUserListContainer').html('<p class="text-muted">Loading...</p>');
            $('#formAccessModal').modal('show');

            $.ajax({
                type: "GET",
                cache: false,
                url: '@Url.Action("GetFormAccessUsers", "Form")',
                data: { FormId: formId },
                success: function (result) {
                    if (!result.ok) {
                        $('#faUserListContainer').html('<p class="text-danger">' + faEsc(result.message) + '</p>');
                        return;
                    }
                    var html = '';
                    if (result.users.length === 0) {
                        html = '<p class="text-muted">No users found.</p>';
                    } else {
                        // nothing is pre-checked; only users already granted access are ticked
                        $.each(result.users, function (i, u) {
                            var checked = result.selectedIds.indexOf(u.userId) !== -1 ? 'checked' : '';
                        html += '<div class="form-check fa-user-item">' +
        '<input class="form-check-input fa-user-chk" type="checkbox" value="' + u.userId + '" id="faUser' + u.userId + '" ' + checked + '>' +
        '<label class="form-check-label" for="faUser' + u.userId + '">' +
            '<span class="fa-user-name">' + faEsc(u.userName) + '</span>' +
            '<span class="fa-user-email">' + faEsc(u.email) + '</span>' +
        '</label>' +
        '</div>';
                        });
                    }
                    $('#faUserListContainer').html(html);
                },
                error: function () {
                    $('#faUserListContainer').html('<p class="text-danger">Failed to load users.</p>');
                }
            });
        }

        function saveFormAccess() {
            var formId = $('#faFormId').val();
            var selectedIds = [];
            $('.fa-user-chk:checked').each(function () {
                selectedIds.push($(this).val());
            });

            $.ajax({
                type: "POST",
                url: '@Url.Action("SaveFormAccess", "Form")',
                data: { FormId: formId, UserIds: selectedIds.join(',') },
                success: function (result) {
                    showLobiboxNotification(result.messageType, result.message);
                    if (result.ok) {
                        $('#formAccessModal').modal('hide');
                    }
                },
                error: function () {
                    showLobiboxNotification('error', 'Failed transaction.');
                }
            });
        }
    </script>

