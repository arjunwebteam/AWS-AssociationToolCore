@using Microsoft.AspNetCore.Http
@using System.Linq
@{
    Layout = null;

    var objuser = new AWSFormBuilder.Entities.Users();
    List<AWSFormBuilder.Entities.AdminMenuItems> lstMainMenu = new();
    List<AWSFormBuilder.Entities.AdminMenuItems> lstSubMenu = new();
    List<AWSFormBuilder.Entities.AdminMenuItems> lstSubmenuCount = new();

    var Pageheading = ViewBag.Pageheading;
    int status = 0;

    AWSFormBuilder.Areas.FormBuilder.BLL.AppInfo _AppInfo = new AWSFormBuilder.Areas.FormBuilder.BLL.AppInfo();
    AWSFormBuilder.Entities.AppInfo objAppInfo = _AppInfo.GetAppInfoDetails(ref status);

    string url = objAppInfo.UserSiteUrl;

    string userRole = Context.Session.GetString("userrole") ?? "";
    string userName = Context.Session.GetString("UserName") ?? "";
    string UserEmail = Context.Session.GetString("UserEmail") ?? "";
    string userIdStr = Context.Session.GetString("UserId") ?? "0";
    long.TryParse(userIdStr, out long userId);

    if (userId > 0)
    {
        AWSFormBuilder.Areas.FormBuilder.BLL.Users _user = new AWSFormBuilder.Areas.FormBuilder.BLL.Users();
        objuser = _user.GetAdminUsersGetByEmail(UserEmail, ref status);

        if (objuser != null)
        {
            _AppInfo.GetAdminMenuData(objuser.UserId, objuser.RoleId,
                ref lstMainMenu, ref lstSubMenu, ref status);
        }
    }

    if (string.IsNullOrEmpty(Context.Session.GetString("SiteName")))
    {
        Context.Session.SetString("SiteName", objAppInfo.SiteName ?? "");
        Context.Session.SetString("CompanyAddress", objAppInfo.CompanyAddress ?? "");
        Context.Session.SetString("CompanyWebSite", objAppInfo.CompanyWebSite ?? "");
        Context.Session.SetString("CompanyEmail", objAppInfo.CompanyEmail ?? "");
        Context.Session.SetString("CompanyPhone", objAppInfo.CompanyPhone ?? "");
        Context.Session.SetString("BaseUrl", objAppInfo.BaseUrl ?? "");
        Context.Session.SetString("UploadPath", objAppInfo.UploadPath ?? "");
        Context.Session.SetString("UserSiteUrl", objAppInfo.UserSiteUrl ?? "");
        Context.Session.SetString("AdminImageUrl", objAppInfo.AdminImageUrl ?? "");
        Context.Session.SetString("AdminSiteUrl", objAppInfo.AdminSiteUrl ?? "");
    }

    int.TryParse(Context.Session.GetString("chapterid"), out int ChapterId);
    var imglocNormal = objAppInfo.BaseUrl + "Areas/FormBuilder/Content/Logo/";

    var Layout1 = Context.Session.GetString("BaseUrl") + "Areas/FormBuilder/Content/LayoutLogo/normalimages/";
    var fevicon = Context.Session.GetString("BaseUrl") + "Areas/FormBuilder/Content/faviconlogo/normalimages/";
    var EventName = ViewBag.EventName;

    string URL = Context.Request.Path.Value ?? "";

    string NormalizeMenuPath(string p)
    {
        p = (p ?? "").Trim();
        if (p.StartsWith("~")) p = p.Substring(1);
        if (!p.StartsWith("/")) p = "/" + p;
        p = p.TrimEnd('/');
        if (p.EndsWith("/Index", StringComparison.OrdinalIgnoreCase))
            p = p.Substring(0, p.Length - "/Index".Length);
        return p.ToLowerInvariant();
    }

    bool IsMenuActive(string currentPath, string menuUrl)
    {
        if (string.IsNullOrWhiteSpace(menuUrl)) return false;
        return NormalizeMenuPath(currentPath) == NormalizeMenuPath(menuUrl);
    }
    // Generate version once for this page load
    var cssVersion = DateTime.Now.Ticks;
}
