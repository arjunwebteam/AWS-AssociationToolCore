<script>
    $(document).ready(function () {
        $('#Chapters').addClass('active');
        $('#wChapters').addClass('active');
        $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
        $('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
    });

   
    function CheckChapterAvailability(cname) {

        var returnval = null;

        $.ajax({
            type: "POST",
            url: '@Url.Action("CheckChapterNameAvailability", "Chapters")', // the URL of the controller action method
            data: { cname: cname }, // optional data
            datatype: "JSON",
            async: false,
            success: function (result) {
                if (result.ok) {
                    returnval = result.data;
                }
            }
        });
        return returnval;
    }

    function Validate() {
        if ($.trim($('#ChapterName').val()) == '') { document.getElementsByName('ChapterName')[0].placeholder = 'Chapter Name Required'; $('#ChapterName').focus().addClass("validate"); return false; } else { $('#ChapterName').focus().removeClass("validate"); }
        if (!CheckChapterAvailability($.trim($('#ChapterName').val()))) { $('#spanChapterName').html(' Chapter Already available.'); $('#ChapterName').focus().addClass("red-border"); return false; } else { $('#spanChapterName').html(''); $('#ChapterName').focus().removeClass("red-border"); }

        if ($.trim($('#ShortName').val()) == '') { document.getElementsByName('ShortName')[0].placeholder = 'Short Name Required'; $('#ShortName').focus().addClass("validate"); return false; } else { $('#ShortName').focus().removeClass("validate"); }
        if ($.trim($('#City').val()) == '') { document.getElementsByName('City')[0].placeholder = 'City Required'; $('#City').focus().addClass("validate"); return false; } else { $('#City').focus().removeClass("validate"); }
        if ($.trim($('#State').val()) == '') { document.getElementsByName('State')[0].placeholder = 'State Required'; $('#State').focus().addClass("validate"); return false; } else { $('#State').focus().removeClass("validate"); }
        //if ($.trim($('#ZipCode').val()) == '') { document.getElementsByName('ZipCode')[0].placeholder = 'ZipCode Required'; $('#ZipCode').focus().addClass("validate"); return false; } else { $('#ZipCode').focus().removeClass("validate"); }
        if (CKEDITOR.instances.Description.getData() == "") { $('#Description').focus().addClass("red-border"); $('#lblDescription').html('Description Required.'); return false; } else { $('#Description').val(CKEDITOR.instances.Description.getData()); $('#lblDescription').html(''); }

        return true;
    }
    function ResetValidateClass() {
        $('#ChapterName').removeClass("validate");
        $('#ShortName').removeClass("validate");
        $('#City').removeClass("validate");
        $('#State').removeClass("validate");
        $('#ZipCode').removeClass("validate");
    }
    isNumberKey: function (evt) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (charCode > 31 && (charCode < 48 || charCode > 57))
            return false;

        return true;
    },

    isChar: function isAlphaKey(evt) {
        var charCode = (evt.which) ? evt.which : event.keyCode;
        if ((charCode >= 65 && charCode <= 90) || (charCode >= 97 && charCode <= 122)) {
            return true;
        }
        return false;
    },
</script>


