<script type="text/javascript">
        function GetPassword(id, pwd) {
        $.ajax({
            type: "POST",
            cache: false,
            url: '@Url.Action("GetPassword", "Users")', // the URL of the controller action method
            data: { Password: pwd }, // optional data

            success: function (result) {
                console.log(result); // Debugging to check the full response
                if (typeof result === "string") {
                    result = JSON.parse(result); // Convert string to object if necessary
                }

               
                if (result.success) {
                    $('#pwdlnk-' + id).hide();
                    $('#pwdtxt-' + id).show().html(result.success);
                } else {
                    alert("Password retrieval failed.");
                }
            }

        });
    }
</script>