                            sb = sb + "<option value=" + lstMembers[i].MemberId + "> " + lstMembers[i].FirstName + " " + lstMembers[i].LastName + "</option>";
                        }
                    }
                    sb = sb + "</select>";
                    $('#divMembers').html(sb);
                }
