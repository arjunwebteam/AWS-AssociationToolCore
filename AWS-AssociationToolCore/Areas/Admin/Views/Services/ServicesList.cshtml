@using AWS_AssociationToolCore.BLL
@using System.Configuration;
@{ Layout = null;}
@{
    string sortcolumn = (string)ViewBag.sortcolumn;
    string sortorder = (string)ViewBag.sortorder;
    Int64 Total = (Int64)ViewBag.total;
    var PageNo = (Int64)ViewBag.pageno;
    var Items = (Int64)ViewBag.items;

    var imgloc = ConfigurationManager.AppSettings["baseurl"] + "Content/Services/thumbphoto/";
    var imglocNormal = ConfigurationManager.AppSettings["baseurl"] + "Content/Services/normalphoto/";

    List<AWS_AssociationToolCore.Entities.Services> lstServices = ViewBag.lstServices;


    string userRole = Context.Session.GetString("userrole") ?? string.Empty;

    bool IsEdit = ViewBag.IsEdit;
    bool IsView = ViewBag.IsView;
    bool IsDelete = ViewBag.IsDelete;
    bool IsExport = ViewBag.IsExport;
    bool IsAdd = ViewBag.IsAdd;
}

<script type="text/javascript">

    function Servicestatus(ServiceId) {
        $.ajax({
            type: "POST",
            url: '@Url.Action("ServicesUpdateStatus", "Services")', // the URL of the controller action method
            data: { ServiceId: ServiceId }, // optional data
            datatype: "JSON",
            success: function (result) {
                showLobiboxNotification(result.messageType, result.message);
                if (result.ok) {
                    ServiceBind($('#hdnPageNo').val());
                }
                else {
                    $('#divmessage').html(result.data);
                    $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                }
            }
        });
    }

    function DeleteService(ServiceId, ImageUrl) {
        var val2 = confirm("Do you want to delete this record?");
        if (val2) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("DeleteService", "Services")',  // the URL of the controller action method
                data: { ServiceId: ServiceId, ImageUrl: ImageUrl }, // optional data
                success: function (result) {
                    showLobiboxNotification(result.messageType, result.message);
                    if (result.ok) {
                        ServiceBind($('#hdnPageNo').val());
                    }
                    else {
                        $("#divmessage").val(result.data);
                        $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                    }
                },
            });
        }
    }

    function UpdateOrderNo(i, ServiceId) {
        var DisplayOrder = parseInt($('#DisplayOrder' + i).val());
        $.ajax({
            type: 'POST',
            url: '@Url.Action("UpdateServicesOrderNo", "Services")',
            data: { DisplayOrder: DisplayOrder, ServiceId: ServiceId },
            success: function (result) {
                var div = '';

                showLobiboxNotification(result.messageType, result.message);
                if (result.ok) {
                    //$('#divmessage').html(result.data);
                    //$('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                    ServiceBind(1);
                }
                else {
                    $('#divmessage').html(result.data);
                    $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                }
            }
        });
    }
</script>

<div class="card-body">
    <div class="table-responsive">
        <table width="100%" class="table table-striped align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th width="5%" style="text-align:center;">S.No</th>
                    <th width="40%">
                        <a style="color: black;" class="cursor-pointer aws-h-a " onclick="javascript:sortresult('ServiceTitle');">
                            Donation Cause @if (sortcolumn == "ServiceTitle")
                            {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                        </a>
                    </th>


                    <th style="text-align:center;" width="16%">#</th>
                    @if (IsEdit == true )
                    {
                        <th width="10%">
                            <a style="color: black;" class="cursor-pointer aws-h-a" onclick="javascript:sortresult('DisplayOrder');">
                                Order No @if (sortcolumn == "DisplayOrder")
                                {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                            </a>
                        </th>
                    }


                    <th style="text-align:center; padding: 8px 6px;" width="12%">Posted Date</th>
                    @if (IsEdit == true )
                    {
                        <th style="text-align:center; padding: 8px 6px;" width="12%">Status</th>
                    }
                    @if (IsEdit == true || IsView == true || IsDelete == true)
                    {
                        <th width="5px">Action</th>
                    }
                    </tr>
            </thead>
            <tbody>
                @if (lstServices.Count != 0)
                {
                    int i = 0;
                    foreach (var item in lstServices)
                    {
                <tr>
                    <td style="text-align:center;">@item.RId</td>
                    <td>@(item.ServiceTitle == null || item.ServiceTitle == "" ? "N/A" : item.ServiceTitle)</td>
                    @if (userRole.Contains("Treasurer"))
                    {
                        <td style="text-align:center;"> <a href="@Url.Action("ServiceDonors", "ServiceDonations", new { ServiceId = item.ServiceId })"> Donors(@(item.ServiceDonationsCount)) </a> </td>
                    }
                    else
                    {
                        <td style="text-align:center;"> <a class="aws-h-a" href="@Url.Action("Index", "ServiceDonations", new { ServiceId = item.ServiceId, ServiceTitle = item.ServiceTitle })"> Donations(@(item.ServiceDonationsCount)) </a> </td>
                    }
                    @if (IsEdit == true )
                    {
                        <td>
                            <input type="text" maxlength="3" style="width:50px;" id="DisplayOrder@(i)" value="@item.DisplayOrder" onkeypress="return Common.isNumberKey(event)" />
                            <a onclick="UpdateOrderNo(@i,@item.ServiceId);" title="Update"><i class="fa fa-fw fa-refresh"></i></a>
                        </td>
                    }
                    <td style="text-align:center;">@(item.UpdatedDate != null && item.UpdatedDate != DateTime.MinValue ? item.UpdatedDate.ToAppDate() : "N/A")</td>
                    @if (IsEdit == true )
                    {
                        <td style="text-align:center;">
                            <div class="menu-hover">
                                @{ var isChecked = item.IsDisplay ? "checked" : ""; }
                                @{var titleValue = item.IsDisplay ? "Active" : "Disabled";}
                                <div>
                                    <label class="switch" title="@titleValue">
                                        <input type="checkbox" onclick="Servicestatus(@item.ServiceId)" @isChecked>
                                        <span class="slider"></span>
                                    </label>
                                </div>
                            </div>
                        </td>
                    }
                    @if (IsEdit == true || IsView == true || IsDelete == true)
                    {
                        <td style="text-align:center;">
                            <div class="table-actions d-flex align-items-center gap-3 fs-6">
                                @if (IsEdit == true )
                                {
                                    <a class="text-warning cursor-pointer" onclick="EditServiceType(@item.ServiceId);" title=" Edit" aria-label="Edit"><i class="bi bi-pencil-fill"></i></a>
                                }
                                @if (IsDelete == true )
                                {
                                    if (@item.ServiceId != 29)
                                    {
                                        <a class="text-danger cursor-pointer" onclick="javascript:DeleteService(@item.ServiceId,'@item.ImageUrl');" title="Delete" aria-label="Delete"><i class="bi bi-trash-fill"></i></a>
                                    }
                                }
                            </div>
                        </td>
                    }
                </tr>
                        i++;
                    }
                }
                else
                {
                    <tr class="odd"><td valign="top" colspan="10" class="font-14 text-center">No  Records found</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="row pt-3">
        <div class="col-sm-4 col-md-5">
            <div class="dataTables_info" id="example_info" role="status" aria-live="polite">
                Showing @((PageNo * Items) - (Items - 1)) - @((PageNo * Items) > Total ? Total : (PageNo * Items)) of @Total entries
            </div>
        </div>
        <div class="col-sm-3 col-md-7 " @(Total > 0 ? "" : "disable")>
            <div class="d-flex flex-wrap gap-4 justify-content-end">

                <div class="dataTables_paginate paging_simple_numbers" id="example_paginate">
                    @Html.Raw(AWS_AssociationToolCore.BLL.Common.SetPaging((Int64)ViewBag.items, ref Total, (Int64)ViewBag.pageno, "pagination pb-0"))
                </div>
            </div>
        </div>
    </div>


</div>

<style>
    .aws-h-a {
        text-decoration: none;
        position: relative;
    }

        .aws-h-a::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            bottom: -2px;
            border-bottom: 2px solid #0756ca;
            transform: scaleX(0);
            transition: transform 0.3s ease;
        }

        .aws-h-a:hover::after {
            transform: scaleX(1);
        }
</style>