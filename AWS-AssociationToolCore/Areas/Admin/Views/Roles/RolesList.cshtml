@using AWS_AssociationToolCore.BLL

@using System.Configuration;
@{ Layout = null;}
@{
    string sortcolumn = (string)ViewBag.sortcolumn;
    string sortorder = (string)ViewBag.sortorder;
    Int64 Total = (Int64)ViewBag.total;
    var PageNo = (Int64)ViewBag.pageno;
    var Items = (Int64)ViewBag.items;


    List<AWS_AssociationToolCore.Entities.Roles> lstRoles = ViewBag.lstRoles;
    bool IsEdit = Convert.ToBoolean(Context.Session.GetString("IsEdit"));
    bool IsView = Convert.ToBoolean(Context.Session.GetString("IsView"));
    bool IsDelete = Convert.ToBoolean(Context.Session.GetString("IsDelete"));
    bool IsExport = Convert.ToBoolean(Context.Session.GetString("IsExport"));
    bool IsAdd = Convert.ToBoolean(Context.Session.GetString("IsAdd"));


}

<script type="text/javascript">

    function Rolestatus(RoleId) {
        $.ajax({
            type: "POST",
            url: '@Url.Action("RolesStatus", "Roles")', // the URL of the controller action method
            data: { RoleId: RoleId }, // optional data
            datatype: "JSON",
            success: function (result) {
                showLobiboxNotification(result.messageType, result.message);
                if (result.ok) {
                    RolesBind(1);
                }
                else {
                    $('#divmessage').html(result.data);
                    $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                }
            }
        });
    }

    function DeleteRoles(RoleId, ImageUrl) {
        var val2 = confirm("Do you want to delete this record?");
        if (val2) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("DeleteRoles", "Roles")',  // the URL of the controller action method
                data: { RoleId: RoleId, ImageUrl: ImageUrl }, // optional data
                success: function (result) {
                    showLobiboxNotification(result.messageType, result.message);
                    if (result.ok) {
                        RolesBind(1);
                    }
                    else {
                        $("#divmessage").val(result.data);
                        $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                    }
                },
            });
        }
    }

   
</script>

<div class="card-body">
    <div class="table-responsive">
        <table width="100%" class="table table-striped align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th width="5%" style="text-align:center;">S.No</th>
                    <th width="40%">
                        <a style="color: black;" class="cursor-pointer aws-h-a " onclick="javascript:sortresult('RoleName');">
                            Role Name @if (sortcolumn == "RoleName")
                            {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                        </a>
                    </th>


                    <th width="16%">#</th>
                    <th width="16%">#</th>
                


                    <th style="text-align:center; padding: 8px 6px;" width="12%">Posted Date</th>
                    
                        <th style="text-align:center; padding: 8px 6px;" width="12%">Status</th>
                    
                        <th width="10%" >Action</th>
                    
                </tr>
            </thead>
            <tbody>
                @if (lstRoles.Count != 0)
                {
                    int i = 0;
                    foreach (var item in lstRoles)
                    {
                <tr>
                    <td style="text-align:center;">@item.RId</td>
                    <td>@(item.RoleName == null || item.RoleName == "" ? "N/A" : item.RoleName)</td>
                    <td><a href="@Url.Action("AssignMenu","AdminMenuItems", new { RoleId = item.RoleId })" >Access</a></td>
                    <td><a href="@Url.Action("Index","Users", new { RoleName = item.RoleName })">Admin Users(@item.UserCount)</a></td>
                    <td style="text-align:center;">@(item.UpdatedTime != null && item.UpdatedTime != DateTime.MinValue ? item.UpdatedTime.ToAppDate() : "N/A")</td>
                    <td style="text-align:center;">
                        <div class="menu-hover">
                            @{ var isChecked = item.IsActive ? "checked" : ""; }
                            @{var titleValue = item.IsActive ? "Active" : "Disabled";}
                            <div>
                                <label class="switch" title="@titleValue">
                                    <input type="checkbox" onclick="Rolestatus(@item.RoleId)" @isChecked>
                                    <span class="slider"></span>
                                </label>
                            </div>
                        </div>
                    </td>
                    <td style="text-align:center;">
                        <div class="table-actions d-flex align-items-center gap-3 fs-6">
                            @if (IsEdit == true)
                            {
                                <a class="text-warning cursor-pointer" onclick="EditRolesType(@item.RoleId);" title=" Edit" aria-label="Edit"><i class="bi bi-pencil-fill"></i></a>
                            }
                            @if (IsDelete == true)
                            {
                                <a class="text-danger cursor-pointer" onclick="javascript:DeleteRoles(@item.RoleId);" title="Delete" aria-label="Delete"><i class="bi bi-trash-fill"></i></a>
                            }
                            </div>
                    </td>

                </tr>
                        i++;
                    }
                }
                else
                {
                    <tr class="odd"><td valign="top" colspan="10" class="font-14 text-center">No  Records found</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="row pt-3">
        <div class="col-sm-4 col-md-5">
            <div class="dataTables_info" id="example_info" role="status" aria-live="polite">
                Showing @((PageNo * Items) - (Items - 1)) - @((PageNo * Items) > Total ? Total : (PageNo * Items)) of @Total entries
            </div>
        </div>
        <div class="col-sm-3 col-md-7 " @(Total > 0 ? "" : "disable")>
            <div class="d-flex flex-wrap gap-4 justify-content-end">

                <div class="dataTables_paginate paging_simple_numbers" id="example_paginate">
                    @Html.Raw(AWS_AssociationToolCore.BLL.Common.SetPaging((Int64)ViewBag.items, ref Total, (Int64)ViewBag.pageno, "pagination pb-0"))
                </div>
            </div>
        </div>
    </div>

</div>

<style>
    .aws-h-a {
        text-decoration: none;
        position: relative;
    }

        .aws-h-a::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            bottom: -2px;
            border-bottom: 2px solid #0756ca;
            transform: scaleX(0);
            transition: transform 0.3s ease;
        }

        .aws-h-a:hover::after {
            transform: scaleX(1);
        }
</style>