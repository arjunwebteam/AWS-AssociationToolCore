@{
    ViewBag.Title = "Index";
    ViewBag.Pageheading = "Volunteers";
    Layout = "~/Areas/Admin/Views/Shared/_MainLayout.cshtml";

    var catlist = (List<AWS_AssociationToolCore.Entities.VolunteerCategories>)ViewBag.catlist;

    var eventlist = (List<AWS_AssociationToolCore.Entities.Events>)ViewBag.eventlist;

    Int64 EventId = ViewBag.EventId;



    string userRole = Context.Session.GetString("userrole") ?? string.Empty;

    bool IsEdit = ViewBag.IsEdit;
    bool IsView = ViewBag.IsView;
    bool IsDelete = ViewBag.IsDelete;
    bool IsExport = ViewBag.IsExport;
    bool IsAdd = ViewBag.IsAdd;
    Int64 Mid = ViewBag.mid;
    Int64 ChapterId = ViewBag.ChapterId;

    // AppInfo nunchi export mode (Selected => modal, lekapothe direct all fields)
    int appInfoStatus = 0;
    AWS_AssociationToolCore.BLL.AppInfo _AppInfo = new AWS_AssociationToolCore.BLL.AppInfo();
    AWS_AssociationToolCore.Entities.AppInfo objAppInfo = _AppInfo.GetAppInfoDetails(ref appInfoStatus);
}


<script type="text/javascript">

    $(document).ready(function () {
        $('#wVolunteer, #wVolunteers').addClass('active');
        $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
        $('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
        PagerClickBind();
    });

    function sortresult(sortcolumn) {
        $('#hdnsortorder').val(($('#hdnsortorder').val() == 'ASC' ? 'DESC' : 'ASC'));
        $('#hdnsortcolumn').val(sortcolumn);
        VolunteerBind(1);
    }

    function VolunteerView(VolunteerId) {
        $.ajax({
            url: '@Url.Action("EditVolunteer", "Volunteers")',
            type: 'POST',
            data: { VolunteerId: VolunteerId },
            datatype: "JSON",
            success: function (result) {
                if (result.ok) {
                    var objInnerPageCategory = result.data;
                    $('#lblCategoryName').html(objInnerPageCategory.CategoryName);

                    $("#InnerPageCategoryView").dialog("open");

                }
                else {
                    alert(result.data);
                }
            }
        });

    }
    function VolunteerBind(Pageno) {

        var pageno = Common.Pageno(Pageno);
        var sortcolumn = $('#hdnsortcolumn').val();
        var sortorder = $('#hdnsortorder').val();
        var items = $('#txtitems').val();
        var Search = $('#txtsearch').val().trim();
        var catid = $('#VolunteerCategoryId').val();
        var eventid = $('#EventId').val();

        $.ajax({
            url: '@Url.Action("VolunteersList", "Volunteers")',
            type: 'GET',
            cache: false,
            data: { Search: Search, PageNo: pageno, SortColumn: sortcolumn, SortOrder: sortorder, Items: items, VolunteerCategoryId: catid, EventId: eventid, IsEdit: '@IsEdit', IsView: '@IsView', IsDelete: '@IsDelete', IsExport: '@IsExport', IsAdd: '@IsAdd', Mid: '@Mid', ChapterId: @ChapterId},
            success: function (result) {
                $('#divDetails').html(result);
                PagerClickBind();
            }
        });
    }
      function PagerClickBind() {
            $(document).off("click", ".pagination .page-link").on("click", ".pagination .page-link", function () {
                var id = $(this).attr("id");
                var pageNo;

                if (id === "Previous" || id === "Next") {
                    pageNo = parseInt($(this).data("page"));
                } else {
                    pageNo = parseInt(id);
                }

                if (!pageNo || isNaN(pageNo) || pageNo < 1) return;

                $('#hdnPageNo').val(pageNo);
                    VolunteerBind(pageNo);
            });
        }
    function Delete(VolunteerId) {
        var val2 = confirm("Do you want to delete this record?");
        if (val2) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("DeleteVolunteer", "Volunteers")',  // the URL of the controller action method
                data: { VolunteerId: VolunteerId }, // optional data
                success: function (result) {
                    showLobiboxNotification(result.messageType, result.message);
                    VolunteerBind(1);
                },
                error: function (req, status, error) {
                    $("#divmessage").html(result.data);
                    $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                }
            });
        }
    }
    function VolunteerStatus(VolunteerId) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Volunteerstatus", "Volunteers")',  // the URL of the controller action method
                data: { VolunteerId: VolunteerId }, // optional data
                success: function (result) {
                    showLobiboxNotification(result.messageType, result.message);
                    VolunteerBind(1);
                },
                error: function (req, status, error) {
                    $("#divmessage").html(result.data);
                    $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                }
            });
    }



    function SearchClear() {
        $('#txtsearch').val('');
        VolunteerBind(1);
    }
    function ClearSearch() {
        $('#txtsearch').val('');
        $('#VolunteerId').val('');
        $('#hdnPageNo').val(1);
        $('#VolunteerCategoryId').val('').trigger('change');
        $('#EventId').val('');
        VolunteerBind(1);
    }

    // ================= Export to Excel =================
    // AppInfo.ExportExel value ("Selected" aithe modal, lekapothe direct all fields download)
    var exportMode = '@(objAppInfo?.ExportExel ?? "")';

    function BuildExportUrl(selectedFields) {
        var url = '@Url.Action("VolunteersExporttoExcel", "Volunteers")'
            + '?Search=' + encodeURIComponent($('#txtsearch').val() || '')
            + '&ChapterId=' + encodeURIComponent('@ChapterId')
            + '&VolunteerCategoryId=' + encodeURIComponent($('#VolunteerCategoryId').val() || '0')
            + '&EventId=' + encodeURIComponent($('#EventId').val() || '0');
        if (selectedFields) {
            url += '&SelectedFields=' + encodeURIComponent(selectedFields);
        }
        return url;
    }

    function ExporttoExcel() {
        if ((exportMode || '').toLowerCase() !== 'advacnce') {
            window.location.href = BuildExportUrl('');
            return;
        }

        $('#exportFieldsValidation').addClass('d-none');
        $('#exportFieldsList').html('<div class="text-center text-muted py-4">Loading fields...</div>');
        $('#exportFieldsModal').modal('show');

        $.ajax({
            url: '@Url.Action("GetVolunteerExportFields", "Volunteers")',
            type: 'GET',
            cache: false,
            data: { ChapterId: '@ChapterId' },
            success: function (result) {
                if (!result.ok) {
                    $('#exportFieldsList').html('<div class="text-danger">' + result.message + '</div>');
                    return;
                }

                // section wise group chey
                var groups = {}, order = [];
                $.each(result.data, function (i, f) {
                    var key = f.fieldKey !== undefined ? f.fieldKey : f.FieldKey;
                    var name = f.displayName !== undefined ? f.displayName : f.DisplayName;
                    var sec = (f.section !== undefined ? f.section : f.Section) || 'Fields';
                    if (!groups[sec]) { groups[sec] = []; order.push(sec); }
                    groups[sec].push({ key: key, name: name });
                });

                var html = '';
                $.each(order, function (s, sec) {
                    html += '<div class="exp-section-title">' + sec + '</div><div class="exp-grid">';
                    $.each(groups[sec], function (i, f) {
                        html += '<label class="exp-item"><span>' + f.name + '</span>'
                              + '<input type="checkbox" class="export-field-chk" value="' + f.key + '" checked></label>';
                    });
                    if (groups[sec].length % 2 === 1) { html += '<div class="exp-item exp-filler"></div>'; }
                    html += '</div>';
                });

                $('#exportFieldsList').html(html || '<div class="text-muted">No exportable fields found.</div>');
            },
            error: function () {
                $('#exportFieldsList').html('<div class="text-danger">Failed to load export fields.</div>');
            }
        });
    }

    function ExportFieldsSelectAll(state) {
        $('.export-field-chk').prop('checked', state);
    }

    function ExportSelectedFieldsToExcel() {
        var selected = $('.export-field-chk:checked').map(function () { return this.value; }).get();
        if (selected.length === 0) {
            $('#exportFieldsValidation').removeClass('d-none');
            return;
        }
        $('#exportFieldsValidation').addClass('d-none');
        $('#exportSpinner').removeClass('d-none');
        $('#btnExportToExcel').prop('disabled', true);

        window.location.href = BuildExportUrl(selected.join(','));

        // file download navigation kabatti callback undadu, konchem tarvata reset chestam
        setTimeout(function () {
            $('#exportSpinner').addClass('d-none');
            $('#btnExportToExcel').prop('disabled', false);
            $('#exportFieldsModal').modal('hide');
        }, 1500);
    }


</script>

<input id="hdnPageNo" type="hidden" value="1" />
<input id="hdnsortcolumn" type="hidden" value="UpdatedDate" />
<input id="hdnsortorder" type="hidden" value="Desc" />


