                {
                    <a data-toggle="modal" href="@Url.Action("AddVolunteer", "Volunteers", new { EventId = EventId, mid = Mid })" class="btn btn-danger pull-right">Add Volunteer</a>
                }
                else
                {
                    <a data-toggle="modal" href="@Url.Action("AddVolunteer", "Volunteers", new { mid = Mid})" class="btn btn-danger pull-right" style="margin-left: 5px;">Add Volunteer</a>
                }
            }
            @if (IsExport == true || userRole.Contains("SuperAdmin") || userRole.Contains("DeveloperAdmin"))
            {
                <a data-toggle="modal" onclick="ExporttoExcel();" class="btn btn-primary pull-right" style="">Export Details to Excel</a>
            }
        </div>*@


            <div class="col-lg-2 col-4 text-end ms-auto">
                <div class="btn-align">
                    @if (IsAdd == true)
                    {

                        if (EventId != 0)
                        {
                            <a href="@Url.Action("AddVolunteer", "Volunteers", new { EventId = EventId, mid = Mid, ChapterId = ChapterId })" class="btn btn-primary">Add Volunteer</a>
                        }
                        else
                        {
                            <a href="@Url.Action("AddVolunteer", "Volunteers", new { mid = Mid, ChapterId = ChapterId })" class="btn btn-primary" style="margin-left: 5px;">Add Volunteer</a>
                        }
                        <a class="cursor-pointer do new-download " data-bs-toggle="tooltip" style="border: 0; background: transparent; border: 1px solid #e8e6e7; padding: 10px; border-radius: 50%; /*! width: 100px; */ background-color: #e8e6e7;" onclick="ExporttoExcel();" title="Export to Data ">
                            <i class="lni lni-download" style="font-size: 20px; color: black;"></i>
                        </a>
                    }
                </div>
            </div>







        </div>





    </div>
    <div id="divDetails" class="box-body table-responsive">
    </div>
    <script>
        $(document).ready(function () {
            $.ajax({
                type : "GET",
                url  : '@Url.Action("VolunteersList", "Volunteers")',
                data : {
                    IsEdit    : '@IsEdit',
                    IsView    : '@IsView',
                    IsDelete  : '@IsDelete',
                    IsExport  : '@IsExport',
                    IsAdd     : '@IsAdd',
                    Mid       : '@Mid',
                    ChapterId : '@(ChapterId == 0 ? 1 : ChapterId)'
                },
                success: function (data) {
                    $("#divDetails").html(data);
                },
                error: function () {
                    $("#divDetails").html('<p class="text-danger">Failed to load.</p>');
                }
            });
        });
    </script>
</div>

<!-- ================= Export Fields Popup ================= -->
<div class="modal fade" id="exportFieldsModal" tabindex="-1" aria-labelledby="exportFieldsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <div class="exp-eyebrow">Export to Excel</div>
                    <h5 class="exp-title" id="exportFieldsModalLabel">Volunteers</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="exportFieldsValidation" class="alert alert-danger d-none py-2" role="alert">
                    Please select at least one field to export.
                </div>
                <div class="exp-toolbar">
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="ExportFieldsSelectAll(true);">Select All</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="ExportFieldsSelectAll(false);">Clear All</button>
                </div>
                <div id="exportFieldsList">
                    <div class="text-center text-muted py-4">Loading fields...</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-export-cancel" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-export-data" id="btnExportToExcel" onclick="ExportSelectedFieldsToExcel();">
                    <span id="exportSpinner" class="spinner-border spinner-border-sm d-none me-1" role="status" aria-hidden="true"></span>
                    Export Data
                </button>
            </div>
        </div>
    </div>
</div>
