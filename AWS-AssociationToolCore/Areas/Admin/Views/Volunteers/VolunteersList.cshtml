@{ Layout = null;}
@{
    string sortcolumn = (string)ViewBag.sortcolumn;
    string sortorder = (string)ViewBag.sortorder;
    Int64 Total = (Int64)ViewBag.total;
    var PageNo = (Int64)ViewBag.pageno;
    var Items = (Int64)ViewBag.items;


    List<AWS_AssociationToolCore.Entities.Volunteers> lstVolunteer = ViewBag.lstVolunteers;


    string userRole = Context.Session.GetString("userrole") ?? string.Empty;

}
<div class="card-body">
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead class="table-light">
                <tr>

                    <th width="1%" style="text-align:center">S.No.</th>
                    <th width="20%" style="text-align: left">
                        <a onclick="javascript:sortresult('FirstName');" class="cursor-pointer aws-h-a " style="color: black;">
                            Name @if (sortcolumn == "FirstName")
                            {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                        </a>
                    </th>
                    <th width="10%" style="text-align: left">
                        Email
                        @*<a style="color: black;" onclick="javascript:sortresult('Email');">
                @if (sortcolumn == "Email")
                {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
            </a>*@
                    </th>
                    <th width="12%" style="text-align: left">
                        PhoneNo
                        @*<a style="color: black;" onclick="javascript:sortresult('PhoneNo');">
                @if (sortcolumn == "PhoneNo")
                {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
            </a>*@
                    </th>
                    <th width="12%" style="text-align: left">
                        <a onclick="javascript:sortresult('CategoryName');" class="cursor-pointer aws-h-a " style="color: black;">
                            Volunteer Category @if (sortcolumn == "CategoryName")
                            {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                        </a>
                    </th>
                    
                    <th style="text-align:center" width="10%">
                        <a class="cursor-pointer aws-h-a " style="color: black;" onclick="javascript:sortresult('HoursSpent');">
                            Hours Spent @if (sortcolumn == "HoursSpent")
                            {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                        </a>
                    </th>
                    <th width="10%" style="text-align:center">
                        IsActive
                        @*<a onclick="javascript:sortresult('IsActive');">
                            @if (sortcolumn == "IsActive")
                            {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}

                        </a>*@
                    </th>
                    <th width="10%" class="white-t-u" style="text-align:center">Actons</th>

                </tr>
            </thead>
            <tbody>
                @if (lstVolunteer.Count != 0)
                {
                    foreach (var item in lstVolunteer)
                    {
                <tr>

                    <td width="41" style="text-align:center">@item.RId</td>
                    <td style="text-align: left">@(item.FirstName + " " + item.LastName) </td>
                    <td style="text-align: left">@(item.Email == "" ? "N/A" : item.Email)</td>
                    @* <td align="left">@(item.HoursSpent == "" ? "N/A" : item.HoursSpent)</td>*@
                    <td style="text-align: left"> @(item.PhoneNo == "" || item.PhoneNo == null ? "N/A" : item.PhoneNo)</td>
                    <td style="text-align: left"> @(item.CategoryName == "" || item.CategoryName == null ? "" : item.CategoryName)</td>
                    <td style="text-align:center">
                        @if (item.HoursSpent != null && item.HoursSpent != "")
                        {
                        <span style="font-weight:bold;"> @item.HoursSpent <span>Hrs</span></span>
                        }
                    else
                    {
                        <span>--</span>
                    }
                    </td>
                    <td style="text-align:center;">
                        <div class="menu-hover">
                            @{ var isChecked = item.IsActive ? "checked" : ""; }
                            @{var titleValue = item.IsActive ? "Active" : "Disabled";}

                            <div>
                                <label class="switch" title="@titleValue">
                                    <input type="checkbox" onclick="VolunteerStatus(@item.VolunteerId)" @isChecked>
                                    <span class="slider"></span>
                                </label>
                            </div>
                        </div>
                    </td>
                    <td style="text-align: center" class="t-t-c">
                        <div class="table-actions  gap-3 fs-6">
                            @*@if (ViewBag.IsView == true || userRole.Contains("SuperAdmin") || userRole.Contains("DeveloperAdmin"))
                            {
                                <a class="text-primary cursor-pointer" href="@Url.Action("ViewVolunteer", "Volunteers", new { VolunteerId = item.VolunteerId, mid = ViewBag.Mid })" title="View" aria-label="Views"><i class="fa fa-eye"></i></a>
                            }*@
                            @if (ViewBag.IsEdit == true )
                            {
                                <a class="text-warning cursor-pointer" href="@Url.Action("EditVolunteer", "Volunteers", new { VolunteerId = item.VolunteerId, mid = ViewBag.Mid, ChapterId = ViewBag.ChapterId  })" title=" Edit" aria-label="Edit"><i class="bi bi-pencil-fill"></i></a>
                            }
                            @if (ViewBag.IsDelete == true )
                            {
                                <a class="text-danger cursor-pointer" onclick="javascript:Delete(@item.VolunteerId);" title="Delete" aria-label="Delete"><i class="bi bi-trash-fill"></i></a>
                            }
                        </div>
                    </td>
                </tr>
                    }
                }
                else
                {
                    <tr class="odd"><td valign="top" colspan="10" class="font-14 text-center">No Records found</td></tr>
                }

            </tbody>
        </table>
    </div>

    <div class="row pt-3">
        <div class="col-sm-4 col-md-5">
            <div class="dataTables_info" id="example_info" role="status" aria-live="polite">
                Showing @((PageNo * Items) - (Items - 1)) - @((PageNo * Items) > Total ? Total : (PageNo * Items)) of @Total entries
            </div>
        </div>
        <div class="col-sm-3 col-md-7 " @(Total > 0 ? "" : "disable")>
            <div class="d-flex flex-wrap gap-4 justify-content-end">

                <div class="dataTables_paginate paging_simple_numbers" id="example_paginate">
                    @Html.Raw(AWS_AssociationToolCore.BLL.Common.SetPaging((Int64)ViewBag.items, ref Total, (Int64)ViewBag.pageno, "pagination pb-0"))
                </div>
            </div>
        </div>
    </div>
</div>


<style>
    .aws-h-a {
        text-decoration: none;
        position: relative;
    }

        .aws-h-a::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            bottom: -2px;
            border-bottom: 2px solid #0756ca;
            transform: scaleX(0);
            transition: transform 0.3s ease;
        }

        .aws-h-a:hover::after {
            transform: scaleX(1);
        }
</style>