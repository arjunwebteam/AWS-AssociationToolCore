                            </div>




                        </div>
                        <div class="col-xs-2 col-lg-4 col-sm-2">
                            <div class="clearfix">
                                <label style="font-size: 15px;">Clone Permissions from Other Role</label>

                                <select class="single-select" id="RoleIds" name="RoleIds" style="font-size: 17px !important; height: 60px; text-align: center; background-color: #ccc; ">
                                    <option value="" selected>--  Select Role  --</option>
                                    @*@if (lstRoles != null && lstRoles.Count != 0)
                                        {
                                            foreach (var item in lstRoles)
                                            {
                                                <option value="@item.RoleId">@item.RoleName</option>
                                            }
                                        }*@
                                </select>

                            </div>




                        </div>
                        <div class="col-xs-2 col-lg-2 col-sm-2" style="margin-top: 0px;">
                            <div>
                                <label>&nbsp;</label>
                            </div>

                            <button type="button" class="btn btn-primary" onclick="CloneRoleIds();">Clone Permissions</button>

                        </div>


                    </div>
                </div>
            </div>
        </div>

    </div>
}




<div id="divAssignMenuList" class="clearfix">
</div>

