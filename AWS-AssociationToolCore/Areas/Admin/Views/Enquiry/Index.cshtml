@using AWS_AssociationToolCore.BLL

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_MainLayout.cshtml";

    var eventlist = (List<AWS_AssociationToolCore.Entities.Events>)ViewBag.eventlist;

    string userRole = Context.Session.GetString("userrole") ?? string.Empty; bool IsEdit = ViewBag.IsEdit;
    bool IsView = ViewBag.IsView;
    bool IsDelete = ViewBag.IsDelete;
    bool IsExport = ViewBag.IsExport;
    bool IsAdd = ViewBag.IsAdd;
    Int64 Mid = ViewBag.mid;
    ViewBag.Pageheading = "Enquiries";

    int status = 0;
    AWS_AssociationToolCore.BLL.AppInfo _AppInfo = new AWS_AssociationToolCore.BLL.AppInfo();
    AWS_AssociationToolCore.Entities.AppInfo objAppInfo = new AWS_AssociationToolCore.Entities.AppInfo();
    objAppInfo = _AppInfo.GetAppInfoDetails(ref status);
}


<script type="text/javascript">

    $(document).ready(function () {
        $('#wEnquiries, #wOthers').addClass('active');
        $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
        $('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');

        $(".date").datepicker({ changeMonth: true, changeYear: true, yearRange: "-90:+0", altFormat: 'mm/dd/yy' });
        PagerClickBind();
    });

       function PagerClickBind() {
            $(document).off("click", ".pagination .page-link").on("click", ".pagination .page-link", function () {
                var id = $(this).attr("id");
                var pageNo;

                if (id === "Previous" || id === "Next") {
                    pageNo = parseInt($(this).data("page"));
                } else {
                    pageNo = parseInt(id);
                }

                if (!pageNo || isNaN(pageNo) || pageNo < 1) return;

                $('#hdnPageNo').val(pageNo);
                    EnquiryBind(pageNo);
            });
        }

    function sortresult(sortcolumn) {
        $('#hdnsortorder').val(($('#hdnsortorder').val() == 'ASC' ? 'DESC' : 'ASC'));
        $('#hdnsortcolumn').val(sortcolumn);
        EnquiryBind(1);
    }

    function EnquiryBind(Pageno) {

        var pageno = Common.Pageno(Pageno);
        var sortcolumn = $('#hdnsortcolumn').val();
        var sortorder = $('#hdnsortorder').val();
        var items = $('#txtitems').val();
        var Search = $('#txtsearch').val();
        var FromDate = $('#FromDate').val();
        var ToDate = $('#ToDate').val();
        var eventid = $('#EventId').val();

        $.ajax({
            url: '@Url.Action("EnquiriesList", "Enquiry")',
            type: 'GET',
            cache: false,
            data: { FromDate: FromDate, ToDate: ToDate, Search: Search, PageNo: pageno, SortColumn: sortcolumn, SortOrder: sortorder, Items: items, EventId: eventid, IsEdit: '@IsEdit', IsView: '@IsView', IsDelete: '@IsDelete', IsExport: '@IsExport', IsAdd: '@IsAdd', Mid: '@Mid' },
            success: function (result) {

                $('#divEnquiries').html(result);
                PagerClickBind();
            }
        });
    }

    function Delete(EnquiryId) {
        var val2 = confirm("Do you want to delete this record?");
        if (val2) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("DeleteEnquiry", "Enquiry")',
                data: { EnquiryId: EnquiryId },
                success: function (result) {
                    showLobiboxNotification(result.messageType, result.message);
                    EnquiryBind(1);
                },
                error: function (req, status, error) {
                    showLobiboxNotification(result.messageType, result.message);
                }
            });
        }
    }

    function EnquiryStatus(EnquiryId) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("EnquiryStatus", "Enquiry")',
                data: { EnquiryId: EnquiryId },
                success: function (result) {
                    showLobiboxNotification(result.messageType, result.message);
                    EnquiryBind(1);
                },
                error: function (req, status, error) {
                    showLobiboxNotification(result.messageType, result.message);
                }
            });
    }


    function ClearSearch() {
        $('#txtsearch').val('');
        $('#FromDate').val('');
        $('#ToDate').val('');
        $('#hdnPageNo').val(1);
        EnquiryBind(1);
    }

    // ================= Export to Excel =================
    // AppInfo.ExportExel value ("Selected" aithe modal, lekapothe direct all fields download)
    var exportMode = '@(objAppInfo?.ExportExel ?? "")';

    function ExportAllFieldsToExcel() {
        var url = '@Url.Action("EnquiriesExporttoExcel", "Enquiry")'
            + '?search=' + encodeURIComponent($('#txtsearch').val() || '')
            + '&eventId=' + encodeURIComponent($('#EventId').val() || '0')
            + '&fromDate=' + encodeURIComponent($('#FromDate').val() || '')
            + '&toDate=' + encodeURIComponent($('#ToDate').val() || '')
            + '&sortColumn=' + encodeURIComponent($('#hdnsortcolumn').val() || 'InsertedTime')
            + '&sortOrder=' + encodeURIComponent($('#hdnsortorder').val() || 'DESC');
        window.location.href = url;
    }

    function ExporttoExcel() {
        if ((exportMode || '').toLowerCase() !== 'advacnce') {
            ExportAllFieldsToExcel();
            return;
        }

        $('#exportFieldsValidation').addClass('d-none');
        $('#exportFieldsList').html('<div class="text-center text-muted py-4">Loading fields...</div>');
        $('#exportFieldsModal').modal('show');

        $.ajax({
            url: '@Url.Action("GetEnquiryExportFields", "Enquiry")',
            type: 'GET',
            cache: false,
            success: function (result) {
                if (!result.ok) {
                    $('#exportFieldsList').html('<div class="text-danger">' + result.message + '</div>');
                    return;
                }

                // section wise group chey (Enquiry Details / Custom Fields)
                var groups = {}, order = [];
                $.each(result.data, function (i, f) {
                    var key = f.fieldKey !== undefined ? f.fieldKey : f.FieldKey;
                    var name = f.displayName !== undefined ? f.displayName : f.DisplayName;
                    var sec = (f.section !== undefined ? f.section : f.Section) || 'Fields';
                    if (!groups[sec]) { groups[sec] = []; order.push(sec); }
                    groups[sec].push({ key: key, name: name });
                });

                var html = '';
                $.each(order, function (s, sec) {
                    html += '<div class="exp-section-title">' + sec + '</div><div class="exp-grid">';
                    $.each(groups[sec], function (i, f) {
                        html += '<label class="exp-item"><span>' + f.name + '</span>'
                              + '<input type="checkbox" class="export-field-chk" value="' + f.key + '" checked></label>';
                    });
                    if (groups[sec].length % 2 === 1) { html += '<div class="exp-item exp-filler"></div>'; }
                    html += '</div>';
                });

                $('#exportFieldsList').html(html || '<div class="text-muted">No exportable fields found.</div>');
            },
            error: function () {
                $('#exportFieldsList').html('<div class="text-danger">Failed to load export fields.</div>');
            }
        });
    }

    function ExportFieldsSelectAll(state) {
        $('.export-field-chk').prop('checked', state);
    }

    function ExportSelectedFieldsToExcel() {
        var selected = $('.export-field-chk:checked').map(function () { return this.value; }).get();
        if (selected.length === 0) {
            $('#exportFieldsValidation').removeClass('d-none');
            return;
        }
        $('#exportFieldsValidation').addClass('d-none');
        $('#exportSpinner').removeClass('d-none');
        $('#btnExportToExcel').prop('disabled', true);

        var url = '@Url.Action("EnquiriesExporttoExcel", "Enquiry")'
            + '?search=' + encodeURIComponent($('#txtsearch').val() || '')
            + '&eventId=' + encodeURIComponent($('#EventId').val() || '0')
            + '&fromDate=' + encodeURIComponent($('#FromDate').val() || '')
            + '&toDate=' + encodeURIComponent($('#ToDate').val() || '')
            + '&sortColumn=' + encodeURIComponent($('#hdnsortcolumn').val() || 'InsertedTime')
            + '&sortOrder=' + encodeURIComponent($('#hdnsortorder').val() || 'DESC')
            + '&SelectedFields=' + encodeURIComponent(selected.join(','));

        window.location.href = url;

        // file download navigation kabatti callback undadu, konchem tarvata reset chestam
        setTimeout(function () {
            $('#exportSpinner').addClass('d-none');
            $('#btnExportToExcel').prop('disabled', false);
            $('#exportFieldsModal').modal('hide');
        }, 1500);
    }

</script>

<input id="hdnPageNo" type="hidden" value="1" />
<input id="hdnsortcolumn" type="hidden" value="InsertedTime" />
<input id="hdnsortorder" type="hidden" value="DESC" />
<div class="card">
    <div class="card-header py-3 mb-3">
        <div class="row  gx-2">

            <div class="col-lg-2 col-md-6 col-8">
                <div class="input-box">
                    <label class="form-label">Search <span class="text-danger"></span></label>
                    <div class="input-group mb-3">
                        <input type="text" class="form-control" name="txtsearch" id="txtsearch" placeholder="Name">
                    </div>
                </div>
            </div>

            <div class="col-xs-12 col-lg-3 col-sm-6">
                <label>Date Range</label>
                <div class="clearfix row">
                    <div class="col-xs-12 col-lg-6 col-sm-6">
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa fa-calendar"></i></span>
                            <input type="text" data-mask="" data-inputmask="'alias': 'mm/dd/yyyy'" class="form-control" placeholder="From" name="FromDate" id="FromDate">
                        </div>
                    </div>
                    <div class="col-xs-12 col-lg-6 col-sm-6">
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa fa-calendar"></i></span>
                            <input type="text" data-mask="" data-inputmask="'alias': 'mm/dd/yyyy'" class="form-control" placeholder="To" name="ToDate" id="ToDate">
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-2 col-2" id="clearhide">
                <div>
                    <label>&nbsp;</label>
                </div>
                <button type="button" class="btn btn-primary px-3" onclick="EnquiryBind(1);">Search</button>
                <button type="button" class="btn btn-danger px-3" onclick="ClearSearch();">Clear</button>
            </div>
            <div class="col-lg-5 col-2 text-end" id="clearhide">
                <div>
                    <label>&nbsp;</label>
                </div>
                @if (IsExport == true)
                {
                    <a class="cursor-pointer do  new-download" data-bs-toggle="tooltip" style="border: 0;background: transparent;border: 1px solid #e8e6e7;padding: 10px;border-radius: 50%;" onclick="ExporttoExcel();" title="Export Data">
                        <i class="lni lni-download" style="font-size: 20px; color: black;"></i>
                    </a>
                }
            </div>

        </div>
    </div>

    <div id="divEnquiries" class="clearfix">
    </div>
</div>

<!-- ================= Export Fields Popup ================= -->
<div class="modal fade" id="exportFieldsModal" tabindex="-1" aria-labelledby="exportFieldsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <div class="exp-eyebrow">Export to Excel</div>
                    <h5 class="exp-title" id="exportFieldsModalLabel">Enquiries</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="exportFieldsValidation" class="alert alert-danger d-none py-2" role="alert">
                    Please select at least one field to export.
                </div>
                <div class="exp-toolbar">
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="ExportFieldsSelectAll(true);">Select All</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="ExportFieldsSelectAll(false);">Clear All</button>
                </div>
                <div id="exportFieldsList">
                    <div class="text-center text-muted py-4">Loading fields...</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-export-cancel" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-export-data" id="btnExportToExcel" onclick="ExportSelectedFieldsToExcel();">
                    <span id="exportSpinner" class="spinner-border spinner-border-sm d-none me-1" role="status" aria-hidden="true"></span>
                    Export Data
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        loadMenuItems();
    });

    function loadMenuItems() {
        $.ajax({
            type: "GET",
            url: '@Url.Action("EnquiriesList", "Enquiry")',
            cache: false,
            data: {
                SortColumn: $('#hdnsortcolumn').val(),
                SortOrder: $('#hdnsortorder').val(),
                PageNo: 1,
                IsEdit    : '@ViewBag.IsEdit',
                IsView    : '@ViewBag.IsView',
                IsDelete  : '@ViewBag.IsDelete',
                IsExport  : '@ViewBag.IsExport',
                IsAdd     : '@ViewBag.IsAdd',
                Mid       : '@ViewBag.mid'
            },
            success: function (data) {
                $("#divEnquiries").html(data);
            },
            error: function () {
                $("#divEnquiries").html('<p class="text-danger">Failed to load.</p>');
            }
        });
    }
</script>

<script>
                var appDateFormat = '@AWS_AssociationToolCore.BLL.AppDate.JqFormat';

    $(document).ready(function () {
        $(function () {
            $("#FromDate,#ToDate").datepicker({
                changeMonth: true,
                changeYear: true,
                showButtonPanel: true,
                dateFormat: appDateFormat
            });
        });
    });
</script>
