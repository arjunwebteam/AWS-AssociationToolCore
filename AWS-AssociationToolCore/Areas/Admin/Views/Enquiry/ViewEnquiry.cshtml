                    </div>
                </div>
                 @if (objAppInfo.CustomFieldStatus == "Yes")
{
    var cfForm = new AWS_AssociationToolCore.BLL.CustomFields()
        .GetDynamicForm(AWS_AssociationToolCore.Entities.CustomFieldFormCodes.Enquiries, objEnquiriy.EnquiryId);

    if (cfForm.Fields != null && cfForm.Fields.Count > 0)
    {
        <div class="box validation">
            <div class="card">
                <div class="card-body">
                    <div class="row g-3 dynamic-fields-row">
                        @* --- Custom Fields (Admin-configured, dynamic) --- *@

                        <div id="customFieldsReadOnly">
                            @await Component.InvokeAsync("DynamicCustomFields", new { formCode = AWS_AssociationToolCore.Entities.CustomFieldFormCodes.Enquiries, recordId = objEnquiriy.EnquiryId, theme = "admin" })
                        </div>

                        <style>
                            #customFieldsReadOnly input:disabled,
                            #customFieldsReadOnly select:disabled,
                            #customFieldsReadOnly textarea:disabled {
                                background-color: #f1f3f5 !important;
                                color: #495057 !important;
                                cursor: not-allowed;
                                opacity: 1;
                                box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.12);
                                resize: none;
                            }
                        </style>

                        <script>
                            $(document).ready(function () {
                                $("#customFieldsReadOnly").find("input, select, textarea").prop("disabled", true);
                            });
                        </script>
                    </div>
                </div>
            </div>
        </div>
    }
}
