@using AWS_AssociationToolCore.BLL
@using System.Configuration
@{ Layout = null;}
@{
    string sortcolumn = (string)ViewBag.sortcolumn;
    string sortorder = (string)ViewBag.sortorder;
    Int64 Total = (Int64)ViewBag.total;
    var PageNo = (Int64)ViewBag.pageno;
    var Items = (Int64)ViewBag.items;
    List<AWS_AssociationToolCore.Entities.PromoCodes> lstPromoCodes = ViewBag.lstPromoCodes;

}

<script type="text/javascript">

    function PromoCodesStatus(PromoCodeId) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("PromoCodesStatus", "PromoCodes")', // the URL of the controller action method
            data: { PromoCodeId: PromoCodeId }, // optional data
            datatype: "JSON",
            success: function (result) {
                showLobiboxNotification(result.messageType, result.message);
                if (result.ok) {
                //    $('#divmessage').html(result.data);
                //    $('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                    PromoCodesBind($('#hdnPageNo').val());
                }
                else {
                    $('#divmessage').html(result.data);
                    $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                }
            }
        });
    }


</script>
<div class="card-body">
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead class="table-light">
                <tr>

                    <th width="70" class="text-center">S.No</th>

                    <th>
                        <a style="color: black;" onclick="javascript:sortresult('PromoCode');" class="white-t-u aws-h-a">
                            Promo Code @if (sortcolumn == "PromoCode")
                            {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                        </a>
                       
                    </th>
                    <th>
                        <a style="color: black;" onclick="javascript:sortresult('Discount');" class="white-t-u aws-h-a">
                            Discount @if (sortcolumn == "Discount")
                            {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                        </a>
                        
                    </th>
                    <th>
                        <a style="color: black;" onclick="javascript:sortresult('EndDate');" class="white-t-u aws-h-a">
                            Expire Date @if (sortcolumn == "EndDate")
                            {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                        </a>
                        
                    </th>
                    <th>Status</th>

                    <th class="text-center" width="50">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Total != 0)
                {
                    //int i = 1;
                    foreach (var item in (List<AWS_AssociationToolCore.Entities.PromoCodes>)ViewBag.lstPromoCodes)
                    {
                        <tr>
                            <td style="text-align: center">@item.RId</td>
                            <td>
                             
                                @item.PromoCode
                            </td>

                            <td>@((int)item.Discount)%</td>

                            <td>@(item.EndDate != null && item.EndDate != DateTime.MinValue ? item.EndDate.ToAppDate() : "N/A")</td>
                            <td>
                                <div class="menu-hover">
                                    @{ var isChecked = item.IsActive ? "checked" : ""; }
                                    @{var titleValue = item.IsActive ? "Active" : "Disabled";}

                                    <div>
                                        <label class="switch" title="@titleValue">
                                            <input type="checkbox" onclick="PromoCodesStatus(@item.PromoCodeId)" @isChecked>
                                            <span class="slider"></span>
                                        </label>
                                    </div>
                                </div>
                            </td>



                            <td style="text-align: center">
                                <div class="table-actions d-flex align-items-center gap-3 fs-6">
                                    @if (ViewBag.IsEdit == true )
                                    {

                                        <a class="text-warning cursor-pointer" href="@Url.Action("EditPromoCodes", "PromoCodes", new { PromoCodeId = item.PromoCodeId, mid = ViewBag.mid })" title=" Edit" aria-label="Edit"><i class="bi bi-pencil-fill"></i></a>
                                    }
                                    @if (ViewBag.IsDelete == true )
                                    {

                                        <a class="text-danger cursor-pointer" onclick="DeletePromoCodes(@item.PromoCodeId)" title="Delete" aria-label="Delete"><i class="bi bi-trash-fill"></i></a>
                                    }

                                </div>
                            </td>



                        </tr>
                    }
                }
                else
                {
                    <tr class="odd"><td valign="top" colspan="10" class="font-14 text-center">No  Records found</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="row pt-3">
        <div class="col-sm-4 col-md-5">
            <div class="dataTables_info" id="example_info" role="status" aria-live="polite">
                Showing @((PageNo * Items) - (Items - 1)) - @((PageNo * Items) > Total ? Total : (PageNo * Items)) of @Total entries
            </div>
        </div>
        <div class="col-sm-3 col-md-7 " @(Total > 0 ? "" : "disable")>
            <div class="d-flex flex-wrap gap-4 justify-content-end">

                <div class="dataTables_paginate paging_simple_numbers" id="example_paginate">
                    @Html.Raw(AWS_AssociationToolCore.BLL.Common.SetPaging((Int64)ViewBag.items, ref Total, (Int64)ViewBag.pageno, "pagination pb-0"))
                </div>
            </div>
        </div>
    </div>

</div>
<style>
    .aws-h-a {
        text-decoration: none;
        position: relative;
    }

        .aws-h-a::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            bottom: -2px;
            border-bottom: 2px solid #0756ca;
            transform: scaleX(0);
            transition: transform 0.3s ease;
        }

        .aws-h-a:hover::after {
            transform: scaleX(1);
        }
</style>
