@using AWS_AssociationToolCore.BLL

@using System.Configuration;
@{ Layout = null;}
@{
    string sortcolumn = (string)ViewBag.sortcolumn;
    string sortorder = (string)ViewBag.sortorder;
    Int64 Total = (Int64)ViewBag.total;
    var PageNo = (Int64)ViewBag.pageno;
    var Items = (Int64)ViewBag.items;
    var ChapterId = ViewBag.ChapterId;

    List<AWS_AssociationToolCore.Entities.QrCode> lstQrCode = ViewBag.lstQrCode;

    string userRole = Context.Session.GetString("userrole") ?? string.Empty;
}
<link rel="stylesheet" type="text/css" href="Content/lib/lightview/css/lightview/lightview.css" />
<script type="text/javascript" src="Content/lib/lightview/js/spinners/spinners.js"></script>
<script type="text/javascript" src="Content/lib/lightview/js/lightview/lightview.js"></script>
<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/fancybox/3.5.7/jquery.fancybox.min.css" />

<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/fancybox/3.5.7/jquery.fancybox.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">


<script type="text/javascript">

    $(document).ready(function () {
        $('.closable').append('<span class="closelink" title="Close"></span>');
        $('.closelink').click(function () {
            $(this).parent().fadeOut('600', function () { $(this).remove(); });
        });
    });

    function QrCodeStatus(QrCodeId) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("QrCodeStatus", "QRCode")', // the URL of the controller action method
            data: { QrCodeId: QrCodeId }, // optional data
            datatype: "JSON",
            success: function (result) {
                showLobiboxNotification(result.messageType, result.message);
                if (result.ok) {
                    Onload($('#hdnPageNo').val());
                }
                else {
                    $('#divmessage').html(result.data);
                    $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                }
            }
        });
    }

    function DeleteQrCode(QrCodeId) {
        var val2 = confirm("Do you want to delete this record?");
        if (val2) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("QrCodeDelete", "QRCode")',  // the URL of the controller action method
                data: { QrCodeId: QrCodeId }, // optional data
                success: function (result) {
                    showLobiboxNotification(result.messageType, result.message);
                    if (result.ok) {
                        Onload($('#hdnPageNo').val());
                    }
                    else {
                        $('#divmessage').html(result.data);
                        $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                    }
                },
            });
        }
    }

    function UpdateOrderNo(i, QrCodeId) {
        var OrderNo = parseInt($('#OrderNo' + i).val());
        $.ajax({
            type: 'POST',
            url: '@Url.Action("QrCodeDisplayOrder", "QrCode")',
            data: { OrderNo: OrderNo, QrCodeId: QrCodeId },
            success: function (result) {
                showLobiboxNotification(result.messageType, result.message);
                if (result.ok) {
                    Onload($('#hdnPageNo').val());
                }
                else {
                    $('#divmessage').html(result.data);
                    $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                }
            }
        });
    }
</script>


<div class="card-body">
    <div class="table-responsive">

        @if (Total == -1)
        {
            <div class="norecords">Sorry failed processing your request.</div>
        }
        else
        {
            <table class="table table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>

                        <th width="8%" class="text-center">S.No</th>

                        <th width="15%" style="text-align:left !important;">
                            <a onclick="javascript:sortresult('QrLevel');" style="color: black;" class="white-t-u aws-h-a">
                                Qr Level @if (sortcolumn == "QrLevel")
                                {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                            </a>
                        </th>
                        @*<th width="15%" style="text-align:left !important;">
                                <a onclick="javascript:sortresult('LabelText');" style="color: black;" class="white-t-u aws-h-a">
                                    Label Text @if (sortcolumn == "LabelText")
                                    {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                                </a>

                            </th>*@
                        <th width="15%" style="text-align:left !important;">
                            <a onclick="javascript:sortresult('FileName');" style="color: black;" class="white-t-u aws-h-a">
                                Qrcode Download @if (sortcolumn == "FileName")
                                {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                            </a>

                        </th>
                        <th width="15%" style="text-align: center !important;">
                            <a onclick="javascript:sortresult('URL');" style="color: black;" class="white-t-u aws-h-a">
                                URL @if (sortcolumn == "URL")
                                {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                            </a>

                        </th>
                        <th width="15%" style="text-align: center !important;">
                            <a onclick="javascript:sortresult('PixelSize');" style="color: black;" class="white-t-u aws-h-a">
                                Pixel Size @if (sortcolumn == "PixelSize")
                                {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                            </a>

                        </th>
                        <th width="15%" style="text-align:left !important;">
                            <a onclick="javascript:sortresult('UpdatedDate');" style="color: black;" class="white-t-u aws-h-a">
                                Posted Date @if (sortcolumn == "UpdatedDate")
                                {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                            </a>


                        </th>

                        @*<th width="15%" class="text-left"> Order No </th>*@

                        <th width="8%" class="text-left">Status</th>

                        <th width="8%">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (lstQrCode.Count != 0)
                    {
                        int i = 0;
                        foreach (var item in lstQrCode)
                        {
                            <tr>
                                <td align="center">@item.RId</td>
                                <td style="text-align: left">@item.qrLevel</td>
                                @*<td style="text-align: left">@item.labelText</td>*@
                                <td style="text-align: center">
                                    <a href="/Admin/QRCode/DownloadQRCode?code=@item.fileName"
                                       download="@item.fileName"
                                       class="cursor-pointer"
                                       aria-label="Download QR Code">
                                        <i class="lni lni-download" style="font-size: 20px; color: black;"></i>
                                    </a>
                                </td>



                                <td style="text-align: center">
                                    <a href="@item.RefUrl" target="_blank">
                                        <i class="fas fa-link icon-style"></i>
                                    </a>
                                </td>
                                <td style="text-align: center">@item.pixelSize</td>

                                <td align="left">@item.UpdatedDate.ToAppDate() </td>

                                <td>
                                    <div class="menu-hover">
                                        @{ var isChecked = item.IsActive ? "checked" : ""; }
                                        @{var titleValue = item.IsActive ? "Active" : "Disabled";}
                                        <div>
                                            <label class="switch" title="@titleValue">
                                                <input type="checkbox" onclick="QrCodeStatus(@item.QrCodeId)" @isChecked>
                                                <span class="slider"></span>
                                            </label>
                                        </div>
                                    </div>
                                </td>

                                <td class="text-center">
                                    <div class="table-actions d-flex align-items-center gap-3 fs-6">

                                        @*@if (ViewBag.IsEdit == true || userRole.Contains("SuperAdmin") || userRole.Contains("DeveloperAdmin"))
                                            {
                                                <a class="text-warning cursor-pointer" onclick="QrCodeEdit(@item.QrCodeId);" title=" Edit" aria-label="Edit"><i class="bi bi-pencil-fill"></i></a>
                                            }*@
                                        @if (ViewBag.IsDelete == true || userRole.Contains("SuperAdmin") || userRole.Contains("DeveloperAdmin"))
                                        {

                                            <a class="text-danger cursor-pointer" onclick="DeleteQrCode(@item.QrCodeId);" title="Delete" aria-label="Delete"><i class="bi bi-trash-fill"></i></a>
                                        }
                                    </div>

                                </td>
                            </tr>
                            i++;
                        }
                    }
                    else
                    {
                        <tr class="odd"><td valign="top" colspan="10" class="font-14 text-center">No  Records found</td></tr>
                    }
                </tbody>
            </table>
        }



    </div>

    <div class="row pt-3">
        <div class="col-sm-4 col-md-5">
            <div class="dataTables_info" id="example_info" role="status" aria-live="polite">
                Showing @((PageNo * Items) - (Items - 1)) - @((PageNo * Items) > Total ? Total : (PageNo * Items)) of @Total entries
            </div>
        </div>
        <div class="col-sm-3 col-md-7 " @(Total > 0 ? "" : "disable")>
            <div class="d-flex flex-wrap gap-4 justify-content-end">
                <div class="dataTables_length" id="example_length">
                    <div class="d-flex align-items-center gap-2 pt-1">
                        <span>Show Items</span>
                        <select id="txtitems" name="txtitems" aria-controls="example" onchange="Onload();" class="form-select form-select-sm w-auto">
                            <option @(Items == 25 ? "selected=selected" : "") value="25">25</option>
                            <option @(Items == 50 ? "selected=selected" : "") value="50">50</option>
                            <option @(Items == 75 ? "selected=selected" : "") value="75">75</option>
                            <option @(Items == 100 ? "selected=selected" : "") value="100">100</option>
                        </select>
                    </div>
                </div>
                <div class="dataTables_paginate paging_simple_numbers" id="example_paginate">
                    @Html.Raw(AWS_AssociationToolCore.BLL.Common.SetPaging((Int64)ViewBag.items, ref Total, (Int64)ViewBag.pageno, "pagination pb-0"))
                </div>
            </div>
        </div>
    </div>



</div>
<script>
    function handleQRResponse(response) {
        const fileName = response.FileName.replace('', '').replace('', '');
        const downloadUrl = `/Admin/QRCode/DownloadQRCode?code=${fileName}`;

        // Inject QR preview and hidden download link
        $('#qrResult').html(`
            <img src="${response.ImagePath}" alt="Generated QR Code" width="300px" /><br>
            <strong>File Name:</strong> ${response.FileName}<br>
            <a href="${downloadUrl}" download="${response.FileName}" id="autoDownloadLink" style="display:none;"></a>
        `);

        // Auto-trigger the download
        setTimeout(() => {
            document.getElementById('autoDownloadLink').click();
        }, 500);
    }
</script>

<style>
    .links_set {
        border: 1px solid #ddd;
        padding: 7px;
        margin-bottom: 20px;
    }

        .links_set p {
            text-align: end;
        }

    .svsn_addphoto_set {
        display: grid;
        grid-template-columns: repeat( auto-fit, minmax(200px, 1fr) );
        gap: 20px;
    }

        .svsn_addphoto_set .svsn {
            display: flex;
            justify-content: flex-start;
            gap: 10px;
            align-items: center;
        }

    .icon-style {
        font-size: 24px; /* size similar to your image */
        color: #6c757d; /* grey tone */
        padding: 8px;
        border-radius: 8px;
        background-color: #f8f9fa; /* light background */
    }
</style>

<style>

    .aws-h-a {
        text-decoration: none;
        position: relative;
    }

        .aws-h-a::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            bottom: -2px;
            border-bottom: 2px solid #0756ca;
            transform: scaleX(0);
            transition: transform 0.3s ease;
        }

        .aws-h-a:hover::after {
            transform: scaleX(1);
        }
</style>

<script>
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl)
    })
</script>
