                <h5 class="modal-title" id="qrImageModalLabel">QR Code Preview</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <img id="qrCodeImage" src="" alt="QR Code" class="img-fluid" style="max-height: 300px;" />
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $("#FormHallTypes").validate({
            rules: {
                qrLevel: "required",
                labelText: "required",
                pixelSize: "required",
                RefUrl: "required",
            },
            messages: {
                qrLevel: "required",
                labelText: "required",
                pixelSize: "required",
                RefUrl: "required",
            },
            errorElement: "em",
            errorPlacement: function (error, element) {
                // Add the `help-block` class to the error element
                error.addClass("invalid-feedback");
                if (element.prop("type") === "checkbox") {
                    error.insertAfter(element.parent("label"));
                } else {
                    error.insertAfter(element);
                }
                // Move the error element after the fieldset element
                if (element.closest("fieldset").length) {
                    element.closest("fieldset").after(error);
                }
            },
            highlight: function (element, errorClass, validClass) {
                $(element).parents("fieldset").addClass("has-error").removeClass("has-success");
            },
            unhighlight: function (element, errorClass, validClass) {
                $(element).parents("fieldset").addClass("has-success").removeClass("has-error");
            },
        });
    });

    // Function to clear form validation errors and reset the form
    function clearFormErrorsAndReset() {
        // Clear any validation error messages
        $('em.error').remove(); // Assuming error messages have a class of 'error-message'

        // Reset the form
        $('form')[0].reset();
    }

    // Event handler for closing the modal dialog
    $('.modal-close-button, .close').on('click', function () {
        // Clear form errors and reset upon closing the modal
        clearFormErrorsAndReset();
    });

    // Event handler for when the modal is closed by clicking outside of it
    $('.modal').on('click', function (event) {
        // Check if the click event occurred outside the modal dialog
        if ($(event.target).hasClass('modal')) {
            // Clear form errors and reset upon closing the modal
            clearFormErrorsAndReset();
        }
    });

    // Additional event handler for any other action that might close the modal
    // For example, pressing escape key
    $(document).on('keydown', function (event) {
        // Check if the escape key was pressed and the modal is open
        if (event.key === "Escape" && $('.modal').is(':visible')) {
            // Clear form errors and reset upon closing the modal
            clearFormErrorsAndReset();
        }
    });

</script>

<div class="card-header py-3 mb-3" id="qrSection">
    <div class="row  gx-2">

        <form id="qrForm">
            <div class="modal-body" style="margin-left:30px; margin-right:30px;">
                <h3 style="font-size:18px; margin-bottom:10px;">Generate QR Code</h3>
                <div class="row">

                    <div class="col-lg-2">
                        <div class="input-box">
                            <label class="form-label">QR Level <span class="text-danger">*</span></label>
                            <select class="form-control" name="qrLevel">
                                <option value="L">L (Low)</option>
                                <option value="M">M (Medium)</option>
                                <option value="Q">Q (Quartile)</option>
                                <option value="H" selected>H (High)</option>
                            </select><br><br>
                        </div>
                    </div>


                    <div class="col-lg-3">
                        <div class="input-box">
                            <label class="form-label">Label Text <span class="text-danger">*</span></label>

                            <input type="text" name="labelText" class="form-control" value="" placeholder="Enter label text here" />
                        </div>
                    </div>
                    <div class="col-lg-2">
                        <div class="input-box">
                            <label class="form-label">Pixel Size <span class="text-danger">*</span></label>
                            <input type="number" name="pixelSize" class="form-control" value="25">
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <div class="input-box">
                            <label class="form-label">URL <span class="text-danger">*</span></label>
                            <input type="text" name="RefUrl" class="form-control" placeholder="Enter the url to generate QR code" value="">
                        </div>
                    </div>
                    <div class="clearfix" style="margin-left:auto; margin-right:auto; text-align:center;">
                        <button class="btn btn-danger px-3" style="width: 150px;" type="submit">Generate</button>
                    </div>
                </div>
            </div>
        </form>

        <br>
        <div class="modal-body" style="margin-left:30px; margin-right:30px;">
            <h3 style="font-size:18px; margin-bottom:10px;">QR Code Preview</h3>
            <div class="row">
                <div class="" style="text-align:center; margin-left:auto; margin-right:auto;">
                    <div id="qrResult"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $('#qrForm').on('submit', function (e) {
        e.preventDefault();

        // ✅ Collect form data
        const data = {
            qrLevel   : $('select[name="qrLevel"]').val(),
            labelText : $('input[name="labelText"]').val(),
            pixelSize : parseInt($('input[name="pixelSize"]').val()),
            RefUrl    : $('input[name="RefUrl"]').val()
        };

        // ✅ Show loading state
        $('#qrResult').html('<p class="text-muted">Generating QR Code, please wait...</p>');

        $.ajax({
            type        : 'POST',
            url         : '@Url.Action("GenerateDynamicQR", "QRCode")',
            contentType : 'application/json',
            data        : JSON.stringify(data),
            success: function (response) {
                if (response.ok) {
                    $('#qrResult').html(`
                        <div class="d-flex flex-column align-items-center gap-3 mt-3">

                            <img src="${response.ImagePath}"
                                 alt="Generated QR Code"
                                 style="width:300px; border:1px solid #ddd; border-radius:8px; padding:10px;" />

                            <div class="d-flex align-items-center gap-3">
                                <strong>File:</strong>
                                <span>${response.FileName}</span>

                                <a href="@Url.Action("DownloadQRCode", "QRCode")?code=${response.FileName}"
                                   download="${response.FileName}"
                                   class="cursor-pointer"
                                   title="Download QR Code"
                                   aria-label="Download QR Code"
                                   style="border:1px solid #e8e6e7;
                                          padding:8px 12px;
                                          border-radius:50%;
                                          background-color:#e8e6e7;
                                          text-decoration:none;">
                                    <i class="lni lni-download" style="font-size:20px; color:black;"></i>
                                </a>
                            </div>

                        </div>
                    `);

                    // ✅ Reload list after generation
                    if (typeof Onload === 'function') {
                        Onload(1);
                    }

                } else {
                    // ✅ Show server error message
                    $('#qrResult').html(`
                        <div class="alert alert-danger mt-3">
                            <i class="bi bi-exclamation-circle"></i>
                            Error: ${response.message}
                        </div>
                    `);
                }
            },
            error: function (xhr, status, error) {
                // ✅ Show AJAX error with details
                $('#qrResult').html(`
                    <div class="alert alert-danger mt-3">
                        <i class="bi bi-exclamation-circle"></i>
                        Failed to generate QR Code. Please try again.<br>
                        <small>${error}</small>
                    </div>
                `);
            }
        });
    });
</script>
