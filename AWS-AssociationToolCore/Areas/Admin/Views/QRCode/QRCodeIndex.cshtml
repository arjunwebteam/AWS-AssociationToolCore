
@using System.Configuration;
@{

    ViewBag.Pageheading = "Qr Code";
    Layout = "~/Areas/Admin/Views/Shared/_MainLayout.cshtml";
    List<AWS_AssociationToolCore.Entities.Chapters> lstChapters = ViewBag.lstChapters;


    int status = 0;
    AWS_AssociationToolCore.BLL.AppInfo _AppInfo = new AWS_AssociationToolCore.BLL.AppInfo();
    AWS_AssociationToolCore.Entities.AppInfo objAppInfo = new AWS_AssociationToolCore.Entities.AppInfo();
    objAppInfo = _AppInfo.GetAppInfoDetails(ref status);
    ViewBag.Title = "QRCode | " + objAppInfo.SiteName;
    string userRole = Context.Session.GetString("userrole") ?? string.Empty;

    bool IsEdit = ViewBag.IsEdit;
    bool IsView = ViewBag.IsView;
    bool IsDelete = ViewBag.IsDelete;
    bool IsExport = ViewBag.IsExport;
    bool IsAdd = ViewBag.IsAdd;
    Int64 Mid = ViewBag.mid;

}
<script>
    function showQRSection() {
        const qrSection = document.getElementById("qrSection");
        if (qrSection) {
            qrSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    }
</script>

<script>
    $(document).ready(function () {
        loadMenuItems();
    });

    function loadMenuItems() {
        $.ajax({
            type: "GET",
            url: '@Url.Action("QrCodeList", "QRCode")',
            data: {

                Mid       : '@ViewBag.mid'
            },
            success: function (data) {
                $("#divService").html(data);
            },
            error: function () {
                $("#divService").html('<p class="text-danger">Failed to load.</p>');
            }
        });
    }
</script>

<script type="text/javascript">

    $(document).ready(function () {

        $('#wQrCode, #wwQrCodeIndex').addClass('active');

        $('#AddSlots').dialog
           ({
               autoOpen: false,
               width: 500,
               modal: true
           });

        $('#ViewInnerPageCategory').dialog
          ({
              autoOpen: false,
              width: 450,
              modal: true
          });
        PagerClickBind();
    });

    function Onload(Pageno) {
        var pageno = Common.Pageno(Pageno);
        var sortcolumn = $('#hdnsortcolumn').val();
        var sortorder = $('#hdnsortorder').val();
        var items = $('#txtitems').val();
        var Search = $('#txtsearch').val();

        $.ajax({
            url: '@Url.Action("QrCodeList", "QrCode")',
            type: 'GET',
            cache: false,
            data: { Search: Search, PageNo: pageno, SortColumn: sortcolumn, SortOrder: sortorder, Items: items , Mid: '@Mid'},
            success: function (result) {
                $('#divService').html(result);
                PagerClickBind();
            }
        });
    }

    function sortresult(sortcolumn) {
        $('#hdnsortorder').val(($('#hdnsortorder').val() == 'ASC' ? 'DESC' : 'ASC'));
        $('#hdnsortcolumn').val(sortcolumn);
        Onload(1);
    }
    function SearchClear() {
        $('#txtsearch').val('');
        $('#QrLevel').val('');
        Onload(1);
    }

    function ClearSearch() {
        $('#txtsearch').val('');
        $('#QrLevel').val('');
        $('#hdnPageNo').val(1);
        Onload(1);
    }

    function PagerClickBind() {
        $(".pagination a").bind("click", function () {
            Onload($(this).text());
        });
    }

    function QrCodeEdit(QrCodeId) {
    $.ajax({
        url: '@Url.Action("ViewQrCode", "QRCode")', // adjust controller/action as needed
        type: 'POST',
        data: { QrCodeId: QrCodeId },
        datatype: "JSON",
        success: function (result) {
            if (result.ok) {
                var objqrcode = result.data;

                // Set image src
                var imageUrl = '@System.Configuration.ConfigurationManager.AppSettings["baseurl"]' + 'Admin/QRCode/DownloadQRCode/' + data.QrCodeId;
                $('#qrCodeImage').attr('src', imageUrl);

                // Set other details if needed
                $('#qrCodeName').text(objqrcode.Name);
                $('#qrCodeDescription').text(objqrcode.Description);

                // Show modal
                $('#QrImageModal').modal('show');
            }
        },
        error: function () {
            alert("Something went wrong while loading the QR Code.");
        }
    });
}

    function Add() {
       clearInnerPageCategory();
        $("#AddQrCode").modal('show');
        $('#lbltitle').html('Add QrCode');
    }

    function clearInnerPageCategory() {
        $('#QrCodeId').val('0');
        $('#QrLevel').val('');
        $('#LabelText').val('');


    }
</script>
<style>
    .svsn_align .field-validation-error {
        top: 27px;
        left: 190px;
        position: absolute;
