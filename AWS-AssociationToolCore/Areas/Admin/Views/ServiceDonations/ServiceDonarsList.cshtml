@using AWS_AssociationToolCore.BLL
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    Layout = null;

    string sortcolumn = ViewBag.sortcolumn as string;
    string sortorder = ViewBag.sortorder as string;

    long Total = ViewBag.total ?? 0;
    long PageNo = ViewBag.pageno ?? 0;
    long Items = ViewBag.items ?? 0;

    var lstServiceDonors = ViewBag.lstServiceDonors as List<AWS_AssociationToolCore.Entities.ServiceDonations>;

    // ✅ Replace FormsAuthentication with Claims
    string userRole = "";

    if (User?.Identity?.IsAuthenticated == true)
    {
        userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    }
}
<script type="text/javascript">

    function ServiceDonationsStatus(ServiceDonationId) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("ServiceDonationsStatus", "ServiceDonations")', // the URL of the controller action method
            data: { ServiceDonationId: ServiceDonationId }, // optional data
            datatype: "JSON",
            success: function (result) {
                showLobiboxNotification(result.messageType, result.message);
                if (result.ok) {
                    ServiceDonationBind($('#hdnPageNo').val());
                }
                else {
                    $('#divmessage').html(result.data);
                    $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                }
            }
        });
    }


</script>
<style>
    .aws-h-a {
        text-decoration: none;
        position: relative;
    }

        .aws-h-a::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            bottom: -2px;
            border-bottom: 2px solid #0756ca;
            transform: scaleX(0);
            transition: transform 0.3s ease;
        }

        .aws-h-a:hover::after {
            transform: scaleX(1);
        }
</style>

<div class="card-body">
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th width="5%" style="text-align: center">S.No.</th>

                    <th style="text-align: left;">
                        <a onclick="javascript:sortresult('FirstName');" class="aws-h-a" style="color:black">
                            First Name @if (sortcolumn == "FirstName")
                            {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                        </a>
                    </th>
                    <th style="text-align: left;">
                        <a onclick="javascript:sortresult('LastName');" class="aws-h-a" style="color:black">
                            Last Name @if (sortcolumn == "LastName")
                            {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                        </a>
                    </th>

                    <th style="text-align: center" >Email</th>
                    <th style="text-align: center" >Phone No</th>
                    <th style="text-align: center">Last Order Date</th>
                  
                    <th width="8%" style="text-align:center;">
                        #
                    </th>
                    <th width="6%" style="text-align: center">Action</th>
                </tr>
            </thead>

            <tbody>
                @if (lstServiceDonors.Count != 0)
                {
                    int i = 0;
                    var location = HttpContextAccessor.HttpContext?.Session.GetString("UserSiteUrl") ?? "";
                    foreach (var item in lstServiceDonors)
                    {
                <tr>
                    <td style="text-align: center">@item.RId</td>


                    <td style="text-align: left" class="t-t-c">@item.FirstName</td>
                    <td style="text-align: left" class="t-t-c">@item.LastName</td>
                    <td style="text-align: center" class="t-t-c">@item.Email</td>
                    <td style="text-align: center" class="t-t-c">@item.PhoneNo</td>
                    <td style="text-align: center" class="t-t-c">@item.LastOrderDate.ToAppDate()</td>

                    <td style="text-align:center">
                        <a href="@Url.Action("Index", "ServiceDonations", new { ServiceDonationId = item.ServiceDonationId, Search = item.Email})"> Donations (@item.ContributionsCount) </a>

                    </td>

                    <td style="text-align: center" class="t-t-c">
                        <div class="table-actions  gap-3 fs-6">
                           
                                <a class="text-primary cursor-pointer" title="Send mail to Donor" onclick="SendMailtoDonor(@item.ServiceDonationId, Email = '@item.Email', UserName = '@(item.FirstName) @(item.LastName)');"><i class="bi bi-envelope-fill"></i></a>
                            
                           
                            </div>
                    </td>

                    
                </tr>
                        i++;
                    }
                }
                else
                {
                    <tr class="odd"><td valign="top" colspan="10" class="font-14 text-center">No  Records found</td></tr>
                }
            </tbody>
        </table>
    </div>



    <div class="row pt-3">
        <div class="col-sm-4 col-md-5">
            <div class="dataTables_info" id="example_info" role="status" aria-live="polite">
                Showing @((PageNo * Items) - (Items - 1)) - @((PageNo * Items) > Total ? Total : (PageNo * Items)) of @Total entries
            </div>
        </div>
        <div class="col-sm-3 col-md-7 " @(Total > 0 ? "" : "disable")>
            <div class="d-flex flex-wrap gap-4 justify-content-end">

                <div class="dataTables_paginate paging_simple_numbers" id="example_paginate">
                    @Html.Raw(AWS_AssociationToolCore.BLL.Common.SetPaging((Int64)ViewBag.items, ref Total, (Int64)ViewBag.pageno, "pagination pb-0"))
                </div>
            </div>
        </div>
    </div>
</div>
