<script>
    // ✅ Remove ALL old jQuery validate code and replace with this simple function
    function ModalBulkValidate() {
        var fileInput = document.getElementById('DocumentFile');
        var spanDoc   = document.getElementById('spanDocumentFile');

        if (!fileInput || fileInput.files.length === 0) {
            spanDoc.innerHTML = 'Please select a file.';
            return false;
        }

        var fileName = fileInput.files[0].name;
        var ext = fileName.split('.').pop().toLowerCase();

        if (ext !== 'xls' && ext !== 'xlsx') {
            spanDoc.innerHTML = 'Invalid file type. Only XLS and XLSX files are allowed.';
            return false;
        }

        spanDoc.innerHTML = '';
        return true;
    }
</script>
