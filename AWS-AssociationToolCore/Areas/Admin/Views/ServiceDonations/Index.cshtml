    <script>
        function BulkValidate() {
            var fileName = $('#Document').val();

            if (!fileName) {
                $('#spanDocument').html('Please select a file.');
                return false;
            }

            var ext = fileName.split('.').pop().toLowerCase();
            if (ext !== 'xls' && ext !== 'xlsx') {
                $('#spanDocument').html('Invalid file type. Only XLS and XLSX files are allowed.');
                return false;
            }

            $('#spanDocument').html('');
            return true;
        }
    </script>

