<div class="content">

    <div class="clearfix sepH_b"></div>
    @using (Html.BeginForm("AddServiceDonation", "ServiceDonations", FormMethod.Post, new { enctype = "multipart/form-data", @id = "ServiceDonation", @name = "ServiceDonation", @novalidate = "novalidate" }))
    {

        <input type="hidden" value="" id="MemberId" name="MemberId" />
        <input type="hidden" name="ServiceDonationId" id="ServiceDonationId" value="" />
        <input type="hidden" name="OrderDate" id="OrderDate" value="@DateTime.UtcNow" />
        <input type="hidden" id="mid" name="mid" value="@ViewBag.mid" />


        if (objAppInfo.chapterStatus == "No")
        {

            <input type="hidden" id="ChapterId" name="ChapterId" value="1" />
        }
        else
        {
            
            <input type="hidden" id="ChapterId" name="ChapterId" value="@ChapterId" />

        }


        <div class="card">
            <div class="card-body">
                <input class="form-control" type="hidden" id="PageDetailId" name="PageDetailId" value="" />
                <div class="row  g-3">
                    <div class="box-header">
                        <h3 class="box-title dis-in">Personal Details </h3>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="input-box">
                            <label class="form-label">First Name :  <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="FirstName" id="FirstName" value="" onkeypress="return Common.isChar(event)">
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="input-box">
                            <label class="form-label">Last Name :  <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="LastName" id="LastName" value="" onkeypress="return Common.isChar(event)">
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="input-box">
                            <label class="form-label">Email :  <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="Email" id="Email" value="">
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="input-box">
                            <label class="form-label">Mobile Number : <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="PhoneNo" id="PhoneNo" maxlength="12" onkeypress="PhoneNochange(event); return Common.isNumberKey(event);">
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="input-box">
                            <label class="form-label">Country : </label>
                            <select class="form-control" id="Country" name="Country">
                                <option value="">Select </option>
                                <option value="USA">USA </option>
                                <option value="India">India</option>
                                <option value="Canada">Canada</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="input-box">
                            <label class="form-label">Address : </label>
                            <input type="text" class="form-control" name="Address" id="Address" value="">
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="input-box">
                            <label class="form-label">Zip Code : </label>
                            <input type="text" class="form-control" name="ZipCode" id="ZipCode" value="" onkeypress="return Common.isNumberKey(event)" maxlength="6">
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <div class="input-box">
                            <label class="form-label">Donation Cause : <span class="text-danger">*</span></label>
                            <select class="form-control" name="ServiceId" id="ServiceId">
                                @if (lstServices != null)
                                {
                                    <option value="">Select</option>
                                    foreach (var item in lstServices)
                                    {
                                        <option @(item.ServiceId == ServiceId ? "selected=selected" : "") value="@item.ServiceId">@item.ServiceTitle</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        @if (objAppInfo.CustomFieldStatus == "Yes")
        {
            var cfForm = new AWS_AssociationToolCore.BLL.CustomFields()
            .GetDynamicForm(AWS_AssociationToolCore.Entities.CustomFieldFormCodes.Donation, 0L);

            if (cfForm.Fields != null && cfForm.Fields.Count > 0)
            {
                <div class="box validation">
                    <div class="card">
                        <div class="card-body">
                            <div class="row g-3 dynamic-fields-row">
                                @* --- Custom Fields (Admin-configured, dynamic) --- *@

                                @await Component.InvokeAsync("DynamicCustomFields", new { formCode = AWS_AssociationToolCore.Entities.CustomFieldFormCodes.Donation, recordId = 0L, theme = "admin" })

                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    
        <div class="card">
            <div class="card-body">
                <div class="row  g-3">
                    <div class="box-header">
                        <h3 class="box-title dis-in">Payment Details </h3>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="input-box">
                            <label class="form-label">Amount ($) : </label>
                            <input type="text" maxlength="6" class="form-control" name="Amount" id="Amount" onkeypress="return Common.isNumberKey(event)" value="">
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <div class="input-box">
                            <label class="form-label">Payment Method : </label>
                            <select class="form-control" name="PaymentMethodId" id="PaymentMethodId" onchange="PaymentMethodBind();">
                                @if (lstPaymentMethod != null)
                                {
                                    <option value="">Select</option>
                                    foreach (var item in lstPaymentMethod)
                                    {
                                        <option value="@item.PaymentMethodId">@item.PaymentMethod</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6" id="ChequeHolderNamehide">
                        <div class="input-box">
                            <label class="form-label">Handed the cash/cheque to - Name of the :</label>
                            <input type="text" class="form-control" id="ChequeHolderName" name="ChequeHolderName">
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6" id="ZellePartnerNamehide">
                        <div class="input-box">
                            <label class="form-label">Zelle Person Name </label>
                            <input type="text" class="form-control" id="ZellePartnerName" name="ZellePartnerName">
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="input-box">
                            <label class="form-label">TransactionId : </label>
                            <input type="text" class="form-control" name="TransactionId" id="TransactionId" value="">
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="input-box">
                            <label class="form-label">Payment Status : </label>
                            <select class="form-control" name="PaymentStatusId" id="PaymentStatusId">
                                @if (lstPaymentStatus != null)
                                {
                                    <option value="">Select</option>
                                    foreach (var item in lstPaymentStatus)
                                    {
                                        <option value="@item.PaymentStatusId">@item.PaymentStatus1</option>

                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <div class="input-box">
                            <label> Is Ananymous : </label>
                            <select class="form-control" name="Field3" id="Field3">
                                <option value="">Select</option>
                                <option value="Yes">Yes</option>
                                <option value="No">No</option>
                            </select>
                        </div>
                    </div>





                    <div class="row">
                        <div class="col-lg-3 col-3 text-end ms-auto">
                            <button type="submit" class="btn btn-success px-3 " onclick="return Validate();" value="submit">@*<i class="bi bi-plus-circle m-0"></i>*@ Submit</button>
                            <a class="btn btn-primary px-3" href="@Url.Action("Index", "ServiceDonations", new { mid = ViewBag.mid })">Cancel</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    }
</div>
<style>
    .dynamic-fields-row input[type=file] {
        display: block !important;
        visibility: visible !important;
        opacity: 1 !important;
        position: static !important;
        width: 100% !important;
        height: auto !important;
    }
</style>


