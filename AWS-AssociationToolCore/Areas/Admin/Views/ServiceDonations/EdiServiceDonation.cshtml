<script>
       $(document).ready(function () {
        $('.dynamic-fields-row .dcf-existing-file-item').each(function () {
            var $item = $(this);
            if ($item.find('.dcf-download-btn').length) return; // already added

            var $img = $item.find('img').first();
            if (!$img.length) return;

            var src = $img.attr('src');
            // remove GUID_ prefix from file name for download
            var fileName = decodeURIComponent(src.split('/').pop())
                .replace(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}_/i, '');

            var $btn = $('<a class="dcf-download-btn" title="Download"><i class="fa fa-download"></i></a>')
                .attr('href', src)
                .attr('download', fileName);

            $item.append($btn);
        });
    });
         var appDateFormat = '@AWS_AssociationToolCore.BLL.AppDate.JqFormat'; // DATE

    $(document).ready(function () {
        $('.dynamic-fields-row .dcf-existing-file-item').each(function () {
            var $item = $(this);
            if ($item.find('.dcf-download-btn').length) return; // already added

            var $img = $item.find('img').first();
            if (!$img.length) return;

            var src = $img.attr('src');
            // remove GUID_ prefix from file name for download
            var fileName = decodeURIComponent(src.split('/').pop())
                .replace(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}_/i, '');

            var $btn = $('<a class="dcf-download-btn" title="Download"><i class="fa fa-download"></i></a>')
                .attr('href', src)
                .attr('download', fileName);

            $item.append($btn);
        });
    });
    $(document).ready(function () {
        PaymentMethodBind();
        $('#wDonate-Sponsors, #wServiceDonors').addClass('active');
        $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
        $('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
        $("#OrderDate").datepicker({ changeMonth: true, changeYear: true, yearRange: "-10:+10", altFormat: appDateFormat });

    });

    function Validate() {

        if ($.trim($('#DonationCause').val()) == '') { document.getElementsByName('DonationCause')[0].placeholder = 'Required'; $('#DonationCause').focus().addClass("validate"); return false; } else { $('#DonationCause').focus().removeClass("validate"); }
        if ($.trim($('#Amount').val()) == '') { document.getElementsByName('Amount')[0].placeholder = 'Required'; $('#Amount').focus().addClass("validate"); return false; } else { $('#Amount').focus().removeClass("validate"); }
        if ($.trim($('#TransactionId').val()) == '') { document.getElementsByName('TransactionId')[0].placeholder = 'Required'; $('#TransactionId').focus().addClass("validate"); return false; } else { $('#TransactionId').focus().removeClass("validate"); }
        if ($.trim($('#PaymentMethodId').val()) == '') { document.getElementsByName('PaymentMethodId')[0].placeholder = 'Required'; $('#PaymentMethodId').focus().addClass("validate"); return false; } else { $('#PaymentMethodId').focus().removeClass("validate"); }
        if ($.trim($('#PaymentStatusId').val()) == '') { document.getElementsByName('PaymentStatusId')[0].placeholder = 'Required'; $('#PaymentStatusId').focus().addClass("validate"); return false; } else { $('#PaymentStatusId').focus().removeClass("validate"); }

        return true;
    }
    function ResetValidateClass() {
        $('#DonationCause').removeClass("validate");
        $('#Amount').removeClass("validate");
        $('#TransactionId').removeClass("validate");
        $('#PaymentMethodId').removeClass("validate");
        $('#PaymentStatusId').removeClass("validate");
    }

    function formatPhoneNumber(number) {
        // Remove any non-numeric characters
        const cleanedNumber = number.replace(/\D/g, "");

        // Ensure the number has 10 digits
        if (cleanedNumber.length < 10) {
            return "Entered less than 10 digits.";
        }
        if (cleanedNumber.length > 10) {
            return "Entered more than 10 digits.";
        }

        // Format the number using string slicing
        const areaCode = cleanedNumber.slice(0, 3);
        const firstThree = cleanedNumber.slice(3, 6);
        const lastFour = cleanedNumber.slice(6);

        return `${areaCode}-${firstThree}-${lastFour}`;
    }

    // Example usage
    const phoneNumber = document.getElementById("phoneNumber"); // Assuming you have an element with this ID
    phoneNumber.addEventListener("input", function () {
        const formattedNumber = formatPhoneNumber(this.value);
        this.value = formattedNumber; // Update the input value with the formatted number
    });


    function handlePaste(event) {
        // Check if the target is the input element
        if (event.target.id === "PhoneNo") {
            const pastedNumber = (event.clipboardData || window.clipboardData).getData('text');
            const formattedNumber = formatPhoneNumber(pastedNumber);
            event.target.value = formattedNumber;
            // Replace input value with formatted number
            event.preventDefault();
            // Prevent default pasting behavior
        }
    }
    function handlePastes(event) {
        // Check if the target is the input element
        if (event.target.id === "SpouseCell") {
            const pastedNumber = (event.clipboardData || window.clipboardData).getData('text');
            const formattedNumber = formatPhoneNumber(pastedNumber);
            event.target.value = formattedNumber;
            // Replace input value with formatted number
            event.preventDefault();
            // Prevent default pasting behavior
        }
    }
    
    function PhoneNochange(event) {
        if (event.keyCode == 8 || event.keyCode == 46) {
        }
        else {
            var ph = $('#PhoneNo').val();
            if (ph.length == 3) { $('#PhoneNo').val(ph + '-'); }
            if (ph.length == 7) { $('#PhoneNo').val(ph + '-'); }
        }
    }




    function PaymentMethodBind() {

        var PaymentMethod = document.getElementById("PaymentMethodId").value;

        //var PaymentMethod = $('#PaymentMethodId').val();
        if (PaymentMethod == 3) {

            $('#ChequeHolderNamehide').show()
            $('#ZellePartnerNamehide').hide()
        }
        else if (PaymentMethod == 6) {
            $('#ChequeHolderNamehide').hide()
            $('#ZellePartnerNamehide').show()
        }
        else {
            $('#ChequeHolderNamehide').hide()
            $('#ZellePartnerNamehide').hide()
        }
    }
</script>
