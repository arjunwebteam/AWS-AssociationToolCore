<style>
    .dynamic-fields-row .dcf-existing-file-item .dcf-file-name {
        word-break: break-all;
        font-size: 13px;
    }

    .dynamic-fields-row .dcf-view-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        margin-top: 6px;
        padding: 4px 12px;
        font-size: 13px;
        border-radius: 4px;
        background: #0d6efd;
        color: #fff !important;
        text-decoration: none;
    }

        .dynamic-fields-row .dcf-view-btn:hover {
            background: #0a58ca;
        }
</style>

<script>
    $(document).ready(function () {
        $('.dynamic-fields-row .dcf-existing-file-item').each(function () {
            var $item = $(this);

            if ($item.find('img').length) return;            // images ki separate download icon undi
            if ($item.find('.dcf-view-btn').length) return;  // already added

            var $link = $item.find('a').first();
            if (!$link.length) return;

            var href = $link.attr('href');
            var fileName = decodeURIComponent(href.split('?')[0].split('/').pop())
                .replace(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}_/i, '');

            // file name clean cheyyi (GUID teesey) + new tab lo open
            $link.text(fileName)
                 .addClass('dcf-file-name')
                 .attr({ target: '_blank', rel: 'noopener noreferrer' });

            // View Document button
            var $view = $('<a class="dcf-view-btn" title="View Document"><i class="fa fa-eye"></i> View Document</a>')
                .attr({ href: href, target: '_blank', rel: 'noopener noreferrer' });

            $item.append('<br/>').append($view);
        });
    });
</script>