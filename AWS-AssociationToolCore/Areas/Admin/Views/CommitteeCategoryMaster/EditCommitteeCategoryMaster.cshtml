<script type="text/javascript" src="ckeditor/ckeditor.js"></script>
<script type="text/javascript" src="ckfinder/ckfinder.js"></script>


<div class="content">
    @using (Html.BeginForm("EditCommitteeCategoryMaster", "CommitteeCategoryMaster", FormMethod.Post, new { enctype = "multipart/form-data", @id = "FormCommitteeCategoryMaster", @name = "FormCommitteeCategoryMaster" }))
    {
        @*@Html.Hidden("CommitteeCategoryId", (Int64)@objCommitteeCategoryMaster.CommitteeCategoryId)
            <input id="PageParentId" name="PageParentId" value="@objCommitteeCategoryMaster.PageParentId" type="hidden" />*@

        if (objAppInfo.chapterStatus == "No")
        {
            <input type="hidden" value="1" name="ChapterIds" id="ChapterIds" />
        }
        else
        {
            <input type="hidden" value="" name="ChapterIds" id="ChapterIds" />

        }
        <input type="hidden" value="@ViewBag.ChapterId" name="ChapterId" id="ChapterId" />
        <input type="hidden" value="@ViewBag.CommitteeCategoryId" name="CommitteeCategoryId" id="CommitteeCategoryId" />


        <input id="mid" name="mid" value="@ViewBag.mid" type="hidden" />

        <div class="box validation">
            <div class="card">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-lg-4 col-md-6">
                            <div class="input-box">
                                <label class="form-label">Add Committee Category <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="CategoryName" id="CategoryName" value="@objCommitteeCategoryMaster.CategoryName">
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <div class="input-box">
                                <label class="form-label">YearId <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="YearId" id="YearId" value="@objCommitteeCategoryMaster.YearId">
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <div class="input-box">
                                <label class="form-label">Display Order </label>
                                <input type="text" class="form-control" name="Position" id="Position" onkeypress="return Common.isNumberKey(event)" value="@objCommitteeCategoryMaster.Position">
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <div class="input-box">
                                <label class="form-label">Parent Menu Item <span class="text-danger"></span></label>
                                <select class="single-select" id="PageParentId" name="PageParentId">
                                    <option value="0" selected="@(objCommitteeCategoryMaster.PageParentId == 0 ? "selected" : null)">---- Root Level ----</option>
                                    @if (lstCommitteeCategoryMaster != null && lstCommitteeCategoryMaster.Count != 0)
                                    {
                                        foreach (var item in lstCommitteeCategoryMaster)
                                        {
                                            <option value="@(item.CommitteeCategoryId)" selected="@(objCommitteeCategoryMaster.PageParentId == item.CommitteeCategoryId ? "selected" : null)">@item.CategoryName</option>

                                            if (lstCommitteeCategoryMaster2 != null && lstCommitteeCategoryMaster2.Count != 0)
                                            {
                                                foreach (var item2 in lstCommitteeCategoryMaster2)
                                                {
                                                    if (item2.PageParentId == item.CommitteeCategoryId)
                                                    {
                                                        <option value="@(item2.CommitteeCategoryId)" selected="@(objCommitteeCategoryMaster.PageParentId == item2.CommitteeCategoryId ? "selected" : null)">| @item2.CategoryName</option>

                                                        if (lstCommitteeCategoryMaster3 != null && lstCommitteeCategoryMaster3.Count != 0)
                                                        {
                                                            foreach (var item3 in lstCommitteeCategoryMaster3)
                                                            {
                                                                if (item3.PageParentId == item2.CommitteeCategoryId)
                                                                {
                                                                    <option value="@item3.CommitteeCategoryId" selected="@(objCommitteeCategoryMaster.PageParentId == item3.CommitteeCategoryId ? "selected" : null)">| | @item3.CategoryName</option>
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                </div>
            </div>


            @if (objAppInfo.chapterStatus == "Yes")
            {

                <div class="card">
                    <div class="card-body">

                        <div class="box validation">
                            <!-- /.box-header -->
                            <div class="box-header">
                                <h3 class="box-title dis-in">Chapters </h3>
                            </div>
                            <div class="box-body">
                                <div class="row">

                                    @if (lstChapters != null && lstChapters.Count != 0)
                                    {
                                        int i = 1;

                                        foreach (var item in lstChapters)
                                        {
                                            int x = 0;
                                            if (objCommitteeCategoryMaster.lstChapterCommittees != null && objCommitteeCategoryMaster.lstChapterCommittees.Count != 0)
                                            {
                                                foreach (var nitem in objCommitteeCategoryMaster.lstChapterCommittees)
                                                {
                                                    if (item.ChapterId == nitem.ChapterId)
                                                    {
                                                        x = 1;
                                                    }
                                                }
                                            }
                                            if (item.ChapterName != "NATS Global")
                                            {
                                                <div class="col-md-3 col-xs-6 col-xxl-2">
                                                    <span class="radiostyle part-4 mb-2 d-block">
                                                        <input type="checkbox" @(x == 1 ? "checked=checked" : "") name="ChapterNamecheckbox" id="ChapterNamecheckbox-@i" class="flat-red" value="@item.ChapterId"> @item.ChapterName
                                                    </span>
                                                </div>
                                            }
                                            i++;
                                        }

                                    }

                                </div>
                            </div>
                        </div>

                    </div>
                </div>



            }








        </div>









        if (objAppInfo.chapterStatus == "Yes")
        {
            <div class="row">
                <div class="col-lg-2 col-3 text-end ms-auto">
                    <button type="submit" onclick="return ChapterNameBind();" class="btn btn-success px-3 " value="submit">Submit</button>
                    <a class="btn btn-primary px-3" href="@Url.Action("Index", "CommitteeCategoryMaster", new { mid = ViewBag.mid })">Cancel</a>
                </div>
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-lg-2 col-3 text-end ms-auto">
                    <button type="submit" class="btn btn-success px-3 " value="submit">Submit</button>
                    <a class="btn btn-primary px-3" href="@Url.Action("Index", "CommitteeCategoryMaster", new { mid = ViewBag.mid })">Cancel</a>
                </div>
            </div>

        }





    }
    <!-- /.box-body -->
</div>
    <!-- /.content -->
<script>
    $(document).ready(function () {
        $("#FormCommitteeCategoryMaster").validate({
            rules: {
                CategoryName: "required",
                YearId: "required",
               /* PageParentId: "required",*/
            },
            messages: {
                CategoryName: "please enter your menu display name",
                YearId: "please enter Year Of Category",
               /* PageParentId: "please Select Parent menu ",*/
            },

            errorElement: "em",
            errorPlacement: function (error, element) {
                // Add the `help-block` class to the error element
                error.addClass("help-block");

                if (element.prop("type") === "checkbox") {
                    error.insertAfter(element.parent("label"));
                } else {
                    error.insertAfter(element);
                }

                // Move the error element after the fieldset element
                if (element.closest("fieldset").length) {
                    element.closest("fieldset").after(error);
                }
            },
            highlight: function (element, errorClass, validClass) {
                $(element).parents("fieldset").addClass("has-error").removeClass("has-success");
            },
            unhighlight: function (element, errorClass, validClass) {
                $(element).parents("fieldset").addClass("has-success").removeClass("has-error");
            },

        });


    });

    function ChapterNameBind() {

        var ChapterNamecheckboxs = Common.GetCheckBoxValue('ChapterNamecheckbox');

        $('#ChapterIds').val(ChapterNamecheckboxs);

        if (ChapterNamecheckboxs == "") {
            alert("Please select atleast one Chapter.");
            return false;
        }

    }


</script>


