@{
    ViewBag.Title = "Index - " + (Context.Session.GetString("SiteName") ?? "");
    Layout = "~/Areas/Admin/Views/Shared/_MainLayout.cshtml";
    Int64 Mid = ViewBag.mid;
    Int64 ChapterId = ViewBag.ChapterId;
    ViewBag.Pageheading = "Committees";

    // ✅ ASP.NET Core Session fixes
    var baseurl = Context.Session.GetString("BaseUrl") ?? "";
    string userRole = Context.Session.GetString("userrole") ?? "";
    bool IsEdit = Convert.ToBoolean(Context.Session.GetString("IsEdit") ?? "false");
    bool IsView = Convert.ToBoolean(Context.Session.GetString("IsView") ?? "false");
    bool IsDelete = Convert.ToBoolean(Context.Session.GetString("IsDelete") ?? "false");
    bool IsExport = Convert.ToBoolean(Context.Session.GetString("IsExport") ?? "false");
    bool IsAdd = Convert.ToBoolean(Context.Session.GetString("IsAdd") ?? "false");
}

<script>
    $(document).ready(function () {
        LoadEventsList();
    });

    function LoadEventsList() {
        $.ajax({
            type: "GET",
            url: '@Url.Action("CommitteeCategoryMasterList", "CommitteeCategoryMaster")',
            data: {
                IsEdit: '@IsEdit',
                IsView: '@IsView',
                IsDelete: '@IsDelete',
                IsExport: '@IsExport',
                IsAdd: '@IsAdd',
                Mid: @Mid, // ✅ no quotes if number
                YearId: @DateTime.Now.Year, // ✅ fixed
                ChapterId: @(ChapterId == 0 ? 1 : ChapterId)
            },
            success: function (data) {
                $("#divCommitteeCategoryMasterList").html(data);
            },
            error: function () {
                $("#divCommitteeCategoryMasterList")
                    .html('<p class="text-danger">Failed to load events.</p>');
            }
        });
    }
</script>

<script type="text/javascript">
    $(document).ready(function () {

        //$('#wCommitteeCategoryMaster').addClass('active');
        $('#wWebPages, #wCommitteeCategoryMaster').addClass('active');
        $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
        $('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');

    });


    function CommitteeCategoryMasterBind() {
        
        var YearId = $('#YearId').val();
        $.ajax({
            type: "GET",
            cache: false,
            url: '@Url.Action("CommitteeCategoryMasterList", "CommitteeCategoryMaster")',
            data: { YearId: YearId, Mid: @Mid , ChapterId:@ChapterId}, // optional data
            success: function (result) {
                $('#divCommitteeCategoryMasterList').html(result);
            }
        });
    }


    function EditMenuPages(MenuPagesId) {
        $.ajax({
            url: '@Url.Action("EditMenuPages", "MenuPages")',
            type: 'POST',
            data: { MenuPagesId: MenuPagesId },
            datatype: "JSON",
            success: function (result) {
                if (result.ok) {
                    var objMenuPages = result.data;
                    $('#AMenuPageId').val(objMenuPages.MenuPageId);
                    $('#AMenuItemId').val(objMenuPages.MenuItemId);
                    $('#APageDetailId').val(objMenuPages.PageDetailId);
                    $('#lbltitle').html('Change Page to Item');
                    $('#hdnPageDetails').html('Change Page to Item');

                    $("#AddMenuPages").modal("show");
                }
                else {
                    alert(result.data);
                }
            }
        });
    }

    function AddPageToItem(itemid, ChapterId) {
        $('#AMenuItemId').val(itemid);
        $('#AChapterId').val(ChapterId);
        $('#APageDetailId').val('');
        $("#AddMenuPages").modal("show");
        $('#hdnPageDetails').html('Add Page to Item');
    }
    function Validate() {

        if ($('#APageDetailId').val() == '') { $('#spanAPageDetailId').html('Required.'); $('#APageDetailId').focus(); return false; } else { $('#spanAPageDetailId').html(''); $('#APageDetailId').focus(); }

        return true;
    }

    function addcommittee() {
        var year = $('#YearId').val();
        window.location.href = '@baseurl' + "Admin/CommitteeCategoryMaster/CreateCommitteeCategoryMaster?mid=" + '@ViewBag.mid' + "&YearId=" + year + "&ChapterId=" + '@ViewBag.ChapterId' ;
    }
</script>
