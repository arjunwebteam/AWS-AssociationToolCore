                border-bottom: 0;
            }

        .dash .section-header {
            flex-wrap: wrap;
        }

        .dash .hero {
            padding: 16px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .dash * {
            transition: none !important;
        }
    }

