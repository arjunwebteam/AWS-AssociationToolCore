        .dash .stat-item:nth-child(-n+2) {
            border-bottom: 1px solid var(--d-line);
        }
    }

    @@media (max-width: 575px) {
        .dash .stat-strip {
            grid-template-columns: 1fr;
        }

        .dash .stat-item {
            border-right: 0;
            border-bottom: 1px solid var(--d-line);
