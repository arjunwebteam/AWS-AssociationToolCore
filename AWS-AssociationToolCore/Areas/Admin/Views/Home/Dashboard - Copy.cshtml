    }

    .dash .section-header.hd-amber {
        background: #ffecd0;
        border-bottom: 1px solid #fbd9a6;
    }

    .dash .section-header.hd-teal {
        background: #d5f0f3;
        border-bottom: 1px solid #b8e2e7;
    }

    .dash .hd-blue .section-title {
        color: #22377f;
    }

    .dash .hd-green .section-title {
        color: #14573a;
    }

    .dash .hd-violet .section-title {
