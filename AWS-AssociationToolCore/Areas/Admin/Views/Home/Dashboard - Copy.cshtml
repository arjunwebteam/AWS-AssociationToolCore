@using AWS_AssociationToolCore.BLL

@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_MainLayout.cshtml";
    ViewBag.Pageheading = "Dashboard";

    Int64 MembersActiveCount = ViewBag.MembersActiveCount;
    decimal MembersActiveSumAmount = ViewBag.MembersActiveSumAmount;
    Int64 MembersInActiveCount = ViewBag.MembersInActiveCount;

    decimal MembersInActiveSumAmount = ViewBag.MembersInActiveSumAmount;
    decimal DonationsWeeklyAmount = ViewBag.DonationsWeeklyAmount;
    decimal DonationsMonthlyAmount = ViewBag.DonationsMonthlyAmount;
    Int64 DonationsWeeklyCount = ViewBag.DonationsWeeklyCount;
    Int64 DonationsMonthlyCount = ViewBag.DonationsMonthlyCount;

    List<AWS_AssociationToolCore.Entities.Members> lstactiveMembers = ViewBag.lstactiveMembers;
    List<AWS_AssociationToolCore.Entities.Members> lstinactiveMembers = ViewBag.lstinactiveMembers;
    List<AWS_AssociationToolCore.Entities.ServiceDonations> lstServiceDonations = ViewBag.lstServiceDonations;
    List<AWS_AssociationToolCore.Entities.Events> lstEvents = ViewBag.lstEvents;
    List<AWS_AssociationToolCore.Entities.TableCount> lstTableCounts = ViewBag.lstTableCounts;

    var inv = System.Globalization.CultureInfo.InvariantCulture;

    // Initials for the round avatar next to a name
    string Initials(string first, string last)
    {
        var a = string.IsNullOrWhiteSpace(first) ? "" : first.Trim().Substring(0, 1).ToUpper();
        var b = string.IsNullOrWhiteSpace(last) ? "" : last.Trim().Substring(0, 1).ToUpper();
        var r = a + b;
        return r == "" ? "?" : r;
    }

    // Soft colour for the payment status pill
    string PayClass(string status)
    {
        var v = (status ?? "").Trim().ToLower();
        if (v == "completed" || v == "paid" || v == "success") return "pill-green";
        if (v == "pending") return "pill-amber";
        if (v == "" || v == "n/a") return "pill-grey";
        return "pill-rose";
    }

    // "In 8 days", "Today", "3 days ago" for the events table
    string DaysLabel(DateTime d)
    {
        var n = (d.Date - DateTime.Today).Days;
        if (n == 0) return "Today";
        if (n == 1) return "Tomorrow";
        if (n > 1) return "In " + n + " days";
        if (n == -1) return "Yesterday";
        return Math.Abs(n) + " days ago";
    }
    string DaysClass(DateTime d)
    {
        var n = (d.Date - DateTime.Today).Days;
        if (n < 0) return "pill-grey";
        if (n <= 7) return "pill-amber";
        return "pill-violet";
    }

    // Member split (donut)
    Int64 totalMembers = MembersActiveCount + MembersInActiveCount;
    double activePct = totalMembers == 0 ? 0 : (MembersActiveCount * 100.0 / totalMembers);
    string activePctCss = activePct.ToString("0.##", inv);
    string activePctText = activePct.ToString("0.#", inv);

    // Membership types in the latest orders (bars)
    var typeGroups = (lstactiveMembers ?? new List<AWS_AssociationToolCore.Entities.Members>())
        .GroupBy(m => string.IsNullOrWhiteSpace(m.MembershipType) ? "Other" : m.MembershipType.Trim())
        .Select(g => new { Name = g.Key, Count = g.Count() })
        .OrderByDescending(x => x.Count)
        .Take(5)
        .ToList();
    int typeMax = typeGroups.Count == 0 ? 1 : typeGroups.Max(x => x.Count);

    // Donations by cause in the latest donations (bars)
    var causeGroups = (lstServiceDonations ?? new List<AWS_AssociationToolCore.Entities.ServiceDonations>())
        .GroupBy(d => string.IsNullOrWhiteSpace(d.DonationCause) ? "Other" : d.DonationCause.Trim())
        .Select(g => new { Name = g.Key, Total = g.Sum(x => Convert.ToDouble(x.Amount)) })
        .OrderByDescending(x => x.Total)
        .Take(5)
        .ToList();
    double causeMax = causeGroups.Count == 0 ? 1 : causeGroups.Max(x => x.Total);
    if (causeMax <= 0) { causeMax = 1; }
}

<script>
    $(document).ready(function () {
        $('#wDashboard').addClass('active');
    });
</script>

