@{
    ViewBag.Title = "Welcome";
    ViewBag.Pageheading = "Welcome";
    Layout = "~/Areas/Admin/Views/Shared/_MainLayout.cshtml";
    int status = 0;

    AWS_AssociationToolCore.BLL.AppInfo _AppInfo = new AWS_AssociationToolCore.BLL.AppInfo();
    AWS_AssociationToolCore.Entities.AppInfo objAppInfo = new AWS_AssociationToolCore.Entities.AppInfo();
    objAppInfo = _AppInfo.GetAppInfoDetails(ref status);

    // same logo path as layout: Areas/FormBuilder/Content/LayoutLogo/normalimages/{LayoutLogo}
    var Logon = objAppInfo.BaseUrl + "Content/Loginlogo/normalimages/";
}

<style type="text/css">
    .zfb-welcome-card {
        background: #fff;
        border: 1px solid #eef0f6;
        border-radius: 16px;
        box-shadow: 0 2px 8px rgba(20, 30, 60, 0.05);
        padding: 48px 40px;
        text-align: center;
    }

    .zfb-welcome-logo {
        display: block;
        margin: 0 auto 28px;
        max-width: 260px;
        max-height: 160px;
        width: auto;
        height: auto;
        object-fit: contain;
    }

    .zfb-welcome-title {
        margin: 0 0 18px;
        font-size: 30px;
        font-weight: 700;
        color: #8b0000;
    }

    .zfb-welcome-text {
        max-width: 820px;
        margin: 0 auto 14px;
        font-size: 16px;
        line-height: 1.8;
        color: #3a3f4b;
    }

        .zfb-welcome-text:last-child {
            margin-bottom: 0;
        }
            .zfb-welcome-contact {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 14px;
        margin-top: 28px;
    }

    .zfb-contact-item {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 10px 20px;
        font-size: 15px;
        font-weight: 600;
        color: #1f2544;
        background: #eef2ff;
        border: 1px solid #c7d2fe;
        border-radius: 10px;
        text-decoration: none;
    }

    .zfb-contact-item i {
        color: #4f46e5;
    }
    .zfb-welcome-contact {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 14px;
    }

    .zfb-help-title {
        margin: 32px 0 14px;
        font-size: 18px;
        font-weight: 600;
        text-align: center;
        color: #1f2544;
    }
    @@media (max-width: 576px) {
        .zfb-welcome-card {
            padding: 32px 20px;
        }

        .zfb-welcome-title {
            font-size: 24px;
        }
    }
</style>

<div class="zfb-welcome-card">
    <img class="zfb-welcome-logo" src="@Logon/@objAppInfo.Loginlogo" alt="@objAppInfo.SiteName" />

    <h2 class="zfb-welcome-title">Welcome to @objAppInfo.SiteName</h2>

    <p class="zfb-welcome-text">
        Manage your association's All Type Of registrations from one place.
        Add new records, update existing details and remove entries that are no longer needed, all in a few clicks.
    </p>


    <p class="zfb-welcome-text">
        We hope you enjoy using the platform. Thank you for being a part of our community.
    </p>

    @if (!string.IsNullOrWhiteSpace(objAppInfo.CompanyPhone) || !string.IsNullOrWhiteSpace(objAppInfo.CompanyEmail))
    {
    <h4 class="zfb-help-title">Need any help?</h4>
    <div class="zfb-welcome-contact">
        @if (!string.IsNullOrWhiteSpace(objAppInfo.CompanyPhone))
        {
        <a class="zfb-contact-item" href="tel:@objAppInfo.CompanyPhone">
            <i class="bi bi-telephone-fill"></i>
            <span>@objAppInfo.CompanyPhone</span>
        </a>
        }
        @if (!string.IsNullOrWhiteSpace(objAppInfo.CompanyEmail))
        {
        <a class="zfb-contact-item" href="mailto:@objAppInfo.CompanyEmail">
            <i class="bi bi-envelope-fill"></i>
            <span>@objAppInfo.CompanyEmail</span>
        </a>
        }
    </div>
    }
</div>
