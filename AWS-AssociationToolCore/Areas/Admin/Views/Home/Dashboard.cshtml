@using AWS_AssociationToolCore.BLL

@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_MainLayout.cshtml";
    ViewBag.Pageheading = "Dashboard";

    Int64 MembersActiveCount = ViewBag.MembersActiveCount;
    decimal MembersActiveSumAmount = ViewBag.MembersActiveSumAmount;
    Int64 MembersInActiveCount = ViewBag.MembersInActiveCount;
    decimal MembersInActiveSumAmount = ViewBag.MembersInActiveSumAmount;
    decimal DonationsWeeklyAmount = ViewBag.DonationsWeeklyAmount;
    decimal DonationsMonthlyAmount = ViewBag.DonationsMonthlyAmount;
    Int64 DonationsWeeklyCount = ViewBag.DonationsWeeklyCount;
    Int64 DonationsMonthlyCount = ViewBag.DonationsMonthlyCount;

    List<AWS_AssociationToolCore.Entities.Members> lstactiveMembers = ViewBag.lstactiveMembers ?? new List<AWS_AssociationToolCore.Entities.Members>();
    List<AWS_AssociationToolCore.Entities.Members> lstinactiveMembers = ViewBag.lstinactiveMembers ?? new List<AWS_AssociationToolCore.Entities.Members>();
    List<AWS_AssociationToolCore.Entities.ServiceDonations> lstServiceDonations = ViewBag.lstServiceDonations ?? new List<AWS_AssociationToolCore.Entities.ServiceDonations>();
    List<AWS_AssociationToolCore.Entities.Events> lstEvents = ViewBag.lstEvents ?? new List<AWS_AssociationToolCore.Entities.Events>();
    List<AWS_AssociationToolCore.Entities.TableCount> lstTableCounts = ViewBag.lstTableCounts ?? new List<AWS_AssociationToolCore.Entities.TableCount>();

    // Initials for the round avatar next to a name
    string Initials(string first, string last)
    {
        var a = string.IsNullOrWhiteSpace(first) ? "" : first.Trim().Substring(0, 1).ToUpper();
        var b = string.IsNullOrWhiteSpace(last) ? "" : last.Trim().Substring(0, 1).ToUpper();
        var r = a + b;
        return r == "" ? "?" : r;
    }

    // Soft colour for the payment status pill
    string PayClass(string status)
    {
        var v = (status ?? "").Trim().ToLower();
        if (v == "completed" || v == "paid" || v == "success") return "pill-green";
        if (v == "pending") return "pill-amber";
        if (v == "" || v == "n/a") return "pill-grey";
        return "pill-rose";
    }
}

<script>
    $(document).ready(function () {
        $('#wDashboard').addClass('active');
    });
</script>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />

<style type="text/css">
    :root {
        --d-ink: #1b2440;
        --d-text: #3a4563;
        --d-muted: #6f7a93;
        --d-line: #e6eaf5;
        --d-card: #ffffff;
        --d-blue: #3d5bd9;
        --d-green: #1f9d60;
        --d-amber: #e08a2e;
        --d-rose: #d9594a;
        --d-violet: #7048d6;
        --d-teal: #0f9aa8;
        --d-shadow: 0 1px 2px rgba(27, 36, 64, .05), 0 8px 24px rgba(27, 36, 64, .06);
    }

    body {
        background: linear-gradient(180deg, #eef2ff 0%, #f6f8fd 320px, #f4f7fc 100%);
        background-attachment: fixed;
    }

    img {
        max-width: 100% !important;
    }

    .body > .header .logo {
        padding: 8px;
    }

    .dash {
        font-family: 'Poppins', 'Segoe UI', Roboto, Arial, sans-serif;
        color: var(--d-ink);
        padding: 4px 2px 32px;
        font-variant-numeric: tabular-nums;
        animation: dashIn .35s ease both;
    }

        .dash h2, .dash h4, .dash h5, .dash h6 {
            font-family: inherit;
        }

        .dash h6 {
            font-size: 14px !important;
        }

    @@keyframes dashIn {
        from {
            opacity: 0;
            transform: translateY(6px);
        }

        to {
