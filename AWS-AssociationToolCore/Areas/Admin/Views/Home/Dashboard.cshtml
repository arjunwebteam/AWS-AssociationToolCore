        justify-content: center;
        font-size: 12px;
        font-weight: 700;
        color: #fff;
        background: linear-gradient(135deg, #3d5bd9, #8a63e6);
    }

        .dash .avatar.av-green {
            background: linear-gradient(135deg, #1f9d60, #3cc4cf);
        }

    .dash .person-name {
        margin: 0;
        font-size: 14px !important;
        font-weight: 600;
        color: var(--d-ink);
    }

    .dash .mail-link {
        color: var(--d-blue);
        text-decoration: none;
    }

        .dash .mail-link:hover {
            text-decoration: underline;
        }

    .dash .id-chip {
        display: inline-block;
        padding: 3px 10px;
        font-size: 12.5px;
        font-weight: 600;
        color: #3f4d7a;
        background: #e9eefc;
        border-radius: 8px;
        white-space: nowrap;
    }

    .dash .amount {
        font-weight: 700;
        color: var(--d-ink);
        white-space: nowrap;
    }

    .dash .date-text {
        color: var(--d-muted);
        white-space: nowrap;
    }

    /* ---------- Pills ---------- */
    .dash .pill {
        display: inline-flex;
