</style>

<div class="dash">

    <!-- Welcome banner -->
    <div class="hero">
        <div>
            <h2>Welcome back, Admin</h2>
            <p>Here is what is happening with your association today.</p>
            <span class="hero-date"><i class="bi bi-calendar-check"></i> @DateTime.Now.ToString("dddd, MMMM d, yyyy")</span>
        </div>
        <div class="hero-actions">
            <a class="hero-btn" href="@Url.Action("Index", "Members", new { mid = 10 })"><i class="bi bi-people-fill"></i> Members</a>
            <a class="hero-btn" href="@Url.Action("Index", "ServiceDonations")"><i class="bi bi-heart-fill"></i> Donations</a>
            <a class="hero-btn" href="@Url.Action("Index", "Events", new { EventType = "upcoming", mid = 6 })"><i class="bi bi-calendar-event-fill"></i> Events</a>
        </div>
    </div>

    <!-- Overview cards -->
    <div class="stat-strip">
        <div class="stat-item si-green">
            <div class="stat-icon"><i class="bi bi-person-check-fill"></i></div>
            <div class="stat-body">
                <div class="stat-label">Active members</div>
                <h4 class="stat-value">@MembersActiveCount</h4>
                <div class="stat-foot">$@MembersActiveSumAmount.ToString("N2") total</div>
            </div>
        </div>
        <div class="stat-item si-rose">
            <div class="stat-icon"><i class="bi bi-person-dash-fill"></i></div>
            <div class="stat-body">
                <div class="stat-label">Inactive members</div>
                <h4 class="stat-value">@MembersInActiveCount</h4>
                <div class="stat-foot">$@MembersInActiveSumAmount.ToString("N2") total</div>
            </div>
        </div>
        <div class="stat-item si-blue">
            <div class="stat-icon"><i class="bi bi-calendar-week"></i></div>
            <div class="stat-body">
                <div class="stat-label">Donations this week</div>
                <h4 class="stat-value">$@DonationsWeeklyAmount.ToString("N2")</h4>
                <div class="stat-foot">@DonationsWeeklyCount @(DonationsWeeklyCount == 1 ? "donation" : "donations")</div>
            </div>
        </div>
        <div class="stat-item si-amber">
            <div class="stat-icon"><i class="bi bi-calendar3"></i></div>
            <div class="stat-body">
                <div class="stat-label">Donations this month</div>
                <h4 class="stat-value">$@DonationsMonthlyAmount.ToString("N2")</h4>
                <div class="stat-foot">@DonationsMonthlyCount @(DonationsMonthlyCount == 1 ? "donation" : "donations")</div>
            </div>
        </div>
    </div>

    <!-- Members (full width) -->
    <div class="section-card mb-4 ac-blue">
        <div class="section-header hd-blue">
            <div class="section-icon"><i class="bi bi-people-fill"></i></div>
            <div>
                <h5 class="section-title">Members</h5>
                <div class="section-sub">Latest membership orders</div>
            </div>
            <a href="@Url.Action("Index", "Members", new { mid = 10 })" class="btn-soft">
                <i class="bi bi-grid-fill"></i> <span>View all members</span>
            </a>
        </div>

        <div class="section-body">
            <div class="table-responsive">
                <table class="table align-middle mb-0 th-blue">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Membership type</th>
                            <th>Payment</th>
                            <th>Price</th>
                            <th>Order date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (lstactiveMembers.Count != 0)
                        {
                            foreach (var item in lstactiveMembers)
                            {
                                <tr>
                                    <td>
                                        @if (item.MemberSkils != null && item.MemberSkils != "")
                                        {
                                            <span class="id-chip">@item.MemberSkils</span>
                                        }
                                        else
                                        {
                                            <span class="reg-none">--</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="person">
                                            <span class="avatar">@Initials(item.FirstName, item.LastName)</span>
                                            <h6 class="person-name">@item.FirstName @item.LastName</h6>
                                        </div>
                                    </td>
                                    <td><a class="mail-link" href="mailto:@item.Email">@item.Email</a></td>
                                    <td><span class="type-pill">@item.MembershipType</span></td>
                                    <td>
                                        @{
                                            var payStatus = item.objMembershipOrder.PaymentStatus == null || item.objMembershipOrder.PaymentStatus == "" ? "N/A" : item.objMembershipOrder.PaymentStatus;
                                        }
                                        <span class="pill @PayClass(payStatus)">@payStatus</span>
                                    </td>
                                    <td class="amount">$@(item.objMembershipOrder.Amount == 0 ? "0.00" : item.objMembershipOrder.Amount.ToString("N2"))</td>
                                    <td class="date-text">@(item.objMembershipOrder.OrderDate == DateTime.MinValue ? "N/A" : item.objMembershipOrder.OrderDate.ToAppDate())</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="empty-state"><i class="bi bi-inbox"></i>No members found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="section-foot">Showing the latest @lstactiveMembers.Count @(lstactiveMembers.Count == 1 ? "order" : "orders"). Use View all members for the full list.</div>
    </div>

    <!-- Donations + Events side by side -->
    <div class="row g-4 align-items-stretch mb-4">
        <div class="col-12 col-xl-6 d-flex">
            <div class="section-card w-100 ac-green">
                <div class="section-header hd-green">
                    <div class="section-icon"><i class="bi bi-heart-fill"></i></div>
                    <div>
                        <h5 class="section-title">Donations</h5>
                        <div class="section-sub">Most recent contributions</div>
                    </div>
                    <a href="@Url.Action("Index", "ServiceDonations")" class="btn-soft">
                        <i class="bi bi-grid-fill"></i> <span>View all</span>
                    </a>
                </div>

                <div class="section-body">
                    <div class="table-responsive scroll-y">
                        <table class="table align-middle mb-0 th-green">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Name</th>
                                    <th>Cause</th>
                                    <th>Amount</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (lstServiceDonations.Count != 0)
                                {
                                    foreach (var item in lstServiceDonations)
                                    {
                                        <tr>
                                            <td><span class="id-chip">@item.ServiceDonationId</span></td>
                                            <td>
                                                <div class="person">
                                                    <span class="avatar av-green">@Initials(item.FirstName, item.LastName)</span>
                                                    <h6 class="person-name">@item.FirstName @item.LastName</h6>
                                                </div>
                                            </td>
                                            <td><span class="cause-pill">@item.DonationCause</span></td>
                                            <td class="amount">$@Math.Round(item.Amount, 2).ToString("N2")</td>
                                            <td class="date-text">@(item.OrderDate == DateTime.MinValue ? item.UpdatedDate.ToAppDate() : item.OrderDate.ToAppDate())</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="empty-state"><i class="bi bi-inbox"></i>No donations found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="section-foot">Showing the latest @lstServiceDonations.Count @(lstServiceDonations.Count == 1 ? "donation" : "donations").</div>
            </div>
        </div>

        <div class="col-12 col-xl-6 d-flex">
            <div class="section-card w-100 ac-violet">
                <div class="section-header hd-violet">
                    <div class="section-icon"><i class="bi bi-calendar-event-fill"></i></div>
                    <div>
                        <h5 class="section-title">Current and upcoming events</h5>
                        <div class="section-sub">Registrations at a glance</div>
                    </div>
                    <a href="@Url.Action("Index", "Events", new { EventType = "upcoming", mid = 6 })" class="btn-soft">
                        <i class="bi bi-grid-fill"></i> <span>View all</span>
                    </a>
                </div>

                <div class="section-body">
                    <div class="table-responsive scroll-y">
                        <table class="table align-middle mb-0 th-violet">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Event</th>
                                    <th>Start date</th>
                                    <th>Registrations</th>
                                    <th>Cultural</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (lstEvents.Count != 0)
                                {
                                    Int64 i = 1;
                                    foreach (var item in lstEvents)
                                    {
                                        <tr>
                                            <td><span class="id-chip">@i</span></td>
                                            <td>
                                                <div class="event-name">
                                                    <span class="event-dot"></span>
                                                    <h6 class="person-name">@item.EventName</h6>
                                                </div>
                                            </td>
                                            <td><span class="date-text">@item.StartDate.ToAppDate()</span></td>
                                            <td>
                                                @if (item.IsRegistration == true)
                                                {
                                                    <a class="reg-link" href="@Url.Action("Index", "EventRegistrations", new { EventId = item.EventId, EventName = item.EventName, mid = 6 })">
                                                        Registrations <span class="count">@item.UsersCount</span>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="reg-none">No registrations</span>
                                                }
                                            </td>
                                            <td>
                                                @if (item.IsCulturalRegistration == true)
                                                {
                                                    <a class="reg-link cultural" href="@Url.Action("Index", "CulturalRegistrations", new { EventId = item.EventId, EventName = item.EventName, mid = ViewBag.Mid })">
                                                        Cultural <span class="count">@item.CUsersCount</span>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="reg-none">No registrations</span>
                                                }
                                            </td>
                                        </tr>
                                        i++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="empty-state"><i class="bi bi-calendar-x"></i>No events found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="section-foot">@lstEvents.Count @(lstEvents.Count == 1 ? "event" : "events") current or upcoming.</div>
            </div>
        </div>
    </div>

    <!-- Quick links -->
    <div class="section-card ac-teal">
        <div class="section-header hd-teal">
            <div class="section-icon"><i class="bi bi-link-45deg"></i></div>
            <div>
                <h5 class="section-title">Quick links</h5>
                <div class="section-sub">Record counts across the system</div>
            </div>
        </div>
        @if (lstTableCounts.Count != 0)
        {
            string[] tones = { "blue", "green", "amber", "violet", "teal", "rose" };
            int qi = 0;
            <div class="quick-links-grid">
                @foreach (var item in lstTableCounts)
                {
                    <div class="quick-link-item @("tile-" + tones[qi % tones.Length])">
                        <div class="quick-link-icon"><i class="bi bi-file-earmark-spreadsheet"></i></div>
                        <div class="quick-link-text">
                            <span class="quick-link-name">@item.TableName</span>
                            <span class="quick-link-count">@item.TotalCount</span>
                        </div>
                    </div>
                    qi++;
                }
            </div>
        }
        else
        {
            <p class="empty-state mb-0"><i class="bi bi-inbox"></i>No quick links found.</p>
        }
    </div>

</div>
