        align-items: center;
        justify-content: center;
        font-size: 18px;
        color: #fff;
    }

    .dash .quick-link-text {
        display: flex;
        flex-direction: column;
        min-width: 0;
        line-height: 1.25;
    }

    .dash .quick-link-name {
        font-size: 13.5px;
        font-weight: 500;
        color: var(--d-muted);
    }

    .dash .quick-link-count {
        font-size: 21px;
