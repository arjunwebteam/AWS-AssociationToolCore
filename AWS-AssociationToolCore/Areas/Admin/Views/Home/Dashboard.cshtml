        }

        .dash .stat-item.si-rose {
            background: linear-gradient(135deg, #d9594a, #f2856f);
        }

        .dash .stat-item.si-blue {
            background: linear-gradient(135deg, #3d5bd9, #6f8cf5);
        }

        .dash .stat-item.si-amber {
            background: linear-gradient(135deg, #e08a2e, #f6b95f);
        }

    .dash .stat-icon {
