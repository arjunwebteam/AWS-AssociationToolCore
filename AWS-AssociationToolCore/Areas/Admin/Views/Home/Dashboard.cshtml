    /* ---------- Welcome banner ---------- */
    .dash .hero {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px 24px;
        padding: 24px 28px;
        margin-bottom: 20px;
        color: #fff;
        background: linear-gradient(120deg, #3d5bd9 0%, #6a4bd6 55%, #b24bd0 100%);
        border-radius: 20px;
        box-shadow: 0 10px 28px rgba(80, 70, 210, .28);
    }

        .dash .hero::before,
        .dash .hero::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            background: rgba(255, 255, 255, .10);
            pointer-events: none;
        }

        .dash .hero::before {
            width: 220px;
            height: 220px;
            right: -50px;
            top: -90px;
        }

        .dash .hero::after {
            width: 150px;
            height: 150px;
            right: 140px;
            bottom: -90px;
        }

        .dash .hero > * {
            position: relative;
            z-index: 1;
        }

        .dash .hero h2 {
            margin: 0;
            font-size: 26px;
            font-weight: 700;
            color: #fff;
        }

        .dash .hero p {
            margin: 4px 0 0;
            font-size: 14px;
            color: rgba(255, 255, 255, .85);
        }

    .dash .hero-date {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 12px;
        padding: 5px 14px;
        font-size: 12.5px;
        font-weight: 600;
        color: #fff;
        background: rgba(255, 255, 255, .18);
        border: 1px solid rgba(255, 255, 255, .35);
        border-radius: 999px;
    }

    .dash .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .dash .hero-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        font-size: 13.5px;
        font-weight: 600;
        color: #fff;
        background: rgba(255, 255, 255, .16);
        border: 1px solid rgba(255, 255, 255, .4);
        border-radius: 12px;
        text-decoration: none;
        transition: background-color .15s ease, transform .15s ease;
    }

        .dash .hero-btn:hover {
            background: #fff;
            color: var(--d-violet);
            transform: translateY(-1px);
        }

    /* ---------- Overview cards ---------- */
    .dash .stat-strip {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 22px;
    }

    .dash .stat-item {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 22px;
        color: #fff;
        border-radius: 18px;
        box-shadow: var(--d-shadow);
        transition: transform .18s ease, box-shadow .18s ease;
    }

        .dash .stat-item::after {
