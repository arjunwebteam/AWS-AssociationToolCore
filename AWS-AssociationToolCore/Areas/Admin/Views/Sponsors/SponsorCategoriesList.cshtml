@using AWS_AssociationToolCore.BLL

@{ Layout = null;}
@{
    string sortcolumn = (string)ViewBag.sortcolumn;
    string sortorder = (string)ViewBag.sortorder;
    Int64 Total = (Int64)ViewBag.total;
    var PageNo = (Int64)ViewBag.pageno;
    var Items = (Int64)ViewBag.items;
    var ChapterId = ViewBag.ChapterId;


    List<AWS_AssociationToolCore.Entities.SponsorCategories> lstSponsorCategories = ViewBag.lstSponsorCategories;
    string userRole = Context.Session.GetString("userrole") ?? string.Empty;

}


<script type="text/javascript">

    $(document).ready(function () {
        $('#wSponsors').addClass('active');
        $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
        $('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
    });
    function DeleteSponsor(SponsorCategoryId) {
        var val2 = confirm("Do you want to delete this record?");
        if (val2) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("DeleteSponsorCategory", "Sponsors")',  // the URL of the controller action method
                data: { SponsorCategoryId: SponsorCategoryId }, // optional data
                success: function (result) {
                    showLobiboxNotification(result.messageType, result.message);
                    if (result.ok) {
                       // $("#divmessage").html(result.data);
                        Onload($('#hdnPageNo').val());
                    }
                    else {
                        $("#divmessage").val(result.data);
                    }
                },
            });
        }
    }


    function SponsorCategoryStatus(SponsorCategoryId) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("SponsorCategoriesStatus", "Sponsors")', // the URL of the controller action method
            data: { SponsorCategoryId: SponsorCategoryId }, // optional data
            datatype: "JSON",
            success: function (result) {
                showLobiboxNotification(result.messageType, result.message);
                if (result.ok) {
                    Onload(1);
                    //$('#divmessage').html(result.data);
                    //$('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                }
                else {
                    $('#divmessage').html(result.data);
                    $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                }
            }
        });
    }

    function SponsorCatgoryDisplayOrder(i, SponsorCategoryId) {
        var DisplayOrder = parseInt($('#DisplayOrder' + i).val());
        $.ajax({
            type: 'POST',
            url: '@Url.Action("UpdateSponsorsCategoryDisplayOrder", "Sponsors")',
            data: { DisplayOrder: DisplayOrder, SponsorCategoryId: SponsorCategoryId },
            success: function (result) {
                var div = '';
                showLobiboxNotification(result.messageType, result.message);
                if (result.ok) {
                   // $("#divmessage").html(result.data);
                    Onload(1);
                   // $('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                }
                else {
                  //  $("#divmessage").html(result.data);
                   // $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                }
            }
        });
    }
</script>
<div class="card-body">
    <div class="table-responsive">

        @if (Total == -1)
        {
            <div class="norecords">Sorry failed processing your request.</div>
        }
        else
        {
            <table class="table table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>

                        <th width="40" class="text-center">S.No</th>
                        <th >
                            <a style="color: black;" onclick="javascript:sortresult('CategoryName');" class="white-t-u aws-h-a">
                                Category Name @if (sortcolumn == "CategoryName")
                                {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                            </a>


                        </th>
                       
                        <th width="100">#</th>

                        <th width="130">
                            <a style="color: black;" onclick="javascript:sortresult('UpdatedTime');" class="white-t-u aws-h-a">
                                Posted Date @if (sortcolumn == "UpdatedTime")
                                {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                            </a>


                        </th>

                        <th width="80">
                            <a style="color: black;" onclick="javascript:sortresult('DisplayOrder');" class="white-t-u aws-h-a">
                                Order No @if (sortcolumn == "DisplayOrder")
                                {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                            </a>
                            @*<a class="cursor-pointer aws-h-a " style="color: black;" onclick="javascript:sortresult('DisplayOrder');">
                Order No @if (sortcolumn == "DisplayOrder")
                {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
            </a>*@ @*<a class="cursor-pointer aws-h-a " style="color: black;" onclick="javascript:sortresult('DisplayOrder');">
                Order No @if (sortcolumn == "DisplayOrder")
                {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
            </a>*@
                    </th>


                    <th width="80">Status</th>

                    <th class="text-center" width="80">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (lstSponsorCategories.Count != 0)
                    {
                        int i = 0;
                        foreach (var item in lstSponsorCategories)
                        {
                    <tr>
                        <td align="center">@item.RId</td>



                        <td>@item.CategoryName</td>
                        <td><a class="cursor-pointer aws-h-a "  href="@Url.Action("Index", "Sponsors", new { SponsorCategoryId = item.SponsorCategoryId ,mid=ViewBag.Mid})">Sponsors</a></td>

                        <td>@(item.UpdatedTime != null && item.UpdatedTime != DateTime.MinValue ? item.UpdatedTime.ToAppDate() : "N/A")</td>


                        <td>
                            <input type="text" maxlength="3" style="width:50px;" id="DisplayOrder@(i)" value="@item.DisplayOrder" onkeypress="return Common.isNumberKey(event)" />
                            <a onclick="SponsorCatgoryDisplayOrder(@i,@item.SponsorCategoryId);" title="Update"><i class="fa fa-fw fa-refresh"></i></a>

                        </td>




                        <td>
                            <div class="menu-hover">
                                @{ var isChecked = item.IsActive ? "checked" : ""; }
                                @{var titleValue = item.IsActive ? "Active" : "Disabled";}

                                <div>
                                    <label class="switch" title="@titleValue">
                                        <input type="checkbox" onclick="SponsorCategoryStatus(@item.SponsorCategoryId)" @isChecked>
                                        <span class="slider"></span>
                                    </label>
                                </div>
                            </div>
                        </td>

                        <td class="text-center">
                            <div class="table-actions d-flex align-items-center gap-3 fs-6">

                                @if (ViewBag.IsEdit == true )
                                {
                                    <a class="text-warning cursor-pointer" onclick="EditSponsorCategory(@item.SponsorCategoryId);" title=" Edit" aria-label="Edit"><i class="bi bi-pencil-fill"></i></a>
                                }
                                @if (ViewBag.IsDelete == true )
                                {
                                    if (item.SponsorsCount == 0)
                                    {


                                        <a class="text-danger cursor-pointer" onclick="DeleteSponsor(@item.SponsorCategoryId);" title="Delete" aria-label="Delete"><i class="bi bi-trash-fill"></i></a>
                                    }
                                    else
                                    {
                                             <a title="This category have @item.SponsorsCount sponsors" class="disable-alpha"><i class="fa fa-trash-o"></i></a>

                                    }
                                }
                            </div>



                            @*<div class="d-flex align-items-center gap-2 fs-6 cus-btn-group ">
                <a class="text-warning cursor-pointer" onclick="EmployeeTypesEdit(@item.WebsiteBannerId);" title="" aria-label="Edit"><i class="bi bi-pencil-fill"></i></a>
                <a class="text-danger" onclick="DeleteEmployeeType(@item.WebsiteBannerId, '@item.Name');" title="" aria-label="Delete"><i class="bi bi-trash-fill"></i></a>
            </div>*@
                        </td>




                    </tr>
                            i++;
                        }
                    }
                    else
                    {
                        <tr class="odd"><td valign="top" colspan="10" class="font-14 text-center">No  Records found</td></tr>
                    }
                </tbody>
            </table>
        }



    </div>

    <div class="row pt-3">
        <div class="col-sm-4 col-md-5">
            <div class="dataTables_info" id="example_info" role="status" aria-live="polite">
                Showing @((PageNo * Items) - (Items - 1)) - @((PageNo * Items) > Total ? Total : (PageNo * Items)) of @Total entries
            </div>
        </div>
        <div class="col-sm-3 col-md-7 " @(Total > 0 ? "" : "disable")>
            <div class="d-flex flex-wrap gap-4 justify-content-end">

                <div class="dataTables_paginate paging_simple_numbers" id="example_paginate">
                    @Html.Raw(AWS_AssociationToolCore.BLL.Common.SetPaging((Int64)ViewBag.items, ref Total, (Int64)ViewBag.pageno, "pagination pb-0"))
                </div>
            </div>
        </div>
    </div>

</div>
<style>
    .aws-h-a {
        text-decoration: none;
        position: relative;
    }

        .aws-h-a::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            bottom: -2px;
            border-bottom: 2px solid #0756ca;
            transform: scaleX(0);
            transition: transform 0.3s ease;
        }

        .aws-h-a:hover::after {
            transform: scaleX(1);
        }
</style>