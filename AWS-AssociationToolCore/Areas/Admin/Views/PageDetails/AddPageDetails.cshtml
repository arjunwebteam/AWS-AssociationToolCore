    List<AWS_AssociationToolCore.Entities.MenuItems> lstMenuItems3 = ViewBag.lstMenuItems3;
    List<AWS_AssociationToolCore.Entities.MenuItems> lstMenuItems4 = ViewBag.lstMenuItems4;

    List<AWS_AssociationToolCore.Entities.MenuItems> lstExistingMenuItems = ViewBag.lstExistingMenuItems;
