<script>

    $(document).ready(function () {
        $("#MenuItemhide").hide();
        $("#ExistingMenuhide").hide();
        $("#MenuItem1hide").hide();

     $.validator.addMethod("validDocument", function (value, element) {
        if (!element.files || element.files.length === 0) return true;

        var file = element.files[0];
        var fileName = file.name.toLowerCase().trim();
        var fileType = (file.type || '').toLowerCase();

        // ✅ Allowed extensions
        var allowedExt = ['.pdf', '.doc', '.docx', '.xls', '.xlsx'];

        var lastDot = fileName.lastIndexOf('.');
        var ext = lastDot !== -1 ? fileName.substring(lastDot) : '';

        // ❌ Block images explicitly
        var blockedImageExt = ['.jpg', '.jpeg', '.png', '.gif', '.bmp', '.webp'];
        if (blockedImageExt.indexOf(ext) !== -1) return false;

        // ❌ Block dangerous files
        var blockedExt = ['.exe', '.bat', '.cmd', '.sh', '.php', '.dll', '.msi'];
        if (blockedExt.indexOf(ext) !== -1) return false;

        // ✅ Allow valid extensions
        if (allowedExt.indexOf(ext) !== -1) return true;

        // ❌ Everything else rejected
        return false;

    }, "Only PDF, DOC, DOCX, XLS, XLSX files are allowed. Images are not allowed.");

        $("#FormMenuItems").validate({
            rules: {
                Heading: "required",
                AddPage: "required",
    file: { validDocument: true }
            },
            messages: {
                Heading: "Please Enter Heading",
                AddPage: "Please Select One",
                file: { validImageExtension: "Invalid file type. Only PDF, DOC, XLS files are allowed." },
            },
            ignore: ":hidden",
            submitHandler: function (form) {
                var Heading = $("#Heading").val();
                var PageDetailId = 0;
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("CheckPageHeadingAvailability", "PageDetails", new { area = "Admin" })',
                    data: {
                        Heading: Heading,
                        PageDetailId: PageDetailId,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (result) {
                        if (result.ok) {
                            if (result.data === true) { form.submit(); }
                            else { $("#spanHeading").text("Heading is Already Available."); }
                        } else { form.submit(); }
                    },
                    error: function () { form.submit(); }
                });
            },
            errorElement: "div",
            errorPlacement: function (error, element) {
                error.addClass("invalid-feedback");
                if (element.prop("type") === "checkbox") {
                    error.insertAfter(element.parent("label"));
                } else {
                    error.insertAfter(element);
                }
                if (element.closest(".input-box").length) {
                    element.closest(".input-box").after(error);
                }
            },
            highlight: function (element) { $(element).addClass("is-invalid").removeClass("is-valid"); },
            unhighlight: function (element) { $(element).addClass("is-valid").removeClass("is-invalid"); },
        });
    });


    function AddPageBind() {
        var AddPage = $("#AddPage").val();
        if (AddPage == 'Only Page') {
            $("#MenuItemhide").hide();
            $("#MenuItem1hide").hide();
            $("#ExistingMenuhide").hide();
        }
        else if (AddPage == 'Existing Menu') {
            $("#MenuItemhide").hide();
            $("#MenuItem1hide").hide();
            $("#ExistingMenuhide").show();
        }
        else if (AddPage == 'New Menu Item') {
            $("#MenuItemhide").show();
            $("#MenuItem1hide").show();
            $("#ExistingMenuhide").hide();
        }
    }
</script>


