@{ Layout = null;}
@{
    string sortcolumn = (string)ViewBag.sortcolumn;
    string sortorder = (string)ViewBag.sortorder;
    Int64 Total = (Int64)ViewBag.total;
    var PageNo = (Int64)ViewBag.pageno;
    var Items = (Int64)ViewBag.items;
    var ChapterId = ViewBag.ChapterId;



    List<AWS_AssociationToolCore.Entities.VolunteerCategories> lstVolunteerCategories = ViewBag.lstVolunteerCategory;

    string userRole = Context.Session.GetString("userrole") ?? string.Empty;
}

<script type="text/javascript">

    function VolunteerCategoriesStatus(VolunteerCategoryId) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("VolunteerCategoryStatus", "VolunteerCategories")', // the URL of the controller action method
            data: { VolunteerCategoryId: VolunteerCategoryId }, // optional data
            datatype: "JSON",
            success: function (result) {
                if (result.ok) {
                    showLobiboxNotification(result.messageType, result.message);
                    
                    VolunteerCategoriesBind(1);
                }
                else {
                    $('#divmessage').html(result.data);
                    $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                }
            }
        });
    }

    function UpdateOrderNo(i, VolunteerCategoryId) {
        var OrderNo = parseInt($('#OrderNo' + i).val());
        $.ajax({
            type: 'POST',
            url: '@Url.Action("VolunteerCategoryDisplayOrder", "VolunteerCategories")',
            data: { OrderNo: OrderNo, VolunteerCategoryId: VolunteerCategoryId },
            success: function (result) {
                var div = '';
                showLobiboxNotification(result.messageType, result.message);
                if (result.ok) {
                    
                    VolunteerCategoriesBind(1);
                }
                else {
                    $("#divmessage").html(result.data);
                    $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                }
            }
        });
    }
</script>



<div class="card-body">
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th width="5%" style="text-align:center">S.No.</th>
                    <th width="44%">
                        <a class="cursor-pointer aws-h-a " style="color: black;" onclick="javascript:sortresult('CategoryName');">
                            Category Name @if (sortcolumn == "CategoryName")
                            {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                        </a>
                    </th>
                    <th style="text-align:center" width="10%">
                        <a class="cursor-pointer aws-h-a " style="color: black;" onclick="javascript:sortresult('VolunteerHours');">
                            Volunteer Hours @if (sortcolumn == "VolunteerHours")
                            {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                        </a>
                    </th>
                    <th style="text-align:center" width="10%">
                        <a class="cursor-pointer aws-h-a " style="color: black;" onclick="javascript:sortresult('OrderNo');">
                            Order No @if (sortcolumn == "OrderNo")
                            {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                        </a>
                    </th>
                    <th style="text-align:center" width="12%">
                        <a onclick="javascript:sortresult('IsActive');">
                            IsActive @if (sortcolumn == "IsActive")
                            {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                        </a>
                    </th>

                    <th width="10%">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (lstVolunteerCategories.Count != 0)
                {
                    int i = 0;
                    foreach (var item in lstVolunteerCategories)
                    {
                <tr>
                    <td style="text-align:center">@item.RId</td>
                    <td style="text-align: left">@item.CategoryName</td>

                    @*<td style="text-align: left">@item.ChapterName</td>*@
                    <td style="text-align:center">
                        <span style="font-weight:bold;"> @item.VolunteerHours <span>Hrs</span></span>
                        </td>
                    <td style="text-align:center">
                        <input type="text" style="width:50px;margin-bottom:0px;" maxlength="3" id="OrderNo@(i)" value="@item.OrderNo" onkeypress="return Common.isNumberKey(event)" />
                        <a onclick="UpdateOrderNo(@i,@item.VolunteerCategoryId);" title="Update"><i class="fa fa-fw fa-refresh"></i></a>

                    </td>

                    <td style="text-align:center;">
                        <div class="menu-hover">
                            @{ var isChecked = item.IsActive ? "checked" : ""; }
                            @{var titleValue = item.IsActive ? "Active" : "Disabled";}

                            <div>
                                <label class="switch" title="@titleValue">
                                    <input type="checkbox" onclick="VolunteerCategoriesStatus(@item.VolunteerCategoryId)" @isChecked>
                                    <span class="slider"></span>
                                </label>
                            </div>
                        </div>
                    </td>
                    <td style="text-align:center">
                        <div class="table-actions d-flex align-items-center gap-3 fs-6">
                            @if (ViewBag.IsEdit == true )
                            {
                                <a class="text-warning cursor-pointer" onclick="VolunteerCategoriesEdit(@item.VolunteerCategoryId);" title=" Edit" aria-label="Edit"><i class="bi bi-pencil-fill"></i></a>
                            }
                            @if (ViewBag.IsDelete == true )
                            {
                                <a class="text-danger cursor-pointer" onclick="Delete(@item.VolunteerCategoryId);" title="Delete" aria-label="Delete"><i class="bi bi-trash-fill"></i></a>
                            }
                        </div>
                    </td>
                </tr>
                        i++;
                    }

                }
                else
                {
                    <tr class="odd"><td valign="top" colspan="10" class="font-14 text-center">No Records found</td></tr>
                }
            </tbody>
        </table>
    </div>



    <div class="row pt-3">
        <div class="col-sm-4 col-md-5">
            <div class="dataTables_info" id="example_info" role="status" aria-live="polite">
                Showing @((PageNo * Items) - (Items - 1)) - @((PageNo * Items) > Total ? Total : (PageNo * Items)) of @Total entries
            </div>
        </div>
        <div class="col-sm-3 col-md-7 " @(Total > 0 ? "" : "disable")>
            <div class="d-flex flex-wrap gap-4 justify-content-end">

                <div class="dataTables_paginate paging_simple_numbers" id="example_paginate">
                    @Html.Raw(AWS_AssociationToolCore.BLL.Common.SetPaging((Int64)ViewBag.items, ref Total, (Int64)ViewBag.pageno, "pagination pb-0"))
                </div>
            </div>
        </div>
    </div>

</div>
<style>
    .aws-h-a {
        text-decoration: none;
        position: relative;
    }

        .aws-h-a::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            bottom: -2px;
            border-bottom: 2px solid #0756ca;
            transform: scaleX(0);
            transition: transform 0.3s ease;
        }

        .aws-h-a:hover::after {
            transform: scaleX(1);
        }
</style>