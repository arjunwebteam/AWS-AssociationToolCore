@using AWS_AssociationToolCore.BLL

@using System.Configuration;
@{ Layout = null;}
@{
    string sortcolumn = (string)ViewBag.sortcolumn;
    string sortorder = (string)ViewBag.sortorder;
    Int64 Total = (Int64)ViewBag.total;
    var PageNo = (Int64)ViewBag.pageno;
    var Items = (Int64)ViewBag.items;
    var ChapterId = ViewBag.ChapterId;

    List<AWS_AssociationToolCore.Entities.PerformanceCategory> lstPerformanceCategorylist = ViewBag.PerformanceCategorylist;

    string userRole = Context.Session.GetString("userrole") ?? string.Empty;
}

<script type="text/javascript">

    function PerformanceCategoryStatus(PerformanceCategoryID) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("PerformanceCategoryStatus", "PerformanceCategory")', 
            data: { PerformanceCategoryID: PerformanceCategoryID }, // optional data
            datatype: "JSON",
            success: function (result) {
                showLobiboxNotification(result.messageType, result.message);
                if (result.ok) {
                    PerformanceCategoryBind($('#hdnPageNo').val());
                }
                else {
                    $('#divmessage').html(result.data);
                    $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                }
            }
        });
    }

    function DeletePerformanceCategory(PerformanceCategoryID) {
        var val2 = confirm("Do you want to delete this record?");
        if (val2) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("DeletePerformanceCategory", "PerformanceCategory")', 
                data: { PerformanceCategoryID: PerformanceCategoryID }, 
                success: function (result) {
                    showLobiboxNotification(result.messageType, result.message);
                    if (result.ok) {
                        PerformanceCategoryBind($('#hdnPageNo').val());
                    }
                    else {
                        //$('#divmessage').html(result.data);
                        //$('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                    }
                },
            });
        }
    }

    function UpdateOrderNo(i, PerformanceCategoryID) {
        var OrderNo = parseInt($('#OrderNo' + i).val());
        $.ajax({
            type: 'POST',
            url: '@Url.Action("PerformanceCategoryOrderNo", "PerformanceCategory")',
            data: { OrderNo: OrderNo, PerformanceCategoryID: PerformanceCategoryID },
            success: function (result) {
                showLobiboxNotification(result.messageType, result.message);
                var div = '';
                if (result.ok) {
                    PerformanceCategoryBind(1);
                }
                else {
                    $('#divmessage').html(result.data);
                    $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                }
            }
        });
    }
</script>


<div class="card-body">
    <div class="table-responsive">

        @if (Total == -1)
        {
            <div class="norecords">Sorry failed processing your request.</div>
        }
        else
        {
            <table class="table table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th width="8%" class="text-center">S.No</th>
                        <th>
                            <a style="color: black;" onclick="javascript:sortresult('CategoryName');" class="white-t-u aws-h-a">
                                Category Name @if (sortcolumn == "CategoryName")
                                {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                            </a>
                        </th>
                        <th style="text-align: center;"> # </th>
                        <th>
                            <a style="color: black;" onclick="javascript:sortresult('MemberAmount');" class="white-t-u aws-h-a">
                                Member Amount @if (sortcolumn == "MemberAmount")
                                {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                            </a>
                        </th>
                        <th>
                            <a style="color: black;" onclick="javascript:sortresult('NonMemberAmount');" class="white-t-u aws-h-a">
                                Non-Member Amount @if (sortcolumn == "NonMemberAmount")
                                {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                            </a>
                        </th>
                        <th width="15%">
                            <a style="color: black;" onclick="javascript:sortresult('OrderNo');" class="white-t-u aws-h-a">
                                Order No @if (sortcolumn == "OrderNo")
                                {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                            </a>

                        </th>
                        <th width="15%">
                            <a style="color: black;" onclick="javascript:sortresult('UpdatedDate');" class="white-t-u aws-h-a">
                                Posted Date @if (sortcolumn == "UpdatedDate")
                                {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                            </a>
                        </th>
                        <th width="8%">Status</th>

                        <th class="text-center" width="80">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (lstPerformanceCategorylist.Count != 0)
                    {
                        int i = 0;
                        foreach (var item in lstPerformanceCategorylist)
                        {
                    <tr>
                        <td align="center">@item.RId</td>
                                <td>@item.CategoryName</td>
                                <td><a href="@Url.Action("Index", "CulturalRegistrations", new { CategoryName = item.CategoryName, mid = 58 })">Cultural Registrations</a> - (@item.cultureCount)</td>

                        <td>@item.MemberAmount</td>
                        <td>@item.NonMemberAmount</td>
                        <td>
                            <input type="text" maxlength="3" style="width:50px;" id="OrderNo@(i)" value="@item.OrderNo" onkeypress="return Common.isNumberKey(event)" />
                            <a onclick="UpdateOrderNo(@i,@item.PerformanceCategoryID);" title="Update"><i class="fa fa-fw fa-refresh"></i></a>
                        </td>
                        <td>@(item.UpdatedDate != null && item.UpdatedDate != DateTime.MinValue ? item.UpdatedDate.ToAppDate()  : "N/A")</td>
                        <td>
                            <div class="menu-hover">
                                @{ var isChecked = item.IsActive ? "checked" : ""; }
                                @{var titleValue = item.IsActive ? "Active" : "Disabled";}

                                <div>
                                    <label class="switch" title="@titleValue">
                                        <input type="checkbox" onclick="PerformanceCategoryStatus(@item.PerformanceCategoryID)" @isChecked>
                                        <span class="slider"></span>
                                    </label>
                                </div>
                            </div>
                        </td>
                        <td class="text-center">
                            <div class="table-actions d-flex align-items-center gap-3 fs-6">
                                @if (ViewBag.IsEdit == true || userRole.Contains("SuperAdmin") || userRole.Contains("DeveloperAdmin"))
                                {
                                    <a class="text-warning cursor-pointer" onclick="EditPerformanceCategory(@item.PerformanceCategoryID);" title=" Edit" aria-label="Edit"><i class="bi bi-pencil-fill"></i></a>
                                }
                                @if (ViewBag.IsDelete == true || userRole.Contains("SuperAdmin") || userRole.Contains("DeveloperAdmin"))
                                {
                if (item.cultureCount == 0)
                {
                                                <a class="text-danger cursor-pointer" onclick="DeletePerformanceCategory(@item.PerformanceCategoryID);" title="Delete" aria-label="Delete"><i class="bi bi-trash-fill"></i></a>
                                            }
                                            else
                                            {
                                                <a class="sepV_a disable-alpha cursor-pointer" style="color: #79818b" title="This Category has Registrations"><i class="bi bi-trash-fill"></i></a>


                                            }
                                        }
                            </div>
                        </td>
                    </tr>
                            i++;
                        }
                    }
                    else
                    {
                        <tr class="odd"><td valign="top" colspan="10" class="font-14 text-center">No  Records found</td></tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="row pt-3">
        <div class="col-sm-4 col-md-5">
            <div class="dataTables_info" id="example_info" role="status" aria-live="polite">
                Showing @((PageNo * Items) - (Items - 1)) - @((PageNo * Items) > Total ? Total : (PageNo * Items)) of @Total entries
            </div>
        </div>
        <div class="col-sm-3 col-md-7 " @(Total > 0 ? "" : "disable")>
            <div class="d-flex flex-wrap gap-4 justify-content-end">
                <div class="dataTables_length" id="example_length">
                    <div class="d-flex align-items-center gap-2 pt-1">
                        <span>Show Items</span>
                        <select id="txtitems" name="txtitems" aria-controls="example" onchange="ThemeBannerBind();" class="form-select form-select-sm w-auto">
                            <option @(Items == 25 ? "selected=selected" : "") value="25">25</option>
                            <option @(Items == 50 ? "selected=selected" : "") value="50">50</option>
                            <option @(Items == 75 ? "selected=selected" : "") value="75">75</option>
                            <option @(Items == 100 ? "selected=selected" : "") value="100">100</option>
                        </select>
                    </div>
                </div>
                <div class="dataTables_paginate paging_simple_numbers" id="example_paginate">
                    @Html.Raw(AWS_AssociationToolCore.BLL.Common.SetPaging((Int64)ViewBag.items, ref Total, (Int64)ViewBag.pageno, "pagination pb-0"))
                </div>
            </div>
        </div>
    </div>



</div>
<style>
    .aws-h-a {
        text-decoration: none;
        position: relative;
    }

        .aws-h-a::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            bottom: -2px;
            border-bottom: 2px solid #0756ca;
            transform: scaleX(0);
            transition: transform 0.3s ease;
        }

        .aws-h-a:hover::after {
            transform: scaleX(1);
        }
</style>
