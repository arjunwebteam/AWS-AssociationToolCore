@{
    ViewBag.Title = "AddPhoto";

    int status1 = 0;
    ViewBag.Pageheading = "Add Photo";
    Layout = "~/Areas/Admin/Views/Shared/_MainLayout.cshtml";
    AWS_AssociationToolCore.BLL.AppInfo _appinfo = new AWS_AssociationToolCore.BLL.AppInfo();
    AWS_AssociationToolCore.Entities.AppInfo objAppInfo = _appinfo.GetAppInfoDetails(ref status1);
    List<AWS_AssociationToolCore.Entities.PhotoCategories> lstPhotoCategories = ViewBag.lstPhotoCategories;
    Int64 PhotoCategoryId = ViewBag.PhotoCategoryId;
    AWS_AssociationToolCore.Entities.Photos objPhotos = ViewBag.objPhotos;

    int status = 0;
    AWS_AssociationToolCore.BLL.PhotosImageSettings _PhotosImageSettings = new AWS_AssociationToolCore.BLL.PhotosImageSettings();
    AWS_AssociationToolCore.Entities.PhotosImageSettings objPhotosImageSettings = new AWS_AssociationToolCore.Entities.PhotosImageSettings();
    objPhotosImageSettings = _PhotosImageSettings.GetPhotosImageSettingsDetails(ref status);
    var imglocNormal = objAppInfo.BaseUrl + "Content/photogallery/thumbphoto/";
    var Test = objPhotosImageSettings.Photosize; // Assuming objPhotosImageSettings.Eventsize is a string
    var parts = Test.Split('*');
    int value1 = 0;
    int value2 = 0;


    if (parts.Length == 2)
    {
        value1 = int.Parse(parts[0]);
        value2 = int.Parse(parts[1]);

        // Now you can use value1 and value2 as integers
    }
    else
    {
        // Handle the case where the split didn't produce two parts
        // This could happen if the input string doesn't contain '*'
        // or if there are more than one '*' characters in the string
    }





}

<script type="text/javascript">
    $(document).ready(function () {
        $('#wGallery, #wPhotoGallery').addClass('active');
        $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
        $('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');

