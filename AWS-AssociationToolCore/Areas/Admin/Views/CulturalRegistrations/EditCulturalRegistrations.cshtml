        function awsAddRow() { addRow($('.child-row').length); }
    function addRow(index) {
        var newRow = '<div class="child-row row gx-2 align-items-center">' +
            '<div class="col-md-4"><fieldset><legend class="float-none w-auto px-1">First Name</legend>' +
            '<input class="input-box" type="text" name="[' + index + '].FirstName" placeholder="First Name"></fieldset></div>' +
            '<div class="col-md-3"><fieldset><legend class="float-none w-auto px-1">Last Name</legend>' +
            '<input class="input-box" type="text" name="[' + index + '].LastName" placeholder="Last Name"></fieldset></div>' +
            '<div class="col-md-3"><fieldset><legend class="float-none w-auto px-1">Email</legend>' +
            '<input class="input-box" type="text" name="[' + index + '].Email" placeholder="Email"></fieldset></div>' +
            '<div class="col-md-2"><a class="aws-remove-btn" onclick="deleteRow(this)"><i class="bi bi-trash3"></i> Remove</a></div>' +
            '</div>';
        $('#childinfo').append(newRow);
    }
    function PaymentMethodBind() {
      
        var PaymentMethod = document.getElementById("PaymentMethodId").value;

        //var PaymentMethod = $('#PaymentMethodId').val();
        if (PaymentMethod == 3) {

            $('#ChequeHolderNamehide').show()
            $('#ZellePartnerNamehide').hide()
        }
        else if (PaymentMethod == 6) {
            $('#ChequeHolderNamehide').hide()
            $('#ZellePartnerNamehide').show()
        }
        else {
            $('#ChequeHolderNamehide').hide()
            $('#ZellePartnerNamehide').hide()
        }
    }

    function paymentbind(type) {
        $('#PaymentType').val(type);
    }
    function scrollToSection() {
        $('#ServicesHistoryhide').show();
        const targetElement = document.getElementById("ServicesHistoryhide");
        if (targetElement) {
            const offset = 100; // Adjust as needed for headers
            const elementPosition = targetElement.getBoundingClientRect().top;
            const offsetPosition = elementPosition + window.pageYOffset - offset;

            window.scrollTo({
                top: offsetPosition,
                behavior: "smooth"
            });
        } else {
            console.error("Element with id 'DonationHistoryhide' not found.");
        }
    }
</script>
