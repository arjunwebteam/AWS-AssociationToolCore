<script>
    $(document).ready(function () {
        LoadEventsList();
        PagerClickBind();
    });

    function LoadEventsList() {
        $.ajax({
            type: "GET",
            url: '@Url.Action("CulturalRegistrationsList", "CulturalRegistrations")',
            data: {
                IsEdit    : '@IsEdit',
                IsView    : '@IsView',
                IsDelete  : '@IsDelete',
                IsExport  : '@IsExport',
                IsAdd     : '@IsAdd',
                EventId:    '@EventId',
                CategoryName:    '@CategoryName',

                Mid       : '@Mid',           // ✅ uses Mid variable not ViewBag.mid
                ChapterId : '@(ChapterId == 0 ? 1 : ChapterId)'
            },
            success: function (data) {
                $("#divDetails").html(data);
            },
            error: function () {
                $("#divDetails").html('<p class="text-danger">Failed to load events.</p>');
            }
        });
    }      function PagerClickBind() {
            $(document).off("click", ".pagination .page-link").on("click", ".pagination .page-link", function () {
                var id = $(this).attr("id");
                var pageNo;

                if (id === "Previous" || id === "Next") {
                    pageNo = parseInt($(this).data("page"));
                } else {
                    pageNo = parseInt(id);
                }

                if (!pageNo || isNaN(pageNo) || pageNo < 1) return;

                $('#hdnPageNo').val(pageNo);
                    Onload(pageNo);
            });
        }

</script>

