}


    var chapterId = '@ViewBag.ChapterId';

    // ================= Export to Excel =================
    // AppInfo.ExportExel value ("Selected" aithe modal, lekapothe direct all fields download)
    var exportMode = '@(objAppInfo?.ExportExel ?? "")';

    function BuildExportUrl(selectedFields) {
        var url = '@Url.Action("CulturalRegistrationsExportToExcel", "CulturalRegistrations")'
            + '?Search=' + encodeURIComponent($('#txtsearch').val() || '')
            + '&ChapterId=' + encodeURIComponent(chapterId || '0');
        if (selectedFields) {
            url += '&SelectedFields=' + encodeURIComponent(selectedFields);
        }
        return url;
    }

    function ExporttoExcel() {
        // "Selected" kakapothe modal open avvadu, direct ga all fields download
        if ((exportMode || '').toLowerCase() !== 'advacnce') {
            window.location.href = BuildExportUrl('');
            return;
        }

        $('#exportFieldsValidation').addClass('d-none');
        $('#exportFieldsList').html('<div class="text-center text-muted py-4">Loading fields...</div>');
        $('#exportFieldsModal').modal('show');

        $.ajax({
            url: '@Url.Action("GetCulturalRegistrationExportFields", "CulturalRegistrations")',
            type: 'GET',
            cache: false,
            data: { ChapterId: chapterId || 0 },
            success: function (result) {
                if (!result.ok) {
                    $('#exportFieldsList').html('<div class="text-danger">' + result.message + '</div>');
                    return;
                }

                // section wise group chey
                var groups = {}, order = [];
                $.each(result.data, function (i, f) {
                    var key = f.fieldKey !== undefined ? f.fieldKey : f.FieldKey;
                    var name = f.displayName !== undefined ? f.displayName : f.DisplayName;
                    var sec = (f.section !== undefined ? f.section : f.Section) || 'Fields';
                    if (!groups[sec]) { groups[sec] = []; order.push(sec); }
                    groups[sec].push({ key: key, name: name });
                });

                var html = '';
                $.each(order, function (s, sec) {
                    html += '<div class="exp-section-title">' + sec + '</div><div class="exp-grid">';
                    $.each(groups[sec], function (i, f) {
                        html += '<label class="exp-item"><span>' + f.name + '</span>'
                              + '<input type="checkbox" class="export-field-chk" value="' + f.key + '" checked></label>';
                    });
                    if (groups[sec].length % 2 === 1) { html += '<div class="exp-item exp-filler"></div>'; }
                    html += '</div>';
                });

                $('#exportFieldsList').html(html || '<div class="text-muted">No exportable fields found.</div>');
            },
            error: function () {
                $('#exportFieldsList').html('<div class="text-danger">Failed to load export fields.</div>');
            }
        });
    }

    function ExportFieldsSelectAll(state) {
        $('.export-field-chk').prop('checked', state);
    }

    function ExportSelectedFieldsToExcel() {
        var selected = $('.export-field-chk:checked').map(function () { return this.value; }).get();
        if (selected.length === 0) {
            $('#exportFieldsValidation').removeClass('d-none');
            return;
        }
        $('#exportFieldsValidation').addClass('d-none');
        $('#exportSpinner').removeClass('d-none');
        $('#btnExportToExcel').prop('disabled', true);

        window.location.href = BuildExportUrl(selected.join(','));

        // file download navigation kabatti callback undadu, konchem tarvata reset chestam
        setTimeout(function () {
            $('#exportSpinner').addClass('d-none');
            $('#btnExportToExcel').prop('disabled', false);
            $('#exportFieldsModal').modal('hide');
        }, 1500);
    }

