@{
    ViewBag.Title = "Index";
    ViewBag.Pageheading = "Add CUltural Registrations";
    Layout = "~/Areas/Admin/Views/Shared/_MainLayout.cshtml";

    var catlist = (List < AWS_AssociationToolCore.Entities.CulturalRegistrations>)ViewBag.catlist;

    var eventlist = (List<AWS_AssociationToolCore.Entities.Events>)ViewBag.eventlist;

    Int64 EventId = ViewBag.EventId;



    string userRole = Context.Session.GetString("userrole") ?? string.Empty;

    bool IsEdit = ViewBag.IsEdit;
    bool IsView = ViewBag.IsView;
    bool IsDelete = ViewBag.IsDelete;
    bool IsExport = ViewBag.IsExport;
    bool IsAdd = ViewBag.IsAdd;
    Int64 Mid = ViewBag.mid;
}
<script>
    $(document).ready(function () {
        LoadEventsList();
    });

    function LoadEventsList() {
        $.ajax({
            type: "GET",
            url: '@Url.Action("VolunteersList", "Volunteers")',
            data: {
                IsEdit    : '@IsEdit',
                IsView    : '@IsView',
                IsDelete  : '@IsDelete',
                IsExport  : '@IsExport',
                IsAdd     : '@IsAdd',
                Mid       : '@Mid',           // ✅ uses Mid variable not ViewBag.mid
            },
            success: function (data) {
                $("#divDetails").html(data);
            },
            error: function () {
                $("#divDetails").html('<p class="text-danger">Failed to load events.</p>');
            }
        });
    }
</script>
<script type="text/javascript">

    $(document).ready(function () {
        $('#wVolunteer, #wVolunteers').addClass('active');
        $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
        $('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
        PagerClickBind();
    });

    function sortresult(sortcolumn) {
        $('#hdnsortorder').val(($('#hdnsortorder').val() == 'ASC' ? 'DESC' : 'ASC'));
        $('#hdnsortcolumn').val(sortcolumn);
        VolunteerBind(1);
    }

    function VolunteerView(VolunteerId) {
        $.ajax({
            url: '@Url.Action("EditVolunteer", "Volunteers")',
            type: 'POST',
            data: { VolunteerId: VolunteerId },
            datatype: "JSON",
            success: function (result) {
                if (result.ok) {
                    var objInnerPageCategory = result.data;
                    $('#lblCategoryName').html(objInnerPageCategory.CategoryName);

                    $("#InnerPageCategoryView").dialog("open");

                }
                else {
                    alert(result.data);
                }
            }
        });

    }
    function VolunteerBind(Pageno) {

        var pageno = Common.Pageno(Pageno);
        var sortcolumn = $('#hdnsortcolumn').val();
        var sortorder = $('#hdnsortorder').val();
        var items = $('#txtitems').val();
        var Search = $('#txtsearch').val().trim();
        var catid = $('#VolunteerCategoryId').val();
        var eventid = $('#EventId').val();

        $.ajax({
            url: '@Url.Action("VolunteersList", "Volunteers")',
            type: 'GET',
            cache: false,
            data: { Search: Search, PageNo: pageno, SortColumn: sortcolumn, SortOrder: sortorder, Items: items, VolunteerCategoryId: catid, EventId: eventid, IsEdit: '@IsEdit', IsView: '@IsView', IsDelete: '@IsDelete', IsExport: '@IsExport', IsAdd: '@IsAdd', Mid: '@Mid'},
            success: function (result) {
                $('#divDetails').html(result);
                PagerClickBind();
            }
        });
    }

    function Delete(VolunteerId) {
        var val2 = confirm("Do you want to delete this record?");
        if (val2) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("DeleteVolunteer", "Volunteers")',  // the URL of the controller action method
                data: { VolunteerId: VolunteerId }, // optional data
                success: function (result) {
                    showLobiboxNotification(result.messageType, result.message);
                    VolunteerBind(1);
                },
                error: function (req, status, error) {
                    $("#divmessage").html(result.data);
                    $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                }
            });
        }
    }
    function VolunteerStatus(VolunteerId) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Volunteerstatus", "Volunteers")',  // the URL of the controller action method
                data: { VolunteerId: VolunteerId }, // optional data
                success: function (result) {
                    showLobiboxNotification(result.messageType, result.message);
                    VolunteerBind(1);
                },
                error: function (req, status, error) {
                    $("#divmessage").html(result.data);
                    $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                }
            });
    }


    function PagerClickBind() {
        $(".pagination a").bind("click", function () {
            VolunteerBind($(this).text());
        });
    }

    function SearchClear() {
        $('#txtsearch').val('');
        VolunteerBind(1);
    }
    function ClearSearch() {
        $('#txtsearch').val('');
        $('#VolunteerId').val('');
        $('#hdnPageNo').val(1);
        $('#VolunteerCategoryId').val('').trigger('change');
        $('#EventId').val('');
        VolunteerBind(1);
    }

    function ExporttoExcel() {
        window.location.href = "Volunteers/VolunteersExporttoExcel?Search=" + $('#txtsearch').val() + "&VolunteerCategoryId=" + $('#VolunteerCategoryId').val()  + "&EventId=" + $('#EventId').val() + "";
    }


</script>

<input id="hdnPageNo" type="hidden" value="1" />
<input id="hdnsortcolumn" type="hidden" value="UpdatedDate" />
<input id="hdnsortorder" type="hidden" value="Desc" />


<div class="card">
    <div class="card-header py-3 mb-3">
        <div class="row gx-2">
            <div class="col-lg-2 col-md-6 col-8">
                <div class="input-box">
                    <label class="form-label">Search  <span class="text-danger"></span></label>
                    <div class="input-group mb-3">
                        <input type="text" class="form-control" name="txtsearch" id="txtsearch" placeholder="Name">
                    </div>
                </div>
            </div>


            <div class="col-lg-2 col-2" id="clearhide">
                <div>
                    <label>&nbsp;</label>
                </div>
                <button type="button" class="btn btn-primary px-3" onclick="VolunteerBind(1);">Search</button>
                <button type="button" class="btn btn-danger px-3" onclick="ClearSearch();">Clear</button>
            </div>


            <div class="col-lg-2 col-6">
                <div class="btn-align">
                    @if (IsAdd == true || userRole.Contains("SuperAdmin") || userRole.Contains("DeveloperAdmin"))
                    {
                        <a class="btn btn-primary" onclick="ExporttoExcel();" style="white-space: nowrap;">Export Details to Excel</a>
                    }
                </div>
            </div>



            <div class="clearfix row">

            </div>

        </div>

        <div class="clearfix row"></div>




    </div>
    <div id="divDetails" class="box-body table-responsive">
@*         @{Html.RenderAction("VolunteersList", "Volunteers", new { IsEdit = IsEdit, IsView = IsView, IsDelete = IsDelete, IsExport = IsExport, IsAdd = IsAdd, Mid = Mid });}
 *@    </div>
</div>