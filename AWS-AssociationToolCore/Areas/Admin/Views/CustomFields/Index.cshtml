@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewBag.Title = "Index";
    ViewBag.Pageheading = "Custom Fields";
    Layout = "~/Areas/Admin/Views/Shared/_MainLayout.cshtml";

    var formlist = (List<AWS_AssociationToolCore.Entities.FormMaster>)ViewBag.Forms;

    string userRole = Context.Session.GetString("userrole") ?? string.Empty;

    bool IsEdit = ViewBag.IsEdit;
    bool IsView = ViewBag.IsView;
    bool IsDelete = ViewBag.IsDelete;
    bool IsAdd = ViewBag.IsAdd;
    Int64 Mid = ViewBag.mid;
    Int64 SelectedFormId = ViewBag.SelectedFormId;
}

<script type="text/javascript">

    $(document).ready(function () {
        $('#wCustomFields, #wForms').addClass('active');
        $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
        $('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
        PagerClickBind();
    });

    function sortresult(sortcolumn) {
        $('#hdnsortorder').val(($('#hdnsortorder').val() == 'ASC' ? 'DESC' : 'ASC'));
        $('#hdnsortcolumn').val(sortcolumn);
        CustomFieldBind(1);
    }

    function CustomFieldBind(Pageno) {

        var pageno = Common.Pageno(Pageno);
        var sortcolumn = $('#hdnsortcolumn').val();
        var sortorder = $('#hdnsortorder').val();
        var items = $('#txtitems').val();
        var Search = $('#txtsearch').val().trim();
        var formid = $('#FormId').val();

        $.ajax({
            url: '@Url.Action("List", "CustomFields")',
            type: 'GET',
            cache: false,
            data: { Search: Search, PageNo: pageno, SortColumn: sortcolumn, SortOrder: sortorder, Items: items, formId: formid, IsEdit: '@IsEdit', IsView: '@IsView', IsDelete: '@IsDelete', IsAdd: '@IsAdd', Mid: '@Mid' },
            success: function (result) {
                $('#divDetails').html(result);
                PagerClickBind();
            }
        });
    }

  


        function Delete(CustomFieldId) {
        var val2 = confirm("Do you want to delete this record?");
        if (val2) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Delete", "CustomFields")',
                data: { id: CustomFieldId },
                success: function (result) {
                    showLobiboxNotification(result.messageType, result.message);
                    CustomFieldBind(1);
                },
                error: function (xhr, status, error) {
                    console.error('Delete failed:', xhr.status, xhr.responseText);
                    showLobiboxNotification('error', 'Failed to delete record.');
                }
            });
        }
    }





    function CustomFieldStatus(CustomFieldId, isActive) {
        $.ajax({
            type: "POST",
            url: '@Url.Action("UpdateStatus", "CustomFields")',
            data: { id: CustomFieldId, isActive: isActive },
            success: function (result) {
                showLobiboxNotification(result.messageType, result.message);
                CustomFieldBind(1);
            },
            error: function (req, status, error) {
                $("#divmessage").html(result.data);
                $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
            }
        });
    }

       function PagerClickBind() {
        $(".pagination a").off("click").on("click", function (e) {
            e.preventDefault();
            CustomFieldBind($(this).text());
        });
    }

    function SearchClear() {
        $('#txtsearch').val('');
        CustomFieldBind(1);
    }

    function ClearSearch() {
        $('#txtsearch').val('');
        $('#hdnPageNo').val(1);
        $('#FormId').val('').trigger('change');
        CustomFieldBind(1);
    }

</script>

<input id="hdnPageNo" type="hidden" value="1" />
<input id="hdnsortcolumn" type="hidden" value="DisplayOrder" />
<input id="hdnsortorder" type="hidden" value="Asc" />


<div class="card">
    <div class="card-header py-3 mb-3">
        <div class="row gx-2">
            <div class="col-lg-3 col-md-6 col-8">
                <div class="input-box">
                    <label class="form-label"> Form :<span class="text-danger"></span></label>
                    <select class="single-select" name="FormId" id="FormId" onchange="CustomFieldBind(1);">
                        <option value="">-- All Forms --</option>
                        @if (formlist != null)
                        {
                            foreach (var item in formlist)
                            {
                                <option value="@item.FormId" selected="@(SelectedFormId == item.FormId ? "selected" : null)">@item.FormName</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <div class="col-lg-2 col-md-6 col-8">
                <div class="input-box">
                    <label class="form-label">Search  <span class="text-danger"></span></label>
                    <div class="input-group mb-3">
                        <input type="text" class="form-control" name="txtsearch" id="txtsearch" placeholder="Field Label/Field Name">
                    </div>
                </div>
            </div>

            <div class="col-lg-2 col-2" id="clearhide">
                <div>
                    <label>&nbsp;</label>
                </div>
                <button type="button" class="btn btn-primary px-3" onclick="CustomFieldBind(1);">Search</button>
                <button type="button" class="btn btn-danger px-3" onclick="ClearSearch();">Clear</button>
            </div>

            <div class="col-lg-2 col-4 text-end ms-auto">
                <div class="btn-align">
                    
                        <a href="@Url.Action("Create", "CustomFields")" class="btn btn-primary">Add Custom Field</a>
                    
                </div>
            </div>

        </div>
    </div>
    <div id="divDetails" class="box-body table-responsive">
    </div>
    <script>
        $(document).ready(function () {
            $.ajax({
                type: "GET",
                url: '@Url.Action("List", "CustomFields")',
                data: {
                    formId: '@SelectedFormId',
                    IsEdit: '@IsEdit',
                    IsView: '@IsView',
                    IsDelete: '@IsDelete',
                    IsAdd: '@IsAdd',
                    Mid: '@Mid'
                },
                success: function (data) {
                    $("#divDetails").html(data);
                    PagerClickBind();
                },
                error: function () {
                    $("#divDetails").html('<p class="text-danger">Failed to load.</p>');
                }
            });
        });
    </script>
</div>
