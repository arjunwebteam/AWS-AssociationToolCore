    let paymentModeTimeout;
    $(document).off('change', '.mode-toggle').on('change', '.mode-toggle', function () {
        clearTimeout(paymentModeTimeout);

        var $this = $(this);
        paymentModeTimeout = setTimeout(function () {
            var isChecked = $this.is(':checked');
            var uniqueId = $this.data('id');
            var accountType = isChecked ? 'Online' : 'Test';

            $('#AccountType_' + uniqueId).val(accountType);

            var paymentSettingId = isChecked
                ? $('#PaymentSettingId_Online_' + uniqueId).val()
                : $('#PaymentSettingId_Test_' + uniqueId).val();

            $('#PaymentSettingId_' + uniqueId).val(paymentSettingId);

            PaymentMode(paymentSettingId, accountType, uniqueId);
        }, 300); // delay in ms
    });



    function PaymentMode(PaymentSettingId, AccountType, uniqueId) {
    $.ajax({
        type: "POST",
        url: '@Url.Action("UpdateMode", "PaymentSettings")',
        data: { PaymentSettingId: PaymentSettingId, AccountType: AccountType, PaymentMethodId: uniqueId },
        success: function (result) {
           showLobiboxNotification(result.messageType, result.message);
            $('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
            Onload($('#hdnPageNo').val(), PaymentSettingId, AccountType, uniqueId);
        },
        error: function (req, status, error) {
            $("#divmessage").html("An error occurred.");
            $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
        }
    });
}

