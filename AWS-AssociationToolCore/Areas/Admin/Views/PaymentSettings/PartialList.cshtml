<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".mode-toggle").forEach(function (toggle) {
            toggle.addEventListener("change", function (event) {
                // Wait for the DOM to register the checkbox state change
                setTimeout(() => {
                    var id = toggle.dataset.id;
                    var isTestMode = toggle.checked;

                    // Toggle input sections
                    document.querySelector(`.online-mode-${id}`).classList.toggle("d-none", isTestMode);
                    document.querySelector(`.test-mode-${id}`).classList.toggle("d-none", !isTestMode);

                    // Update hidden fields
                    var form = toggle.closest("form");
                    form.querySelector(`#AccountType_${id}`).value = isTestMode ? "Online" : "Test";

                    var settingId = isTestMode
                        ? document.getElementById(`PaymentSettingId_Test_${id}`).value
                        : document.getElementById(`PaymentSettingId_Online_${id}`).value;
                    form.querySelector(`#PaymentSettingId_${id}`).value = settingId;

                    // Update mode label (Live/Test) and class
                    const statusDisplay = form.closest('.payment_card').querySelector('.account-status-display');
                    if (isTestMode) {
                        statusDisplay.textContent = "Test";
                        statusDisplay.classList.remove("bg-light-success");
                        statusDisplay.classList.add("bg-light-danger");
                    } else {
                        statusDisplay.textContent = "Live";
                        statusDisplay.classList.remove("bg-light-danger");
                        statusDisplay.classList.add("bg-light-success");
                    }
                }, 0); // Delay to allow checkbox state to settle
            });
        });
    });



</script>


