@{

    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_MainLayout.cshtml";
    ViewBag.Pageheading = "Chapters";


    Int64 ChapterId = ViewBag.ChapterId;

    bool IsEdit = Convert.ToBoolean(Context.Session.GetString("IsEdit"));
    bool IsView = Convert.ToBoolean(Context.Session.GetString("IsView"));
    bool IsDelete = Convert.ToBoolean(Context.Session.GetString("IsDelete"));
    bool IsExport = Convert.ToBoolean(Context.Session.GetString("IsExport"));
    bool IsAdd = Convert.ToBoolean(Context.Session.GetString("IsAdd"));
    Int64 Mid = ViewBag.mid;


}
<script type="text/javascript">

    $(document).ready(function () {

        $('#wChapters').addClass('active');
        $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
        $('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
        PagerClickBind();

    });

    function sortresult(sortcolumn) {

        $('#hdnsortorder').val(($('#hdnsortorder').val() == 'ASC' ? 'DESC' : 'ASC'));
        $('#hdnsortcolumn').val(sortcolumn);
        ChaptersBind(1);
    }
        function ChaptersBind(Pageno) {

            var pageno = Common.Pageno(Pageno);
            var sortcolumn = $('#hdnsortcolumn').val();
            var sortorder = $('#hdnsortorder').val();
            var items = $('#txtitems').val();
            var Search = $('#txtsearch').val().trim();

            $.ajax({
                url: '@Url.Action("ChaptersList", "Chapters")',
                type: 'GET',
                cache: false,
                data: { Search: Search, PageNo: pageno, SortColumn: sortcolumn, SortOrder: sortorder, Items: items, ChapterId:@ChapterId,mid:@Mid, IsEdit: '@IsEdit', IsView: '@IsView', IsDelete: '@IsDelete', IsExport: '@IsExport', IsAdd: '@IsAdd'},
                success: function (result) {
                    $('#divDetails').html(result);
                    PagerClickBind();
                }
            });
        }
               function PagerClickBind() {
                $(document).off("click", ".pagination .page-link").on("click", ".pagination .page-link", function () {
                    var id = $(this).attr("id");
                    var pageNo;

                    if (id === "Previous" || id === "Next") {
                        pageNo = parseInt($(this).data("page"));
                    } else {
                        pageNo = parseInt(id);
                    }

                    if (!pageNo || isNaN(pageNo) || pageNo < 1) return;

                    $('#hdnPageNo').val(pageNo);
                            ChaptersBind(pageNo);
                });
            }
 function Delete(ChapterId) {
    if (!confirm("Do you want to delete this record?")) return;
    $.ajax({
        type: "POST",
        url: '@Url.Action("DeleteChapter", "Chapters")',
        data: {
            ChapterId: ChapterId,
            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
        },
        success: function (result) {
            if (result.ok) {
                showLobiboxNotification(result.messageType, result.message);
                ChaptersBind($('#hdnPageNo').val());
            } else {
                showLobiboxNotification(result.messageType, result.message);
            }
        },
        error: function (req, status, error) {
            showLobiboxNotification('error', 'Failed to delete. Please try again.');
            $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
        }
    });
}


    function SearchClear() {
        $('#txtsearch').val('');
        ChaptersBind(1);
    }
    function ClearSearch() {
        $('#txtsearch').val('');
        $('#InnerPageCategoryId').val('');
        $('#hdnPageNo').val(1);
        ChaptersBind(1);
    }
</script>

<input id="hdnPageNo" type="hidden" value="1" />
<input id="hdnsortcolumn" type="hidden" value="UpdatedDate" />
<input id="hdnsortorder" type="hidden" value="DESC" />



<div class="card">
    <!-- /.box-header -->
    <div class="card-header py-3 mb-3">
        <div class="row  gx-2">
            <div class="col-lg-3 col-md-6 col-8">
                <div class="input-box">
                    <label class="form-label">Search  <span class="text-danger"></span></label>
                    <div class="input-group mb-3">
                        <input type="text" class="form-control" name="txtsearch" id="txtsearch" placeholder="Chapter Name">
                        @*<span class="input-group-text pointer" style="cursor:pointer" onclick="ServiceDonationBind();" id="basic-addon1"><i class="bi bi-search"></i></span>*@
                    </div>
                </div>
            </div>
            <div class="col-lg-2 col-2" id="clearhide">
                <div>
                    <label>&nbsp;</label>
                </div>
                <button type="button" class="btn btn-primary px-3" onclick="ChaptersBind(1);">Search</button>
                <button type="button" class="btn btn-danger px-3" onclick="ClearSearch();">Clear</button>

            </div>

            @if (IsAdd == true)
            {
            <div class="col-lg-2 col-4 text-end ms-auto">
                <div class="btn-align">
                    <a data-toggle="modal" href="@Url.Action("AddChapter", "Chapters" ,new { mid=ViewBag.Mid })" class="btn btn-primary px-3 pull-right">Add Chapter</a>



                </div>
            </div>
            }
        </div>
    </div>

    <div id="divDetails" class="clearfix">


    </div>

    <script>
                $(document).ready(function () {
        LoadEventsList();
         PagerClickBind();
        });
              function LoadEventsList() {
            $.ajax({
                type : "GET",
                url  : '@Url.Action("ChaptersList", "Chapters")',
                data : {
                    IsEdit    : '@IsEdit',
                    IsView    : '@IsView',
                    IsDelete  : '@IsDelete',
                    IsExport  : '@IsExport',
                    IsAdd     : '@IsAdd',
                    Mid       : '@Mid',
                    ChapterId : '@(ChapterId == 0 ? 1 : ChapterId)'
                },
                success: function (data) {
                    $("#divDetails").html(data);
                },
                error: function () {
                    $("#divDetails").html('<p class="text-danger">Failed to load.</p>');
                }
            });
              }
    </script>


</div>
