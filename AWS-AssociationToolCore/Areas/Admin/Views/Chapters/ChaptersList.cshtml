@using System.Configuration
@using AWS_AssociationToolCore.BLL
@{ Layout = null;}
@{
    string sortcolumn = (string)ViewBag.sortcolumn;
    string sortorder = (string)ViewBag.sortorder;
    Int64 Total = (Int64)ViewBag.total;
    var PageNo = (Int64)ViewBag.pageno;
    var Items = (Int64)ViewBag.items;


    List<AWS_AssociationToolCore.Entities.Chapters> lstDetails = ViewBag.lstChapters;

    string userRole = Context.Session.GetString("userrole") ?? string.Empty;
}

<script type="text/javascript">

    function Chapterstatus(ChapterId) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("Chapterstatus", "Chapters")', // the URL of the controller action method
            data: { ChapterId: ChapterId }, // optional data
            datatype: "JSON",
            success: function (result) {
                showLobiboxNotification(result.messageType, result.message);
                if (result.ok) {
                    ChaptersBind($('#hdnPageNo').val());
                }
                else {
                    $('#divmessage').html(result.data);
                    $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                }
            }
        });
    }




     function UpdateDisplayOrder(i, ChapterId) {
        var DisplayOrder = parseInt($('#DisplayOrder' + i).val());
        $.ajax({
            type: 'POST',
            url: '@Url.Action("ChapterDisplayOrder", "Chapters")',
            data: { DisplayOrder: DisplayOrder, ChapterId: ChapterId },
            success: function (result) {
                showLobiboxNotification(result.messageType, result.message);
                var div = '';
                if (result.ok) {

                    ChaptersBind(1);
                }
                else {
                    $("#divmessage").html(result.data);
                    $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                }
            }
        });
    }
</script>

<div class="card-body">
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th width="5%" style="text-align: center">S.No.</th>
                    <th width="15%">
                        <a style="color: black;" onclick="javascript:sortresult('ChapterName');" class="white-t-u aws-h-a">
                            Chapter Name @if (sortcolumn == "ChapterName")
                            {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                        </a>

                    </th>
                    <th width="15%">
                        <a style="color: black;" onclick="javascript:sortresult('ShortName');" class="white-t-u aws-h-a">
                            Short Name @if (sortcolumn == "ShortName")
                            {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                        </a>
                    </th>
                    @*<th width="10%">
                            <a onclick="javascript:sortresult('City');" class="white-t-u">
                                City @if (sortcolumn == "City")
                                {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                            </a>
                        </th>
                        <th width="10%">
                            <a onclick="javascript:sortresult('State');" class="white-t-u">
                                State @if (sortcolumn == "State")
                                {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                            </a>
                        </th>*@
                    <th width="15%">
                        <a style="color: black;" onclick="javascript:sortresult('UpdatedDate');" class="white-t-u aws-h-a">
                            Posted Date @if (sortcolumn == "UpdatedDate")
                            {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                        </a>
                    </th>
                    <th width="10%">
                        <a style="color: black;" onclick="javascript:sortresult('OrderNo');" class="white-t-u aws-h-a">
                            Order No @if (sortcolumn == "OrderNo")
                            {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                        </a>
                    </th>
                    <th width="12%" style="text-align: center">
                        Status

                    </th>
                    <th width="10%" style="text-align: center">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (lstDetails.Count != 0)
                {
                    int i = 0;
                    var location = ConfigurationManager.AppSettings["usersiteurl"];
                    foreach (var item in lstDetails)
                    {
                        <tr>
                            <td style="text-align: center">@item.RId</td>
                            <td style="text-align: left" class="t-t-c">@item.ChapterName</td>
                            <td style="text-align: left" class="t-t-c">@item.ShortName</td>
                            @*<td style="text-align: left" class="t-t-c">@item.City</td>
                              <td style="text-align: left" class="t-t-c">@item.State</td>*@
                            <td style="text-align: left">@item.UpdatedDate.ToAppDate()</td>
                            <td >
                                <input type="text" maxlength="3" style="width: 50px; text-align: center;" id="DisplayOrder@(i)" value="@item.OrderNo" onkeypress="return Common.isNumberKey(event)" />
                                <a onclick="UpdateDisplayOrder(@i,@item.ChapterId);" title="Update"><i class="fa fa-fw fa-refresh"></i></a>

                            </td>

                            <td style="text-align: center">
                                <div class="menu-hover">
                                    @{ var isChecked = item.IsActive ? "checked" : ""; }
                                    @{var titleValue = item.IsActive ? "Active" : "Disabled";}
                                    <div>
                                        <label class="switch" title="@titleValue">
                                            <input type="checkbox" onclick="Chapterstatus(@item.ChapterId)" @isChecked>
                                            <span class="slider"></span>
                                        </label>
                                    </div>
                                </div>
                            </td>

                            <td style="text-align: center" class="t-t-c">
                                <div class="table-actions  gap-3 fs-6">
                                    @*@if (ViewBag.IsView == true || userRole.Contains("SuperAdmin") || userRole.Contains("DeveloperAdmin"))
                                        {
                                            <a class="text-primary cursor-pointer" href="@Url.Action("ViewChapter", "Chapters", new { ChapterId = item.ChapterId })" title="View" aria-label="Views"><i class="fa fa-eye"></i></a>
                                        }*@
                                    @if (ViewBag.IsEdit == true )
                                    {
                                        <a class="text-warning cursor-pointer" href="@Url.Action("EditChapter", "Chapters", new { ChapterId = item.ChapterId,mid = ViewBag.Mid })" title=" Edit" aria-label="Edit"><i class="bi bi-pencil-fill"></i></a>
                                    }
                                    @if (ViewBag.IsDelete == true)
                                    {
                                        <a class="text-danger cursor-pointer" onclick="javascript:Delete(@item.ChapterId);" title="Delete" aria-label="Delete"><i class="bi bi-trash-fill"></i></a>
                                    }
                                </div>
                            </td>
                        </tr>
                        i++;
                    }
                }
                else
                {
                    <tr>

                        <td class="norecords  text-center" colspan="8">No Records Found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="row pt-3">
        <div class="col-sm-4 col-md-5">
            <div class="dataTables_info" id="example_info" role="status" aria-live="polite">
                Showing @((PageNo * Items) - (Items - 1)) - @((PageNo * Items) > Total ? Total : (PageNo * Items)) of @Total entries
            </div>
        </div>
        <div class="col-sm-3 col-md-7 " @(Total > 0 ? "" : "disable")>
            <div class="d-flex flex-wrap gap-4 justify-content-end">

                <div class="dataTables_paginate paging_simple_numbers" id="example_paginate">
                    @Html.Raw(AWS_AssociationToolCore.BLL.Common.SetPaging((Int64)ViewBag.items, ref Total, (Int64)ViewBag.pageno, "pagination pb-0"))
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .aws-h-a {
        text-decoration: none;
        position: relative;
    }

        .aws-h-a::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            bottom: -2px;
            border-bottom: 2px solid #0756ca;
            transform: scaleX(0);
            transition: transform 0.3s ease;
        }

        .aws-h-a:hover::after {
            transform: scaleX(1);
        }
</style>