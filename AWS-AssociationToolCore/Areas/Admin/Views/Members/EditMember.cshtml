        var returnval = null;
        $.ajax({
            type: "POST",
            url: '@Url.Action("CheckProfileEmailAvailability", "Members")',
            data: { MemberId: userid, Email: email },
            datatype: "JSON",
            async: false,
            success: function (result) {
