            }
        });
        return returnval;
    }

    function CheckProfilePhoneNoAvailability(MobilePhone, userid) {
        var returnval = null;
        $.ajax({
            type: "POST",
            url: '@Url.Action("CheckProfilePhoneNoAvailability", "Members")',
            data: { MemberId: userid, MobilePhone: MobilePhone },
            datatype: "JSON",
            async: false,
            success: function (result) {
                if (result.ok) { returnval = result.data; }
            }
        });
        return returnval;
    }

    function Billing() {
        var type = $('#SameBilling').val();
        if (type == 'No') { $('#TTTD').show(); }
        else { $('#TTTD').hide(); }
    }

    function Insurance() {
        var type = $('#Field2').val();
        if (type == 'Yes') { $('#Beneficiary').show(); $('#University').show(); }
        else { $('#Beneficiary').hide(); $('#University').hide(); }
    }

    function NoofPaym() {
        var type = $('#FrequencyofDonation').val();
        if (type == 'OneTimeDonation') {
            $('#TAmount').hide(); $('#NoofPay').hide(); $('#TStarts').hide();
        } else {
            $('#TAmount').show(); $('#NoofPay').show(); $('#TStarts').show();
        }
    }

    function DonatAmount() {
        var type = $('#Donate').val();
        if (type == 'Yes') { $('#Frequency').show(); }
        else { $('#Frequency').show(); }
    }

    function AmountChange(AAmount) {
        $('#OtherAmount').attr('readonly', 'readonly');
        if (AAmount == 'Other') {
            $('#Amount').val('');
            $('#OtherAmount').removeAttr('readonly');
        } else {
            var mamt = $('#TMemberAmount').val();
            AAmount = parseFloat(AAmount) + parseFloat(mamt);
            $('#MemberAmount').val(AAmount);
            $('#total').html(AAmount);
            $('#OtherAmount').val('');
        }
    }

    function OtherNewAmount() {
        var OtherAmount = $('#OtherAmount').val();
        if (OtherAmount != '') {
            var mamt = $('#TMemberAmount').val();
            OtherAmount = parseFloat(OtherAmount) + parseFloat(mamt);
            $('#MemberAmount').val(OtherAmount);
            $('#total').html(OtherAmount);
        }
    }

    function PaymentMethodBind() {
        var PaymentMethod = document.getElementById("PaymentMethodId").value;
        if (PaymentMethod == 3) {
            $('#ChequeHolderNamehide').show();
            $('#ZellePartnerNamehide').hide();
        } else if (PaymentMethod == 6) {
            $('#ChequeHolderNamehide').hide();
            $('#ZellePartnerNamehide').show();
        } else {
            $('#ChequeHolderNamehide').hide();
            $('#ZellePartnerNamehide').hide();
        }
    }
</script>

<script type="text/javascript">
           $(document).ready(function () {
