    function formatPhoneNumber(number) {
        const cleanedNumber = number.replace(/\D/g, "");
        if (cleanedNumber.length < 10) return "Entered less than 10 digits.";
        if (cleanedNumber.length > 10) return "Entered more than 10 digits.";
        const areaCode = cleanedNumber.slice(0, 3);
        const firstThree = cleanedNumber.slice(3, 6);
        const lastFour = cleanedNumber.slice(6);
        return `${areaCode}-${firstThree}-${lastFour}`;
    }

    const phoneNumber = document.getElementById("phoneNumber");
    if (phoneNumber) {
        phoneNumber.addEventListener("input", function () {
            const formattedNumber = formatPhoneNumber(this.value);
            this.value = formattedNumber;
        });
    }

    function handlePaste(event) {
        if (event.target.id === "MobilePhone") {
            const pastedNumber = (event.clipboardData || window.clipboardData).getData('text');
            const formattedNumber = formatPhoneNumber(pastedNumber);
            event.target.value = formattedNumber;
            event.preventDefault();
        }
    }

    function handlePastes(event) {
        if (event.target.id === "SpouseCell") {
            const pastedNumber = (event.clipboardData || window.clipboardData).getData('text');
            const formattedNumber = formatPhoneNumber(pastedNumber);
            event.target.value = formattedNumber;
            event.preventDefault();
        }
    }

