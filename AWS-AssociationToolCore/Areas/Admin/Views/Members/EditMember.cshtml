                                            <option @(item.PaymentMethodId == objMemberDetails.objMembershipOrder.PaymentMethodId ? "selected=selected" : "") value="@item.PaymentMethodId">@item.PaymentMethod</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="input-box">
                                <label class="form-label">Transaction Id </label>
                                <input type="text" class="form-control" value="@objMemberDetails.objMembershipOrder.TransactionId" id="TransactionId" name="TransactionId">
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="input-box">
                                <label class="form-label">Payment Status <span class="text-danger">*</span></label>
                                <select class="single-select" name="PaymentStatusId" id="PaymentStatusId">
                                    @if (lstPaymentStatus != null)
                                    {
                                        <option value="">Select</option>
                                        foreach (var item in lstPaymentStatus)
                                        {
                                            <option @(item.PaymentStatusId == objMemberDetails.objMembershipOrder.PaymentStatusId ? "selected=selected" : "") value="@item.PaymentStatusId">@item.PaymentStatus1</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <div id="ChequeHolderNamehide">
                            <div class="row">
                                <div class="col-xs-12 col-lg-3 col-sm-6">
                                    <label class="dk-t poppins-regular"> Cheque Image : </label>
                                    <img class="fl_img" src="@(AWS_AssociationToolCore.BLL.Common.ValidateImage(imglocNormal + objMemberDetails.ReceiptUrl, imglocNormal + "no-imagefinal.jpg"))" alt="" width="60%">


                                </div>
                                <div class="col-xs-12 col-lg-3 col-sm-6">
                                    <label>Cheque Holder Name :</label>
                                    <input type="text" id="ChequeHolderName" value="@objMemberDetails.ChequeHolderName" class="form-control" name="ChequeHolderName">
                                    <span class="field-validation-error" id="spanTransactionId"></span>
                                </div>
                            </div>
                        </div>

                        <div id="ZellePartnerNamehide">
                            <div class="row">
                                <div class="col-lg-3 col-md-6">
                                    <label>Zelle Id :</label>
                                    <input type="text" id="Zelle" value="@objMemberDetails.Zelle" class="form-control" name="Zelle">
                                </div>
                                <div class="col-lg-3 col-md-6">
                                    <label>Zelle PartnerName :</label>
                                    <input type="text" id="ZellePartnerName" value="@objMemberDetails.ZellePartnerName" class="form-control" name="ZellePartnerName">
                                </div>
                                <div class="col-lg-3 col-md-6">
                                    <label class="dk-t poppins-regular"> Zelle Receipt Image : </label>
                                    <img class="fl_img" src="@(AWS_AssociationToolCore.BLL.Common.ValidateImage(imglocNormal + objMemberDetails.ReceiptUrl, imglocNormal + "no-imagefinal.jpg"))" alt="" width="60%">

                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-lg-6 col-md-6">
                            <div class="input-box">
                                <label class="form-label">User Comments</label>
                                <textarea type="text" id="UserComment" class="form-control" name="UserComment">@objMemberDetails.objMembershipOrder.UserComment</textarea>
                            </div>
                        </div>
                        <div class="col-lg-6 col-md-6">
                            <div class="input-box">
                                <label class="form-label">Admin Comments</label>
                                <textarea type="text" class="form-control" id="AdminComment" name="AdminComment">@objMemberDetails.objMembershipOrder.AdminComment</textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row gy-3 justify-content-end mt-3">
                <div class="col-lg-3 col-md-6">
                    <div class="text-end">
                        <strong><label class="form-label">Last Modified by :<span class="text-danger">@objMemberDetails.objMembershipOrder.UpdatedBy</span></label></strong>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="text-end">
                        <strong><label class="form-label">Last Modified Date :<span class="text-danger">@objMemberDetails.UpdatedTime.ToString("MM/dd/yyyy")</span></label></strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-3 col-3 text-end ms-auto">
            <button type="submit" class="btn btn-success px-3" value="submit"> Submit</button>
            <a class="btn btn-primary px-3" href="@Url.Action("Index", "Members", new { mid = ViewBag.mid, type = ViewBag.type })">Cancel</a>
        </div>
    </div>
}

<div class="card mt-3" id="MemberLogsId">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="text-align:center">S.No</th>
                        <th style="text-align:center">First Name</th>
                        <th style="text-align:center">Last Name</th>
                        <th style="text-align:center">Email</th>
                        <th style="text-align:center">Mobile Number</th>
                        <th style="text-align:center">State</th>
                        <th style="text-align:center">City</th>
                        <th style="text-align:center">ZipCode</th>
                        <th style="text-align:center">Address-1</th>
                        <th style="text-align:center">Address-2</th>
                        <th style="text-align:center">Membership Type</th>
                        <th style="text-align:center">Payment Method</th>
                        <th style="text-align:center">Transaction Id</th>
                        <th style="text-align:center">Payment Status</th>
                        <th style="text-align:center">User Comments</th>
                        <th style="text-align:center">Admin Comments</th>
                        <th style="text-align:center">Last Modified by</th>
                        <th style="text-align:center">Last Modified Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (lstMemberLogs.Count != 0)
                    {
                        Int64 i = 1;
                        foreach (var item in lstMemberLogs)
                        {
                            <tr>
                                <td style="text-align:center">@i</td>
                                <td>
                                    <div class="align-items-center gap-3 cursor-pointer">
                                        <div><p class="mb-0">@item.FirstName</p></div>
                                    </div>
                                </td>
                                <td>@item.LastName</td>
                                <td style="text-align:left">
                                    <div class="align-items-center gap-3 cursor-pointer">
                                        <div>
                                            <a href="mailto:@item.Email"><p class="mb-0">@item.Email</p></a>
                                        </div>
                                    </div>
                                </td>
                                <td>@item.MobilePhone</td>
                                <td>@item.State</td>
                                <td>@item.City</td>
                                <td>@item.ZipCode</td>
                                <td>@item.Address</td>
                                <td>@item.Address2</td>
                                <td>@item.MembershipType</td>
                                <td>@item.PaymentMethod</td>
                                <td>@item.TransactionId</td>
                                <td>@item.PaymentStatus</td>
                                <td>@item.UserComment</td>
                                <td>@item.AdminComment</td>
                                <td>@item.UpdatedBy</td>
                                <td style="text-align:center">
                                    <span style="color: #990033">@(item.UpdatedTime.ToString("MM-dd-yyyy"))</span>
                                </td>
                            </tr>
                            i++;
                        }
                    }
                    else
                    {
                        <tr class="odd"><td valign="top" colspan="18" class="font-14 text-center">No Records found</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    var _URL = window.URL || window.webkitURL;
    $("#file").change(function (e) {
        var file, img;
        if ((file = this.files[0])) {
            img = new Image();
            img.onload = function () {
                if (this.width == 350 && this.height == 250) {
                    $('#hdnimgvalidate').val('1');
                } else {
                    $('#hdnimgvalidate').val('0');
                }
            };
            img.src = _URL.createObjectURL(file);
        }
    });

    function scrollToSection() {
        $('#MemberLogsId').show();
        const targetElement = document.getElementById("MemberLogsId");
        if (targetElement) {
            const offset = 100;
            const elementPosition = targetElement.getBoundingClientRect().top;
            const offsetPosition = elementPosition + window.pageYOffset - offset;
            window.scrollTo({ top: offsetPosition, behavior: "smooth" });
        } else {
            console.error("Element with id 'MemberLogsId' not found.");
        }
    }
</script>
<script src="Scripts/Admin/cropper-js-min.js" type="text/javascript"></script>
<style>
    .dynamic-fields-row .dcf-existing-file-item .dcf-file-name {
        word-break: break-all;
        font-size: 13px;
    }

    .dynamic-fields-row .dcf-view-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        margin-top: 6px;
        padding: 4px 12px;
        font-size: 13px;
        border-radius: 4px;
        background: #0d6efd;
        color: #fff !important;
        text-decoration: none;
    }

        .dynamic-fields-row .dcf-view-btn:hover {
            background: #0a58ca;
        }
</style>

<script>
    $(document).ready(function () {
        $('.dynamic-fields-row .dcf-existing-file-item').each(function () {
            var $item = $(this);

            if ($item.find('img').length) return;            // images ki separate download icon undi
            if ($item.find('.dcf-view-btn').length) return;  // already added

            var $link = $item.find('a').first();
            if (!$link.length) return;

            var href = $link.attr('href');
            var fileName = decodeURIComponent(href.split('?')[0].split('/').pop())
                .replace(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}_/i, '');

            // file name clean cheyyi (GUID teesey) + new tab lo open
            $link.text(fileName)
                 .addClass('dcf-file-name')
                 .attr({ target: '_blank', rel: 'noopener noreferrer' });

            // View Document button
            var $view = $('<a class="dcf-view-btn" title="View Document"><i class="fa fa-eye"></i> View Document</a>')
                .attr({ href: href, target: '_blank', rel: 'noopener noreferrer' });

            $item.append('<br/>').append($view);
        });
    });
</script>
