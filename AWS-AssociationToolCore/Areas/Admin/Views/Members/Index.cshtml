            function BulkValidate() {
                if ($('#Document').val() == "") { $('#spanDocument').show().html('Required. <span>&nbsp;</span><i>&nbsp;</i><abbr onclick="closeValidation(this);">&nbsp;</abbr>'); $('#Document').focus(); return false; } else { $('#spanDocument').hide().html(' '); }
                if (!Common.isDocument($('#Document').val())) { $('#spanDocument').html('Sorry image is invalid. Only allowed extensions are:<b>xls, xlsx</b>.'); $('#Document').focus(); return false; } else { $('#spanDocument').html(''); }

                return true;
            }


                  // ✅ Single, correct PagerClickBind — fixed OrderBind → EventRegistrationBind
            function PagerClickBind() {
                $(document).off("click", ".pagination .page-link").on("click", ".pagination .page-link", function () {
                    var id = $(this).attr("id");
                    var pageNo;

                    if (id === "Previous" || id === "Next") {
                        pageNo = parseInt($(this).data("page"));
                    } else {
                        pageNo = parseInt(id);
                    }

                    if (!pageNo || isNaN(pageNo) || pageNo < 1) return;

                    $('#hdnPageNo').val(pageNo);
                        Onload(pageNo);
                });
            }


        function sortresult(sortcolumn) {

            $('#hdnsortorder').val(($('#hdnsortorder').val() == 'ASC' ? 'DESC' : 'ASC'));
            $('#hdnsortcolumn').val(sortcolumn);
            Onload(1);
        }

