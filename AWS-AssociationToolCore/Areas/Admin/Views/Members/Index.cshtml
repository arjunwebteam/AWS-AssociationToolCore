<script>
    $(document).ready(function () {

        // ✅ Custom extension validator — checks by extension only
        $.validator.addMethod("validXlsExtension", function (value, element) {
            if (element.files && element.files.length > 0) {
                var allowedExtensions = ["xls", "xlsx"];
                var fileName = element.files[0].name;
                var extension = fileName.split('.').pop().toLowerCase().trim();
                return $.inArray(extension, allowedExtensions) !== -1;
            }
            return true;
        }, "Only XLS or XLSX files are allowed.");

        $("#VolunteerForm").validate({
            rules: {
                Document: {
                    required: true,
                    validXlsExtension: true
                }
            },
            messages: {
                Document: {
                    required: "Please select a document.",
                    validXlsExtension: "Invalid file type. Only XLS or XLSX files are allowed."
                }
            },
            errorElement: "div",
            errorPlacement: function (error, element) {
                error.addClass("invalid-feedback");
                if (element.prop("type") === "checkbox") {
                    error.insertAfter(element.parent("label"));
                } else {
                    error.insertAfter(element);
                }
                if (element.closest(".input-box").length) {
                    element.closest(".input-box").after(error);
                }
            },
            highlight: function (element) {
                $(element).addClass("is-invalid").removeClass("is-valid");
            },
            unhighlight: function (element) {
                $(element).addClass("is-valid").removeClass("is-invalid");
            }
            // ✅ NOTE: submitHandler REMOVED — using direct submit binding below instead
        });

        // ✅ NEW: directly bind submit — preventDefault() runs FIRST, always,
        // regardless of whether validate plugin's submitHandler fires correctly
        $('#VolunteerForm').on('submit', function (e) {
            e.preventDefault();   // ✅ stops native form submission unconditionally

            var form = this;

            // Run validation rules; if invalid, errors show automatically and we stop here
            if (!$(form).valid()) {
                return false;
            }

            var formData = new FormData(form);
            var submitBtn = $(form).find('input[type="submit"]');
            submitBtn.prop('disabled', true).val('Uploading...');

            $.ajax({
                url: form.action,
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                xhrFields: {
                    responseType: 'blob'
                },
                success: function (data, status, xhr) {
                    var contentType = xhr.getResponseHeader('content-type') || '';

                    if (contentType.indexOf('text/csv') !== -1) {
                        var disposition = xhr.getResponseHeader('content-disposition');
                        var fileName = 'Member-Bulk-Upload-Report.csv';
                        if (disposition && disposition.indexOf('filename=') !== -1) {
                            fileName = disposition.split('filename=')[1].replace(/"/g, '').trim();
                        }

                        var blob = new Blob([data], { type: 'text/csv' });
                        var link = document.createElement('a');
                        link.href = window.URL.createObjectURL(blob);
                        link.download = fileName;
                        document.body.appendChild(link);
                        link.click();
                        document.body.removeChild(link);
                    }

                    // ✅ Close modal — with fallback in case bootstrap 'modal' plugin fails silently
                    try {
                        $('#AddMembershipType').modal('hide');
                    } catch (err) {
                        console.error('Modal hide failed:', err);
                        $('#AddMembershipType').removeClass('show').css('display', 'none');
                        $('.modal-backdrop').remove();
                        $('body').removeClass('modal-open');
                    }

                    // ✅ Show notification — with fallback if function isn't defined
                    if (typeof showLobiboxNotification === 'function') {
                        showLobiboxNotification('success', 'Members uploaded successfully. Report downloaded.');
                    } else {
                        alert('Members uploaded successfully. Report downloaded.');
                    }

                    Onload($('#hdnPageNo').val() || 1);

                    submitBtn.prop('disabled', false).val('Submit');
                    form.reset();
                    $(form).find('.is-valid, .is-invalid').removeClass('is-valid is-invalid');
                },
                error: function (xhr) {
                    submitBtn.prop('disabled', false).val('Submit');
                    console.error('Upload error:', xhr.status, xhr.responseText);
                    if (typeof showLobiboxNotification === 'function') {
                        showLobiboxNotification('error', 'Upload failed. Please try again.');
                    } else {
                        alert('Upload failed. Please try again.');
                    }
                }
            });
        });

        // ✅ Live re-validate on file change
        $('#Document').on('change', function () {
            $("#VolunteerForm").validate().element("#Document");
        });

    });


</script>




