        function Onload(Pageno) {
        var role = $('#Role').val();
        var pageno = Common.Pageno(Pageno);
        var sortcolumn = $('#hdnsortcolumn').val();
        var sortorder = $('#hdnsortorder').val();
            var items = $('#txtitems').val();
        var Search = $('#txtsearch').val().trim();
        var MembershipTypeId = $('#MembershipTypeId').val();
        var ExpiryDate = $('#ExpiryDate').val();
        var EndDate = $('#EndDate').val();
        var StartDate = $('#StartDate').val();
        var PaymentStatusId = $('#PaymentStatusId').val();
        var IsVolunteer = $('#IsVolunteer').val();

        // ✅ Get ChapterId and default to 1 if 0 or empty
        var ChapterId = $('#ChapterId').val();
        ChapterId = (ChapterId == 0 || ChapterId == "0" || ChapterId == "") ? 1 : ChapterId;

        var type = '@type';

        if ($('#StartDate').val() != "" && $('#EndDate').val() != "") {
            var startdate = new Date($('#StartDate').val());
            var enddate = new Date($('#EndDate').val());
            if (startdate > enddate) {
                $('#spanStartDate').html('From date should be less than to date.');
                return false;
            } else {
                $('#spanStartDate').html('');
            }
        }

        if (role != '') {
            $.ajax({
                url: '@Url.Action("MembersList", "Members")',
                type: 'GET',
                cache: false,
                data: {
                    Search: Search,
                    PageNo: pageno,
                    StartDate: StartDate,
                    EndDate: EndDate,
                    PaymentStatusId: PaymentStatusId,
                    ExpiryDate: ExpiryDate,
                    IsVolunteer: IsVolunteer,
                    SortColumn: sortcolumn,
                    SortOrder: sortorder,
                    Items: items,
                    MembershipTypeId: MembershipTypeId,
                    ChapterId: ChapterId,  // ✅ Will always be 1 if 0 or empty
                    IsEdit: '@IsEdit',
                    IsView: '@IsView',
                    IsDelete: '@IsDelete',
                    IsExport: '@IsExport',
                    IsAdd: '@IsAdd',
                    Mid: '@Mid',
                    type: type
                },
                success: function (result) {
                    $('#divDetails').html(result);
                    PagerClickBind();
                }
            });
        } else {
            $('#divDetails').html('<div class="norecords">Please Search for the list.</div>');
        }

        $('#Role').val('@userRole');
    }

