<script>
    var appDateFormat = '@AWS_AssociationToolCore.BLL.AppDate.JqFormat'; // DATE

    $(document).ready(function () {

        $("#StartDate, #EndDate, #RegistrationStartDate, #RegistrationEndDate, #EarlyBirdCutOfDate").datepicker({
            dateFormat: appDateFormat,
            minDate: 0,
            changeMonth: true,
            changeYear: true,
            onClose: function () {
                // Date select chesina taruvata End Date ni malli validate chey
                if ($("#EndDate").val() !== "") {
                    $("#EndDate").valid();
                }
            }
        }).on('focus', function () {
            $(this).datepicker("show");
        });

        FormDisplay();
    });
</script>

<script>
    var _URL = window.URL || window.webkitURL;
    $("#file").change(function (e) {
        var file, img;
        if ((file = this.files[0])) {
            img = new Image();
            img.onload = function () {
                if (this.width == 270 && this.height == 370) {
                    $('#hdnimgvalidate').val('1');
                }
                else {
                    $('#hdnimgvalidate').val('0');
                }
            };
            img.src = _URL.createObjectURL(file);
        }
    });

</script>
