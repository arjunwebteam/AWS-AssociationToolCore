</script>
<script type="text/javascript">
    function FormDisplay() {
        var Type = $('#Type').val();

        if (Type == "External Registration") {
            document.getElementById("IsRegistration").checked = false;
            $('#showform').show();
            $('#ExpernalReg').show();
            $('#InternalReg').hide();
            $('#RegStart').show();
            $('#RegEnd').show();
        }
        else if (Type == "Internal Registration") {
            $('#MetaKeywords').val('');
            $('#showform').show();
            $('#InternalReg').show();
            $('#ExpernalReg').hide();
            $('#RegStart').show();
            $('#RegEnd').show();
        }
    }

    function readURL(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();

            reader.onload = function (e) {
                $('#blah')
                    .attr('src', e.target.result)
                    .width(@value1)
                    .height(@value2);
                $('#image').attr('src', e.target.result);
                $('#divimage').show();
                $('#noimagetext').hide();
            };

            reader.readAsDataURL(input.files[0]);
        }
    }

    function EarlyBirdDisplay() {
        var IsEarlyBird = '';
        IsEarlyBird = $('#IsEarlyBird').val();
        if (IsEarlyBird == "true") {

            $('#earlydateshow').show();

        }
        else {
            $('#earlydateshow').hide();
        }

    }
</script>


