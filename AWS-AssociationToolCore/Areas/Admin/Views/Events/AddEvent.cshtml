    function GetEmail() {
        var ChapterId = $('#ChapterId').val();
        if (PhoneNo != '') {
            $.ajax({
                url: '@Url.Action("GetCommitteeDetailedInfo", "Events")',
                type: 'POST',
                data: { ChapterId: ChapterId },
                datatype: "JSON",
                success: function (result) {
                    if (result.ok) {
                        var objCommitteeInfo = result.data;
                        $('#ContactEmail').val(objCommitteeInfo.SecretaryEmail);
                    }
                    else {
                        $('#divmessage').val(result.data);
                        $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                    }
                }
            });
        }
    }



    function readURL(input)

    {
        if (input.files && input.files[0]) {
            var reader = new FileReader();

            reader.onload = function (e) {
                $('#blah')
                    .attr('src', e.target.result)
                    .width(@value1)
                    .height(@value2);


                $('#image').attr('src', e.target.result);
                $('#divimage').show();
                $('#noimagetext').hide();
            };

            reader.readAsDataURL(input.files[0]);
        }
    }
</script>
<script type="text/javascript">
    function FormDisplay() {
        var Type = $('#Type').val();

        if (Type == "External Registration") {
            document.getElementById("IsRegistration").checked = false;
            $('#showform').show();
            $('#ExpernalReg').show();
            $('#InternalReg').hide();
            $('#RegStart').show();
            $('#RegEnd').show();
        }
        else if (Type == "Internal Registration") {
            $('#MetaKeywords').val('');
            $('#showform').show();
            $('#InternalReg').show();
            $('#ExpernalReg').hide();
            $('#RegStart').show();
            $('#RegEnd').show();
            document.getElementById("IsRegistration").checked = true;
        }
    }

    function EarlyBirdDisplay() {
        var IsEarlyBird = $('#IsEarlyBird').val();

        if (IsEarlyBird == "true") {

            $('#earlydateshow').show();

        }
        else {
            $('#earlydateshow').hide();
        }

    }



    function ChapterNameBind() {

        var ChapterNamecheckboxs = Common.GetCheckBoxValue('ChapterNamecheckbox');

        $('#ChapterIds').val(ChapterNamecheckboxs);
       
      
        if (ChapterNamecheckboxs == "") {
            alert("Please select atleast one Chapter.");
            return false;
        }

    }


</script>


