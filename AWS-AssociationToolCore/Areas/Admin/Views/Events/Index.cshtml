

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_MainLayout.cshtml";
    ViewBag.Pageheading = "Events";

    var EventType = ViewBag.EventType;
    List<AWS_AssociationToolCore.Entities.Chapters> lstChapters = ViewBag.lstChapters;
    Int64 ChapterId = ViewBag.ChapterId;
    string userRole = Context.Session.GetString("userrole") ?? string.Empty;

    bool IsEdit = Convert.ToBoolean(Context.Session.GetString("IsEdit"));
    bool IsView = Convert.ToBoolean(Context.Session.GetString("IsView"));
    bool IsDelete = Convert.ToBoolean(Context.Session.GetString("IsDelete"));
    bool IsExport = Convert.ToBoolean(Context.Session.GetString("IsExport"));
    bool IsAdd = Convert.ToBoolean(Context.Session.GetString("IsAdd"));
    Int64 Mid = ViewBag.mid;

    int status = 0;
    AWS_AssociationToolCore.BLL.AppInfo _AppInfo = new AWS_AssociationToolCore.BLL.AppInfo();
    AWS_AssociationToolCore.Entities.AppInfo objAppInfo = new AWS_AssociationToolCore.Entities.AppInfo();
    objAppInfo = _AppInfo.GetAppInfoDetails(ref status);

}

<script type="text/javascript">
         var appDateFormat = '@AWS_AssociationToolCore.BLL.AppDate.JqFormat';

    $(document).ready(function () {
        $('#wEvents').addClass('active');
        $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
        $('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                PagerClickBind();

    });

    function PagerClickBind() {
        $(".pagination a").bind("click", function () {
            EventBind($(this).text());
        });

    }
    function sortresult(sortcolumn) {

        $('#hdnsortorder').val(($('#hdnsortorder').val() == 'ASC' ? 'DESC' : 'ASC'));
        $('#hdnsortcolumn').val(sortcolumn);
        EventBind(1);
    }
    function EventBind(Pageno) {
        var pageno = Common.Pageno(Pageno);
        var search = $('#keyword').val();
        var sortcolumn = $('#hdnsortcolumn').val();
        var sortorder = $('#hdnsortorder').val();
        var items = $('#txtitems').val();;
        var CategoryId = $('#EventCategoryId').val();
        var ChapterId = $('#ChapterId').val();
        @*var ChapterId = 0;
        if (@ChapterId != 0) {
            ChapterId = @ChapterId;
        }
        else {

        ChapterId = $('#ChapterId').val();

        }*@
        $.ajax({
            url: '@Url.Action("EventsList", "Events")',
            type: 'GET',
            cache: false,
            data: { search: search, PageNo: pageno, SortColumn: sortcolumn, SortOrder: sortorder, Items: items, EventType: '@EventType', EventCategoryId: CategoryId, ChapterId: ChapterId, IsEdit: '@IsEdit', IsView: '@IsView', IsDelete: '@IsDelete', IsExport: '@IsExport', IsAdd: '@IsAdd', Mid: '@Mid' },
            success: function (result) {
                $('#divEventsList').html(result);
                PagerClickBind();

            }
        });
    }

    @*function Delete(EventId, ImageFileName) {

            $.ajax({
                type: "POST",
                url: '@Url.Action("EventDelete", "Events")',  // the URL of the controller action method
                data: { EventId: EventId, ImageFileName: ImageFileName }, // optional data
                success: function (result) {
                    showLobiboxNotification(result.messageType, result.message);
                    if (result.ok) {
                        //$("#divmessage").html(result.data);

                        //$('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                        EventBind($('#hdnPageNo').val());
                    }
                    else {
                        $("#divmessage").html(result.data);
                        EventBind($('#hdnPageNo').val());
                        $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                    }
                }

            });

    }*@


     function Delete(EventId, ImageFileName) {
        var val2 = confirm("Do you want to delete this record?");
        if (val2) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("EventDelete", "Events")',  // the URL of the controller action method
                data: { EventId: EventId, ImageFileName: ImageFileName }, // optional data
                success: function (result) {
                    if (result.ok) {
                              showLobiboxNotification(result.messageType, result.message);
                                 EventBind($('#hdnPageNo').val());
                    }
                    else {
                        $("#divmessage").html(result.data);
                        EventBind($('#hdnPageNo').val());
                        $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                    }
                }

            });
        }
    }

    function ClearSearch() {
        $('#keyword').val('');
        $('#hdnPageNo').val(1);
        $('#EventCategoryId').val('');
        //$('#ChapterId').val('').trigger('change');
        //$('#ChapterId').val(1);
        EventBind(1);
    }

    function EventStatus(EventId) {
        $.ajax({
            type: "POST",
            url: '@Url.Action("EventStatus", "Events")', // the URL of the controller action method
            data: { EventId: EventId }, // optional data
            datatype: "JSON",
            success: function (result) {
                showLobiboxNotification(result.messageType, result.message);
                if (result.ok) {
                  /*  $('#divmessage').html(result.data);*/
                    EventBind(1);

                //    $('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                }
                else {
                    $('#divmessage').html(result.data);
                    $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                }
            }
        });
    }

        function PagerClickBind() {

        $(document).off("click", ".pagination .page-link").on("click", ".pagination .page-link", function () {
            var id = $(this).attr("id");
            var pageNo;

            if (id === "Previous" || id === "Next") {
                pageNo = parseInt($(this).data("page"));
            } else {
                pageNo = parseInt(id);
            }

            if (!pageNo || isNaN(pageNo) || pageNo < 1) return;

            OrderBind(pageNo);  // ← only difference from Donations page
        });
    }

</script>



<input id="hdnPageNo" type="hidden" value="1" />
<input id="hdnsortorder" name="hdnsortorder" value="" type="hidden" />
<input id="hdnsortcolumn" name="hdnsortcolumn" value="EventId" type="hidden" />

<div class="card">

    <div class="card-header py-3 mb-3">
        <div class="row  gx-2">

            <div class="d-flex flex-wrap cmn-btn-group-hover  cmn-btn-group tabs-btn" style="gap:10px">
                @if (ChapterId != 0)
                {

                    <a class="cmn-btn bdr-btn1 @(EventType == "upcoming" ? "active" : "")" href="@Url.Action("Index", "Events", new { EventType = "upcoming", ChapterId = ChapterId, mid = Mid })">Current/Upcoming Events</a>

                    <a class="cmn-btn bdr-btn1 @(EventType == "past" ? "active" : "")" href="@Url.Action("Index", "Events", new { EventType = "past", ChapterId = ChapterId, mid = Mid })">Past Events</a>
                }
                else
                {
                    <a class="cmn-btn bdr-btn1 @(EventType == "upcoming" ? "active" : "")" href="@Url.Action("Index", "Events", new { EventType = "upcoming", ChapterId = ChapterId, mid = Mid })">Current/Upcoming Events</a>

                    <a class="cmn-btn bdr-btn1 @(EventType == "past" ? "active" : "")" href="@Url.Action("Index", "Events", new { EventType = "past", mid = Mid })">Past Events</a>
                }


            </div>
            @if (objAppInfo.chapterStatus == "Yes")
            {
                <div class="col-lg-2 col-md-6 col-8">
                    <div class="input-box">
                        <label class="form-label"> <span class="text-danger"></span>Search by Chapter</label>
                        <div class="input-group">
                           
                                <select class="form-control" id="ChapterId" name="ChapterId" style="@(ChapterId != 1 ? "pointer-events:none;" : "")">

                                    @if (lstChapters != null && lstChapters.Count != 0)
                                    {
                                        foreach (var item in lstChapters)
                                        {
                                            @*<option value="@item.ChapterId">@item.ChapterName</option>*@
                                            <option @(item.ChapterId == ChapterId ? "selected='selected'" : "") value="@item.ChapterId">@item.ChapterName</option>

                                            @*<option value="@item.ChapterId" @(item.ChapterId == ChapterId ? "selected=selected" : "")>@item.ChapterName</option>*@
                                        }
                                    }


                                </select>
                                @*<span class="input-group-text pointer" style="cursor:pointer" onclick="MenuItemsBind(1);" id="basic-addon1"><i class="bi bi-search"></i></span>*@
</div>
                    </div>
                </div>
            }
            <div class="col-lg-3 col-md-6 col-8">
                <div class="input-box">
                    <label class="form-label">Search by Event Name<span class="text-danger"></span></label>
                    <div class="input-group mb-3">
                        <input type="text" class="form-control" name="keyword" id="keyword" placeholder="Event Name">

                    </div>

                </div>
            </div>

            <div class="col-lg-2 col-2" id="clearhide">
                <div>
                    <label>&nbsp;</label>
                </div>
                <button type="button" class="btn btn-primary px-3" onclick="EventBind(1);">Search</button>
                <button type="button" class="btn btn-danger px-3" onclick="ClearSearch();">Clear</button>
            </div>

            <div class="col-lg-2 col-4 text-end ms-auto">
                <div class="btn-align">
                    @if (IsAdd == true)
                    {
                        <a class="btn btn-primary" href="@Url.Action("AddEvent", "Events", new { mid = Mid })">Add Event</a>
                    }

                </div>
            </div>

        </div>
    </div>
    <div id="divEventsList" class="clearfix">

</div>
    <script>
        $(document).ready(function () {
            LoadEventsList();
                     PagerClickBind();

        });

        function LoadEventsList() {
            $.ajax({
                type: "GET",
                url: '@Url.Action("EventsList", "Events")',
                data: {
                    IsEdit    : '@IsEdit',
                    IsView    : '@IsView',
                    IsDelete  : '@IsDelete',
                    IsExport  : '@IsExport',
                    IsAdd     : '@IsAdd',
                    Mid       : '@Mid',    
                    EventType: '@EventType',// ✅ uses Mid variable not ViewBag.mid
                    ChapterId : '@(ChapterId == 0 ? 1 : ChapterId)'
                },
                success: function (data) {
                    $("#divEventsList").html(data);
                },
                error: function () {
                    $("#divEventsList").html('<p class="text-danger">Failed to load events.</p>');
                }
            });
        }
    </script>
</div>
