@using AWS_AssociationToolCore.BLL

@{ Layout = null;}
@{
    string sortcolumn = (string)ViewBag.sortcolumn;
    string sortorder = (string)ViewBag.sortorder;
    Int64 Total = (Int64)ViewBag.total;
    var PageNo = (Int64)ViewBag.pageno;
    var Items = (Int64)ViewBag.items;

    List<AWS_AssociationToolCore.Entities.Videos> lstVideosLst = ViewBag.lstVideosLst;

    int status1 = 0;
    AWS_AssociationToolCore.BLL.AppInfo _appinfo = new AWS_AssociationToolCore.BLL.AppInfo();
    AWS_AssociationToolCore.Entities.AppInfo objAppInfo = _appinfo.GetAppInfoDetails(ref status1);

    // ✅ Use BaseUrl from DB - same as your PhotoGallery views
    var location = objAppInfo.AdminSiteUrl + "Content/Admin/Videogallery/thumb/";
    string userRole = Context.Session.GetString("userrole") ?? string.Empty;

}


<link href="Content/User/css/magnific-popup.min.css" rel="stylesheet" />
<script src="Scripts/User/jquery.magnific-popup.min.js"></script>
<script type="text/javascript">

    $(document).ready(function () {
        $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
        $('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
    });

    function VideoStatus(VideoId) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("VideoStatus", "VideoGallery")', // the URL of the controller action method
            data: { VideoId: VideoId }, // optional data
            datatype: "JSON",
            success: function (result) {
                showLobiboxNotification(result.messageType, result.message);
                if (result.ok) {
                    //$('#divmessage').html(result.data);
                    //$('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                    //$('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                    VideosBind($('#hdnPageNo').val());
                }
                else {
                    $('#divmessage').html(result.data);
                    $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                    $('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                }
            }
        });
    }

    function UpdateDisplayOrder(j, VideoId) {
        var DisplayOrder = parseInt($('#DisplayOrder' + j).val());
        $.ajax({
            type: 'POST',
            url: '@Url.Action("VideoDisplayOrder", "VideoGallery")',
            data: { DisplayOrder: DisplayOrder, VideoId: VideoId },
            success: function (result) {
                showLobiboxNotification(result.messageType, result.message);
                var div = '';
                if (result.ok) {
                    //$("#divmessage").html(result.data);
                    //$('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                    //$('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                    VideosBind(1);
                }
                else {
                    $("#divmessage").html(result.data);
                    $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                    $('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                }
            }
        });
    }
</script>


<div class="card-body">
    <div class="table-responsive">

        @if (Total == -1)
        {
            <div class="norecords">Sorry failed processing your request.</div>
        }
        else
        {
            <table width="100%" class="table table-striped align-middle mb-0 aws-video-popup">
                <thead class="table-light">
                    <tr>

                        <th width="6%" class="text-center">S.No</th>

                        <th>
                            <a style="color: black;" onclick="javascript:sortresult('CategoryName');" class="white-t-u aws-h-a">
                                Gallery Name @if (sortcolumn == "CategoryName")
                                {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                            </a>
                        </th>
                        <th width="18%">Video</th>

                        <th width="16%">
                            <a style="color: black;" onclick="javascript:sortresult('DisplayOrder');" class="white-t-u aws-h-a">
                                Order No @if (sortcolumn == "DisplayOrder")
                                {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                            </a>

                        </th>
                        <th width="10%">Status</th>

                        <th class="text-center" width="8%">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (lstVideosLst.Count != 0)
                    {
                        int j = 0;
                        foreach (var item in lstVideosLst)
                        {
                            <tr>
                                <td align="center">@item.RId</td>



                                <td>@item.CategoryName</td>
                               


                                <td>
                                    <a href="https://www.youtube.com/embed/@(item.VideoUrl)" class="lightview red-t" data-lightview-group='example2' data-lightview-title="@item.Heading">
                                        <img alt="@item.Heading" title="@item.Heading" style="height:55px;" src='http://i1.ytimg.com/vi/@(item.VideoUrl)/mqdefault.jpg'>
                                    </a>
                                </td>

                                <td>
                                    <input type="text" maxlength="3" style="width:50px;" id="DisplayOrder@(j)" value="@item.DisplayOrder" onkeypress="return Common.isNumberKey(event)" />
                                    <a onclick="UpdateDisplayOrder(@j,@item.VideoId);" title="Update"><i class="fa fa-fw fa-refresh"></i></a>

                                </td>



                                <td>
                                    <div class="menu-hover">
                                        @{ var isChecked = item.IsActive ? "checked" : ""; }
                                        @{var titleValue = item.IsActive ? "Active" : "Disabled";}

                                        <div>
                                            <label class="switch" title="@titleValue">
                                                <input type="checkbox" onclick="VideoStatus(@item.VideoId)" @isChecked>
                                                <span class="slider"></span>
                                            </label>
                                        </div>
                                    </div>
                                </td>



                                <td class="text-center">
                                    <div class="table-actions d-flex align-items-center gap-3 fs-6">

                                        @if (ViewBag.IsEdit == true)
                                        {
                                            <a class="text-warning cursor-pointer" onclick="VideoEdit(@item.VideoId);" title=" Edit" aria-label="Edit"><i class="bi bi-pencil-fill"></i></a>
                                        }

                                        @if (ViewBag.IsDelete == true)
                                        {
                                            <a class="text-danger cursor-pointer" id="159" onclick="javascript:Delete(@item.VideoId);" title="Delete" aria-label="Delete"><i class="bi bi-trash-fill"></i></a>
                                        }

                                    </div>


                                </td>

                            </tr>
                            j++;
                        }
                    }
                    else
                    {
                        <tr class="odd"><td valign="top" colspan="10" class="font-14 text-center">No  Records found</td></tr>
                    }
                </tbody>
            </table>
        }



    </div>
    <div class="row pt-3">
        <div class="col-sm-4 col-md-5">
            <div class="dataTables_info" id="example_info" role="status" aria-live="polite">
                Showing @((PageNo * Items) - (Items - 1)) - @((PageNo * Items) > Total ? Total : (PageNo * Items)) of @Total entries
            </div>
        </div>
        <div class="col-sm-3 col-md-7 " @(Total > 0 ? "" : "disable")>
            <div class="d-flex flex-wrap gap-4 justify-content-end">

                <div class="dataTables_paginate paging_simple_numbers" id="example_paginate">
                    @Html.Raw(AWS_AssociationToolCore.BLL.Common.SetPaging((Int64)ViewBag.items, ref Total, (Int64)ViewBag.pageno, "pagination pb-0"))
                </div>
            </div>
        </div>
    </div>



</div>

<style>
    .aws-h-a {
        text-decoration: none;
        position: relative;
    }

        .aws-h-a::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            bottom: -2px;
            border-bottom: 2px solid #0756ca;
            transform: scaleX(0);
            transition: transform 0.3s ease;
        }

        .aws-h-a:hover::after {
            transform: scaleX(1);
        }
</style>



<script>
    $(document).ready(function () {
        // Initialize Magnific Popup
        $('.aws-video-popup').magnificPopup({
            delegate: 'a',
            type: 'iframe',
            iframe: {
                patterns: {
                    youtube: {
                        index: 'youtu',
                        id: function (url) {
                            // Extract video ID from URL
                            var match = url.match(/[^\w-]([-\w]{11})[^-\w]?/);
                            if (match && match[1]) {
                                return match[1];
                            }
                        },
                        src: 'https://www.youtube.com/embed/%id%?autoplay=1'
                    },
                    vimeo: {
                        index: 'vimeo.com/',
                        id: '/',
                        src: 'https://player.vimeo.com/video/%id%?autoplay=1'
                    }
                    // Add more patterns for other video platforms if needed
                }
            },
            gallery: {
                enabled: true
            }
        });
    });
</script>