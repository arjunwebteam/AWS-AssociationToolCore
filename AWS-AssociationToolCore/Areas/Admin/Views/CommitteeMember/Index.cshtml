@{
    ViewBag.Title = "Index";



    ViewBag.Pageheading = "Committee Members";
    Layout = "~/Areas/Admin/Views/Shared/_MainLayout.cshtml";

    var CommitteeCategoryId = ViewBag.CommitteeCategoryId;

    List<AWS_AssociationToolCore.Entities.CommitteeMembers> lstCommittee = ViewBag.lstCommittee;
    List<AWS_AssociationToolCore.Entities.CommitteeCategories> lstCommitteeCategory = ViewBag.lstCommitteeCategory;
    List<AWS_AssociationToolCore.Entities.Chapters> lstChapters = ViewBag.lstChapters;

    List<AWS_AssociationToolCore.Entities.Chapters> lstLChapters = ViewBag.lstLChapters;
    List<AWS_AssociationToolCore.Entities.CommitteeMembers> lstCommitteebyedit = ViewBag.lstCommitteebyedit;

    Int64 ChapterId = ViewBag.ChapterId;
    Int64 mid = ViewBag.mid;

 

    string userRole = Context.Session.GetString("userrole") ?? string.Empty;
    bool IsEdit = ViewBag.IsEdit;
    bool IsView = ViewBag.IsView;
    bool IsDelete = ViewBag.IsDelete;
    bool IsExport = ViewBag.IsExport;
    bool IsAdd = ViewBag.IsAdd;
    Int64 Mid = ViewBag.mid;



    int status = 0;
    AWS_AssociationToolCore.BLL.AppInfo _AppInfo = new AWS_AssociationToolCore.BLL.AppInfo();
    AWS_AssociationToolCore.Entities.AppInfo objAppInfo = new AWS_AssociationToolCore.Entities.AppInfo();
    objAppInfo = _AppInfo.GetAppInfoDetails(ref status);





}
<script>
    $(document).ready(function () {

        $('.m-single-select').each(function () {

            var $this = $(this);

            $this.select2({
                theme: 'bootstrap4',
                allowClear: true,

                /* use whichever modal this select actually lives in */
                dropdownParent: $this.closest('.modal'),
                placeholder: $this.data('placeholder') || 'Select'
            });

        });

    });
</script>
<script>
    $(document).ready(function () {
        LoadCommitteeList();
                PagerClickBind();

    });

       function LoadCommitteeList() {
        $.ajax({
            type: "GET",
            url: '@Url.Action("CommitteeMemberList", "CommitteeMember")',
            data: {
                IsEdit: '@IsEdit',
                IsView: '@IsView',
                IsDelete: '@IsDelete',
                IsExport: '@IsExport',
                CommitteeCategoryId: '@CommitteeCategoryId',
                IsAdd: '@IsAdd',
                Mid: @Mid, // ✅ remove quotes
                YearId: @DateTime.Now.Year, // ✅ FIXED
                ChapterId: @(ChapterId == 0 ? 1 : ChapterId)
            },
            success: function (data) {
                $("#divcommittee").html(data);
            },
            error: function (xhr) {
                console.log(xhr.responseText); // ✅ debug
                $("#divcommittee").html('<p class="text-danger">Failed to load events.</p>');
            }
        });
    }
    function PagerClickBind() {
            $(document).off("click", ".pagination .page-link").on("click", ".pagination .page-link", function () {
                var id = $(this).attr("id");
                var pageNo;

                if (id === "Previous" || id === "Next") {
                    pageNo = parseInt($(this).data("page"));
                } else {
                    pageNo = parseInt(id);
                }

                if (!pageNo || isNaN(pageNo) || pageNo < 1) return;

                $('#hdnPageNo').val(pageNo);
                    Onload(pageNo);
            });
        }
</script>

<script type="text/javascript">
    $(document).ready(function () {
        $('#wCommittees,wCommitteeMembers').addClass('active');
        $('.closable').append('<span id="lblclose" class="closelink" title="Close"></span>');
        $('#SponsorCategoryId').val(CommitteeCategoryId);
        $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
        $('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');

    });


    function sortresult(sortcolumn) {
        $('#hdnsortorder').val(($('#hdnsortorder').val() == 'ASC' ? 'DESC' : 'ASC'));
        $('#hdnsortcolumn').val(sortcolumn);
        Onload(1);
    }

    function Onload(Pageno) {

        var pageno = Common.Pageno(Pageno);
        var sortcolumn = $('#hdnsortcolumn').val();
        var sortorder = $('#hdnsortorder').val();
        var items = $('#txtitems').val();
        var Search = $('#keyword').val();
        var CommitteeCategoryId = $('#CommitteeCategoryId').val();
        var ChapterId = $('#ddlChapterId').val();


        $.ajax({
            url: '@Url.Action("CommitteeMemberList", "CommitteeMember")',
            type: 'GET',
            cache: false,
            data: { Search: Search, PageNo: pageno, SortColumn: sortcolumn, SortOrder: sortorder, Items: items, CommitteeCategoryId: CommitteeCategoryId, ChapterId: ChapterId, IsEdit: '@IsEdit', IsView: '@IsView', IsDelete: '@IsDelete', IsExport: '@IsExport', IsAdd: '@IsAdd', Mid: '@Mid'},
            success: function (result) {
                $('#divcommittee').html(result);
                PagerClickBind();
            }
        });
    }

    function ClearSearch() {
        $('#keyword').val('');
        //$('#CommitteeCategoryId').val('');
        $('#CommitteeCategoryId').val('').trigger('change');
        $('#ddlChapterId').val('').trigger('change');
        $('#ddlChapterId').val(@ChapterId);
        $('#CommitteeCategoryId').val(@CommitteeCategoryId);
        $('#hdnPageNo').val(1);
        Onload(1);
    }

    function Add() {
        clearCommitteeMember();
       
        $("#AddCommitteeMember").modal("show");
        $('#lbltitle').html('Add Committee Member');
    }


    function EditCommitteeMember(CommitteeMemberId) {
        $.ajax({
            url: '@Url.Action("EditCommitteeMember", "CommitteeMember")',
            type: 'POST',
            data: { CommitteeMemberId: CommitteeMemberId },
            datatype: "JSON",
            success: function (result) {
                if (result.ok) {
                    var objCommitteeMember = result.data;
                    $('#ddlCommitteeMemberId').val(objCommitteeMember.CommitteeMemberId);
                    $('#ddllChapterId').val(objCommitteeMember.ChapterId);
                    $('#ddlCommitteeCategoryId').val(objCommitteeMember.CommitteeCategoryId);
                    $('#ddlMemberId').val(objCommitteeMember.MemberId);
                    $('#ddlDesignation').val(objCommitteeMember.Designation);
                    $('#ddlDescription').val(objCommitteeMember.Description);
                    $('#ddlDisplayOrder').val(objCommitteeMember.DisplayOrder);
                    $('#ddllbltitle').html('Edit Committee Member');
                    
 
                    $("#editCommitteeMember").modal("show");
                }
                else {
                    alert(result.data);
                }
            }
        });
    }

    function clearCommitteeMember() {
        $('#CommitteeId').val('');
        $('#Designation').val('');
        $('#spanCommitteeId').html('');
        $('#spanDesignation').html('');
        $('#Designation').focus().focus().removeClass("red-border");
        
    }

    function Validate() {
        if ($('#hdnMode').val() == 'add') {
            if ($('#MemberId').val() == '') { $('#spanMemberId').html('Required.'); $('#MemberId').focus(); return false; } else { $('#spanMemberId').html(''); $('#MemberId').focus(); }
            if ($('#ChapterId').val() == '') { $('#spanChapterId').html('Required.'); $('#ChapterId').focus(); return false; } else { $('#spanChapterId').html(''); $('#ChapterId').focus(); }
            //if ($('#Designation').val() == '') { $('#spanDesignation').html('Required.'); $('#Designation').focus(); return false; } else { $('#spanDesignation').html(''); $('#Designation').focus(); }

        }
        return true;
    }

    function AddEditValidate(mode, CommitteeMemberId) {
        $('#hdnMode').val(mode);
        if (mode == 'add') {
            Add();
        }
        else {
            EditCommitteeMember(CommitteeMemberId);
        }
    }
</script>
<input id="hdnMode" type="hidden" value="add" />
<input id="hdnPageNo" type="hidden" value="1" />
