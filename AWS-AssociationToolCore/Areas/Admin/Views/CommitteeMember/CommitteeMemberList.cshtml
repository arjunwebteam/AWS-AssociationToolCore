@using System.Configuration;
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment env
@{
    Layout = null;
}
@{
    string sortcolumn = (string)ViewBag.sortcolumn;
    string sortorder = (string)ViewBag.sortorder;
    Int64 Total = (Int64)ViewBag.total;
    var PageNo = (Int64)ViewBag.pageno;
    var Items = (Int64)ViewBag.items;

    // ✅ Fixed: Session["BaseUrl"] → Context.Session.GetString("BaseUrl")
    var baseUrl = Context.Session.GetString("BaseUrl") ?? "";
    var imgloc = baseUrl + "Content/MemberProfileImages/";
    var imglocNormal1 = baseUrl + "Content/committees/normalphoto/";
    var imglocNormal = "~/Content/committees/normalphoto/";

    List<AWS_AssociationToolCore.Entities.Members> lstCommittees = ViewBag.lstCommittees;

    // ✅ Already correct
    string userRole = Context.Session.GetString("userrole") ?? string.Empty;
}

<script type="text/javascript">

    $(document).ready(function () {
        $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
        $('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
        $('#MWebsite').addClass('active');
    });

    function CommitteeStatus(CommitteeMemberId) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("CommitteeStatus", "CommitteeMember")', // the URL of the controller action method
            data: { CommitteeMemberId: CommitteeMemberId }, // optional data
            datatype: "JSON",
            success: function (result) {
                if (result.ok) {
                    showLobiboxNotification(result.messageType, result.message);
                    Onload($('#hdnPageNo').val());
                    
                }
                else {
                    $('#divmessage').html(result.data);
                    $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                }
            }
        });
    }

    function DeleteCommittee(CommitteeMemberId) {
        var val2 = confirm("Do you want to delete this record?");
        if (val2) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("DeleteCommitteeMember", "CommitteeMember")',  // the URL of the controller action method
                data: { CommitteeMemberId: CommitteeMemberId }, // optional data
                success: function (result) {
                    if (result.ok) {
                        showLobiboxNotification(result.messageType, result.message);
                        Onload($('#hdnPageNo').val());
                        
                    }
                    else {
                        $("#divmessage").val(result.data);
                        $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                    }
                },
            });
        }
    }

    function UpdateDisplayOrder(i, CommitteeMemberId) {
        var DisplayOrder = parseInt($('#DisplayOrder' + i).val());
        $.ajax({
            type: 'POST',
            url: '@Url.Action("CommitteeMemberDisplayOrder", "CommitteeMember")',
            data: { DisplayOrder: DisplayOrder, CommitteeMemberId: CommitteeMemberId },
            success: function (result) {
                showLobiboxNotification(result.messageType, result.message);

                if (result.ok) {
                    Onload(1);
                }
                else {
                    $("#divmessage").html(result.data);
                    $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                }
            }
        });
    }
</script>



<div class="card-body">
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th width="7%" style="text-align: center">S.No.</th>
                    <th width="8%">Picture</th>
                    <th width="12%">
                        <a onclick="javascript:sortresult('Name');" class="white-t-u black aws-h-a">
                            Name @if (sortcolumn == "Name")
                            {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                        </a>
                    </th>
                    <th width="12%">
                        <a onclick="javascript:sortresult('Email');" class="white-t-u black aws-h-a">
                            Email @if (sortcolumn == "Email")
                            {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                        </a>
                    </th>
                    <th width="12%">Phone</th>
                    <th width="12%">
                        <a onclick="javascript:sortresult('CategoryName');" class="white-t-u black aws-h-a">
                            Category Name @if (sortcolumn == "CategoryName")
                            {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                        </a>
                    </th>
                    <th width="9%">Display Order</th>
                    <th width="9%">Status</th>
                    <th width="8%">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (lstCommittees.Count != 0)
                {
                    int i = 0;
                    foreach (var item in lstCommittees)
                    {
                <tr valign="">
                    <td style="text-align:center">
                        @item.RId
                    </td>
                    @*<td>
                        @if (item.ProfileImage != null && item.ProfileImage != "")
                        {
                            <img width="40px" title="@item.Name" alt="@item.Name" src="@AWS_AssociationToolCore.BLL.Common.ValidateImage((imgloc + item.ProfileImage), imgloc + "no-image.png")" class="borwhite5 border-radius shadow" />
                        }
                        else
                        {
                            <img width="40px" title="@item.Name" alt="@item.Name" src="Content/MemberProfileImages/no-img.png" class="borwhite5 border-radius shadow" />
                        }
                    </td>*@


                    <td>
                           

                                <img width="100px" title="@item.CategoryName" alt="@item.CategoryName" src="@AWS_AssociationToolCore.BLL.Common.ValidateImage((imgloc + item.ProfileImage), imgloc + "no-image.jpeg")" class="borwhite5 border-radius shadow" />
                           

                               @*                        <img class="borwhite5 border-radius shadow" style="width:40px;border-radius:3px" src="@AWS_AssociationToolCore.BLL.Common.GetImagePath(imglocNormal, (item.ProfileImage != null && item.ProfileImage != "" ? item.ProfileImage : "N/A"), "~/Content/MemberProfileImages/no-img.png")" class="fl_img" alt="" width="100%">

 *@                   
</td>









                    @*<td style="text-align: left"><a href="@Url.Action("EditCommittee", "Committees", new { MemberId =  item.MemberId,CommitteeCategoryId= item.CommitteeCategoryId })"> @item.Name</a></td>*@

                            <td><a href="@Url.Action("EditMember", "Members", new { MemberId = item.MemberId })">@item.Name</a></td>
                    <td>@item.Email</td>
                    <td>@(item.MobilePhone != null && item.MobilePhone != "" ? item.MobilePhone : "N/A")</td>

                    <td>@(item.CategoryName != null && item.CategoryName != "" ? item.CategoryName : "N/A")</td>
                    <td style="text-align:center">
                        <input type="text" style="width:50px;margin-bottom:0px;" maxlength="3" id="DisplayOrder@(i)" value="@item.DisplayOrder" onkeypress="return Common.isNumberKey(event)" />
                        <a onclick="UpdateDisplayOrder(@i,@item.CommitteeMemberId);" title="Update"><i class="fa fa-fw fa-refresh"></i></a>

                    </td>
                    <td>
                        <div class="menu-hover">
                            @{ var isChecked = item.IsApproved ? "checked" : ""; }
                            @{var titleValue = item.IsApproved ? "Active" : "Disabled";}

                            <div>
                                <label class="switch" title="@titleValue">
                                    <input type="checkbox" onclick="CommitteeStatus(@item.CommitteeMemberId)" @isChecked>
                                    <span class="slider"></span>
                                </label>
                            </div>
                        </div>
                    </td>

                    <td class="text-center" style="text-align:center">
                        <div class="table-actions d-flex align-items-center gap-3 fs-6">
                            @if (ViewBag.IsEdit == true )
                            {
                                <a class="text-warning cursor-pointer" onclick="AddEditValidate('edit', @item.CommitteeMemberId);" title=" Edit" aria-label="Edit"><i class="bi bi-pencil-fill"></i></a>
                            }
                            @if (ViewBag.IsDelete == true )
                            {

                                <a class="text-danger cursor-pointer" onclick="javascript:DeleteCommittee(@item.CommitteeMemberId);" title="Delete" aria-label="Delete"><i class="bi bi-trash-fill"></i></a>

                            }
                        </div>
                    </td>
                </tr>
                        i++;
                    }
                }
                else
                {
                    <tr class="odd"><td valign="top" colspan="10" class="font-14 text-center">No  Records found</td></tr>

                }
            </tbody>
        </table>

    </div>



    <div class="row pt-3">
        <div class="col-sm-4 col-md-5">
            <div class="dataTables_info" id="example_info" role="status" aria-live="polite">
                Showing @((PageNo * Items) - (Items - 1)) - @((PageNo * Items) > Total ? Total : (PageNo * Items)) of @Total entries
            </div>
        </div>
        <div class="col-sm-3 col-md-7 " @(Total > 0 ? "" : "disable")>
            <div class="d-flex flex-wrap gap-4 justify-content-end">

                <div class="dataTables_paginate paging_simple_numbers" id="example_paginate">
                    @Html.Raw(AWS_AssociationToolCore.BLL.Common.SetPaging((Int64)ViewBag.items, ref Total, (Int64)ViewBag.pageno, "pagination pb-0"))
                </div>
            </div>
        </div>
    </div>
</div>
