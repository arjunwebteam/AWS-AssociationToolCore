@{
    ViewBag.Title = "AddMailTemplate";
    Layout = "~/Areas/Admin/Views/Shared/_MainLayout.cshtml";
    List<AWS_AssociationToolCore.Entities.Chapters> lstChapters = ViewBag.lstChapters;

    AWS_AssociationToolCore.Entities.News objNews = ViewBag.objNews;

    ViewBag.Pageheading = "Edit News";


    int status = 0;
    AWS_AssociationToolCore.BLL.PhotosImageSettings _PhotosImageSettings = new AWS_AssociationToolCore.BLL.PhotosImageSettings();
    AWS_AssociationToolCore.Entities.PhotosImageSettings objPhotosImageSettings = new AWS_AssociationToolCore.Entities.PhotosImageSettings();
    objPhotosImageSettings = _PhotosImageSettings.GetPhotosImageSettingsDetails(ref status);



    var Test = objPhotosImageSettings.Newssize; // Assuming objPhotosImageSettings.Eventsize is a string
    var parts = Test.Split('*');
    int value1 = 0;
    int value2 = 0;


    if (parts.Length == 2)
    {
        value1 = int.Parse(parts[0]);
        value2 = int.Parse(parts[1]);

        // Now you can use value1 and value2 as integers
    }
    else
    {
        // Handle the case where the split didn't produce two parts
        // This could happen if the input string doesn't contain '*'
        // or if there are more than one '*' characters in the string
    }

    AWS_AssociationToolCore.BLL.AppInfo _AppInfo = new AWS_AssociationToolCore.BLL.AppInfo();
    AWS_AssociationToolCore.Entities.AppInfo objAppInfo = new AWS_AssociationToolCore.Entities.AppInfo();
    objAppInfo = _AppInfo.GetAppInfoDetails(ref status);
    var cssloc = objAppInfo.BaseUrl + "Content/Admin/front-end-style.css";

    var imglocNormal = objAppInfo.BaseUrl + "Content/news/";


}
<script src="https://code.jquery.com/ui/1.11.4/jquery-ui.min.js"></script>
