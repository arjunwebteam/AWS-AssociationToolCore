<script>
            var appDateFormat = '@AWS_AssociationToolCore.BLL.AppDate.JqFormat';

    $(document).ready(function () {
        // Initialize datepickers
        $("#ExpiryDate, #PostDate").datepicker({
            changeMonth: true,
            changeYear: true,
            showButtonPanel: true,
            dateFormat: appDateFormat
        });

        // Initialize CKEditor inside document ready
        var editor = CKEDITOR.replace('Description', {
            contentsCss: '../css/editor.css'
        });
        CKFinder.setupCKEditor(editor, '@(objAppInfo.BaseUrl)ckfinder/');

        // Other initializations
        $('#wNews, #wOthers').addClass('active');
        $('#CropImage').dialog({
            autoOpen: false,
            width: 600,
            modal: true
        });

        $('#UpdatedBy').on('change', function () {
            $(this).valid();
        });

        // Validate form
        $("#SponsorForm").validate({
            submitHandler: function (form) {
                if (CKEDITOR.instances.Description.getData() == "") {
                    $('#spanDescription').html('<div class="invalid-feedback" style="display:block;">Description is required</div>');
                    return false;
                }
                $('#spanDescription').html('');
                form.submit();
            },
            rules: {
                UpdatedBy: "required",
                Title: "required",
                PostDate: "required",
                ExpiryDate: "required",
                OrderNo: "required",
            },
            messages: {
                UpdatedBy: "Please Select Type",
                Title: "Title is required",
                PostDate: "Post Date is required",
                ExpiryDate: "Expiry Date is required",
                OrderNo: "Order No is required",
            },
            errorElement: "div",
            errorPlacement: function (error, element) {
                error.addClass("invalid-feedback");
                error.insertAfter(element);
            },
            highlight: function (element) {
                $(element).addClass("is-invalid").removeClass("is-valid");
            },
            unhighlight: function (element) {
                $(element).addClass("is-valid").removeClass("is-invalid");
            }
        });
    });

    // Functions outside document ready
    function ResetValidateClass() {
        $('#Title').removeClass("validate");
        $('#Editor').removeClass("validate");
        $('#OrderNo').removeClass("validate");
    }

    function readURL(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                $('#blah').attr('src', e.target.result).width(@value1).height(@value2);
                $('#image').attr('src', e.target.result);
                $('#divimage').show();
                $('#noimagetext').hide();
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    function ChapterNameBind() {
        var ChapterNamecheckboxs = Common.GetCheckBoxValue('ChapterNamecheckbox');
        $('#ChapterIds').val(ChapterNamecheckboxs);
        if (ChapterNamecheckboxs == "") {
            alert("Please select atleast one Chapter.");
            return false;
        }
    }

    var _URL = window.URL || window.webkitURL;
    $("#file").change(function (e) {
        var file, img;
        if ((file = this.files[0])) {
            img = new Image();
            img.onload = function () {
                if (this.width == 670 && this.height == 542) {
                    $('#hdnimgvalidate').val('1');
                }
                else {
                    $('#hdnimgvalidate').val('0');
                }
            };
            img.src = _URL.createObjectURL(file);
        }
    });
</script>

<script src="Scripts/Admin/cropper-js-min.js" type="text/javascript"></script>
