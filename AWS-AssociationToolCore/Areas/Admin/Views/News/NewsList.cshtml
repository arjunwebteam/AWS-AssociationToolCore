@using AWS_AssociationToolCore.BLL
@using System.Configuration;
@{ Layout = null;}
@{
    string sortcolumn = (string)ViewBag.sortcolumn;
    string sortorder = (string)ViewBag.sortorder;
    Int64 Total = (Int64)ViewBag.total;
    var PageNo = (Int64)ViewBag.pageno;
    var Items = (Int64)ViewBag.items;


    List<AWS_AssociationToolCore.Entities.News> lstNews = ViewBag.lstNews;

    int status1 = 0;
    AWS_AssociationToolCore.BLL.AppInfo _appinfo = new AWS_AssociationToolCore.BLL.AppInfo();
    AWS_AssociationToolCore.Entities.AppInfo objAppInfo = _appinfo.GetAppInfoDetails(ref status1);

    var imgloc = objAppInfo.BaseUrl + "Content/Admin/news/thumbimages/";
    var imglocNormal = objAppInfo.BaseUrl + "Content/Admin/news/normalimages/";
    string userRole = Context.Session.GetString("userrole") ?? string.Empty;
}
 
    <script type="text/javascript">

    function NewsStatus(NewsId) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("NewsStatus", "News")', // the URL of the controller action method
            data: { NewsId: NewsId }, // optional data
            datatype: "JSON",
            success: function (result) {
                showLobiboxNotification(result.messageType, result.message);
                if (result.ok) {
                    //$('#divmessage').html(result.data);
                    //$('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                    NewsBind($('#hdnPageNo').val());
                }
                else {
                    $('#divmessage').html(result.data);
                    $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                }
            }
        });
    }

        function DeleteNews(NewsId, Title) {
        var val2 = confirm("Do you want to delete this record?");
        if (val2) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Delete", "News")',  // the URL of the controller action method
                data: { NewsId: NewsId, Title: Title }, // optional data
                success: function (result) {
                    showLobiboxNotification(result.messageType, result.message);
                    if (result.ok) {
                        //$('#divmessage').html(result.data);
                        //$('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                        NewsBind($('#hdnPageNo').val());
                    }
                    else {
                        $('#divmessage').html(result.data);
                        $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                    }
                },
            });
        }
    } 
        function UpdateOrderNo(i, NewsId) {
            var OrderNo = parseInt($('#OrderNo' + i).val());
            $.ajax({
                type: 'POST',
                url: '@Url.Action("NewsDisplayOrder", "News")',
                data: { OrderNo: OrderNo, NewsId: NewsId },
                success: function (result) {
                    var div = '';
                    showLobiboxNotification(result.messageType, result.message);
                    if (result.ok) {
                        //$("#divmessage").html(result.data);
                        //$('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                        NewsBind(1);
                    }
                    else {
                        $("#divmessage").html(result.data);
                        $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                    }
                }
            });
        }
    </script>
    <div class="card-body">
        <div class="table-responsive">

            @if (Total == -1)
            {
                <div class="norecords">Sorry failed processing your request.</div>
            }
            else
            {
                <table class="table table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>

                            <th width="40" class="text-center">S.No</th>
                            <th>
                                <a class="cursor-pointer aws-h-a " style="color: black;" onclick="javascript:sortresult('Title');">
                                    Title @if (sortcolumn == "Title")
                                    {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                                </a>
                            </th>
                            <th width="120">
                                <a class="cursor-pointer aws-h-a " style="color: black;" onclick="javascript:sortresult('PostDate');">
                                    Posted Date @if (sortcolumn == "PostDate")
                                    {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                                </a>
                                
                            </th>
                            <th width="120">
                                <a class="cursor-pointer aws-h-a " style="color: black;" onclick="javascript:sortresult('ExpiryDate');">
                                    Expiry Date @if (sortcolumn == "ExpiryDate")
                                    {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                                </a>
 
                            </th>
                           
                            <th width="120">
                                <a class="cursor-pointer aws-h-a " style="color: black;" onclick="javascript:sortresult('OrderNo');">
                                    Order No @if (sortcolumn == "OrderNo")
                                    {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                                </a>
                            </th>
                            <th width="80">Status</th>

                            <th class="text-center" width="80">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (lstNews.Count != 0)
                        {
                            int i = 0;
                            foreach (var item in lstNews)
                            {
                        <tr>
                            <td align="center">@item.RId</td>



                            <td>@item.Title</td>

                            <td>@item.PostDate.ToAppDate()</td>


                            <td>


                                @if (item.ExpiryDate == null || item.ExpiryDate == DateTime.MinValue)
                                {
                                    @("Default")
                                }
                                else
                                {
                                    @item.ExpiryDate.ToAppDate()
                                }


                            </td>


                            <td>
                                <input type="text" maxlength="3" style="width:50px;" id="OrderNo@(i)" value="@item.OrderNo" onkeypress="return Common.isNumberKey(event)" />
                                <a onclick="UpdateOrderNo(@i,@item.NewsId);" title="Update"><i class="fa fa-fw fa-refresh"></i></a>

                            </td>


                          
                            <td>
                                <div class="menu-hover">
                                    @{ var isChecked = item.IsActive ? "checked" : ""; }
                                    @{var titleValue = item.IsActive ? "Active" : "Disabled";}
                                    <div>
                                        <label class="switch" title="@titleValue">
                                            <input type="checkbox" onclick="NewsStatus(@item.NewsId)" @isChecked>
                                            <span class="slider"></span>
                                        </label>
                                    </div>
                                </div>
                            </td>

                            <td class="text-center">
                                <div class="table-actions d-flex align-items-center gap-3 fs-6">

                                    @if (ViewBag.IsEdit == true )
                                    {
                                        <a class="text-warning cursor-pointer" href="@Url.Action("EditNews", "News", new { NewsId = item.NewsId, mid = ViewBag.Mid })"  title=" Edit" aria-label="Edit"><i class="bi bi-pencil-fill"></i></a>
                                       

                                    }
                                    @if (ViewBag.IsDelete == true )
                                    {

                                        <a class="text-danger cursor-pointer" onclick="DeleteNews(@item.NewsId, '@item.Title');" title="Delete" aria-label="Delete"><i class="bi bi-trash-fill"></i></a>
                                    }
                                </div>


                            </td>




                        </tr>
                                i++;
                            }
                        }
                        else
                        {
                            <tr class="odd"><td valign="top" colspan="10" class="font-14 text-center">No  Records found</td></tr>
                        }
                    </tbody>
                </table>
            }



        </div>
    <div class="row pt-3">
        <div class="col-sm-4 col-md-5">
            <div class="dataTables_info" id="example_info" role="status" aria-live="polite">
                Showing @((PageNo * Items) - (Items - 1)) - @((PageNo * Items) > Total ? Total : (PageNo * Items)) of @Total entries
            </div>
        </div>
        <div class="col-sm-3 col-md-7 " @(Total > 0 ? "" : "disable")>
            <div class="d-flex flex-wrap gap-4 justify-content-end">

                <div class="dataTables_paginate paging_simple_numbers" id="example_paginate">
                    @Html.Raw(AWS_AssociationToolCore.BLL.Common.SetPaging((Int64)ViewBag.items, ref Total, (Int64)ViewBag.pageno, "pagination pb-0"))
                </div>
            </div>
        </div>
    </div>



    </div>
    <style>
        .aws-h-a {
            text-decoration: none;
            position: relative;
        }

            .aws-h-a::after {
                content: '';
                position: absolute;
                left: 0;
                right: 0;
                bottom: -2px;
                border-bottom: 2px solid #0756ca;
                transform: scaleX(0);
                transition: transform 0.3s ease;
            }

            .aws-h-a:hover::after {
                transform: scaleX(1);
            }
    </style>