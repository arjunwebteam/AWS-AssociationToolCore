                                {
                                    foreach (var item in lstChapters)
                                    {
                                        <option @(item.ChapterId == ChapterId ? "selected='selected'" : "") value="@item.ChapterId">@item.ChapterName</option>
                                    }
                                }


                            </select>
                            @*<span class="input-group-text pointer" style="cursor:pointer" onclick="MenuItemsBind(1);" id="basic-addon1"><i class="bi bi-search"></i></span>*@
</div>
                </div>
            </div>
            }
                <!--<div class="col-lg-3 col-md-3 col-6">
                    <div class="input-box">
                        <label class="form-label">Link Target</label>
                        <select class="single-select" id="UpdatedBy" name="UpdatedBy">
                            <option value="">Select Target Link</option>-->
                            @*<option value="">-- Select --</option>*@
                            <!--<option value="News">News</option>
                            <option value="Blog">Blog</option>

                        </select>
                    </div>
                </div>-->

                <div class="col-lg-2 col-md-3 col-6">
                    <div class="input-box">
                        <label class="form-label">Search<span class="text-danger"></span></label>
                        <div class="input-group mb-3">
                            <input type="text" class="form-control" name="keyword" id="keyword" placeholder="News Title">
                            @*<span class="input-group-text pointer" style="cursor:pointer" id="basic-addon1" onclick="Onload(1);"><i class="bi bi-search"></i></span>*@
                        </div>

                    </div>
                </div>



                <div class="ol-lg-3 col-md-3 col-6">
                    <div>
                        <label>&nbsp;</label>
                    </div>


                    <button type="button" class="btn btn-primary px-3" onclick="NewsBind(1);">Search</button>
                    <button type="submit" class="btn btn-danger px-3" onclick="ClearSearch();">Clear</button>
                </div>


                <div class="col-lg-2 col-4 text-end ms-auto">
                    <div class="btn-align">
                        @if (IsAdd == true )
                        {
                            <a class="btn btn-primary" href="@Url.Action("AddNews", "News", new { mid = Mid})">Add News</a>

                        }





                    </div>
