@{
    ViewBag.Title = "AddMailTemplate";
    Layout = "~/Areas/Admin/Views/Shared/_MainLayout.cshtml";

    ViewBag.Pageheading = "Add News";
    List<AWS_AssociationToolCore.Entities.Chapters> lstChapters = ViewBag.lstChapters;


    int status = 0;
    AWS_AssociationToolCore.BLL.PhotosImageSettings _PhotosImageSettings = new AWS_AssociationToolCore.BLL.PhotosImageSettings();
    AWS_AssociationToolCore.Entities.PhotosImageSettings objPhotosImageSettings = new AWS_AssociationToolCore.Entities.PhotosImageSettings();
    objPhotosImageSettings = _PhotosImageSettings.GetPhotosImageSettingsDetails(ref status);


    var Test = objPhotosImageSettings.Newssize; // Assuming objPhotosImageSettings.Eventsize is a string
    var parts = Test.Split('*');
    int value1 = 0;
    int value2 = 0;


    if (parts.Length == 2)
    {
        value1 = int.Parse(parts[0]);
        value2 = int.Parse(parts[1]);

        // Now you can use value1 and value2 as integers
    }
    else
    {
        // Handle the case where the split didn't produce two parts
        // This could happen if the input string doesn't contain '*'
        // or if there are more than one '*' characters in the string
    }

    AWS_AssociationToolCore.BLL.AppInfo _AppInfo = new AWS_AssociationToolCore.BLL.AppInfo();
    AWS_AssociationToolCore.Entities.AppInfo objAppInfo = new AWS_AssociationToolCore.Entities.AppInfo();
    objAppInfo = _AppInfo.GetAppInfoDetails(ref status);
    var cssloc = objAppInfo.BaseUrl+ "Content/Admin/front-end-style.css";

}

<script type="text/javascript" src="ckeditor/ckeditor.js"></script>


<script type="text/javascript">

    $(document).ready(function () {

        $('#wNews, #wOthers').addClass('active');
        $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
        $('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');



        $('#CropImage').dialog({
            autoOpen: false,
            width: 600,
            modal: true
        });

    });

    function ChapterNameBind() {

        var ChapterNamecheckboxs = Common.GetCheckBoxValue('ChapterNamecheckbox');

        $('#ChapterIds').val(ChapterNamecheckboxs);
        if (ChapterNamecheckboxs == "") {
            alert("Please select atleast one Chapter.");
            return false;
        }

    }

    function ResetValidateClass() {

        $('#UpdatedBy').removeClass("validate");
        $('#Title').removeClass("validate");
        $('#PostDate').removeClass("validate");
        $('#ExpiryDate').removeClass("validate");

        $('#Editor').removeClass("validate");
        $('#OrderNo').removeClass("validate");
    }

    $(document).ready(function () {
        $('#wNews').addClass('active');
        $('#Others').addClass('active');
        $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
        $('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');

    });


    function readURL(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();

            reader.onload = function (e) {
                $('#blah')
                    .attr('src', e.target.result)
                    .width(@value1)
                    .height(@value2);
                $('#image').attr('src', e.target.result);
                $('#divimage').show();
                $('#noimagetext').hide();
            };

            reader.readAsDataURL(input.files[0]);
        }
    }




</script>
