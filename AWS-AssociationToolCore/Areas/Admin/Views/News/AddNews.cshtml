@using (Html.BeginForm("Save", "News", FormMethod.Post, new { enctype = "multipart/form-data", @id = "VolunteerForm", @name = "VolunteerForm" }))
{



    if (objAppInfo.chapterStatus == "No")
    {
        <input type="hidden" value="1" name="ChapterIds" id="ChapterIds" />
    }
    else
    {
        <input type="hidden" value="" name="ChapterIds" id="ChapterIds" />

    }




    <input type="hidden" value="@ViewBag.mid" name="mid" id="mid" />

    <div class="card">
        <div class="card-body">

            <div class="row  g-3">


                <div class="col-lg-3 col-md-6">
                    <div class="input-box">
                        <label class="form-label">Type </label>
                        <select class="single-select" id="UpdatedBy" name="UpdatedBy">
                            <option value="">Select Target</option>
                            <option value="News">News</option>
                     


                        </select>
                    </div>
                </div>


                <div class="col-lg-3 col-md-6">
                    <div class="input-box">
                        <label class="form-label">Title<span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="Title" id="Title" placeholder="Title">
                    </div>
                </div>


                <div class="col-lg-3 col-md-6">
                    <div class="input-box">
                        <label class="form-label">Post Date<span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="PostDate" id="PostDate" placeholder="@AWS_AssociationToolCore.BLL.AppDate.Key">
                    </div>
                </div>



                <div class="col-lg-3 col-md-6">
                    <div class="input-box">
                        <label class="form-label">Expiry Date <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="ExpiryDate" id="ExpiryDate" placeholder="@AWS_AssociationToolCore.BLL.AppDate.Key">
                    </div>
                </div>


                <div class="col-lg-3 col-md-6">
                    <div class="input-box">
                        <label class="form-label">Order No<span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="OrderNo" id="OrderNo" onkeypress="return Common.isNumberKey(event);" placeholder="Order No">
                    </div>
                </div>



                <div class="col-lg-3 col-md-6">
                    <div class="input-box">
                        <label class="form-label">
                            Image
                            <button type="button" data-bs-toggle="tooltip" title="Image size should be maintained width * height (@objPhotosImageSettings.Newssize)" class="" style="border: 0;background: transparent;padding: 0px;"><i class="bi bi-info-circle"></i></button>

                        </label>
                        <div class="position-relative">
                            <input type="file" id="file" class="item-img file center-block browse form-control" name="file">
                        </div>
                        <!--<label style="color: #f00;" id="lblfile"></label>-->
                        @*<label><b style="color: #f00;font-size:15px">Note :</b> Document should accept only 'PDF' file Format. </label>*@

                        <!--<div style="font-size:13px; line-height:26px;">
                            <span style="color:#ff0000; text-decoration:underline; font-weight:600">Note :</span> <b style="color: #f00; font-size: 15px"></b> Image size should be maintained width * height (@objPhotosImageSettings.Newssize)<br>

                            <span><b>1)</b>&nbsp;To resize Banners width &amp; height, please use <a href="https://picresize.com/" target="_blank">picresize.com</a>. </span><br>
                            <span><b>2)</b>&nbsp;To Optimize Banners width &amp; height, please use <a href="https://imagecompressor.com/" target="_blank">imagecompressor.com</a>. </span>
                        </div>-->

                        <div class="confirm-identity">
                            <div class="ci-user d-flex align-items-center justify-content-center">
                                <div class="ci-user-picture" style="display: none;">
                                    <input type="hidden" id="Thumbimage" name="Thumbimage">
                                    <img src="" id="item-img-output" class="imgpreviewPrf img-fluid" alt="">
                                </div>
                            </div>

                        </div>



                    </div>
                </div>



            </div>

        </div>
    </div>







    if (objAppInfo.chapterStatus == "Yes")
    {
        <div class="card">
            <div class="card-body">

                <div class="box validation">
                    <!-- /.box-header -->
                    <div class="box-header">
                        <h3 class="box-title dis-in mb-2">Chapters </h3>
                    </div>
                    <div class="box-body">

                        @if (lstChapters != null && lstChapters.Count != 0)
                        {
                            int i = 1;
                            <div class="row">
                                @foreach (var item in lstChapters)
                                {
                                    if (item.ChapterName != "NATS Global")
                                    {

                                        <div class="col-md-3 col-xs-6 col-xxl-2">
                                            <span class="radiostyle part-4 mb-2 d-block">
                                                <input type="checkbox" @*@(i == item.ChapterId ? "checked=checked" : "")*@ name="ChapterNamecheckbox" id="ChapterNamecheckbox-@i" class="flat-red" value="@item.ChapterId"> @item.ChapterName
                                           
                                            
                                            </span>
                                        </div>
                                    }
                                    i++;
                                }
                            </div>
                        }

                    </div>
                </div>

            </div>
        </div>


    }



    <div class="card">
        <div class="card-body">

            <div class="box validation">
                <div class="box-header">
                    <h3 class="box-title dis-in"> Description</h3>
                </div>
                <div class="box-body">
                    <div class="row  g-3">
                        <div class="col-lg-12">
                            <div class="input-box">
                                @*<label>Description </label>*@
                                <textarea rows="10" placeholder="Description *" name="NewsText" id="NewsText" cols="80" style="visibility: hidden; display: none;"></textarea><br />
                                <span class="field-validation-error" id="spanDescription"></span>
                                <script type="text/javascript">
                                    // var editor = CKEDITOR.replace('NewsText', { contentsCss: '../css/editor.css' });
                                    // CKFinder.setupCKEditor(editor, '@(objAppInfo.BaseUrl)ckfinder/');




                                                                        var editor = CKEDITOR.replace('NewsText', {
                                        contentsCss: '../css/editor.css',
                                        filebrowserBrowseUrl: '/filemanager/browse.html',
                                        filebrowserImageBrowseUrl: '/filemanager/browse.html',
                                        filebrowserUploadUrl: '/api/filemanager/upload',
                                        filebrowserImageUploadUrl: '/api/filemanager/upload'
                                    });





                                </script>
                            </div>
                        </div>


                    </div>
                </div>

            </div>
        </div>
    </div>



    if (objAppInfo.chapterStatus == "Yes")
    {
        <div class="row">
            <div class="col-lg-2 col-3 text-end ms-auto">
                <button type="submit" onclick="return ChapterNameBind();" class="btn btn-success px-3">@*<i class="bi bi-plus-circle m-0"></i>*@ Submit</button>
                <a class="btn btn-primary px-3" href="@Url.Action("Index", "News", new { mid = ViewBag.mid })">Cancel</a>

            </div>
        </div>
    }



    else
    {
        <div class="row">
            <div class="col-lg-2 col-3 text-end ms-auto">
                <button type="submit" class="btn btn-success px-3">@*<i class="bi bi-plus-circle m-0"></i>*@ Submit</button>
                <a class="btn btn-primary px-3" href="@Url.Action("Index", "News", new { mid = ViewBag.mid })">Cancel</a>

            </div>
        </div>


    }
}

