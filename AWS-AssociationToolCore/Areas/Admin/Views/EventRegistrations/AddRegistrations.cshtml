   function calculate_total(plist, count, ecount, regcount,RegistrationTitle) {

        if (RegValidate(plist, count, ecount, regcount)) {
            document.getElementById("amount" + plist).innerHTML = "$" + ($('#hamount' + plist).val() * $('#people' + plist).val());
            total5 = 0;
            var z = 0;
            for (i = 1; i <= @lstEventRegistrationTypes.Count; i++) {
                p = document.getElementById('people' + i).value;
                p = parseInt(p);
                if (p > 0) {
                    total5 = total5 + (p * $('#hamount' + i).val());
                }
            }

            total5 = parseFloat(total5).toFixed(2);



            $('#AmountPaid').val(total5);
            $('#TotalAmount').html(total5);


        }
    }

    function PaymentMethodBind() {

        var PaymentMethod = $('#PaymentMethodId').val();
        if (PaymentMethod == 3) {
            $('#ChequeHolderNamehide').show()
            $('#ZellePartnerNamehide').hide()
        }
        else if (PaymentMethod == 6) {
            $('#ChequeHolderNamehide').hide()
            $('#ZellePartnerNamehide').show()
        }
        else {
            $('#ChequeHolderNamehide').hide()
            $('#ZellePartnerNamehide').hide()
        }
    }

    function paymentbind(type) {
        $('#PaymentType').val(type);
    }
    function scrollToSection() {
        $('#ServicesHistoryhide').show();
        const targetElement = document.getElementById("ServicesHistoryhide");
        if (targetElement) {
            const offset = 100; // Adjust as needed for headers
            const elementPosition = targetElement.getBoundingClientRect().top;
            const offsetPosition = elementPosition + window.pageYOffset - offset;

            window.scrollTo({
                top: offsetPosition,
                behavior: "smooth"
            });
        } else {
            console.error("Element with id 'DonationHistoryhide' not found.");
        }
    }
     function Validate(id, stype, count) {

        var return_val = true;
        
        var validval = 1;
        for (v = 1; v <= @lstEventRegistrationTypes.Count; v++) {
            if ($('#people'+v).val() == '' && validval == 1)
            {
                validval = 1;
            }
            else {
                validval = 0;
            }
        }
        if (validval == 1 && id == 1) {
            if (@lstEventRegistrationTypes.Count > 0)
                {
                    alert("Please select atleast one Registration Category .");
                    return_val = false;
                }
            }


        return return_val;
    }
</script>
