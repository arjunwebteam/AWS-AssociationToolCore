@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_MainLayout.cshtml";
    ViewBag.Pageheading = "Event Registrations";
    Int64 ChapterId = ViewBag.ChapterId;

    Int64 EventId = ViewBag.EventId;
    string EventName = ViewBag.EventName;
    List<AWS_AssociationToolCore.Entities.EventRegistrationTypes> lstEventRegistrationTypes = ViewBag.lstEventRegistrationTypes;

    string userRole = HttpContextAccessor.HttpContext.Session.GetString("userrole") ?? "";

    bool IsEdit = Convert.ToBoolean(Context.Session.GetString("IsEdit"));
    bool IsView = Convert.ToBoolean(Context.Session.GetString("IsView"));
    bool IsDelete = Convert.ToBoolean(Context.Session.GetString("IsDelete"));
    bool IsExport = Convert.ToBoolean(Context.Session.GetString("IsExport"));
    bool IsAdd = Convert.ToBoolean(Context.Session.GetString("IsAdd"));
    Int64 Mid = ViewBag.mid;

    // ✅ NEW: AppInfo (export mode kosam)
    int appStatus = 0;
    AWS_AssociationToolCore.BLL.AppInfo _AppInfo = new AWS_AssociationToolCore.BLL.AppInfo();
    AWS_AssociationToolCore.Entities.AppInfo objAppInfo = _AppInfo.GetAppInfoDetails(ref appStatus);
}



<input id="hdnPageNo" type="hidden" value="1" />
<input id="hdnsortorder" name="hdnsortorder" value="DESC" type="hidden" />
<input id="hdnsortcolumn" name="hdnsortcolumn" value="UpdatedTime" type="hidden" />

<script>
    $(document).ready(function () {
        $('#wEvents').addClass('active');

        // ✅ Load list on page load
        EventRegistrationBind(1);

        $('.showhmap').click(function () {
            $('.hmap').toggle("slow");
        });

        $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
        $('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');

        PagerClickBind();
    });

    function sortresult(sortcolumn) {
        $('#hdnsortorder').val($('#hdnsortorder').val() === 'ASC' ? 'DESC' : 'ASC');
        $('#hdnsortcolumn').val(sortcolumn);
        EventRegistrationBind(1);
    }

    // ✅ Main list loader
    function EventRegistrationBind(Pageno) {
        var pageno = Common.Pageno(Pageno);
        $.ajax({
            url: '@Url.Action("EventUsersList", "EventRegistrations")',
            type: 'GET',
            cache: false,
            data: {
                search:     $('#txtsearch').val(),
                EventId:    '@EventId',
                PageNo:     pageno,
                SortColumn: $('#hdnsortcolumn').val(),
                SortOrder:  $('#hdnsortorder').val(),
                Items:      $('#txtitems').val(),
                IsEdit:     '@IsEdit',
                IsView:     '@IsView',
                IsDelete:   '@IsDelete',
                IsExport:   '@IsExport',
                IsAdd:      '@IsAdd',
                Mid:        '@Mid'
            },
            success: function (result) {
                $('#divEventsList').html(result);
                PagerClickBind();
            },
            error: function () {
                $('#divEventsList').html('<p class="text-danger">Failed to load registrations.</p>');
            }
        });
    }

    function ClearSearch() {
        $('#txtsearch').val('');
        $('#hdnPageNo').val(1);
        EventRegistrationBind(1);
    }

    function Delete(EventUserInfoId) {
        if (!confirm("Do you want to delete this record?")) return;
        $.ajax({
            type: "POST",
            url: '@Url.Action("DeleteEventUser", "EventRegistrations")',
            data: { EventUserInfoId: EventUserInfoId },
            success: function (result) {
                showLobiboxNotification(result.messageType, result.message);
                EventRegistrationBind($('#hdnPageNo').val());
            },
            error: function () {
                $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
            }
        });
    }

    // ================= Export to Excel (with field selection modal) =================
    // AppInfo.ExportExel value ("Selected" aithe modal open avutundi, lekapothe direct all fields download)
    var exportMode = '@(objAppInfo?.ExportExel ?? "")';

    function BuildExportUrl(selectedFields) {
        var url = '@Url.Action("EventuserExporttoExcel", "EventRegistrations")'
            + '?Search=' + encodeURIComponent($('#txtsearch').val() || '')
            + '&EventId=' + encodeURIComponent('@EventId')
            + '&SortColumn=' + encodeURIComponent($('#hdnsortcolumn').val() || '')
            + '&SortOrder=' + encodeURIComponent($('#hdnsortorder').val() || '');
        if (selectedFields) {
            url += '&SelectedFields=' + encodeURIComponent(selectedFields);
        }
        return url;
    }

    function ExporttoExcel() {
        // "Selected" kakapothe modal open avvadu, direct ga all fields download
        if ((exportMode || '').toLowerCase() !== 'advacnce') {
            window.location.href = BuildExportUrl('');
            return;
        }

        $('#exportFieldsValidation').addClass('d-none');
        $('#exportFieldsList').html('<div class="text-center text-muted py-4">Loading fields...</div>');
        $('#exportFieldsModal').modal('show');

        $.ajax({
            url: '@Url.Action("GetEventRegistrationExportFields", "EventRegistrations")',
            type: 'GET',
            cache: false,
            data: { EventId: '@EventId', Search: $('#txtsearch').val() || '' },
            success: function (result) {
                if (!result.ok) {
                    $('#exportFieldsList').html('<div class="text-danger">' + result.message + '</div>');
                    return;
                }

                // section wise group chey
                var groups = {}, order = [];
                $.each(result.data, function (i, f) {
                    var key = f.fieldKey !== undefined ? f.fieldKey : f.FieldKey;
                    var name = f.displayName !== undefined ? f.displayName : f.DisplayName;
                    var sec = (f.section !== undefined ? f.section : f.Section) || 'Fields';
                    if (!groups[sec]) { groups[sec] = []; order.push(sec); }
                    groups[sec].push({ key: key, name: name });
                });

                var html = '';
                $.each(order, function (s, sec) {
                    html += '<div class="exp-section-title">' + sec + '</div><div class="exp-grid">';
                    $.each(groups[sec], function (i, f) {
                        html += '<label class="exp-item"><span>' + f.name + '</span>'
                              + '<input type="checkbox" class="export-field-chk" value="' + f.key + '" checked></label>';
                    });
                    if (groups[sec].length % 2 === 1) { html += '<div class="exp-item exp-filler"></div>'; }
                    html += '</div>';
                });

                $('#exportFieldsList').html(html || '<div class="text-muted">No exportable fields found.</div>');
            },
            error: function () {
                $('#exportFieldsList').html('<div class="text-danger">Failed to load export fields.</div>');
            }
        });
    }

    function ExportFieldsSelectAll(state) {
        $('.export-field-chk').prop('checked', state);
    }

    function ExportSelectedFieldsToExcel() {
        var selected = $('.export-field-chk:checked').map(function () { return this.value; }).get();
        if (selected.length === 0) {
            $('#exportFieldsValidation').removeClass('d-none');
            return;
        }
        $('#exportFieldsValidation').addClass('d-none');
        $('#exportSpinner').removeClass('d-none');
        $('#btnExportToExcel').prop('disabled', true);

        window.location.href = BuildExportUrl(selected.join(','));

        // file download navigation kabatti callback undadu, konchem tarvata reset chestam
        setTimeout(function () {
            $('#exportSpinner').addClass('d-none');
            $('#btnExportToExcel').prop('disabled', false);
            $('#exportFieldsModal').modal('hide');
        }, 1500);
    }

    // ✅ Single, correct PagerClickBind — fixed OrderBind → EventRegistrationBind
    function PagerClickBind() {
        $(document).off("click", ".pagination .page-link").on("click", ".pagination .page-link", function () {
            var id = $(this).attr("id");
            var pageNo;

            if (id === "Previous" || id === "Next") {
                pageNo = parseInt($(this).data("page"));
            } else {
                pageNo = parseInt(id);
            }

            if (!pageNo || isNaN(pageNo) || pageNo < 1) return;

            $('#hdnPageNo').val(pageNo);
            EventRegistrationBind(pageNo);
        });
    }
</script>

<div class="card">
    <div class="card-header py-3 mb-3">
        <div class="row gx-2">

            <div class="col-lg-2 col-md-6 col-8">
                <div class="input-box">
                    <label class="form-label">Search</label>
                    <div class="input-group mb-3">
                        <input type="text" class="form-control" name="txtsearch" id="txtsearch"
                               placeholder="Search by Name / Email / Phone No" />
                    </div>
                </div>
            </div>

            <div class="col-lg-2 col-2" id="clearhide">
                <div><label>&nbsp;</label></div>
                <button type="button" class="btn btn-primary px-3" onclick="EventRegistrationBind(1);">Search</button>
                <button type="button" class="btn btn-danger px-3" onclick="ClearSearch();">Clear</button>
            </div>

            <div class="col-lg-8 col-2 text-end" id="clearhide">

                <div><label>&nbsp;</label></div>
                @* 
                <a class="btn btn-primary t-m15 white-t showhmap"
                   style="background-color:#F94C02; background-image:linear-gradient(to bottom right,#F94C02 0%,#F93002 100%); border-color:#f93402;">
                    Ticket Availability
                </a> *@

                @if (IsAdd)
                {
                    <a href="@Url.Action("AddRegistrations", "EventRegistrations", new { EventId, EventName, mid = Mid })"
                       class="btn btn-primary px-3">
                        Add Registration
                    </a>
                }

                @if (IsExport)
                {
                    <a class="cursor-pointer do"
                       data-bs-toggle="tooltip"
                       onclick="ExporttoExcel();"
                       title="Export Data"
                       style="border:0; background:transparent; border:1px solid #e8e6e7; padding:10px; border-radius:50%; background-color:#e8e6e7;">
                        <i class="lni lni-download" style="font-size:20px; color:black;"></i>
                    </a>
                }
            </div>

        </div>
    </div>

    <div class="card-header" style="border-bottom:0;">
        <div class="grayBackground nobL nobR hmap b-p10" style="display:none;">
            <div class="text-center">
                <h4><b>Ticket Availability:</b></h4>
            </div>
            <div class="filedsetInner clearfix">
                <table class="table table-hover table_vam font13" width="100%">
                    <thead>
                        <tr>
                            <th width="7%" style="background-color:#b20400; color:white;">S.No</th>
                            <th width="43%" style="background-color:#b20400; color:white;">Registration Type</th>
                            <th width="10%" style="background-color:#b20400; color:white;">Registrations</th>
                            <th width="10%" style="background-color:#b20400; color:white;">BOGO25</th>
                            <th width="10%" style="background-color:#b20400; color:white;">TANA25</th>
                            <th width="10%" style="background-color:#b20400; color:white;">NAGA25</th>
                            <th width="10%" style="background-color:#c5e955;">No.of Tickets</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>

    <div id="divEventsList"></div>
</div>

<!-- ================= Export Fields Popup ================= -->
<div class="modal fade" id="exportFieldsModal" tabindex="-1" aria-labelledby="exportFieldsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <div class="exp-eyebrow">Export to Excel</div>
                    <h5 class="exp-title" id="exportFieldsModalLabel">Event Registrations</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="exportFieldsValidation" class="alert alert-danger d-none py-2" role="alert">
                    Please select at least one field to export.
                </div>
                <div class="exp-toolbar">
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="ExportFieldsSelectAll(true);">Select All</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="ExportFieldsSelectAll(false);">Clear All</button>
                </div>
                <div id="exportFieldsList">
                    <div class="text-center text-muted py-4">Loading fields...</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-export-cancel" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-export-data" id="btnExportToExcel" onclick="ExportSelectedFieldsToExcel();">
                    <span id="exportSpinner" class="spinner-border spinner-border-sm d-none me-1" role="status" aria-hidden="true"></span>
                    Export Data
                </button>
            </div>
        </div>
    </div>
</div>

<script>

    $(document).ready(function () {
        $.ajax({
            type : "GET",
            url  : '@Url.Action("EventUsersList", "EventRegistrations")',
            data : {
                IsEdit    : '@IsEdit',
                IsView    : '@IsView',
                IsDelete  : '@IsDelete',
                IsExport  : '@IsExport',
                IsAdd     : '@IsAdd',
                Mid       : '@Mid',
                EventId:    '@EventId',
                ChapterId : '@(ChapterId == 0 ? 1 : ChapterId)'
            },
            success: function (data) {
                $("#divEventsList").html(data);
            },
            error: function () {
                $("#divEventsList").html('<p class="text-danger">Failed to load.</p>');
            }
        });
    });
</script>
