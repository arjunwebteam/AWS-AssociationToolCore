                                    <td style="text-align: left">@item.ZipCode</td>

                                    <td style="text-align: left">@Math.Round(item.Amount, 2)</td>
                                    <td style="text-align: left">@item.TransactionId</td>
                                    <td style="text-align: left">@item.PaymentMethod</td>
                                    <td style="text-align: left">@item.PaymentStatus</td>
                                    <td style="text-align: left">@item.Address1</td>
                                    <td style="text-align: left">@item.Address2</td>
                                    <td style="text-align: left">@item.UpdatedBy</td>



                                    <td style="text-align: center">
                                        @item.UpdatedDate.ToString("MM/dd/yyyy")&nbsp;@item.UpdatedDate.ToString("hh:mm:ss tt")
                                    </td>




                                </tr>

                                i++;

                            }
                        }
                        else
                        {
                            <tr class="odd"><td valign="top" colspan="25" class="font-14 text-center">No data found</td></tr>
                        }
                    </tbody>*@
            </table>
        </div>

    </div>
</div>
