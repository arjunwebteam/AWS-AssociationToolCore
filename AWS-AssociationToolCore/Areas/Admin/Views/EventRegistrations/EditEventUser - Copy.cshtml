<script>
    function toggleTickets(type) {

        const icon = document.getElementById('icon-' + type);
        const header = document.getElementById('header-' + type);
        const isExpanded = icon.classList.contains('expanded');

        // Get all ticket rows for this type
        const ticketRows = document.querySelectorAll(`[id^="ticket-${type}-"]`);

        if (isExpanded) {
            // Collapse
            header.classList.add('hidden');
            ticketRows.forEach(row => row.classList.add('hidden'));
            icon.textContent = '▶';
            icon.classList.remove('expanded');
        } else {
            // Expand
            header.classList.remove('hidden');
            ticketRows.forEach(row => row.classList.remove('hidden'));
            icon.textContent = '▼';
            icon.classList.add('expanded');
        }
    }

    // Add smooth animations
    document.addEventListener('DOMContentLoaded', function () {
        const sections = document.querySelectorAll('.section');
        sections.forEach((section, index) => {
            section.style.opacity = '0';
            section.style.transform = 'translateY(20px)';

            setTimeout(() => {
                section.style.transition = 'all 0.7s ease';
                section.style.opacity = '1';
                section.style.transform = 'translateY(0)';
            }, index * 100);
        });
    });


    function allocateSeat(eventticketId, ticketId) {
        var seatNo = document.getElementById("seat-" + eventticketId).value;
        var EventUserInfoId = @objEventUserInfo.EventUserInfoId;
        var EventId = @objEventUserInfo.EventId;
        var email = '@objEventUserInfo.Email';
        if (!seatNo) {
            alert("Please enter a seat number.");
            return;
        }

        // Ask admin whether to notify attendee
        if (confirm("Do you want to send seating details to the attendee via email?")) {
            notify = true;
        } else {
            notify = false;
        }

        $.ajax({
            url: '/EventRegistrations/AllocateSeat',
            type: 'POST',
            data: { eventticketId: eventticketId, TicketId: ticketId, seatNo: seatNo, EventUserInfoId: EventUserInfoId, EventId: EventId, notify: notify, email: email },
            success: function (response) {
                alert(response.message);
            },
            error: function () {
                alert("Error allocating seat. Please try again.");
            }
        });
    }
</script>
