@{

    ViewBag.Title = "Index";
    ViewBag.Pageheading = " Membership Types";

    Layout = "~/Areas/Admin/Views/Shared/_MainLayout.cshtml";
    List<AWS_AssociationToolCore.Entities.Chapters> lstChapters = ViewBag.lstChapters;
    Int64 ChapterId = ViewBag.ChapterId;
    string userRole = Context.Session.GetString("userrole") ?? string.Empty;

    bool IsEdit = Convert.ToBoolean(Context.Session.GetString("IsEdit"));
    bool IsView = Convert.ToBoolean(Context.Session.GetString("IsView"));
    bool IsDelete = Convert.ToBoolean(Context.Session.GetString("IsDelete"));
    bool IsExport = Convert.ToBoolean(Context.Session.GetString("IsExport"));
    bool IsAdd = Convert.ToBoolean(Context.Session.GetString("IsAdd"));
    Int64 Mid = ViewBag.mid;



    int status = 0;
    AWS_AssociationToolCore.BLL.AppInfo _AppInfo = new AWS_AssociationToolCore.BLL.AppInfo();
    AWS_AssociationToolCore.Entities.AppInfo objAppInfo = new AWS_AssociationToolCore.Entities.AppInfo();
    objAppInfo = _AppInfo.GetAppInfoDetails(ref status);

}

<script type="text/javascript">

    $(document).ready(function () {
        $('#wMembership, #wMembershipTypes').addClass('active');
        $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
        $('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
        /*$("#Validity").datepicker({ changeMonth: true, changeYear: true, yearRange: "-90:+0", altFormat: 'mm/dd/yy' });*/

        PagerClickBind();

    });

    function PagerClickBind() {
        $(".pagination a").bind("click", function () {
            MembershipTypeBind($(this).text());
        });
    }


    function sortresult(sortcolumn) {
        $('#hdnsortorder').val(($('#hdnsortorder').val() == 'ASC' ? 'DESC' : 'ASC'));
        $('#hdnsortcolumn').val(sortcolumn);
        MembershipTypeBind(1);
    }

    function Add() {
        clearMembershipType();
        $("#AddMembershipType").modal('show');
        $('#lbltitle').html('Add Membership Type');
    }

    function clearMembershipType() {
        $("#MembershipTypeId").val('');
        $('#MembershipType').val('');
            $('#ChapterId').val('1').trigger('change');
        $('#spanMembershipType').html('');
        $('#Price').val('');
        $('#spanPrice').html('');
        $("#AddMembershipType").modal('hide');
        $('#MembershipType').focus().removeClass("red-border");
        $('#Price').focus().removeClass("red-border");
        MembershipTypeBind
    }

      function MembershipTypeBind(Pageno) {
        var pageno = Common.Pageno(Pageno);
        var sortcolumn = $('#hdnsortcolumn').val();
        var sortorder = $('#hdnsortorder').val();
        var items = $('#txtitems').val();

        // ✅ Read from the correct dropdown ID
        var ChapterId = $('#ddlSearchChapterId').val();
        ChapterId = (ChapterId == 0 || ChapterId == "0" || ChapterId == "") ? 1 : ChapterId;

        $.ajax({
            url: '@Url.Action("MembershipTypesList", "MembershipTypes")',
            type: 'GET',
            cache: false,
            data: {
                ChapterId: ChapterId,
                PageNo: pageno,
                SortColumn: sortcolumn,
                SortOrder: sortorder,
                Items: items,
                IsEdit: '@IsEdit',
                IsView: '@IsView',
                IsDelete: '@IsDelete',
                IsExport: '@IsExport',
                IsAdd: '@IsAdd',
                Mid: '@Mid'
            },
            success: function (result) {
                $('#divMembershipType').html(result);
                PagerClickBind();
            }
        });
    }

    function MembershipTypeEdit(MembershipTypeId) {
        $.ajax({
            url: '@Url.Action("EditMembershipTypes", "MembershipTypes")',
            type: 'POST',
            data: { MembershipTypeId: MembershipTypeId },
            datatype: "JSON",
            success: function (result) {
                if (result.ok) {
                    var objMembershipType = result.data;
                    $('#MembershipTypeId').val(objMembershipType.MembershipTypeId);
                    $('#MembershipType').val(objMembershipType.MembershipType);
                    // $('#ChapterName').val(objMembershipType.ChapterName);

    $('#ddlChapterId').val(String(objMembershipType.ChapterId));
                    $('#Price').val(objMembershipType.Price);
                    $('#FormattedField').val(objMembershipType.FormattedField);

                    //var Date = Common.ConvertDate(objMembershipType.Validity);
                    $('#Validity').val(objMembershipType.Validity);
                    if (objMembershipType.Validity != 0) {
                        $('#Validity').show();
                        var arr = document.getElementsByName('mval');
                        arr[1].checked = true;
                        arr[0].checked = false;
                    }
                    $('#DisplayOrder').val(objMembershipType.DisplayOrder);
                    $('#lbltitle').html('Edit Membership Type');

                    $('#MembershipType').focus().removeClass("red-border");
                    $('#Price').focus().removeClass("red-border");
                    $('#spanMembershipType').html('');
                    $('#spanPrice').html('');
                    $('#Validity').removeClass("red-border");
                    $('#spanValidity').html('');

                    $("#AddMembershipType").modal('show');
                }
                else {
                    alert(result.data);
                }
            }
        });
    }

    function MembershipTypeSave() {
        var objMembershipType = {};
        objMembershipType.MembershipTypeId = $('#MembershipTypeId').val();
        objMembershipType.MembershipType = $('#MembershipType').val();
        objMembershipType.Price = $('#Price').val();
        objMembershipType.Validity = $('#Validity').val();
        objMembershipType.DisplayOrder = $('#DisplayOrder').val();

        $.ajax({
            url: '@Url.Action("AddMembershipTypes", "MembershipTypes")',
            type: 'POST',
            data: JSON.stringify(objMembershipType),
            datatype: "JSON",
            contentType: 'application/json',
            success: function (result) {
                showLobiboxNotification(result.messageType, result.message);

                if (result.ok) {
                    //$("#divmessage").html(result.data);
                    MembershipTypeBind($('#hdnPageNo').val());

                    $("#AddCommitteeCategory").modal("hide");
                    $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                    $('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                }
                else {
                    $("#spanCategoryName").html(result.data);
                    $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                    $('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                }
            }
        });
    }

    function Delete(MembershipTypeId) {
        var val2 = confirm("Do you want to delete this record?");
        if (val2) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("DeleteMembershipTypes", "MembershipTypes")',  // the URL of the controller action method
                data: { MembershipTypeId: MembershipTypeId }, // optional data
                success: function (result) {
                    showLobiboxNotification(result.messageType, result.message);

                    //$("#divmessage").html(result.data);
                    MembershipTypeBind($('#hdnPageNo').val());
                },
                error: function (req, status, error) {
                    $("#divmessage").html(result.data);
                }
            });
        }
    }

    function mvalidity() {
        $('#Validity').show();
    }
    function lvalidity() {
        $('#Validity').hide();
        $('#Validity').val('');
    }
    function ClearSearch() {
        $('#keyword').val('');
        $('#ddlSearchChapterId').val('1').trigger('change'); // ✅ correct ID
        MembershipTypeBind(1);
    }
</script>

<input id="hdnPageNo" type="hidden" value="1" />
<input id="hdnsortcolumn" type="hidden" value="UpdatedTime" />
<input id="hdnsortorder" type="hidden" value="DESC" />

@*<div class="content-header">
        <h2 style="FONT-FAMILY: system-ui;">
            Membership Types
        </h2>

    </div>*@



<div class="card">
    <div class="card-header py-3 mb-3">
       
        <div class="row gx-2">

            @if (objAppInfo.chapterStatus == "Yes")
            {

                <div class="col-lg-3 col-md-6 col-8">
                    <div class="input-box">
                        <label class="form-label"> <span class="text-danger"></span>Search by Chapter</label>
                        <div class="input-group">


                            <select class="form-control" id="ddlSearchChapterId" name="ChapterId" style="@(ChapterId != 1 ? "pointer-events:none;" : "")">




                                @if (lstChapters != null && lstChapters.Count != 0)
                                {
                                    foreach (var item in lstChapters)
                                    {
                                        <option value="@item.ChapterId" @(item.ChapterId == ChapterId ? "selected=selected" : "")>@item.ChapterName</option>



                                    }
                                }


                            </select>
                            @*<span class="input-group-text pointer" style="cursor:pointer" onclick="MenuItemsBind(1);" id="basic-addon1"><i class="bi bi-search"></i></span>*@
                        </div>
                    </div>
                </div>

                <div class="col-lg-2 col-2">
                    <div>
                        <label>&nbsp;</label>
                    </div>
                    <button type="button" class="btn btn-primary px-3" onclick="MembershipTypeBind(1);">Search</button>
                    <button type="button" class="btn btn-danger px-3" onclick="ClearSearch();">Clear</button>
                </div>


            }

            <div class="col-lg-3 col-4 text-end ms-auto">
                <div class="btn-align">
                    @if (IsAdd == true)
                    {
                        <a class="btn btn-primary" onclick="Add();">Add Membership Type</a>
                    }
                    </div>
            </div>





            <div class="clearfix row">

            </div>

        </div>


    </div>

    <div class="modal fade" id="AddMembershipType" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            @using (Html.BeginForm("AddMembershipTypes", "MembershipTypes", FormMethod.Post, new { enctype = "multipart/form-data", @id = "FormWebBanners", @name = "FormWebBanners" }))
            {
                @*<input class="form-control" type="hidden" id="VendorLevelId" name="VendorLevelId" />*@
                <input type="hidden" id="MembershipTypeId" name="MembershipTypeId" value="0" />
                <input type="hidden" id="mid" name="mid" value="@Mid" />
                <input type="hidden" id="DisplayOrder" name="DisplayOrder" value="" />

                if (objAppInfo.chapterStatus == "No")
                {
                    <input id="ChapterId" name="ChapterId" type="hidden" value="1" />
                }
                //<input type="hidden" id="ChapterId" name="ChapterId" value="1" />
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><span id="lbltitle"></span></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-2">
                            <div class="col-lg-12 col-md-6">
                                <div class="input-box">
                                    <label class="form-label"> Membership Type <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="MembershipType" name="MembershipType" placeholder="Enter Membership Type" onkeypress="return Common.isChar(event)">
                                    <span class="field-validation-error" id="spanMembershipType"></span>

                                </div>
                            </div>
                            @if (objAppInfo.chapterStatus == "Yes")
                            {
                                <div class="col-lg-12 col-md-6">
                                    <div class="input-box">
                                        <label class="form-label">Chapters</label>

                                        <select class="form-control" id="ddlChapterId" name="ChapterId">

                                            <option value="">-- Select --</option>
                                            @if (lstChapters != null && lstChapters.Count != 0)
                                            {
                                                foreach (var item in lstChapters)
                                                {
                                                    <option value="@item.ChapterId" @(item.ChapterId == ChapterId ? "selected=selected" : "")>@item.ChapterName</option>
                                                }
                                            }
                                        </select>


                                    </div>
                                </div>

                            }

                                <div class="col-lg-12 col-md-6">
                                    <div class="input-box">
                                        <label class="form-label"> Price <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" onkeypress="return Common.isNumberKey(event);" id="Price" name="Price" placeholder="Enter price" maxlength="6">
                                    </div>
                                </div>
                                <div class="col-lg-12 col-md-6">
                                    <div class="input-box">
                                        <label class="form-label"> Membership Id Format <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="FormattedField" name="FormattedField" placeholder="Enter ID prefix (e.g., P-)">
                                        <span class="field-validation-error" id="spanFormattedField"></span>



                                    </div>
                                    <span style="padding-bottom: 10px">
                                        <br /><span style="color:#ff0000;">Note: </span>Here mention the string value to auto generate Membership-Id<br /> <span style="color:#ff6a00; font-weight:bold;">(Ex: P-, LF-, G- etc)</span>
                                    </span>
                                </div>
                                @*<br />*@
                                <div class="col-lg-12 col-md-6">
                                    <div class="input-box">
                                        @*<br />*@
                                        <label class="form-label"> Validity <span class="text-danger">*</span></label>
                                        @*<input type="text" class="form-control" id="FormattedField" name="FormattedField">*@
                                        <input type="radio" value="yes" checked="checked" id="lifetime" name="mval" onclick="lvalidity();" style="margin-left:4px;"> Life Time

                                        <input type="radio" value="no" id="No" name="mval" onclick="mvalidity();" style="margin-left:10px;">
                                        No
                                        <input type="text" value="" class="form-control t-m10" onkeypress="return Common.isNumberKey(event);" id="Validity" placeholder="Please Enter Months" name="Validity" maxlength="2" style="display: none;">

                                    </div>
                                    <br />

                                    <div>

                                    <span><span style="color:#ff0000;">Note: </span>If <b>Validity is No</b> Please enter validity in months <br /><b>(Ex: 12, 24, 36 etc)</b></span>
                                    </div>

                                </div>



                            </div>
                    </div>


                    <div class="modal-footer">
                        <input type="submit" class=" btn btn-success px-3 me-2" value="Submit" />

                        <a onclick=" $('#AddMembershipType').dialog('close')" class="btn btn-primary" data-bs-dismiss="modal">Cancel</a>



                    </div>
                </div>
            }
        </div>
    </div>

    <div id="divMembershipType" class="clearfix">
    </div>

    <script>
        $(document).ready(function () {
            $.ajax({
                type : "GET",
                url  : '@Url.Action("MembershipTypesList", "MembershipTypes")',
                data : {
                    IsEdit    : '@IsEdit',
                    IsView    : '@IsView',
                    IsDelete  : '@IsDelete',
                    IsExport  : '@IsExport',
                    IsAdd     : '@IsAdd',
                    Mid       : '@Mid',
                     ChapterId : '@(ChapterId == 0 ? 1 : ChapterId)'
                },
                success: function (data) {
                    $("#divMembershipType").html(data);
                },
                error: function () {
                    $("#divMembershipType").html('<p class="text-danger">Failed to load.</p>');
                }
            });
        });
    </script>


</div>
<script type="text/javascript">


    $(document).ready(function () {
        PagerClickBind();
    });

    $(document).ready(function () {
        $("#BannerUrl").change(function () {
            validateBannerUrl();
        });

        function validateBannerUrl() {
            $("#FormWebBanners").validate().resetForm();
            $("#FormWebBanners").validate().element("#BannerUrl");
        }

        $.validator.addMethod("validImageExtension", function (value, element) {
            if (element.files && element.files.length > 0) {
                var allowedExtensions = ["jpg", "png", "gif", "jpeg"];
                var fileName = element.files[0].name;
                var extension = fileName.split('.').pop().toLowerCase();
                return $.inArray(extension, allowedExtensions) !== -1;
            }
            return true;
        }, "Only allowed extensions are: jpg, png, gif, jpeg");


        var validateForm = $("#FormWebBanners").validate({
            rules: {
                MembershipType: "required",
                Price: {
                    required: true,
                    number: true // Ensures the input is a valid number
                },
                FormattedField: "required",
                Validity: {
                    required: function () {
                        return $("input[name='mval']:checked").val() === "no";
                    },
                    
                }
            },
            messages: {
                MembershipType: "Please enter a membership type",
                Price: {
                    required: "Please enter a membership price",
                    number: "Invalid Price"
                },
                FormattedField: "Please enter a membership ID format",
                Validity: {
                    required: "Please Enter Validity (Is In Months)",
                    number: "Invalid Validity"
                }
            },
            submitHandler: function (form) {
                var response = grecaptcha.getResponse();
                if ('Yes' == 'Yes') {
                    if (response.length === 0) {
                        alert('Please confirm that you are not a robot.');
                    }
                    else {
                        form.submit();
                    }
                }
                else {
                    form.submit();
                }
            },

            errorElement: "div",
            errorPlacement: function (error, element) {
                // Add the `invalid-feedback` class to the error element
                error.addClass("invalid-feedback");

                if (element.prop("type") === "checkbox") {
                    error.insertAfter(element.parent("label"));
                } else {
                    error.insertAfter(element);
                }

                // Move the error element after the fieldset element
                if (element.closest(".input-box").length) {
                    element.closest(".input-box").after(error);
                }
            },
            highlight: function (element, errorClass, validClass) {
                // Highlight the input, textarea, or select element with the `is-invalid` class
                var $element = $(element);
                if ($element.is('input, textarea, select')) {
                    $element.addClass("is-invalid").removeClass("is-valid");
                }


            },
            unhighlight: function (element, errorClass, validClass) {
                // Unhighlight the input, textarea, or select element by adding the `is-valid` class
                var $element = $(element);
                if ($element.is('input, textarea, select')) {
                    $element.addClass("is-valid").removeClass("is-invalid");
                }

            },


        });

        $('.modal').on('hidden.bs.modal', function () {
            // Reset form fields
            $('#FormWebBanners')[0].reset();

            // Reset form validations
            validateForm.resetForm();

            // Clear validation classes
            $('.modal').find('.error').removeClass('is-valid is-invalid');
            $('.modal').find('.form-control').removeClass('is-valid is-invalid');
        });
    });





</script>
<script>
    // Function to clear form validation errors and reset the form
    function clearFormErrorsAndReset() {
        // Clear any validation error messages
        $('em.error').remove(); // Assuming error messages have a class of 'error-message'

        // Reset the form
        $('form')[0].reset();
    }

    // Event handler for closing the modal dialog
    $('.modal-close-button, .close').on('click', function () {
        // Clear form errors and reset upon closing the modal
        clearFormErrorsAndReset();
    });

    // Event handler for when the modal is closed by clicking outside of it
    $('.modal').on('click', function (event) {
        // Check if the click event occurred outside the modal dialog
        if ($(event.target).hasClass('modal')) {
            // Clear form errors and reset upon closing the modal
            clearFormErrorsAndReset();
        }
    });

    // Additional event handler for any other action that might close the modal
    // For example, pressing escape key
    $(document).on('keydown', function (event) {
        // Check if the escape key was pressed and the modal is open
        if (event.key === "Escape" && $('.modal').is(':visible')) {
            // Clear form errors and reset upon closing the modal
            clearFormErrorsAndReset();
        }
    });


</script>






