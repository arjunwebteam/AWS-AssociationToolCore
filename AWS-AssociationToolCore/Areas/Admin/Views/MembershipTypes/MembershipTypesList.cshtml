@using AWS_AssociationToolCore.BLL

@{ Layout = null;}
@{
    string sortcolumn = (string)ViewBag.sortcolumn;
    string sortorder = (string)ViewBag.sortorder;
    Int64 Total = (Int64)ViewBag.total;
    var PageNo = (Int64)ViewBag.pageno;
    var Items = (Int64)ViewBag.items;
    var ChapterId = ViewBag.ChapterId;

    List<AWS_AssociationToolCore.Entities.MembershipTypes> lstMembershipType = ViewBag.lstMembershipTypes;

    bool IsEdit = Convert.ToBoolean(Context.Session.GetString("IsEdit"));
    bool IsView = Convert.ToBoolean(Context.Session.GetString("IsView"));
    bool IsDelete = Convert.ToBoolean(Context.Session.GetString("IsDelete"));
    bool IsExport = Convert.ToBoolean(Context.Session.GetString("IsExport"));

    string userRole = Context.Session.GetString("userrole") ?? string.Empty;
}

@*mahipal*@
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">


<script>
    $(document).ready(function () {
        $('#wMembership, #wMembershipTypes').addClass('active');
        $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
        $('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
    });

    function MembershipTypeStatus(MembershipTypeId) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("UpdateMembershipTypeStatus", "MembershipTypes")', // the URL of the controller action method
            data: { MembershipTypeId: MembershipTypeId }, // optional data
            datatype: "JSON",
            success: function (result) {
                showLobiboxNotification(result.messageType, result.message);

                if (result.ok) {
                    //$('#divmessage').html(result.data);
                    //$('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                    MembershipTypeBind(1);
                }
                else {
                    $('#divmessage').html(result.data);
                    $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                }
            }
        });
    }
    function UpdateDisplayOrder(i, MembershipTypeId) {
        var DisplayOrder = parseInt($('#DisplayOrder' + i).val());
        $.ajax({
            type: 'POST',
            url: '@Url.Action("UpdateDisplayOrder", "MembershipTypes")',
            data: { DisplayOrder: DisplayOrder, MembershipTypeId: MembershipTypeId },
            success: function (result) {
                showLobiboxNotification(result.messageType, result.message);

                var div = '';
                if (result.ok) {
                    //$("#divmessage").html(result.data);
                    //$('.alert-success').append('<i class="fa fa-check"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                    MembershipTypeBind(1);
                }
                else {
                    $("#divmessage").html(result.data);
                    $('.alert-danger').append('<i class="fa fa-ban"></i><button class="close" aria-hidden="true" data-dismiss="alert" type="button">×</button>');
                }
            }
        });
    }
</script>

<div class="card-body">
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead class="table-light">
                <tr>

                    <th width="80" style="text-align: center;">S.No</th>
                    <th width="10%" style="text-align: left">
                        <a onclick="javascript:sortresult('MembershipType');" class="cursor-pointer aws-h-a " style="color: black;">
                            Type
                        </a>
                    </th>
                    <th width="10%" style="text-align: left">
                        <a onclick="javascript:sortresult('Price');" class="cursor-pointer aws-h-a " style="color: black;">
                            Price
                        </a>
                    </th>
                    <th style="text-align: center;"> # </th>
                    <th style="text-align: center;"> Validity (Months)</th>
                    <th style="text-align: center;"> Membership Id Format</th>
                    <th style="text-align:center;">
                        <a style="color: black;" class="cursor-pointer aws-h-a" onclick="javascript:sortresult('DisplayOrder');">
                            Modified Date @if (sortcolumn == "UpdatedTime")
                            {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                        </a>
                    </th>
                    @if (IsEdit == true )
                    {

                        <th style="text-align:center;">
                            <a style="color: black;" class="cursor-pointer aws-h-a" onclick="javascript:sortresult('DisplayOrder');">
                                Order No @if (sortcolumn == "DisplayOrder")
                                {<img alt="@(sortorder)" title="@(sortorder)" src="Content/Admin/images/sort_@(sortorder).gif" />}
                            </a>
                        </th>

                        <th>Status</th>
                    }
                    @if (IsEdit == true || IsView == true || IsDelete == true)
                    {
                        <th>Action</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (lstMembershipType.Count != 0)
                {
                    int i = 0;
                    foreach (var item in lstMembershipType)
                    {

                <tr>
                    <td style="text-align: center;">@item.RId</td>
                    <td style="text-align: left;">

                        <div class="d-flex align-items-center gap-3">
                            <div class="">
                                <p class="mb-0">@item.MembershipType</p>
                            </div>
                        </div>
                    </td>
                    <td>$@item.Price</td>
                            <td><a href="@Url.Action("Index", "Members", new { MembershipTypeId = item.MembershipTypeId , mid = ViewBag.Mid})">Members</a> - (@item.MemberCount)</td>
                    <td style="text-align: center; color: #ff6a00; font-weight: bold; ">@(item.Validity != null && item.Validity != 0 ? item.Validity.ToString() : "Life Time")</td>
                    <td style="text-align: center; color: #ff6a00; font-weight: bold;">@(item.FormattedField != null && item.FormattedField != "" ? item.FormattedField : "--")</td>
                    <td style="text-align: center; color: #ff6a00; font-weight: bold;">@item.UpdatedTime.ToAppDate()</td>
                    @if (IsEdit == true )
                    {
                        <td style="text-align: center">
                            <input type="text" style="width:35px;margin-bottom:0px;" maxlength="3" id="DisplayOrder@(i)" value="@item.DisplayOrder" onkeypress="return Common.isNumberKey(event)" />
                            <a onclick="UpdateDisplayOrder(@i,@item.MembershipTypeId);" title="Update"><i style="font-size: 17px; cursor: pointer;" class="fa">&#xf021;</i></a>

                        </td>
                        <td>
                            <div class="menu-hover">
                                @{ var isChecked = item.IsActive ? "checked" : ""; }
                                @{var titleValue = item.IsActive ? "Active" : "Disabled";}

                                <div>
                                    <label class="switch" title="@titleValue">
                                        <input type="checkbox" onclick="MembershipTypeStatus(@item.MembershipTypeId)" @isChecked>
                                        <span class="slider"></span>
                                    </label>
                                </div>
                            </div>
                        </td>
                    }
                    @if ( IsEdit == true || IsView == true || IsDelete == true)
                    {
                        <td class="text-center">
                            <div class="table-actions d-flex align-items-center gap-3 fs-6">
                                @if (IsEdit == true )
                                {
                                    <a class="text-warning cursor-pointer" onclick="MembershipTypeEdit(@item.MembershipTypeId);" title=" Edit" aria-label="Edit"><i class="bi bi-pencil-fill"></i></a>
                                }
                                @if (IsDelete == true )
                                {
                                            if (item.MemberCount == 0)
                                            {
                                                <a class="text-danger cursor-pointer" onclick="Delete(@item.MembershipTypeId, '@item.MembershipType');" title="Delete" aria-label="Delete"><i class="bi bi-trash-fill"></i></a>
                                            }
                                            else
                                            {
                                                <a class="sepV_a disable-alpha cursor-pointer" style="color: #79818b" title="This committee has members"><i class="bi bi-trash-fill"></i></a>

                                            }
                                        
                                }
                            </div>
                        </td>
                    }
                    </tr>
                        i++;
                    }
                }
                else
                {
                    <tr class="odd"><td valign="top" colspan="10" class="font-14 text-center">No  Records found</td></tr>
                }
            </tbody>
        </table>
    </div>


    <div class="row pt-3">
        <div class="col-sm-4 col-md-5">
            <div class="dataTables_info" id="example_info" role="status" aria-live="polite">
                Showing @((PageNo * Items) - (Items - 1)) - @((PageNo * Items) > Total ? Total : (PageNo * Items)) of @Total entries
            </div>
        </div>
        <div class="col-sm-3 col-md-7 " @(Total > 0 ? "" : "disable")>
            <div class="d-flex flex-wrap gap-4 justify-content-end">

                <div class="dataTables_paginate paging_simple_numbers" id="example_paginate">
                    @Html.Raw(AWS_AssociationToolCore.BLL.Common.SetPaging((Int64)ViewBag.items, ref Total, (Int64)ViewBag.pageno, "pagination pb-0"))
                </div>
            </div>
        </div>
    </div>



</div>


<style>
    .aws-h-a {
        text-decoration: none;
        position: relative;
    }

        .aws-h-a::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            bottom: -2px;
            border-bottom: 2px solid #0756ca;
            transform: scaleX(0);
            transition: transform 0.3s ease;
        }

        .aws-h-a:hover::after {
            transform: scaleX(1);
        }
</style>