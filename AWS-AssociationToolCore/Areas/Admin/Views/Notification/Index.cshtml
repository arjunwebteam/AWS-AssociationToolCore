    function SendNotification() {



        $('#NotificationDialog').modal('show');
        $('#lbltitle').html('Send Notifications');
        $('#Title').val('');
        $('#Body').val('');
    }



    function selectall(name, i) {
        var status = true;
        if ($("#A" + name).hasClass('selectall')) {
            $("#A" + name).removeClass('selectall').addClass('clearall');
            $('#SelectAll').val('No');
            status = false;
        }
        else {
            $("#A" + name).removeClass('clearall').addClass('selectall');
            $('#SelectAll').val('Yes');
            status = true;
        }
        $('.C' + name).each(function () { //iterate all listed checkbox items
            this.checked = status; //change ".checkbox" checked status
        });
    }


    function NotificationSending() {
    if (ValidateNotification()) {

        var AppuserIds = $('#AppuserIds').val();
        var Title = $('#Title').val();
        var Body = $('#Body').val();
        var Action = $('#Action').val();
        var PaymentDate = $('#PaymentDate').val();
        var Eid = '';
        var Els = '';
        var Wv = '';
        var SS = '';
        var LS = '';
        var SE = '';

        if (Action == "Events") {
            Eid = $('#EventId').val();
        }
        if (Action == "EventList") {
            Els = $('#EventType').val();
        }
        if (Action == "WebViews") {
            Wv = $('#WebViews').val();
        }
        if (Action == "Services") {
            SS = $('#Action').val();
        }
        if (Action == "Leadership") {
            LS = $('#Action').val();
        }
        if (Action == "SavedEvents") {
            SE = $('#Action').val();
        }

        // ✅ ADD THIS BLOCK — create FormData manually
        var formData = new FormData();
        formData.append("AppuserIds", AppuserIds);
        formData.append("Action", Action);
        formData.append("Title", Title);
        formData.append("Body", Body);
        formData.append("Eid", Eid);
        formData.append("Els", Els);
        formData.append("Wv", Wv);
        formData.append("SS", SS);
        formData.append("LS", LS);
        formData.append("SE", SE);
        formData.append("PaymentDate", PaymentDate);

        // 👇 add the file properly
        var fileInput = document.getElementById("BannerUrl");
        if (fileInput.files.length > 0) {
            formData.append("BannerUrl", fileInput.files[0]);
        }

        // ✅ only change this small part:
        $.ajax({
            type: "POST",
            url: '@Url.Action("SendNotification", "Notification")',
            data: formData,              // 👈 pass FormData here
            contentType: false,          // 👈 required
            processData: false,          // 👈 required
            success: function (result) {
                showLobiboxNotification(result.messageType, result.message);
                if (result.ok) {
                    $('#divmessage').html('<div class="closable success">Sent Notification successfully</div>');
                    AppUsersBind(1);
                }
                else {
                    $('#divmessage').html('<div class="closable error">Failed Sending Notification.</div>');
                }
                $("#NotificationDialog").modal("hide");
                $('.closable').append("<a class=\"dis-in\" onclick=\"this.parentElement.style.display='none';\" ><i class=\"closelink\">&nbsp;</i></a>");
                $('.success').append("<i class=\"success-icon\">&nbsp;</i>");
                $('.error').append("<i class=\"error-icon\">&nbsp;</i>");
                $('#NotificationDialog').dialog('close');

                $('#Submitbtn').show();
                $('#Loading').hide();
                AppUsersBind(1);
            }
        });
    }
}




    function ValidateNotification() {
        if ($.trim($('#Title').val()) == '') { $('#Title').focus().addClass('redborder'); $('#spanTitle').show().html('Title Required <span>&nbsp;</span><i>&nbsp;</i><abbr onclick="closeValidation(this);">&nbsp;</abbr>'); return false; } else { $('#spanTitle').hide().html(''); $('#Title').removeClass("redborder"); }

        if ($.trim($('#Body').val()) == '') { $('#Body').focus().addClass('redborder'); $('#spanBody').show().html('Body Required <span>&nbsp;</span><i>&nbsp;</i><abbr onclick="closeValidation(this);">&nbsp;</abbr>'); return false; } else { $('#spanBody').hide().html(''); $('#Body').removeClass("redborder"); }

        return true;
    }


function ItemSelect() {
        var NType = $('#Action').val();
    if (NType != "") {

        if (NType == "Events") {
            $.ajax({
                url: '@Url.Action("EventList", "Events")',
                type: 'POST',
                cache: false,
                success: function (result) {
                    if (result.ok) {
                        var EventsList = result.data;
                        var sb = "";
                        sb = sb + "<select id=\"EventId\" name=\"EventId\" class=\"bsearch-box form-control search_test\">";
                        sb = sb + "<option value=\"\">Select</option>";
                        if (EventsList != null) {

                            for (var k = 0; k < EventsList.length; k++) {
                                sb = sb + "<option value=\"" + EventsList[k].EventId + "\">" + EventsList[k].EventName + "</option>";
                            }
                        }
                        sb = sb + "</select>";
                        $('#divBlog').html('');
                        $('#divBlog').html(sb);
                        $('#BlogSec').show();
                        $('#BlogSec1').hide();
                        $('#BlogSec2').hide();

                        window.Search = $('.bsearch-box').SumoSelect({ csvDispCount: 3, search: true, searchText: 'Enter here.' });
                    }
                }
            });
        }
        else if (NType == "EventList")
       {
            $('#BlogSec1').show();
            $('#BlogSec').hide();
            $('#BlogSec2').hide();

        }

        else if (NType == "Immediately") {


            $('#BlogSec2').hide();
            $('#BlogSec').hide();
            $('#BlogSec1').hide();

        }
        else if (NType == "SpecificTime") {


            $('#BlogSec2').show();
            $('#BlogSec').hide();
            $('#BlogSec1').hide();

        }
        else if (NType == "Services") {


            $('#BlogSec3').show();
            $('#BlogSec').hide();
            $('#BlogSec1').hide();
            $('#BlogSec2').hide();
        }
        else if (NType == "Leadership") {
            $('#BlogSec3').show();
            $('#BlogSec').hide();
            $('#BlogSec1').hide();
            $('#BlogSec2').hide();
        }
        else if (NType == "SavedEvents") {
            $('#BlogSec3').show();
            $('#BlogSec').hide();
            $('#BlogSec1').hide();
            $('#BlogSec2').hide();
        }


    }
}


