       function AppUsersBind(Pageno) {

        var pageno = Common.Pageno(Pageno);
        var sortcolumn = $('#hdnsortcolumn').val();
        var sortorder = $('#hdnsortorder').val();
        var items = $('#txtitems').val();
        var Search = $('#txtsearch').val().trim();

        $.ajax({
            url: '@Url.Action("NotificationUsersList", "Notification")',
            type: 'GET',
            cache: false,
            data: { Search: Search, PageNo: pageno, SortColumn: sortcolumn, SortOrder: sortorder, Items: items},
            success: function (result) {
                $('#divDetails').html(result);
                PagerClickBind();
            }
        });
    }


    function UsersView(NotificationID) {
        var imgloc = $('#imgloc').val();
        $.ajax({
            url: '@Url.Action("NotificationView", "Notification")',
            type: 'POST',
            data: { NotificationID: NotificationID },
            datatype: "JSON",
            success: function (result) {
               
                if (result.ok) {
                   
                  
                    var objNotification = result.data;
                    $('#Vlbltitle').html('View Notification');
                    //$('#VlblName').html(objNotification.Title);
                   // $('#VlblBody').html(objNotification.Body);

                    var body = objNotification.Body.replace(/\n/g, "<br>");
                    $("#VlblBody").html(body);

                    var Title = objNotification.Title.replace(/\n/g, "<br>");
                    $("#VlblName").html(Title);


                    $('#lblKumar').html('Notification Preview Details');
                    if (objNotification.imageurl != '') {
                        var imageUrl = imgloc + objNotification.imageurl;

                        $('#test1').attr('src', imageUrl).show();
                    }
                    
                    
                    $('#Kumar').modal('show');

                }
                else {
                    alert(result.data);
                }
            }
        });

    }


</script>


