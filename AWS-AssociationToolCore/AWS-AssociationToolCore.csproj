<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<MvcRazorCompileOnPublish>true</MvcRazorCompileOnPublish>
		<RazorCompileOnBuild>true</RazorCompileOnBuild>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>AWS_AssociationToolCore</RootNamespace>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
		<NoWarn>CS0579</NoWarn>
		<PreserveCompilationReferences>true</PreserveCompilationReferences>
		<AcceptNPOIOSMFLicense>true</AcceptNPOIOSMFLicense>
		<PreserveCompilationContext>true</PreserveCompilationContext>
		<StaticWebAssetsCacheDefineStaticWebAssetsEnabled>false</StaticWebAssetsCacheDefineStaticWebAssetsEnabled>
	</PropertyGroup>

	<!-- ✅ This is for copying views -->
	<ItemGroup>
		<Compile Remove="$(IntermediateOutputPath)**\*.cs" />
		<Compile Remove="Areas\Forms\**" />
		<Content Remove="Areas\Forms\**" />
		<EmbeddedResource Remove="Areas\Forms\**" />
		<None Remove="Areas\Forms\**" />
	</ItemGroup>
	<ItemGroup>
		<Content Update="Views\**\*" CopyToPublishDirectory="Always" />
		<Content Update="Areas\**\*" CopyToPublishDirectory="Always" />
	</ItemGroup>
